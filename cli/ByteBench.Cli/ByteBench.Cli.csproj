<Project Sdk="Microsoft.NET.Sdk">

  <!-- The `bytebench` command-line client: a .NET tool (dotnet tool install -g ByteBench.Cli), no dependencies beyond the BCL. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ByteBench.Cli</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>bytebench</ToolCommandName>
    <!-- Release builds set it from the tag: dotnet pack -p:Version=1.2.3 (see .github/workflows/cli-release.yml). -->
    <Version Condition="'$(Version)' == ''">0.1.0</Version>
  </PropertyGroup>

  <!-- NuGet package metadata. The repository has no LICENSE file, so no license metadata is set. -->
  <PropertyGroup>
    <PackageId>ByteBench.Cli</PackageId>
    <Title>ByteBench CLI</Title>
    <Authors>ByteBench contributors</Authors>
    <Description>Command-line client for ByteBench: issues, pull requests, repositories and pipelines from a terminal. Installs the `bytebench` command.</Description>
    <PackageTags>bytebench;cli;issues;pull-requests;git;devops</PackageTags>
    <PackageProjectUrl>https://github.com/finepointcgi/ByteBench</PackageProjectUrl>
    <RepositoryUrl>https://github.com/finepointcgi/ByteBench</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
