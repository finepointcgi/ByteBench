<div class="gb-empty-state">
    <MudIcon Class="mud-text-secondary" Icon="@Icons.Material.Outlined.SearchOff" Size="Size.Large" />
    <MudText Typo="Typo.h6" HtmlTag="h2">Not found</MudText>
    <MudText Class="mud-text-secondary" Typo="Typo.body2">@Message</MudText>
    <MudButton Href="/" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.ArrowBack" Class="mt-2">Back to dashboard</MudButton>
</div>

@code {
    [Parameter] public string Message { get; set; } = "This project does not exist.";
}
