@inject IssueService Issues
@inject CurrentUser Me
@inject IDialogService Dialogs
@inject ISnackbar Snackbar

@* Sticky bar over the issue list while issues are selected. Each action is one IssueService.BulkUpdateAsync call. *@
<div class="bulk-bar" role="toolbar" aria-label="Bulk edit">
    <b class="bulk-count">@SelectedIds.Count selected</b>
    <MudMenu Label="Status" AriaLabel="Set status" Disabled="busy" Size="Size.Small" Variant="Variant.Text" Color="Color.Inherit"
             EndIcon="@Icons.Material.Filled.ArrowDropDown" Dense="true" MaxHeight="360" Class="bulk-menu">
        @foreach (var s in Enum.GetValues<IssueStatus>()) { <MudMenuItem OnClick="() => SetStatus(s)">@s.Name()</MudMenuItem> }
    </MudMenu>
    <MudMenu Label="Assignee" AriaLabel="Set assignee" Disabled="busy" Size="Size.Small" Variant="Variant.Text" Color="Color.Inherit"
             EndIcon="@Icons.Material.Filled.ArrowDropDown" Dense="true" MaxHeight="360" Class="bulk-menu">
        <MudMenuItem OnClick="() => SetAssignee(null)">Unassigned</MudMenuItem>
        <MudMenuItem OnClick="() => SetAssignee(Me.Id)">Me</MudMenuItem>
        @foreach (var u in Users.Where(u => u.Id != Me.Id)) { <MudMenuItem OnClick="() => SetAssignee(u.Id)">@u.DisplayName</MudMenuItem> }
    </MudMenu>
    <MudMenu Label="Priority" AriaLabel="Set priority" Disabled="busy" Size="Size.Small" Variant="Variant.Text" Color="Color.Inherit"
             EndIcon="@Icons.Material.Filled.ArrowDropDown" Dense="true" MaxHeight="360" Class="bulk-menu">
        @foreach (var p in Enum.GetValues<IssuePriority>().Reverse())
        {
            <MudMenuItem OnClick="() => SetPriority(p)"><span class="d-inline-flex align-center gap-2"><PriorityIcon Priority="p" /> @p</span></MudMenuItem>
        }
    </MudMenu>
    <MudMenu Label="Milestone" AriaLabel="Set milestone" Disabled="busy" Size="Size.Small" Variant="Variant.Text" Color="Color.Inherit"
             EndIcon="@Icons.Material.Filled.ArrowDropDown" Dense="true" MaxHeight="360" Class="bulk-menu">
        <MudMenuItem OnClick="() => SetMilestone(null)">No milestone</MudMenuItem>
        @foreach (var m in Project.Milestones.Where(m => !m.IsClosed)) { <MudMenuItem OnClick="() => SetMilestone(m.Id)">@m.Title</MudMenuItem> }
    </MudMenu>
    @if (Project.Labels.Count > 0)
    {
        <MudMenu Label="Add label" AriaLabel="Add label" Disabled="busy" Size="Size.Small" Variant="Variant.Text" Color="Color.Inherit"
                 StartIcon="@Icons.Material.Filled.Add" EndIcon="@Icons.Material.Filled.ArrowDropDown" Dense="true" MaxHeight="360" Class="bulk-menu">
            @foreach (var l in Project.Labels) { <MudMenuItem OnClick="() => AddLabel(l)"><LabelChip Label="l" /></MudMenuItem> }
        </MudMenu>
        <MudMenu Label="Remove label" AriaLabel="Remove label" Disabled="busy" Size="Size.Small" Variant="Variant.Text" Color="Color.Inherit"
                 StartIcon="@Icons.Material.Filled.Remove" EndIcon="@Icons.Material.Filled.ArrowDropDown" Dense="true" MaxHeight="360" Class="bulk-menu">
            @foreach (var l in Project.Labels) { <MudMenuItem OnClick="() => RemoveLabel(l)"><LabelChip Label="l" /></MudMenuItem> }
        </MudMenu>
    }
    @if (Perms.Role >= ProjectRole.Maintainer)
    {
        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error" StartIcon="@Icons.Material.Outlined.Delete" Disabled="busy"
                   OnClick="Delete" Class="bulk-delete">Delete</MudButton>
    }
    <span class="bulk-end">
        @if (busy) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Style="width:18px;height:18px" Color="Color.Inherit" /> }
        @if (error != null) { <span class="bulk-error" role="alert">@error</span> }
        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Inherit" OnClick="OnClear" Class="bulk-clear">Clear selection</MudButton>
    </span>
</div>

@code {
    [Parameter, EditorRequired] public Project Project { get; set; } = null!;
    [Parameter, EditorRequired] public List<User> Users { get; set; } = [];
    [Parameter, EditorRequired] public ProjectPermissions Perms { get; set; } = ProjectPermissions.None;
    [Parameter, EditorRequired] public IReadOnlyCollection<int> SelectedIds { get; set; } = [];
    [Parameter] public EventCallback OnClear { get; set; }
    /// <summary>Raised after an action (argument: whether issues were deleted).</summary>
    [Parameter] public EventCallback<bool> OnDone { get; set; }

    private bool busy;
    private string? error;

    private Task SetStatus(IssueStatus s) => Run(new() { Status = s }, $"status → {s.Name()}");
    private Task SetPriority(IssuePriority p) => Run(new() { Priority = p }, $"priority → {p}");

    private Task SetAssignee(int? id) => id == null
        ? Run(new() { SetAssignee = true }, "unassigned")
        : Run(new() { SetAssignee = true, AssigneeId = id }, "assignee → " + (id == Me.Id ? Me.User?.DisplayName : Users.FirstOrDefault(u => u.Id == id)?.DisplayName ?? "?"));

    private Task SetMilestone(int? id) => id == null
        ? Run(new() { SetMilestone = true }, "milestone removed")
        : Run(new() { SetMilestone = true, MilestoneId = id }, "milestone → " + Project.Milestones.FirstOrDefault(m => m.Id == id)?.Title);

    private Task AddLabel(Label l) => Run(new() { AddLabelId = l.Id }, "+ " + l.Name);
    private Task RemoveLabel(Label l) => Run(new() { RemoveLabelId = l.Id }, "− " + l.Name);

    private async Task Delete()
    {
        var n = SelectedIds.Count;
        var ok = await Dialogs.ShowMessageBoxAsync($"Delete {n} issue{(n == 1 ? "" : "s")}?", "This cannot be undone.",
            yesText: "Delete", cancelText: "Cancel");
        if (ok != true) return;
        await Run(new() { Delete = true }, "deleted");
    }

    private async Task Run(BulkIssueChange change, string what)
    {
        if (SelectedIds.Count == 0) return;
        busy = true; error = null;
        try
        {
            var r = await Issues.BulkUpdateAsync(SelectedIds.ToList(), change, Me.Id);
            Snackbar.Add(change.Delete ? $"Deleted {r.Deleted} issue{(r.Deleted == 1 ? "" : "s")}."
                : $"{what}: {r.Changed} updated" + (r.Unchanged > 0 ? $", {r.Unchanged} already set" : "") + ".", Severity.Success);
            await OnDone.InvokeAsync(change.Delete);
        }
        catch (InvalidOperationException ex) { error = ex.Message; }
        finally { busy = false; }
    }
}
