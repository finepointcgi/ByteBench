@inject IssueService Issues
@inject CurrentUser Me
@inject IJSRuntime JS

@* Sticky bar over the issue list while issues are selected. Each action is one IssueService.BulkUpdateAsync call. *@
<div class="bulk-bar" role="toolbar" aria-label="Bulk edit">
    <b class="bulk-count">@SelectedIds.Count selected</b>
    <select @key="(nameof(SetStatus), version)" class="form-select form-select-sm" disabled="@busy" @onchange="SetStatus" aria-label="Set status">
        <option value="" selected>Status…</option>
        @foreach (var g in Workflow.Statuses.GroupBy(s => s.Category).OrderBy(g => g.Key))
        {
            <optgroup label="@g.Key.Name()">
                @foreach (var ws in g) { <option value="@ws.Id">@ws.Name</option> }
            </optgroup>
        }
    </select>
    <select @key="(nameof(SetAssignee), version)" class="form-select form-select-sm" disabled="@busy" @onchange="SetAssignee" aria-label="Set assignee">
        <option value="" selected>Assignee…</option>
        <option value="none">Unassigned</option>
        <option value="@Me.Id">Me</option>
        @foreach (var u in Users.Where(u => u.Id != Me.Id)) { <option value="@u.Id">@u.DisplayName</option> }
    </select>
    <select @key="(nameof(SetPriority), version)" class="form-select form-select-sm" disabled="@busy" @onchange="SetPriority" aria-label="Set priority">
        <option value="" selected>Priority…</option>
        @foreach (var p in Enum.GetValues<IssuePriority>().Reverse()) { <option value="@p">@p.Icon() @p</option> }
    </select>
    <select @key="(nameof(SetMilestone), version)" class="form-select form-select-sm" disabled="@busy" @onchange="SetMilestone" aria-label="Set milestone">
        <option value="" selected>Milestone…</option>
        <option value="none">No milestone</option>
        @foreach (var m in Project.Milestones.Where(m => !m.IsClosed)) { <option value="@m.Id">@m.Title</option> }
    </select>
    @if (Project.Labels.Count > 0)
    {
        <select @key="(nameof(AddLabel), version)" class="form-select form-select-sm" disabled="@busy" @onchange="AddLabel" aria-label="Add label">
            <option value="" selected>+ Label…</option>
            @foreach (var l in Project.Labels) { <option value="@l.Id">@l.Name</option> }
        </select>
        <select @key="(nameof(RemoveLabel), version)" class="form-select form-select-sm" disabled="@busy" @onchange="RemoveLabel" aria-label="Remove label">
            <option value="" selected>− Label…</option>
            @foreach (var l in Project.Labels) { <option value="@l.Id">@l.Name</option> }
        </select>
    }
    @if (Perms.Role >= ProjectRole.Maintainer)
    {
        <button type="button" class="btn btn-outline-danger btn-sm" disabled="@busy" @onclick="Delete">Delete</button>
    }
    <span class="ms-auto d-flex align-items-center gap-2">
        @if (busy) { <span class="spinner-border spinner-border-sm"></span> }
        @if (message != null) { <span class="small @(isError ? "text-danger" : "text-success")">@message</span> }
        <button type="button" class="btn btn-link btn-sm" @onclick="OnClear">Clear selection</button>
    </span>
</div>

@code {
    [Parameter, EditorRequired] public Project Project { get; set; } = null!;
    /// <summary>The project's workflow: the status menu lists its statuses, grouped by category.</summary>
    [Parameter, EditorRequired] public ProjectWorkflow Workflow { get; set; } = ProjectWorkflow.Empty;
    [Parameter, EditorRequired] public List<User> Users { get; set; } = [];
    [Parameter, EditorRequired] public ProjectPermissions Perms { get; set; } = ProjectPermissions.None;
    [Parameter, EditorRequired] public IReadOnlyCollection<int> SelectedIds { get; set; } = [];
    [Parameter] public EventCallback OnClear { get; set; }
    /// <summary>Raised after an action (argument: whether issues were deleted).</summary>
    [Parameter] public EventCallback<bool> OnDone { get; set; }

    private bool busy, isError;
    private int version; // bumped after each action so the selects re-render showing their placeholder
    private string? message;

    private static int? Id(ChangeEventArgs e) => int.TryParse(e.Value?.ToString(), out var v) ? v : null;
    private static string Val(ChangeEventArgs e) => e.Value?.ToString() ?? "";

    // Bulk status goes through IssueService.ReconcileStatusAsync, so transitions apply and a refusal changes nothing.
    private Task SetStatus(ChangeEventArgs e) => Id(e) is { } id && Workflow.Find(id) is { } ws
        ? Run(new() { WorkflowStatusId = id }, $"status → {ws.Name}") : Task.CompletedTask;
    private Task SetPriority(ChangeEventArgs e) => Enum.TryParse<IssuePriority>(Val(e), out var p) ? Run(new() { Priority = p }, $"priority → {p}") : Task.CompletedTask;

    private Task SetAssignee(ChangeEventArgs e) => Val(e) switch
    {
        "" => Task.CompletedTask,
        "none" => Run(new() { SetAssignee = true }, "unassigned"),
        _ => Run(new() { SetAssignee = true, AssigneeId = Id(e) }, "assignee → " + (Users.FirstOrDefault(u => u.Id == Id(e))?.DisplayName ?? "?")),
    };

    private Task SetMilestone(ChangeEventArgs e) => Val(e) switch
    {
        "" => Task.CompletedTask,
        "none" => Run(new() { SetMilestone = true }, "milestone removed"),
        _ => Run(new() { SetMilestone = true, MilestoneId = Id(e) }, "milestone → " + Project.Milestones.FirstOrDefault(m => m.Id == Id(e))?.Title),
    };

    private Task AddLabel(ChangeEventArgs e) => Id(e) is { } id ? Run(new() { AddLabelId = id }, "+ " + Project.Labels.FirstOrDefault(l => l.Id == id)?.Name) : Task.CompletedTask;
    private Task RemoveLabel(ChangeEventArgs e) => Id(e) is { } id ? Run(new() { RemoveLabelId = id }, "− " + Project.Labels.FirstOrDefault(l => l.Id == id)?.Name) : Task.CompletedTask;

    private async Task Delete()
    {
        var n = SelectedIds.Count;
        if (!await JS.InvokeAsync<bool>("confirm", $"Delete {n} issue{(n == 1 ? "" : "s")}? This cannot be undone.")) return;
        await Run(new() { Delete = true }, "deleted");
    }

    private async Task Run(BulkIssueChange change, string what)
    {
        if (SelectedIds.Count == 0) return;
        busy = true; message = null; isError = false;
        try
        {
            var r = await Issues.BulkUpdateAsync(SelectedIds.ToList(), change, Me.Id);
            message = change.Delete ? $"Deleted {r.Deleted} issue{(r.Deleted == 1 ? "" : "s")}."
                : $"{what}: {r.Changed} updated" + (r.Unchanged > 0 ? $", {r.Unchanged} already set" : "") + ".";
            await OnDone.InvokeAsync(change.Delete);
        }
        catch (InvalidOperationException ex) { message = ex.Message; isError = true; }
        finally { busy = false; version++; }
    }
}
