@* Workspace secrets of the signed-in user (RepositoryId null) or of one repository. Values are write-only: never shown after saving. *@
@using ByteBench.Services.Workspaces
@inject WorkspaceSecretService Secrets
@inject CurrentUser Me
@inject IDialogService Dialogs
@inject ISnackbar Snackbar

<div class="wss" data-testid="ws-secrets">
@if (error != null) { <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3">@error</MudAlert> }

@if (items.Count == 0 && !adding)
{
    <MudText Typo="Typo.body2" Class="mud-text-secondary mb-2">No secrets yet.</MudText>
}
else if (items.Count > 0)
{
    <MudSimpleTable Dense="true" Elevation="0" Class="mb-3">
        <thead><tr><th>Name</th><th>Value</th><th>Updated</th><th></th></tr></thead>
        <tbody>
            @foreach (var s in items)
            {
                <tr @key="s.Id">
                    <td class="mono">@s.Name</td>
                    <td class="mud-text-secondary">••••••</td>
                    <td class="mud-text-secondary">@s.UpdatedAt.ToString("yyyy-MM-dd")</td>
                    <td>
                        <MudTooltip Text="Replace the value"><MudIconButton Icon="@Icons.Material.Outlined.Edit" Size="Size.Small" aria-label="@($"Replace secret {s.Name}")" OnClick="() => Edit(s)" /></MudTooltip>
                        <MudTooltip Text="Delete"><MudIconButton Icon="@Icons.Material.Outlined.Delete" Color="Color.Error" Size="Size.Small" aria-label="@($"Delete secret {s.Name}")" OnClick="() => Delete(s)" /></MudTooltip>
                    </td>
                </tr>
            }
        </tbody>
    </MudSimpleTable>
}

@if (adding)
{
    <MudGrid Spacing="2">
        <MudItem xs="12" md="5">
            <MudTextField T="string" Label="Name" Placeholder="DATABASE_URL" @bind-Value="name" Immediate="true" ReadOnly="@(editing != null)"
                          Variant="Variant.Outlined" Margin="Margin.Dense" ShrinkLabel="true" Class="gb-mono-input" autocomplete="off" data-testid="ws-secret-name" />
        </MudItem>
        <MudItem xs="12" md="7">
            <MudTextField T="string" Label="Value" InputType="InputType.Password" @bind-Value="value" Placeholder="Write-only; never shown again"
                          Variant="Variant.Outlined" Margin="Margin.Dense" ShrinkLabel="true" autocomplete="new-password" data-testid="ws-secret-value" />
        </MudItem>
    </MudGrid>
    <div class="d-flex gap-2 mt-2">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" Disabled="@(string.IsNullOrWhiteSpace(name) || string.IsNullOrEmpty(value))" OnClick="Save" data-testid="ws-secret-save">@(editing == null ? "Add secret" : "Replace value")</MudButton>
        <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="Cancel">Cancel</MudButton>
    </div>
}
else
{
    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Add" OnClick="() => adding = true" data-testid="ws-secret-add">Add secret</MudButton>
}
</div>

@code {
    /// <summary>Null: the signed-in user's own secrets.</summary>
    [Parameter] public int? RepositoryId { get; set; }

    private List<WorkspaceSecretInfo> items = [];
    private bool adding;
    private WorkspaceSecretInfo? editing;
    private string name = "", value = "";
    private string? error;

    protected override async Task OnParametersSetAsync() => await Load();

    private async Task Load()
    {
        await Me.EnsureLoadedAsync();
        try { items = RepositoryId is { } r ? await Secrets.ListForRepositoryAsync(r, Me.Id) : await Secrets.ListMineAsync(Me.Id); error = null; }
        catch (InvalidOperationException ex) { error = ex.Message; items = []; }
    }

    private void Edit(WorkspaceSecretInfo s) { editing = s; name = s.Name; value = ""; adding = true; }

    private void Cancel() { adding = false; editing = null; name = ""; value = ""; error = null; }

    private async Task Save()
    {
        try
        {
            if (RepositoryId is { } r) await Secrets.SaveForRepositoryAsync(r, Me.Id, name, value);
            else await Secrets.SaveMineAsync(Me.Id, name, value);
            Snackbar.Add("Secret saved. It reaches workspaces that start after this.", Severity.Success);
            Cancel();
            await Load();
        }
        catch (InvalidOperationException ex) { error = ex.Message; }
        finally { value = ""; }
    }

    private async Task Delete(WorkspaceSecretInfo s)
    {
        var ok = await Dialogs.ShowMessageBoxAsync($"Delete {s.Name}?", "Workspaces that start after this won't get it. Running workspaces keep what they have until they stop.", yesText: "Delete", cancelText: "Cancel");
        if (ok != true) return;
        try
        {
            if (RepositoryId is { } r) await Secrets.DeleteForRepositoryAsync(r, Me.Id, s.Id);
            else await Secrets.DeleteMineAsync(Me.Id, s.Id);
            await Load();
        }
        catch (InvalidOperationException ex) { error = ex.Message; }
    }
}
