@* Filterable, paginated audit log. With ProjectId: that project's events (Owners). Without: every event (site admins). *@
@using ByteBench.Services.Audit
@using System.Text.Json
@inject AuditLog Audit
@inject IssueService Issues

<div class="audit-viewer">
<form class="audit-filters" @onsubmit="Search" @onsubmit:preventDefault>
    <MudTextField T="string" @bind-Value="actor" Label="Actor (username)" Variant="Variant.Outlined" Margin="Margin.Dense"
                  Immediate="true" Class="audit-f-actor" aria-label="Actor" />
    <MudAutocomplete T="string" @bind-Value="action" Label="Action prefix" Placeholder="e.g. member." Variant="Variant.Outlined" Margin="Margin.Dense"
                     SearchFunc="SearchActions" CoerceValue="true" CoerceText="false" ResetValueOnEmptyText="true" MaxItems="50"
                     Clearable="true" Class="audit-f-action" aria-label="Action prefix" />
    @if (ProjectId == null)
    {
        <MudTextField T="string" @bind-Value="projectKey" Label="Project key" Variant="Variant.Outlined" Margin="Margin.Dense"
                      Immediate="true" Class="audit-f-project" aria-label="Project key" />
    }
    @* Wrapped: the picker also hands Class to its inner input, so sizing it directly stretches that input. *@
    <div class="audit-f-dates">
        <MudDateRangePicker DateRange="Range" DateRangeChanged="SetRange" Label="Dates (UTC)" Variant="Variant.Outlined" Margin="Margin.Dense"
                            PlaceholderStart="From" PlaceholderEnd="To" Clearable="true" Editable="true" aria-label="Date range (UTC)" />
    </div>
    <div class="audit-f-buttons">
        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                   StartIcon="@Icons.Material.Filled.FilterList">Filter</MudButton>
        <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="Reset">Reset</MudButton>
    </div>
    <MudSpacer />
    <MudButton Href="@ExportHref" download Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Outlined.FileDownload">Export CSV</MudButton>
</form>

@if (error != null) { <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3">@error</MudAlert> }

@if (result != null)
{
    <MudText Typo="Typo.caption" HtmlTag="div" Class="mud-text-secondary mb-2">
        @if (result.Total == 0) { <span>No events match.</span> }
        else { <span>Showing @(Skip + 1)–@(Skip + result.Events.Count) of @result.Total events (newest first). Times are shown in UTC.</span> }
    </MudText>
    @if (result.Events.Count > 0)
    {
        <MudPaper Outlined="true" Class="audit-table-wrap">
            <MudSimpleTable Dense="true" Hover="true" Elevation="0" Class="audit-table">
                <thead>
                    <tr>
                        <th style="width:150px">Time (UTC)</th><th>Actor</th><th>Action</th><th>Target</th>
                        @if (ProjectId == null) { <th>Project</th> }
                        <th>IP</th><th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var e in result.Events)
                    {
                        var open = expanded.Contains(e.Id);
                        <tr @key="e.Id">
                            <td class="mono audit-small audit-nowrap" title="@Display.Ago(e.CreatedAt)">@e.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss")</td>
                            <td>@(e.ActorName ?? (e.ActorId is { } aid ? $"user #{aid}" : "system / anonymous"))</td>
                            <td><code>@e.Action</code></td>
                            <td class="audit-small">@(e.TargetType == null ? "" : $"{e.TargetType} {e.TargetId}")</td>
                            @if (ProjectId == null) { <td class="mono audit-small">@(e.ProjectId is { } p ? result.ProjectKeys.GetValueOrDefault(p, $"#{p} (deleted)") : "")</td> }
                            <td class="mono audit-small">@e.IpAddress</td>
                            <td class="audit-right">
                                <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Primary" aria-expanded="@(open ? "true" : "false")"
                                           OnClick="() => ToggleDetails(e.Id)">
                                    @(open ? "Hide" : "Details")
                                </MudButton>
                            </td>
                        </tr>
                        @if (open)
                        {
                            <tr @key="(e.Id, 'd')" class="audit-detail-row">
                                <td colspan="@(ProjectId == null ? 7 : 6)">
                                    <div class="audit-small"><b>User agent:</b> <span class="audit-muted">@(e.UserAgent ?? "unknown")</span></div>
                                    <pre class="audit-details mono">@Pretty(e.Details)</pre>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </MudSimpleTable>
        </MudPaper>
        <div class="audit-pager">
            <MudPagination Count="PageCount" Selected="pageNumber" SelectedChanged="Go" Size="Size.Small" Variant="Variant.Outlined"
                           ShowFirstButton="true" ShowLastButton="true" MiddleCount="3" BoundaryCount="1" />
            <MudText Class="mud-text-secondary" Typo="Typo.caption">Page @pageNumber of @PageCount</MudText>
        </div>
    }
}
</div>

@code {
    /// <summary>Show only this project's events (null: all events, for site admins).</summary>
    [Parameter] public int? ProjectId { get; set; }
    [Parameter] public string? ProjectKey { get; set; }

    private const int PageSize = 50;
    private string? actor, action, projectKey, error;
    private DateOnly? from, to;
    private int pageNumber = 1;
    private AuditPage? result;
    private List<string> actions = [];
    private readonly HashSet<long> expanded = [];

    private int Skip => (pageNumber - 1) * PageSize;
    private int PageCount => Math.Max(1, ((result?.Total ?? 0) + PageSize - 1) / PageSize);

    private DateRange Range => new(from?.ToDateTime(TimeOnly.MinValue), to?.ToDateTime(TimeOnly.MinValue));

    private void SetRange(DateRange? r)
    {
        from = r?.Start is { } s ? DateOnly.FromDateTime(s) : null;
        to = r?.End is { } e ? DateOnly.FromDateTime(e) : null;
    }

    private Task<IEnumerable<string>> SearchActions(string? text, CancellationToken _) =>
        Task.FromResult(string.IsNullOrWhiteSpace(text)
            ? Prefixes
            : Prefixes.Where(a => a.Contains(text.Trim(), StringComparison.OrdinalIgnoreCase)));

    /// <summary>Recorded action names plus their "area." prefixes, for the action filter's suggestions.</summary>
    private IEnumerable<string> Prefixes => actions.Select(a => a.Split('.')[0] + ".").Distinct().Concat(actions);

    private string ExportHref
    {
        get
        {
            var q = new List<string>();
            void Add(string k, string? v) { if (!string.IsNullOrWhiteSpace(v)) q.Add($"{k}={Uri.EscapeDataString(v.Trim())}"); }
            Add("project", ProjectId != null ? ProjectKey : projectKey);
            Add("actor", actor);
            Add("action", action);
            Add("from", from?.ToString("yyyy-MM-dd"));
            Add("to", to?.ToString("yyyy-MM-dd"));
            return "/admin/audit/export.csv" + (q.Count > 0 ? "?" + string.Join("&", q) : "");
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        try { actions = await Audit.ActionNamesAsync(ProjectId); }
        catch (InvalidOperationException ex) { error = ex.Message; return; }
        await Load();
    }

    private async Task Search()
    {
        pageNumber = 1;
        await Load();
    }

    private async Task Reset()
    {
        actor = action = projectKey = null;
        from = to = null;
        await Search();
    }

    private async Task Go(int n)
    {
        pageNumber = n;
        await Load();
    }

    private async Task Load()
    {
        error = null;
        expanded.Clear();
        int? pid = ProjectId;
        if (pid == null && !string.IsNullOrWhiteSpace(projectKey))
        {
            var p = await Issues.GetProjectAsync(projectKey.Trim());
            if (p == null) { error = $"No project with key '{projectKey.Trim().ToUpperInvariant()}'."; result = null; return; }
            pid = p.Id;
        }
        try
        {
            result = await Audit.SearchAsync(new AuditQuery
            {
                ProjectId = pid, Actor = actor, ActionPrefix = action, Page = pageNumber, PageSize = PageSize,
                FromUtc = from?.ToDateTime(TimeOnly.MinValue, DateTimeKind.Utc),
                ToUtc = to?.AddDays(1).ToDateTime(TimeOnly.MinValue, DateTimeKind.Utc),
            });
        }
        catch (InvalidOperationException ex) { error = ex.Message; result = null; }
    }

    private void ToggleDetails(long id)
    {
        if (!expanded.Remove(id)) expanded.Add(id);
    }

    private static string Pretty(string? json)
    {
        if (string.IsNullOrEmpty(json)) return "(no details)";
        try { return JsonSerializer.Serialize(JsonDocument.Parse(json).RootElement, new JsonSerializerOptions { WriteIndented = true, Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping }); }
        catch (JsonException) { return json; }
    }
}
