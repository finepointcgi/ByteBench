@* CI secret variables of a project (RepositoryId null) or of one repository. Values are write-only: never shown after saving. *@
@using ByteBench.Services.Ci
@inject CiVariableService Variables
@using ByteBench.Components.Repositories
@inject IDialogService Dialogs
@inject ISnackbar Snackbar

<div class="civ">
@if (error != null) { <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3">@error</MudAlert> }

@if (variables.Count == 0 && draft == null)
{
    <MudText Typo="Typo.body2" Class="mud-text-secondary mb-2">No variables yet.</MudText>
}
else if (variables.Count > 0)
{
    <MudSimpleTable Dense="true" Elevation="0" Class="civ-table mb-3">
        <thead><tr><th>Name</th><th class="civ-col-value">Value</th><th>Protected</th><th>Updated</th><th><span class="civ-sr">Actions</span></th></tr></thead>
        <tbody>
            @foreach (var v in variables)
            {
                <tr @key="v.Id">
                    <td class="mono civ-name">@v.Name</td>
                    <td class="mud-text-secondary civ-col-value">••••••</td>
                    <td>@(v.IsProtected ? "Yes" : "No")</td>
                    <td class="mud-text-secondary" title="@v.UpdatedAt.ToString("yyyy-MM-dd HH:mm") UTC (@Display.Ago(v.UpdatedAt))">updated @v.UpdatedAt.ToString("yyyy-MM-dd")@(v.UpdatedBy != null ? " by " + v.UpdatedBy : "")</td>
                    <td class="civ-actions">
                        <MudTooltip Text="Edit">
                            <MudIconButton Icon="@Icons.Material.Outlined.Edit" Size="Size.Small" aria-label="@($"Edit variable {v.Name}")" OnClick="() => StartEdit(v)" />
                        </MudTooltip>
                        <MudTooltip Text="Delete">
                            <MudIconButton Icon="@Icons.Material.Outlined.Delete" Color="Color.Error" Size="Size.Small" aria-label="@($"Delete variable {v.Name}")" OnClick="() => Delete(v)" />
                        </MudTooltip>
                    </td>
                </tr>
            }
        </tbody>
    </MudSimpleTable>
}

@if (draft != null)
{
    <div class="civ-form">
        <MudGrid Spacing="2">
            <MudItem xs="12" md="5">
                <MudTextField T="string" Label="Name" Placeholder="DEPLOY_TOKEN" @bind-Value="draft.Name" Immediate="true" InputId="@($"civ-name-{uid}")"
                              Variant="Variant.Outlined" Margin="Margin.Dense" ShrinkLabel="true" Class="gb-mono-input" autocomplete="off" />
            </MudItem>
            <MudItem xs="12" md="7">
                @* Password input keeps it off screen while typing; autocomplete=new-password keeps browsers from saving it. *@
                <MudTextField T="string" Label="Value" InputType="InputType.Password" @bind-Value="draft.Value" InputId="@($"civ-value-{uid}")"
                              Placeholder="@(draft.Id == null ? "Single line" : "Leave empty to keep the current value")"
                              Variant="Variant.Outlined" Margin="Margin.Dense" ShrinkLabel="true" Class="ci-var-value" autocomplete="new-password" />
            </MudItem>
        </MudGrid>
        <MudCheckBox T="bool" @bind-Value="draft.IsProtected" Color="Color.Primary" Dense="true" Class="mt-2">
            <span class="small"><b>Protected</b>: only pipelines on protected branches get it (see branch protection)</span>
        </MudCheckBox>
        <div class="d-flex gap-2 mt-2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" Disabled="@string.IsNullOrWhiteSpace(draft.Name)" OnClick="Save">@(draft.Id == null ? "Add variable" : "Save variable")</MudButton>
            <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="() => draft = null">Cancel</MudButton>
        </div>
    </div>
}
else
{
    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Add" OnClick="StartAdd">Add variable</MudButton>
}
</div>

@code {
    [Parameter, EditorRequired] public int ProjectId { get; set; }
    /// <summary>Null: the project's variables (every repository gets them).</summary>
    [Parameter] public int? RepositoryId { get; set; }

    private readonly string uid = Guid.NewGuid().ToString("N")[..6];
    private List<CiVariableInfo> variables = [];
    private Draft? draft;
    private string? error;

    private sealed class Draft
    {
        public int? Id { get; set; }
        public string Name { get; set; } = "";
        public string? Value { get; set; }
        public bool IsProtected { get; set; }
    }

    protected override async Task OnParametersSetAsync() => await Load();

    private async Task Load()
    {
        try { variables = await Variables.ListAsync(ProjectId, RepositoryId); }
        catch (InvalidOperationException ex) { error = ex.Message; }
    }

    private void StartAdd() { error = null; draft = new Draft(); }

    private void StartEdit(CiVariableInfo v) { error = null; draft = new Draft { Id = v.Id, Name = v.Name, IsProtected = v.IsProtected }; }

    private async Task Save()
    {
        if (draft == null) return;
        error = null;
        try
        {
            await Variables.SaveAsync(ProjectId, RepositoryId, draft.Id, draft.Name, draft.Value, draft.IsProtected);
            Snackbar.Add($"Saved {draft.Name.Trim()}.", Severity.Success);
            draft = null; // drops the typed value from memory
            await Load();
        }
        catch (InvalidOperationException ex) { error = ex.Message; }
    }

    private async Task Delete(CiVariableInfo v)
    {
        error = null;
        if (!await Dialogs.ConfirmAsync("Delete CI variable", $"Delete the CI variable {v.Name}? Pipelines will no longer get it.")) return;
        try
        {
            await Variables.DeleteAsync(ProjectId, RepositoryId, v.Id);
            Snackbar.Add($"Deleted {v.Name}.", Severity.Success);
            await Load();
        }
        catch (InvalidOperationException ex) { error = ex.Message; }
    }
}
