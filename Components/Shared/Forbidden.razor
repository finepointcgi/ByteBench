@* Friendly "you can see this project but can't do this" message. For projects the user can't see at all, use ProjectNotFound. *@
<div class="gb-empty-state">
    <MudIcon Class="mud-text-secondary" Icon="@Icons.Material.Outlined.Lock" Size="Size.Large" />
    <MudText Typo="Typo.h6" HtmlTag="h2">Not allowed</MudText>
    <MudText Class="mud-text-secondary" Typo="Typo.body2">@Message</MudText>
    <MudButton Href="@(BackHref ?? "/")" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.ArrowBack" Class="mt-2">
        @(BackHref == null ? "Back to dashboard" : "Go back")
    </MudButton>
</div>

@code {
    [Parameter] public string Message { get; set; } = "You don't have permission to do that in this project.";
    [Parameter] public string? BackHref { get; set; }
}
