@implements IDisposable
@inject SavedFilterService Filters
@inject LiveEvents Live

@* "Filters" dropdown on the issue list: apply, star and save filters (a saved filter is the list's query string). *@
<div class="filters-menu">
    <MudButton Variant="@(open ? Variant.Filled : Variant.Outlined)" Color="@(open ? Color.Primary : Color.Default)" OnClick="Toggle"
               StartIcon="@Icons.Material.Filled.FilterList" EndIcon="@Icons.Material.Filled.ArrowDropDown" aria-expanded="@(open ? "true" : "false")"
               Class="filters-btn">
        <span class="filters-btn-text">Filters@(Current is { } c ? $": {c.Name}" : "")</span>
    </MudButton>
    <MudPopover Open="open" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" Paper="true" Elevation="8" Class="filters-popover">
        <div class="filters-dropdown" role="menu" @onkeydown="PopoverKey">
            @if (filters.Count == 0)
            {
                <MudText Typo="Typo.body2" Class="mud-text-secondary px-4 py-2">No saved filters yet. Set up the list, then save it below.</MudText>
            }
            @foreach (var f in filters)
            {
                <div class="filters-item @(f.Id == Current?.Id ? "current" : "")" @key="f.Id">
                    <MudIconButton Icon="@(f.IsStarred ? Icons.Material.Filled.Star : Icons.Material.Outlined.StarBorder)" Size="Size.Small"
                                   Color="@(f.IsStarred ? Color.Warning : Color.Default)" title="@(f.IsStarred ? "Unstar" : "Star (show in sidebar)")"
                                   aria-label="@(f.IsStarred ? $"Unstar {f.Name}" : $"Star {f.Name}")" OnClick="() => Star(f)" />
                    <a href="@Href(f.Query)" @onclick="() => open = false">@f.Name</a>
                    @if (f.IsShared) { <span class="filters-shared" title="Shared with the project by @f.OwnerName">shared</span> }
                    @if (f.IsMine && f.Id == Current?.Id) { <span class="filters-current">current</span> }
                </div>
            }
            <div class="filters-save">
                @if (Changed is { } changed)
                {
                    <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Primary" Class="mb-2 filters-update" OnClick="() => UpdateQuery(changed)">
                        Update “@changed.Name” with the current filter
                    </MudButton>
                }
                <MudText Typo="Typo.subtitle2" Class="mb-1">Save current filter</MudText>
                <div class="d-flex gap-2 align-center">
                    <MudTextField T="string" @bind-Value="name" Immediate="true" MaxLength="100" Placeholder="Name, e.g. My open bugs"
                                  Variant="Variant.Outlined" Margin="Margin.Dense" OnKeyDown="Key" Class="flex-grow-1 mt-0" aria-label="Filter name" />
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@string.IsNullOrWhiteSpace(name)" OnClick="Save">Save</MudButton>
                </div>
                @if (Perms.Role >= ProjectRole.Developer)
                {
                    <MudCheckBox T="bool" @bind-Value="shared" Dense="true" Size="Size.Small" Label="Share with the project" Class="ml-n2 mt-1" />
                }
                @if (error != null) { <MudText Typo="Typo.caption" Color="Color.Error" Class="d-block mt-1">@error</MudText> }
            </div>
            <a class="filters-manage" href="/p/@Project.Key/filters" @onclick="() => open = false">Manage filters…</a>
        </div>
    </MudPopover>
    <MudOverlay Visible="open" OnClick="() => open = false" AutoClose="true" />
</div>

@code {
    [Parameter, EditorRequired] public Project Project { get; set; } = null!;
    [Parameter, EditorRequired] public ProjectPermissions Perms { get; set; } = ProjectPermissions.None;
    /// <summary>The issue list's current query string (from <see cref="IssueFilterQuery"/>).</summary>
    [Parameter, EditorRequired] public string Query { get; set; } = "";

    private List<SavedFilterView> filters = [];
    private bool open, shared;
    private string? name, error;
    private int loadedFor;
    private IDisposable? liveSubscription;

    /// <summary>The saved filter matching the current list, if any (own filters first).</summary>
    private SavedFilterView? Current => filters.OrderByDescending(f => f.IsMine).FirstOrDefault(f => IssueFilterQuery.Normalize(f.Query) == Query);

    /// <summary>The last-applied own filter whose conditions were since changed on the page.</summary>
    private SavedFilterView? Changed => Current == null && lastApplied is { } id ? filters.FirstOrDefault(f => f.Id == id && f.IsMine) : null;
    private int? lastApplied;

    private string Href(string query) => $"/p/{Project.Key}/issues" + (query.Length > 0 ? "?" + query : "");

    protected override async Task OnParametersSetAsync()
    {
        if (loadedFor != Project.Id) { loadedFor = Project.Id; lastApplied = null; await Load(); }
        if (Current is { } c) lastApplied = c.Id;
    }

    private async Task Load() => filters = await Filters.ListAsync(Project.Id);

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender) liveSubscription = Live.Subscribe<SavedFiltersChanged>(e => e.ProjectId != Project.Id ? Task.CompletedTask : InvokeAsync(async () =>
        {
            await Load();
            StateHasChanged();
        }));
    }

    private void Toggle() { open = !open; error = null; }

    private void PopoverKey(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") open = false;
    }

    private async Task Key(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(name)) await Save();
    }

    private async Task Save()
    {
        error = null;
        try
        {
            var f = await Filters.CreateAsync(Project.Id, name!, Query, shared);
            lastApplied = f.Id;
            name = null;
            shared = false;
            await Load();
        }
        catch (InvalidOperationException ex) { error = ex.Message; }
    }

    private async Task UpdateQuery(SavedFilterView f)
    {
        error = null;
        try { await Filters.UpdateQueryAsync(f.Id, Query); await Load(); }
        catch (InvalidOperationException ex) { error = ex.Message; }
    }

    private async Task Star(SavedFilterView f)
    {
        error = null;
        try { await Filters.SetStarAsync(f.Id, !f.IsStarred); await Load(); }
        catch (InvalidOperationException ex) { error = ex.Message; }
    }

    public void Dispose() => liveSubscription?.Dispose();
}
