@* Project setting: automatic AI code review of pull requests. Self-contained so the Settings page only renders it. *@
@using GitBench.Services.Ai
@inject AiClient Ai
@inject AiReviewService Reviews
@inject ISnackbar Snackbar

<MudPaper Outlined="true" Class="pa-5 mb-4" Style="max-width:720px">
    <MudText Typo="Typo.subtitle1" HtmlTag="h2" Class="mb-2" Style="font-weight:600">AI code review</MudText>
    <MudSwitch T="bool" Value="enabled" ValueChanged="Toggle" Color="Color.Primary"
               Label="Review pull requests automatically with GitBench AI" />
    <MudText Typo="Typo.caption" HtmlTag="p" Class="mud-text-secondary mt-1">
        When on, GitBench AI reviews each new pull request and each new push to an open pull request's source branch,
        and posts its findings as comments. Anyone can still ask for a review from the pull request page.
    </MudText>
    @if (!Ai.IsConfigured)
    {
        <MudAlert Severity="Severity.Info" Dense="true" Class="mt-2">AI review isn't set up (set ANTHROPIC_API_KEY), so nothing is reviewed yet.</MudAlert>
    }
</MudPaper>

@code {
    [Parameter, EditorRequired] public Project Project { get; set; } = null!;

    private bool enabled;

    protected override void OnParametersSet() => enabled = Project.AiReviewEnabled;

    private async Task Toggle(bool on)
    {
        enabled = on;
        await Reviews.SetAutoReviewAsync(Project.Id, enabled);
        Project.AiReviewEnabled = enabled;
        Snackbar.Add(enabled ? "AI code review turned on." : "AI code review turned off.", Severity.Success);
    }
}
