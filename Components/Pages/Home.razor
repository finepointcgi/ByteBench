@page "/"
@inject IssueService Issues
@inject CurrentUser Me
@inject LiveEvents Live
@inject ByteBench.Services.Explore.UserActivityService Feed
@inject ByteBench.Services.Dashboards.DashboardService Dashboards
@inject NavigationManager Nav
@inject Microsoft.EntityFrameworkCore.IDbContextFactory<ByteBench.Data.AppDbContext> DbFactory
@implements IDisposable

<PageTitle>Dashboard · ByteBench</PageTitle>

@if (homeId is { } hid)
{
    @* A pinned dashboard replaces the default layout below (Dashboards → Use as Home). *@
    <ByteBench.Components.Dashboards.DashboardBoard DashboardId="hid" @key="hid" OnMissing="ShowDefault" OnHomeChanged="ShowDefault" />
}
else
{
<div class="dash">
@if (noAdminYet)
{
    <MudAlert Severity="Severity.Info" Dense="true" Class="mb-4" role="status">
        This ByteBench has no site administrator yet. To make yourself one, restart the server once with
        <code>Bootstrap__AdminUsers=@Me.User?.UserName</code> (see Installation in the documentation). Until then nobody can manage users, backups or settings.
    </MudAlert>
}
<div class="d-flex align-center justify-space-between flex-wrap gap-4 mb-5">
    <MudText Typo="Typo.h5" Class="dash-title">Welcome back, @Me.User?.DisplayName.Split(' ')[0]</MudText>
    <div class="d-flex align-center flex-wrap gap-2">
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.DashboardCustomize" OnClick="Customize">Customize</MudButton>
        <MudButton Href="/projects/new" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add">New project</MudButton>
    </div>
</div>

<MudGrid Spacing="4">
    <MudItem xs="12" md="8">
        <div class="d-flex align-center gap-2 mb-2">
            <MudIcon Icon="@Icons.Material.Outlined.Folder" Size="Size.Small" Color="Color.Primary" />
            <MudText Typo="Typo.subtitle1" Class="dash-section">Projects</MudText>
        </div>
        @if (projects.Count == 0)
        {
            <MudPaper Outlined="true" Class="dash-empty">No projects yet. <a href="/projects/new">Create one</a>.</MudPaper>
        }
        <MudGrid Spacing="3">
            @foreach (var p in projects)
            {
                var total = p.OpenCount + p.ClosedCount;
                <MudItem xs="12" sm="6" lg="4">
                    <a class="dash-project-link" href="/p/@p.Key/issues">
                        <MudCard Outlined="true" Class="dash-project">
                            <MudCardContent>
                                <div class="d-flex align-center gap-3 mb-2">
                                    <span class="proj-avatar">@p.Key[..1]</span>
                                    <div class="dash-min0">
                                        <MudText Typo="Typo.subtitle2" Class="dash-ellipsis">@p.Name</MudText>
                                        <MudText Typo="Typo.caption" Class="mud-text-secondary mono">@p.Key</MudText>
                                    </div>
                                </div>
                                <MudText Typo="Typo.body2" Class="mud-text-secondary dash-desc">@p.Description</MudText>
                                <MudProgressLinear Value="@(total == 0 ? 0 : p.ClosedCount * 100.0 / total)" Color="Color.Success" Rounded="true" Size="Size.Small" Class="my-2"
                                                   aria-label="@($"{p.Name}: {p.ClosedCount} of {total} issues closed")" />
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">@p.OpenCount open · @p.ClosedCount closed</MudText>
                            </MudCardContent>
                        </MudCard>
                    </a>
                </MudItem>
            }
        </MudGrid>

        <MudCard Outlined="true" Class="mt-6">
            <MudCardHeader Class="dash-card-head">
                <CardHeaderContent>
                    <div class="d-flex align-center gap-2">
                        <MudIcon Icon="@Icons.Material.Outlined.AssignmentInd" Size="Size.Small" Color="Color.Primary" />
                        <MudText Typo="Typo.subtitle1" Class="dash-section">Assigned to me</MudText>
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text">@mine.Count</MudChip>
                    </div>
                </CardHeaderContent>
            </MudCardHeader>
            <MudDivider />
            <div class="dash-issues">
                @if (mine.Count == 0)
                {
                    <MudText Typo="Typo.body2" Class="mud-text-secondary pa-6" Align="Align.Center">Nothing assigned to you. 🎉</MudText>
                }
                @foreach (var i in mine)
                {
                    <IssueRow Issue="i" />
                }
            </div>
        </MudCard>
    </MudItem>

    <MudItem xs="12" md="4">
        <MudCard Outlined="true">
            <MudCardHeader Class="dash-card-head">
                <CardHeaderContent>
                    <div class="d-flex align-center gap-2">
                        <MudIcon Icon="@Icons.Material.Outlined.History" Size="Size.Small" Color="Color.Primary" />
                        <MudText Typo="Typo.subtitle1" Class="dash-section">Activity from your projects</MudText>
                    </div>
                </CardHeaderContent>
            </MudCardHeader>
            <MudDivider />
            <ActivityFeed Items="activity" Empty="No activity in your projects yet." />
        </MudCard>
    </MudItem>
</MudGrid>
</div>
}

@code {
    private List<ProjectSummary> projects = [];
    private List<Issue> mine = [];
    private List<ByteBench.Services.Explore.FeedItem> activity = [];

    private int? homeId;

    protected override async Task OnInitializedAsync()
    {
        homeId = (await Dashboards.GetHomeAsync())?.Dashboard.Id;
        if (homeId == null) await Load();
        await CheckForAdminAsync();
    }

    // A fresh install has nobody with admin rights, and nothing in the UI says how to fix that.
    private bool noAdminYet;
    private async Task CheckForAdminAsync()
    {
        if (Me.User is not { IsAdmin: false }) return;
        await using var db = await DbFactory.CreateDbContextAsync();
        noAdminYet = !await Microsoft.EntityFrameworkCore.EntityFrameworkQueryableExtensions.AnyAsync(db.Users, u => u.IsAdmin);
    }

    private async Task ShowDefault()
    {
        homeId = null;
        await Load();
    }

    /// <summary>Copies this default layout into a new personal dashboard, pins it as Home and opens it for editing.</summary>
    private async Task Customize()
    {
        var d = await Dashboards.CreateAsync("My dashboard", withDefaultGadgets: true);
        await Dashboards.SetHomeAsync(d.Id);
        Nav.NavigateTo($"/dashboards/{d.Id}");
    }

    private async Task Load()
    {
        projects = await Issues.GetProjectsAsync();
        mine = await Issues.GetAssignedToAsync(Me.Id);
        activity = await Feed.GetFeedAsync(take: 15); // issues, comments, pull requests and pushes
    }

    // ----- Live updates: new activity anywhere refreshes the feed (and counts / assigned work) -----
    private IDisposable? liveSubscription;

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender) liveSubscription = Live.Subscribe<ActivityChanged>(_ => homeId != null ? Task.CompletedTask : InvokeAsync(async () =>
        {
            await Load();
            StateHasChanged();
        }));
    }

    public void Dispose() => liveSubscription?.Dispose();
}
