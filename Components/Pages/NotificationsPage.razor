@page "/notifications"
@implements IDisposable
@inject NotificationService Notifications
@inject LiveEvents Live
@inject CurrentUser Me
@inject NavigationManager Nav

<PageTitle>Notifications · ByteBench</PageTitle>

<div class="notif-page">
    <div class="d-flex align-center justify-space-between flex-wrap gap-4 mb-3">
        <MudText Typo="Typo.h5" Class="notif-heading">Notifications</MudText>
        <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Outlined.DoneAll" Disabled="@(unreadCount == 0)" OnClick="MarkAllRead">Mark all read</MudButton>
    </div>

    <MudTabs ActivePanelIndex="@(UnreadOnly ? 1 : 0)" ActivePanelIndexChanged="TabChanged" Elevation="0" Class="mb-3" TabHeaderClass="notif-tabs">
        <MudTabPanel Text="All" />
        <MudTabPanel Text="Unread" BadgeData="@(unreadCount > 0 ? unreadCount : null)" BadgeColor="Color.Primary" />
    </MudTabs>

    @if (result != null)
    {
        <MudPaper Outlined="true" Class="notif-list">
            @if (result.Items.Count == 0)
            {
                <MudText Typo="Typo.body2" Class="mud-text-secondary pa-8" Align="Align.Center">@(UnreadOnly ? "No unread notifications." : "No notifications yet.")</MudText>
            }
            @foreach (var n in result.Items)
            {
                <div class="notif-row @(n.IsRead ? "" : "unread")" @key="n.Id">
                    @if (!n.IsRead) { <span class="notif-dot" title="Unread"></span> }
                    <Avatar User="n.Actor" Size="28" />
                    <a class="notif-text" href="@n.Url" @onclick="() => Open(n)" @onclick:preventDefault>
                        <b>@(n.Actor?.DisplayName ?? "ByteBench")</b> @NotificationService.Verb(n.Kind)
                        <span class="notif-title">@n.Title</span>
                    </a>
                    <span class="notif-when">@Display.Ago(n.CreatedAt)</span>
                    @if (!n.IsRead)
                    {
                        <MudTooltip Text="Mark read">
                            <MudIconButton Icon="@Icons.Material.Outlined.MarkEmailRead" Size="Size.Small" OnClick="() => MarkRead(n)" aria-label="Mark read" />
                        </MudTooltip>
                    }
                </div>
            }
        </MudPaper>

        @if (result.Pages > 1)
        {
            <nav class="d-flex align-center justify-center flex-wrap gap-3 mt-3" aria-label="Pages">
                @if (result.Page > 1) { <MudButton Variant="Variant.Outlined" Size="Size.Small" Href="@PageUrl(result.Page - 1)" StartIcon="@Icons.Material.Filled.ChevronLeft">Newer</MudButton> }
                <MudText Typo="Typo.caption" Class="mud-text-secondary">Page @result.Page of @result.Pages · @result.Total total</MudText>
                @if (result.Page < result.Pages) { <MudButton Variant="Variant.Outlined" Size="Size.Small" Href="@PageUrl(result.Page + 1)" EndIcon="@Icons.Material.Filled.ChevronRight">Older</MudButton> }
            </nav>
        }
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "filter")] public string? Filter { get; set; }
    [SupplyParameterFromQuery(Name = "page")] public int? PageNumber { get; set; }

    private NotificationPage? result;
    private int unreadCount;
    private IDisposable? subscription;

    private bool UnreadOnly => Filter == "unread";

    private string PageUrl(int p) => "/notifications?" + (UnreadOnly ? "filter=unread&" : "") + "page=" + p;

    protected override Task OnParametersSetAsync() => Load();

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
            subscription = Live.Subscribe<NotificationsChanged>(e => e.UserId == Me.Id
                ? InvokeAsync(async () => { await Load(); StateHasChanged(); })
                : Task.CompletedTask);
    }

    private async Task Load()
    {
        result = await Notifications.GetPageAsync(Me.Id, UnreadOnly, PageNumber ?? 1);
        unreadCount = await Notifications.GetUnreadCountAsync(Me.Id);
    }

    private void TabChanged(int index)
    {
        if ((index == 1) != UnreadOnly) Nav.NavigateTo(index == 1 ? "/notifications?filter=unread" : "/notifications");
    }

    private async Task Open(Notification n)
    {
        if (!n.IsRead) await Notifications.MarkReadAsync(Me.Id, n.Id);
        Nav.NavigateTo(n.Url);
    }

    private async Task MarkRead(Notification n)
    {
        await Notifications.MarkReadAsync(Me.Id, n.Id);
        await Load();
    }

    private async Task MarkAllRead()
    {
        await Notifications.MarkAllReadAsync(Me.Id);
        await Load();
    }

    public void Dispose() => subscription?.Dispose();
}
