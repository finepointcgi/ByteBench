@page "/account/notifications"
@attribute [Authorize]
@using GitBench.Services.Email
@using Microsoft.Extensions.Options
@inject NotificationPreferences Preferences
@inject CurrentUser Me
@inject IOptions<EmailOptions> EmailOptions

<PageTitle>Notification preferences · GitBench</PageTitle>

<div class="page-header">
    <h1>Notification preferences</h1>
    <div class="d-flex gap-3 align-items-center">
        @if (savedAt != null) { <span class="small muted" role="status">✓ Saved</span> }
        <a class="btn btn-link btn-sm" href="/notifications">Notifications</a>
        <a class="btn btn-link btn-sm" href="/account/profile">Profile</a>
    </div>
</div>

@if (prefs == null)
{
    <div class="muted">Loading…</div>
}
else
{
    <div class="card-panel narrow notif-prefs">
        <h2 class="h6 mb-2">Email</h2>
        <div class="form-check form-switch mb-1">
            <input class="form-check-input" type="checkbox" role="switch" id="np-email" checked="@emailEnabled" @onchange="OnEmailToggled" />
            <label class="form-check-label" for="np-email">Send me notification emails</label>
        </div>
        <div class="small muted mb-3">
            @if (string.IsNullOrWhiteSpace(Me.User?.Email)) { <span>Your account has no email address. Add one on your <a href="/account/profile">profile</a>.</span> }
            else { <span>Emails go to <b>@Me.User!.Email</b>.</span> }
            @if (!EmailOptions.Value.Enabled) { <span> Email delivery is turned off on this server, so nothing is sent for now.</span> }
            else if (EmailOptions.Value.DigestMinutes > 0) { <span> Emails are batched: at most one every @EmailOptions.Value.DigestMinutes minutes.</span> }
        </div>

        <div class="form-check mb-4">
            <input class="form-check-input" type="checkbox" id="np-self" checked disabled />
            <label class="form-check-label" for="np-self">Don't notify me about my own actions</label>
            <div class="small muted">Always on: you never get notifications or emails about things you did yourself.</div>
        </div>

        <h2 class="h6 mb-2">What you hear about</h2>
        <table class="table table-sm align-middle notif-prefs-table">
            <thead>
                <tr>
                    <th scope="col">Event</th>
                    <th scope="col" class="text-center">In-app + email</th>
                    <th scope="col" class="text-center">In-app only</th>
                    <th scope="col" class="text-center">Off</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var g in NotificationPreferences.Groups)
                {
                    var group = g.Group;
                    <tr @key="group">
                        <th scope="row" class="fw-normal">
                            <div class="fw-semibold">@g.Title</div>
                            <div class="small muted">@g.Description</div>
                        </th>
                        @foreach (var c in Choices)
                        {
                            var channel = c;
                            <td class="text-center">
                                <input type="radio" class="form-check-input" name="np-@group" id="np-@group-@channel"
                                       aria-label="@($"{g.Title}: {Label(channel)}")"
                                       checked="@(channels[group] == channel)" disabled="@(channel == NotificationChannel.InAppAndEmail && !emailEnabled)"
                                       @onchange="() => SetChannel(group, channel)" />
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
        <p class="small muted mb-0">
            Defaults: in-app for everything, plus email for assignments, mentions and review requests.
            To silence one issue or pull request, use <b>🔕 Mute</b> next to its Watch button.
        </p>
    </div>
}

@code {
    private static readonly NotificationChannel[] Choices = [NotificationChannel.InAppAndEmail, NotificationChannel.InApp, NotificationChannel.Off];

    private UserNotificationPreferences? prefs;
    private Dictionary<NotificationGroup, NotificationChannel> channels = [];
    private bool emailEnabled;
    private DateTime? savedAt;

    protected override async Task OnInitializedAsync()
    {
        await Me.EnsureLoadedAsync();
        if (!Me.IsSignedIn) return;
        prefs = await Preferences.GetAsync(Me.Id);
        channels = new(prefs.Channels);
        emailEnabled = prefs.EmailEnabled;
    }

    private static string Label(NotificationChannel c) => c switch
    {
        NotificationChannel.InAppAndEmail => "In-app + email",
        NotificationChannel.InApp => "In-app only",
        _ => "Off",
    };

    private Task OnEmailToggled(ChangeEventArgs e)
    {
        emailEnabled = e.Value is true || e.Value?.ToString() == "true";
        return SaveAsync();
    }

    private Task SetChannel(NotificationGroup group, NotificationChannel channel)
    {
        channels[group] = channel;
        return SaveAsync();
    }

    private async Task SaveAsync()
    {
        await Preferences.SaveAsync(Me.Id, emailEnabled, channels);
        savedAt = DateTime.UtcNow;
    }
}
