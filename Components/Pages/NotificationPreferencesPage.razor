@page "/account/notifications"
@attribute [Authorize]
@using GitBench.Services.Email
@using Microsoft.Extensions.Options
@inject NotificationPreferences Preferences
@inject CurrentUser Me
@inject IOptions<EmailOptions> EmailOptions
@inject ISnackbar Snackbar

<PageTitle>Notification preferences · GitBench</PageTitle>

<div class="notif-prefs-page">
<div class="page-header">
    <MudText Typo="Typo.h5" HtmlTag="h1">Notification preferences</MudText>
    <div class="np-links">
        <MudButton Href="/notifications" Variant="Variant.Text" Size="Size.Small" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Notifications">Notifications</MudButton>
        <MudButton Href="/account/profile" Variant="Variant.Text" Size="Size.Small" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Person">Profile</MudButton>
    </div>
</div>

@if (prefs == null)
{
    <MudText Class="mud-text-secondary">Loading…</MudText>
}
else
{
    <MudPaper Outlined="true" Class="pa-4 np-panel">
        <MudText Typo="Typo.subtitle1" HtmlTag="h2" Class="np-title">Email</MudText>
        <MudSwitch T="bool" Value="emailEnabled" ValueChanged="OnEmailToggled" Color="Color.Primary" Label="Send me notification emails" />
        <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3 np-help">
            @if (string.IsNullOrWhiteSpace(Me.User?.Email)) { <span>Your account has no email address. Add one on your <MudLink Href="/account/profile" Typo="Typo.body2">profile</MudLink>.</span> }
            else { <span>Emails go to <b>@Me.User!.Email</b>.</span> }
            @if (!EmailOptions.Value.Enabled) { <span> Email delivery is turned off on this server, so nothing is sent for now.</span> }
            else if (EmailOptions.Value.DigestMinutes > 0) { <span> Emails are batched: at most one every @EmailOptions.Value.DigestMinutes minutes.</span> }
        </MudText>

        <MudCheckBox T="bool" Value="true" Disabled="true" Color="Color.Primary" Label="Don't notify me about my own actions" />
        <MudText Typo="Typo.body2" Class="mud-text-secondary mb-4 np-help">Always on: you never get notifications or emails about things you did yourself.</MudText>

        <MudText Typo="Typo.subtitle1" HtmlTag="h2" Class="np-title">What you hear about</MudText>
        <div class="np-groups">
            @foreach (var g in NotificationPreferences.Groups)
            {
                var group = g.Group;
                <div class="np-group" @key="group">
                    <div class="np-group-text">
                        <div class="np-group-title">@g.Title</div>
                        <div class="np-group-desc">@g.Description</div>
                    </div>
                    <MudRadioGroup T="NotificationChannel" Value="channels[group]" ValueChanged="channel => SetChannel(group, channel)"
                                   Name="@($"np-{group}")" Class="np-choices" role="radiogroup" aria-label="@g.Title">
                        @foreach (var c in Choices)
                        {
                            var channel = c;
                            <MudRadio T="NotificationChannel" Value="channel" Color="Color.Primary" Dense="true"
                                      Disabled="@(channel == NotificationChannel.InAppAndEmail && !emailEnabled)"
                                      AriaLabel="@($"{g.Title}: {Label(channel)}")">@Label(channel)</MudRadio>
                        }
                    </MudRadioGroup>
                </div>
            }
        </div>
        <MudText Typo="Typo.body2" Class="mud-text-secondary mt-3 np-help">
            Defaults: in-app for everything, plus email for assignments, mentions and review requests.
            To silence one issue or pull request, use <b>Mute</b> next to its Watch button.
        </MudText>
    </MudPaper>
}
</div>

@code {
    private static readonly NotificationChannel[] Choices = [NotificationChannel.InAppAndEmail, NotificationChannel.InApp, NotificationChannel.Off];

    private UserNotificationPreferences? prefs;
    private Dictionary<NotificationGroup, NotificationChannel> channels = [];
    private bool emailEnabled;

    protected override async Task OnInitializedAsync()
    {
        await Me.EnsureLoadedAsync();
        if (!Me.IsSignedIn) return;
        prefs = await Preferences.GetAsync(Me.Id);
        channels = new(prefs.Channels);
        emailEnabled = prefs.EmailEnabled;
    }

    private static string Label(NotificationChannel c) => c switch
    {
        NotificationChannel.InAppAndEmail => "In-app + email",
        NotificationChannel.InApp => "In-app only",
        _ => "Off",
    };

    private Task OnEmailToggled(bool value)
    {
        emailEnabled = value;
        return SaveAsync();
    }

    private Task SetChannel(NotificationGroup group, NotificationChannel channel)
    {
        channels[group] = channel;
        return SaveAsync();
    }

    private async Task SaveAsync()
    {
        await Preferences.SaveAsync(Me.Id, emailEnabled, channels);
        Snackbar.Add("Preferences saved.", Severity.Success);
    }
}
