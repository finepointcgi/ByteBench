@page "/workspaces/{PublicId}"
@using ByteBench.Services.Editor.Ai
@using ByteBench.Services.Workspaces
@implements IDisposable
@inject CurrentUser Me
@inject WorkspaceService Workspaces
@inject WorkspaceAiService WorkspaceAi
@inject NavigationManager Nav
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@using Microsoft.Extensions.Options

<PageTitle>@(view?.RepositoryPath ?? "Workspace") · ByteBench</PageTitle>

@if (view == null)
{
    <ProjectNotFound Message="This workspace doesn't exist." />
}
else
{
    var ws = view.Workspace;
    var full = fullscreen && ws.State == WorkspaceState.Running;
    @* Full screen is a fixed layer over the whole viewport (above ByteBench's app bar and menu), so it needs no browser fullscreen API and works in embedded views. *@
    @if (full)
    {
        @* ByteBench's app bar and menu are hidden (not just covered) and the page can't scroll while the IDE has the screen. *@
        <style>.mud-appbar, .mud-drawer, .mud-drawer-overlay { display: none !important; } html, body { overflow: hidden !important; }</style>
    }
    <div class="ws-page @(full ? "ws-full" : "")" data-testid="ws-page" data-fullscreen="@(full ? "true" : "false")">
    <div class="ws-bar">
        <div class="ws-title">
            @if (full)
            {
                <MudButton Href="@($"/p/{view.ProjectKey}/repos/{view.RepoSlug}")" Size="Size.Small" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack" data-testid="ws-back">Back</MudButton>
            }
            <MudText Typo="Typo.subtitle1" HtmlTag="h1"><b>@view.RepositoryPath</b> <span class="mono">@ws.Ref</span></MudText>
            <MudChip T="string" Size="Size.Small" Color="@StateColor()" data-testid="ws-state">@ws.State</MudChip>
            @if (!ws.CanPush) { <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">read-only</MudChip> }
        </div>
        <div class="ws-actions">
            @if (ws.State == WorkspaceState.Running)
            {
                <WorkspaceGitBar PublicId="@PublicId" Ref="@ws.Ref" />
                <MudTooltip Text="Open in your own editor (VS Code, JetBrains Gateway)">
                    <MudIconButton Icon="@Icons.Material.Outlined.Laptop" Size="Size.Small" OnClick="OpenEditorPanel" aria-label="Open in local editor" data-testid="ws-editor" />
                </MudTooltip>
                <MudMenu Label="Preview" Dense="true" StartIcon="@Icons.Material.Outlined.Preview" Size="Size.Small" Variant="Variant.Outlined" data-testid="ws-preview-menu">
                    @if (ports == null) { <MudMenuItem Disabled="true">Looking for ports…</MudMenuItem> }
                    else if (AllPorts().Count == 0) { <MudMenuItem Disabled="true">Nothing is listening yet. Start your app in the terminal, or run a task.</MudMenuItem> }
                    else foreach (var p in AllPorts())
                    {
                        var port = p;
                        <MudMenuItem OnClick="() => OpenPreview(port)">Port @port@(ports!.Contains(port) ? "" : " (not listening yet)")</MudMenuItem>
                    }
                </MudMenu>
                <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.PlayArrow" OnClick="() => showTasks = !showTasks" data-testid="ws-tasks-toggle">Tasks@(RunningCount() > 0 ? $" ({RunningCount()} running)" : "")</MudButton>
                <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.AutoAwesome" OnClick="() => showAi = !showAi" data-testid="ws-ai-toggle">AI</MudButton>
                <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.Group" OnClick="() => showTools = !showTools" data-testid="ws-tools-toggle">Share &amp; history</MudButton>
                <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.OpenInNew" OnClick="OpenIdeTab">New tab</MudButton>
                <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.RestartAlt" OnClick="Restart" data-testid="ws-restart">Restart</MudButton>
            }
            @if (ws.IsLive)
            {
                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Outlined.Stop" OnClick="Stop" data-testid="ws-stop">Stop</MudButton>
            }
            @if (ws.State == WorkspaceState.Running)
            {
                <MudTooltip Text="@(fullscreen ? "Leave full screen (show ByteBench's menu)" : "Full screen")">
                    <MudIconButton Icon="@(fullscreen ? Icons.Material.Outlined.FullscreenExit : Icons.Material.Outlined.Fullscreen)" Size="Size.Small" OnClick="() => fullscreen = !fullscreen"
                                   aria-label="@(fullscreen ? "Leave full screen" : "Enter full screen")" data-testid="ws-fullscreen-toggle" />
                </MudTooltip>
            }
        </div>
    </div>

    @if (ws.State == WorkspaceState.Starting)
    {
        <MudPaper Outlined="true" Class="pa-5 mt-3" Style="max-width:760px">
            <MudProgressLinear Indeterminate="true" Class="mb-3" />
            Starting the container, locking down its network and checking out <span class="mono">@ws.Ref</span>… This takes a moment@(ws.EnvironmentSummary is { Length: > 0 } es && es != "default image" ? $" (environment: {es}; the first start of a toolchain builds its image)" : "").
            @if (env is { ProvisionLog.Length: > 0 }) { <pre class="mono ws-log" data-testid="ws-provision-log">@env.ProvisionLog</pre> }
        </MudPaper>
    }
    else if (ws.State == WorkspaceState.Running)
    {
        <div class="ws-notices">
        <WorkspaceIdleBanner PublicId="@PublicId" />
        @if (env != null)
        {
            foreach (var e in env.Errors)
            {
                <MudAlert Severity="Severity.Error" Dense="true" Class="mb-1" data-testid="ws-env-error">@e</MudAlert>
            }
            @if (env.Errors.Count > 0) { <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-1">The environment file wasn't used; this workspace has the default setup. Edit the file, then <MudLink OnClick="ReloadEnv">reload the environment</MudLink>.</MudAlert> }
            foreach (var w in env.Warnings.Where(w => !w.StartsWith("Environment file:", StringComparison.Ordinal) && !w.Contains("was not used because", StringComparison.Ordinal)))
            {
                <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-1" data-testid="ws-warning">@w</MudAlert>
            }
            @if (env.SetupState == "Failed")
            {
                <MudAlert Severity="Severity.Error" Dense="true" Class="mb-1" data-testid="ws-setup-failed">
                    @env.SetupMessage <MudLink OnClick="() => showTasks = true">Show the setup log</MudLink> · <MudLink OnClick="RerunSetup">Run setup again</MudLink>
                </MudAlert>
            }
            else if (env.SetupState is "Running" or "Pending")
            {
                <MudAlert Severity="Severity.Info" Dense="true" Class="mb-1" data-testid="ws-setup-running"><MudProgressLinear Indeterminate="true" Size="Size.Small" Class="mb-1" />Setup is running (installing dependencies…). <MudLink OnClick="() => showTasks = true">Show the log</MudLink></MudAlert>
            }
        }
        </div>
        <div class="ws-body">
            @if (ideUrl != null)
            {
                <iframe class="ws-ide" src="@ideUrl" title="Workspace IDE" allow="clipboard-read; clipboard-write" data-testid="ws-ide"></iframe>
            }
            @if (previewUrl != null)
            {
                <div class="ws-side">
                    <div class="ws-side-head"><b>Preview :@previewPort</b><span class="flex-grow-1"></span>
                        <MudIconButton Icon="@Icons.Material.Outlined.OpenInNew" Size="Size.Small" OnClick="OpenPreviewTab" aria-label="Open the preview in a new tab" />
                        <MudIconButton Icon="@Icons.Material.Outlined.Close" Size="Size.Small" OnClick="() => previewUrl = null" aria-label="Close the preview" /></div>
                    <iframe class="ws-frame" src="@previewUrl" title="Preview" data-testid="ws-preview"></iframe>
                </div>
            }
            @if (showTools)
            {
                <div class="ws-side" data-testid="ws-tools-panel">
                    <div class="ws-side-head"><b>Share, history, network</b><span class="flex-grow-1"></span>
                        <MudIconButton Icon="@Icons.Material.Outlined.Close" Size="Size.Small" OnClick="() => showTools = false" aria-label="Close" /></div>
                    <WorkspaceToolsPanel PublicId="@PublicId" Running="true" />
                </div>
            }
            @if (showTasks && env != null)
            {
                <div class="ws-side ws-tasks" data-testid="ws-tasks-panel">
                    <div class="ws-side-head"><b>Tasks &amp; setup</b><span class="flex-grow-1"></span>
                        <MudIconButton Icon="@Icons.Material.Outlined.Refresh" Size="Size.Small" OnClick="ReloadEnv" aria-label="Reload the environment file" title="Reload .bytebench/workspace.yml" />
                        <MudIconButton Icon="@Icons.Material.Outlined.Close" Size="Size.Small" OnClick="() => showTasks = false" aria-label="Close tasks" /></div>
                    <div class="ws-tasks-body">
                        <div class="mud-text-secondary" style="font-size:12px" data-testid="ws-env-summary">Environment: @env.Summary@(env.Services.Count > 0 ? " · services: " + string.Join(", ", env.Services) : "")</div>
                        @if (env.SetupState is not "None")
                        {
                            <div class="ws-task" data-testid="ws-setup">
                                <div class="ws-task-head"><b>Setup</b>
                                    <MudChip T="string" Size="Size.Small" Color="@SetupColor(env.SetupState)" data-testid="ws-setup-state">@SetupLabel(env.SetupState)</MudChip>
                                    <span class="flex-grow-1"></span>
                                    @if (env.SetupState is not ("Running" or "Pending")) { <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="RerunSetup">Run again</MudButton> }
                                </div>
                                @if (env.SetupMessage != null) { <div class="mud-text-secondary" style="font-size:12px">@env.SetupMessage</div> }
                                @if (env.SetupLog.Length > 0) { <pre class="mono ws-log" data-testid="ws-setup-log">@env.SetupLog</pre> }
                            </div>
                        }
                        @if (env.Tasks.Count == 0)
                        {
                            <div class="mud-text-secondary" style="font-size:13px">No tasks. Define them under <code>tasks:</code> in <code>.bytebench/workspace.yml</code>.</div>
                        }
                        @foreach (var t in env.Tasks)
                        {
                            var task = t;
                            <div class="ws-task" data-testid="@($"ws-task-{task.Name}")">
                                <div class="ws-task-head"><b>@task.Name</b>
                                    <MudChip T="string" Size="Size.Small" Color="@TaskColor(task.State)" data-testid="ws-task-state">@task.State</MudChip>
                                    @if (task.ExitCode is { } exitCode && task.State != "Running") { <span class="mud-text-secondary" style="font-size:12px">exit @exitCode</span> }
                                    <span class="flex-grow-1"></span>
                                    @if (task.Port is { } p) { <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="() => OpenPreview(p)" data-testid="ws-task-open">:@p</MudButton> }
                                    @if (task.State == "Running") { <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error" OnClick="() => StopTask(task.Name)" data-testid="ws-task-stop">Stop</MudButton> }
                                    else { <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PlayArrow" OnClick="() => RunTask(task.Name)" data-testid="ws-task-run">Run</MudButton> }
                                </div>
                                <div class="mono mud-text-secondary" style="font-size:12px">@task.Command</div>
                                @if (taskLogs.TryGetValue(task.Name, out var tl) && tl.Length > 0) { <pre class="mono ws-log" data-testid="ws-task-log">@tl</pre> }
                            </div>
                        }
                    </div>
                </div>
            }
            @if (showAi)
            {
                <div class="ws-side" data-testid="ws-ai-panel">
                    <div class="ws-side-head"><b>AI assistant</b><span class="flex-grow-1"></span>
                        <MudIconButton Icon="@Icons.Material.Outlined.Close" Size="Size.Small" OnClick="() => showAi = false" aria-label="Close the assistant" /></div>
                    @if (aiStatus is { Enabled: false })
                    {
                        <MudAlert Severity="Severity.Info" Dense="true" Class="ma-2">@aiStatus.DisabledReason</MudAlert>
                    }
                    else
                    {
                        <div class="ws-chat">
                            @foreach (var m in chat)
                            {
                                <div class="ws-msg @(m.FromUser ? "me" : "ai")">@m.Text</div>
                            }
                            @foreach (var t in toolLines) { <div class="ws-tool mono">@t</div> }
                            @if (aiBusy) { <MudProgressLinear Indeterminate="true" Size="Size.Small" /> }
                            @if (aiNote != null) { <MudAlert Severity="Severity.Warning" Dense="true">@aiNote</MudAlert> }
                        </div>
                        <WorkspaceReviewPanel PublicId="@PublicId" />
                        <div class="ws-input">
                            <MudTextField T="string" @bind-Value="draft" Immediate="true" Lines="3" Variant="Variant.Outlined" Margin="Margin.Dense" Placeholder="Ask about the code, or ask for a change…"
                                          Disabled="aiBusy" data-testid="ws-ai-input" />
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" Disabled="@(aiBusy || string.IsNullOrWhiteSpace(draft))" OnClick="SendAi" data-testid="ws-ai-send">Send</MudButton>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">The assistant edits files and runs commands in your workspace but never commits or pushes: review with git diff, then commit.</MudText>
                        </div>
                    }
                </div>
            }
        </div>
    }
    else
    {
        <MudAlert Severity="@(ws.State == WorkspaceState.Failed ? Severity.Error : Severity.Info)" Class="mt-3" Style="max-width:760px">
            This workspace is @ws.State.ToString().ToLowerInvariant()@(ws.StopReason != null ? $" ({ws.StopReason})" : "")@(ws.Error != null ? ": " + ws.Error : ".")
            @if (ws.VolumesKept)
            {
                <span> Its files and installed dependencies are kept; resume it to carry on where you stopped (they are deleted after @RetentionDays() days).</span>
                <MudButton OnClick="Resume" Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" Class="ml-3" data-testid="ws-resume">Resume</MudButton>
                <MudButton OnClick="DeleteWorkspace" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error" Class="ml-1" data-testid="ws-delete">Delete</MudButton>
            }
            <MudButton Href="@($"/p/{view.ProjectKey}/repos/{view.RepoSlug}/workspace?ref={Uri.EscapeDataString(ws.Ref)}")" Size="Size.Small" Variant="Variant.Outlined" Class="ml-3">Start a new one</MudButton>
        </MudAlert>
        <div class="mt-3" style="max-width:1100px"><WorkspaceAuditTable PublicId="@PublicId" /></div>
        @if (env is { ProvisionLog.Length: > 0 } && ws.State == WorkspaceState.Failed) { <pre class="mono ws-log" style="max-width:760px" data-testid="ws-provision-log">@env.ProvisionLog</pre> }
    }
    </div>
}

@code {
    [Parameter] public string PublicId { get; set; } = "";

    private WorkspaceInfo? view;
    private string? ideUrl, previewUrl;
    private int previewPort;
    private List<int>? ports;
    private bool showAi, aiBusy, showTools;
    private WorkspaceAiStatus? aiStatus;
    private string draft = "", aiNote = null!;
    private readonly List<EditorChatMessage> chat = [];
    private readonly List<string> toolLines = [];
    private PeriodicTimer? timer;
    private WorkspaceState? lastState;
    private CancellationTokenSource? aiCts;
    private WorkspaceService.WorkspaceEnvironmentView? env;
    private bool showTasks, tasksShownOnce;
    /// <summary>Full screen is the default while the workspace runs: the IDE gets the whole viewport under one slim bar.</summary>
    private bool fullscreen = true;
    private readonly Dictionary<string, string> taskLogs = [];
    private readonly HashSet<string> autoPreviewed = [];
    [Inject] private IOptionsMonitor<WorkspaceOptions> WsOptions { get; set; } = null!;

    private int RetentionDays() => WsOptions.CurrentValue.VolumeRetentionDays;
    private int RunningCount() => env?.Tasks.Count(t => t.State == "Running") ?? 0;
    private List<int> AllPorts() => (ports ?? []).Concat(env?.Ports ?? []).Distinct().Order().ToList();

    private static Color SetupColor(string s) => s switch { "Succeeded" or "UpToDate" => Color.Success, "Failed" => Color.Error, _ => Color.Info };
    private static string SetupLabel(string s) => s switch { "UpToDate" => "up to date", "Pending" => "waiting", _ => s.ToLowerInvariant() };
    private static Color TaskColor(string s) => s switch { "Running" => Color.Info, "Succeeded" => Color.Success, "Failed" => Color.Error, _ => Color.Default };

    /// <summary>Environment, setup output and the logs of tasks that have run: refreshed with the page's poll while the workspace is starting or running.</summary>
    private async Task RefreshEnvAsync()
    {
        if (view == null || view.Workspace.State is not (WorkspaceState.Starting or WorkspaceState.Running or WorkspaceState.Failed)) return;
        try
        {
            env = await Workspaces.GetEnvironmentAsync(PublicId, Me.Id);
            if (view.Workspace.State != WorkspaceState.Running) return;
            if (!tasksShownOnce && (env.Tasks.Count > 0 || env.SetupState is not "None")) { tasksShownOnce = true; showTasks = true; } // the panel opens by itself once, when there is something to show
            foreach (var t in env.Tasks.Where(t => t.State != "Idle"))
            {
                var (lines, _, _) = await Workspaces.TaskLogAsync(PublicId, Me.Id, t.Name, 0, 200);
                taskLogs[t.Name] = string.Join('\n', lines);
                // A task marked preview: true opens the preview beside the IDE once its port is listening.
                if (t.Preview && t.Port is { } p && t.State == "Running" && ports?.Contains(p) == true && autoPreviewed.Add($"{t.Name}@{t.StartedAt:O}") && previewUrl == null)
                    await OpenPreview(p);
            }
        }
        catch (InvalidOperationException) { }
    }

    private async Task RunTask(string name)
    {
        try { await Workspaces.RunTaskAsync(PublicId, Me.Id, name); await RefreshEnvAsync(); }
        catch (InvalidOperationException ex) { Snackbar.Add(ex.Message, Severity.Warning); }
    }

    private async Task StopTask(string name)
    {
        try { await Workspaces.StopTaskAsync(PublicId, Me.Id, name); await RefreshEnvAsync(); }
        catch (InvalidOperationException ex) { Snackbar.Add(ex.Message, Severity.Warning); }
    }

    private async Task RerunSetup()
    {
        try { await Workspaces.RerunSetupAsync(PublicId, Me.Id); await RefreshEnvAsync(); }
        catch (InvalidOperationException ex) { Snackbar.Add(ex.Message, Severity.Warning); }
    }

    private async Task ReloadEnv()
    {
        try
        {
            var errors = await Workspaces.ReloadEnvironmentAsync(PublicId, Me.Id);
            Snackbar.Add(errors.Count == 0 ? "Environment reloaded." : "The environment file has problems (shown on the page).", errors.Count == 0 ? Severity.Success : Severity.Warning);
            await RefreshEnvAsync();
        }
        catch (InvalidOperationException ex) { Snackbar.Add(ex.Message, Severity.Warning); }
    }

    private async Task Resume()
    {
        try { await Workspaces.ResumeAsync(PublicId, Me.Id); lastState = null; await RefreshAsync(); }
        catch (InvalidOperationException ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    private async Task DeleteWorkspace()
    {
        var ok = await Dialogs.ShowMessageBoxAsync("Delete this workspace?", "Its saved files and installed dependencies are deleted for good. Push what you want to keep first.", yesText: "Delete", cancelText: "Cancel");
        if (ok != true) return;
        try { await Workspaces.DeleteAsync(PublicId, Me.Id); Nav.NavigateTo("/workspaces"); }
        catch (InvalidOperationException ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    protected override async Task OnInitializedAsync()
    {
        await Me.EnsureLoadedAsync();
        await RefreshAsync();
        timer = new PeriodicTimer(TimeSpan.FromSeconds(2));
        _ = LoopAsync();
    }

    private async Task LoopAsync()
    {
        try
        {
            while (await timer!.WaitForNextTickAsync())
            {
                await RefreshAsync();
                if (view?.Workspace.State == WorkspaceState.Running && ++tick % 3 == 1) await LoadPorts(); // the Preview menu's ports, every ~6 s
                await RefreshEnvAsync();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (ObjectDisposedException) { }
    }

    private async Task RefreshAsync()
    {
        view = await Workspaces.GetMineAsync(PublicId, Me.Id);
        var state = view?.Workspace.State;
        if (state != lastState)
        {
            lastState = state;
            ideUrl = state == WorkspaceState.Running ? await Workspaces.EntryUrlAsync(PublicId, Me.Id, new Uri(Nav.BaseUri)) : null;
            if (state == WorkspaceState.Running && view != null) aiStatus = await WorkspaceAi.GetStatusAsync(view.Workspace.ProjectId);
        }
    }

    private Color StateColor() => view?.Workspace.State switch
    {
        WorkspaceState.Running => Color.Success, WorkspaceState.Failed => Color.Error, WorkspaceState.Starting => Color.Info, _ => Color.Default,
    };

    private int tick;

    private async Task LoadPorts()
    {
        try { ports = await Workspaces.ListeningPortsAsync(PublicId, Me.Id); }
        catch (InvalidOperationException) { ports = []; }
    }

    private async Task OpenPreview(int port)
    {
        previewPort = port;
        previewUrl = await Workspaces.EntryUrlAsync(PublicId, Me.Id, new Uri(Nav.BaseUri), port);
        if (previewUrl == null) Snackbar.Add("The preview isn't available.", Severity.Warning);
    }

    private async Task OpenPreviewTab()
    {
        var url = await Workspaces.EntryUrlAsync(PublicId, Me.Id, new Uri(Nav.BaseUri), previewPort);
        if (url != null) await JS.InvokeVoidAsync("open", url, "_blank", "noopener");
    }

    private async Task OpenIdeTab()
    {
        var url = await Workspaces.EntryUrlAsync(PublicId, Me.Id, new Uri(Nav.BaseUri));
        if (url != null) await JS.InvokeVoidAsync("open", url, "_blank", "noopener");
    }

    private async Task Stop()
    {
        var ok = await Dialogs.ShowMessageBoxAsync("Stop this workspace?",
            $"The container and its running processes end. Your files and installed dependencies are kept for {RetentionDays()} days so you can resume; push the work you want to keep anyway.", yesText: "Stop", cancelText: "Cancel");
        if (ok != true) return;
        try { await Workspaces.StopAsync(PublicId, Me.Id); Snackbar.Add("Workspace stopped.", Severity.Success); }
        catch (InvalidOperationException ex) { Snackbar.Add(ex.Message, Severity.Error); }
        await RefreshAsync();
    }

    private async Task Restart()
    {
        try { await Workspaces.RestartAsync(PublicId, Me.Id); Snackbar.Add("Workspace restarted.", Severity.Success); }
        catch (InvalidOperationException ex) { Snackbar.Add(ex.Message, Severity.Error); }
        lastState = null;
        await RefreshAsync();
    }

    private async Task OpenCommit()
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };
        await Dialogs.ShowAsync<WorkspaceCommitDialog>("Commit & push", new DialogParameters { ["PublicId"] = PublicId, ["CanPush"] = view!.Workspace.CanPush, ["Ref"] = view.Workspace.Ref }, options);
    }

    private Task OpenEditorPanel() =>
        Dialogs.ShowAsync<WorkspaceEditorDialog>("Connect from your editor", new DialogParameters { ["PublicId"] = PublicId }, new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });

    private async Task SendAi()
    {
        var text = draft.Trim();
        if (text.Length == 0 || aiBusy) return;
        draft = "";
        aiNote = null!;
        toolLines.Clear();
        var history = chat.ToList();
        chat.Add(new EditorChatMessage(true, text));
        var reply = new EditorChatMessage(false, "");
        aiBusy = true;
        aiCts = new CancellationTokenSource();
        var sink = new PanelSink(async delta => { reply = reply with { Text = reply.Text + delta }; await InvokeAsync(StateHasChanged); },
            async line => { toolLines.Add(line); await InvokeAsync(StateHasChanged); });
        try
        {
            var result = await WorkspaceAi.RunAsync(PublicId, Me.Id, text, history, sink, aiCts.Token);
            var body = result.Text.Length > 0 ? result.Text : reply.Text;
            if (body.Length > 0) chat.Add(new EditorChatMessage(false, body));
            aiNote = result.Error ?? result.StopNote!;
        }
        catch (OperationCanceledException) { }
        catch (InvalidOperationException ex) { aiNote = ex.Message; }
        finally { aiBusy = false; toolLines.Clear(); }
    }

    private sealed class PanelSink(Func<string, Task> text, Func<string, Task> tool) : IEditorAiSink
    {
        public Task TextAsync(string delta) => text(delta);
        public Task ToolAsync(string name, string detail) => tool(detail);
        public Task ProposalAsync(ProposedEdit edit) => Task.CompletedTask;
    }

    public void Dispose()
    {
        timer?.Dispose();
        aiCts?.Cancel();
    }
}
