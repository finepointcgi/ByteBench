@page "/timesheet"
@using GitBench.Services.Fields
@using GitBench.Components.Fields
@inject TimeTrackingService Time
@inject CurrentUser Me
@inject NavigationManager Nav

<PageTitle>My timesheet</PageTitle>

<div class="ts-page">
    <div class="page-header">
        <div>
            <MudText Typo="Typo.h5" HtmlTag="h1">My timesheet</MudText>
            <MudText Class="mud-text-secondary" Typo="Typo.body2">Work you logged, by week (hours). Log work from an issue's Work log.</MudText>
        </div>
        <div class="d-flex align-center gap-1">
            <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft" aria-label="Previous week" OnClick="() => Go(-7)" />
            <MudText Typo="Typo.subtitle2">@week.ToString("MMM d") – @week.AddDays(6).ToString("MMM d, yyyy")</MudText>
            <MudIconButton Icon="@Icons.Material.Filled.ChevronRight" aria-label="Next week" OnClick="() => Go(7)" />
            @if (week != TimeTrackingService.WeekStart(DateTime.Today))
            {
                <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="() => Go(null)">This week</MudButton>
            }
        </div>
    </div>
    <MudPaper Outlined="true" Class="pa-2">
        <WeekGrid Entries="entries" WeekStart="week" />
    </MudPaper>
    @if (entries.Count > 0)
    {
        <MudText Typo="Typo.subtitle2" Class="mt-4 mb-1">Entries</MudText>
        <MudPaper Outlined="true">
            @foreach (var e in entries)
            {
                <div class="ts-entry" @key="e.LogId">
                    <span class="mud-text-secondary ts-day">@e.Date.ToString("ddd MMM d")</span>
                    <b class="ts-mins">@Duration.Format(e.Minutes)</b>
                    <a href="/p/@e.ProjectKey/issues/@e.IssueKey.Split('-').Last()#work-log" class="mono">@e.IssueKey</a>
                    <span class="ts-text">@e.IssueTitle@(e.Comment != null ? $" — {e.Comment}" : "")</span>
                </div>
            }
        </MudPaper>
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "week")] public string? WeekParam { get; set; }

    private DateTime week;
    private List<TimesheetEntry> entries = [];

    protected override async Task OnParametersSetAsync()
    {
        week = TimeTrackingService.WeekStart(DateTime.TryParse(WeekParam, out var d) ? d : DateTime.Today);
        await Me.EnsureLoadedAsync();
        entries = await Time.GetUserEntriesAsync(Me.Id, week, week.AddDays(7));
    }

    private void Go(int? days)
    {
        var target = days is { } n ? week.AddDays(n) : TimeTrackingService.WeekStart(DateTime.Today);
        Nav.NavigateTo($"/timesheet?week={target:yyyy-MM-dd}");
    }
}
