@page "/p/{Key}/repos/{Slug}/commits/{Sha}"
@inherits RepoPageBase

<PageTitle>@detail?.Commit.MessageShort · @Repo?.Name</PageTitle>

@if (NotFound)
{
    <ProjectNotFound Message="This repository does not exist." />
}
else if (Repo != null)
{
    <RepoHeader Repo="Repo" Active="commits" />

    @if (detail == null)
    {
        <div class="empty">Commit <span class="mono">@Sha</span> was not found in this repository.</div>
    }
    else
    {
        var c = detail.Commit;
        <MudPaper Outlined="true" Class="pa-4 mb-4">
            <div class="commit-top">
                <div class="gb-min0 flex-grow-1">
                    <MudText Typo="Typo.h6" HtmlTag="h2" Class="commit-title">@c.MessageShort</MudText>
                    @if (c.Body != null)
                    {
                        <pre class="commit-body">@c.Body</pre>
                    }
                    <IssueKeyLinks ProjectKey="@Repo.Project.Key" Text="@c.Message" />
                </div>
                <MudButton Href="@RepoUrls.Source(Repo, c.Sha)" Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.Code" Class="gb-nowrap">Browse files</MudButton>
            </div>
            <div class="commit-meta">
                <GitAvatar Name="@c.AuthorName" Email="@c.AuthorEmail" Users="UsersByEmail" Size="22" ShowName />
                <span class="muted">committed @Display.Ago(c.When.UtcDateTime) · @c.When.ToLocalTime().ToString("MMM d, yyyy HH:mm")</span>
                <span class="commit-parents muted small">
                    @(c.ParentShas.Count == 1 ? "parent" : c.ParentShas.Count > 1 ? "parents" : "root commit")
                    @foreach (var p in c.ParentShas)
                    {
                        <text> </text><a class="sha-pill" href="@RepoUrls.Commit(Repo, p)">@p[..7]</a>
                    }
                    · commit <span class="sha-pill commit-sha" title="@c.Sha">@c.Sha</span>
                </span>
            </div>
        </MudPaper>

        @if (c.ParentShas.Count > 1)
        {
            <MudText Typo="Typo.body2" Class="mud-text-secondary mb-2">Showing changes against the first parent.</MudText>
        }
        <DiffView Files="detail.Files" Repo="Repo" ViewRef="@c.Sha" EmptyText="This commit has no file changes." />
    }
}

@code {
    [Parameter] public string Sha { get; set; } = "";

    private CommitDetail? detail;

    protected override async Task OnParametersSetAsync()
    {
        if (!await LoadRepoAsync()) return;
        var sha = Sha;
        detail = await Git(path => GitOps.GetCommitDetail(path, sha));
    }
}
