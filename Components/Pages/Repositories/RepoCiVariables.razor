@page "/p/{Key}/repos/{Slug}/settings/ci-variables"
@inherits RepoPageBase
@inject ProjectAccess Access

<PageTitle>CI variables · @Repo?.Name</PageTitle>

@if (NotFound)
{
    <ProjectNotFound Message="This repository does not exist." />
}
else if (Repo != null && !perms.Can(Permission.ManageRepositories))
{
    <RepoHeader Repo="Repo" Active="settings" />
    <Forbidden Message="Only Maintainers and Owners can manage CI variables." BackHref="@RepoUrls.Base(Repo)" />
}
else if (Repo != null)
{
    <RepoHeader Repo="Repo" Active="settings" />

    <div class="settings-layout">
        <RepoSettingsNav Repo="Repo" Active="ci-variables" />
        <div class="gb-min0">
            <div class="mb-4">
                <MudText Typo="Typo.h6" HtmlTag="h2" Class="d-flex align-center gap-2 mb-1"><MudIcon Icon="@Icons.Material.Outlined.Key" /> CI variables</MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary">
                    Secret environment variables for this repository's pipelines. They override
                    <a href="/p/@Repo.Project.Key/settings#ci-variables">project variables</a> with the same name.
                    Values are encrypted at rest, masked as <code>***</code> in step logs, and never shown again after saving.
                    <b>Protected</b> variables only reach pipelines on <a href="@RepoUrls.BranchProtection(Repo)">protected branches</a>
                    (for pull requests, the source branch must be protected).
                </MudText>
            </div>
            <MudPaper Outlined="true" Class="pa-4">
                <CiVariablesEditor ProjectId="Repo.ProjectId" RepositoryId="Repo.Id" />
            </MudPaper>
        </div>
    </div>
}

@code {
    private ProjectPermissions perms = ProjectPermissions.None;

    protected override async Task OnParametersSetAsync()
    {
        if (!await LoadRepoAsync()) return;
        perms = await Access.GetPermissionsAsync(Repo!.ProjectId);
    }
}
