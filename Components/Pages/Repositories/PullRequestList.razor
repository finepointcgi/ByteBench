@page "/p/{Key}/pull-requests"
@page "/p/{Key}/repos/{Slug}/pull-requests"
@inject IssueService Issues
@inject RepositoryService Repos
@inject PullRequestService PRs
@inject NavigationManager Nav
@inject ProjectAccess Access

<PageTitle>Pull requests · @project?.Name</PageTitle>

@if (notFound)
{
    <ProjectNotFound Message="@(Slug != null ? "This repository does not exist." : "This project does not exist.")" />
}
else if (project != null)
{
    @if (scopedRepo != null)
    {
        <RepoHeader Repo="scopedRepo" Active="prs" />
    }
    else
    {
        <div class="page-header">
            <div>
                <h1>Pull requests</h1>
                <div class="muted">@project.Name · all repositories</div>
            </div>
        </div>
    }

    <div class="d-flex align-items-end gap-3">
        <div class="tabs flex-grow-1">
            @foreach (var s in Enum.GetValues<PullRequestState>())
            {
                <a class="tab @(CurrentState == s ? "active" : "")" href="@StateUrl(s)">
                    @s <span class="count">@(s switch { PullRequestState.Open => counts.Open, PullRequestState.Merged => counts.Merged, _ => counts.Declined })</span>
                </a>
            }
        </div>
        <div class="d-flex gap-2 mb-2">
            @if (scopedRepo == null)
            {
                <select class="form-select form-select-sm" value="@(RepoFilter ?? "")" @onchange="FilterRepo">
                    <option value="">All repositories</option>
                    @foreach (var r in repos) { <option value="@r.Repository.Slug">@r.Repository.Name</option> }
                </select>
            }
            @if (repos.Count > 0 && canCreate)
            {
                <a class="btn btn-primary btn-sm text-nowrap" href="@RepoUrls.NewPullRequest(project.Key, scopedRepo?.Slug ?? RepoFilter)">+ Create pull request</a>
            }
        </div>
    </div>

    <div class="issue-list">
        @if (repos.Count == 0)
        {
            <div class="empty">This project has no repositories yet. <a href="@RepoUrls.List(project.Key)">Create one</a> to open pull requests.</div>
        }
        else if (prs.Count == 0)
        {
            <div class="empty">No @CurrentState.ToString().ToLowerInvariant() pull requests.</div>
        }
        @foreach (var pr in prs)
        {
            var approvals = pr.Reviews.Count(r => r.State == ReviewState.Approved);
            var changes = pr.Reviews.Count(r => r.State == ReviewState.ChangesRequested);
            <a class="issue-row pr-row" href="@RepoUrls.PullRequest(pr)" @key="pr.Id">
                <Avatar User="pr.Author" Size="28" />
                <div class="issue-main">
                    <div class="issue-title">@pr.Title</div>
                    <div class="issue-meta">
                        <span class="mono">@pr.Repository.Slug#@pr.Number</span>
                        · <span class="branch-pill mono">@pr.SourceBranch</span> → <span class="branch-pill mono">@pr.TargetBranch</span>
                        · opened @Display.Ago(pr.CreatedAt) by @pr.Author.DisplayName
                        · updated @Display.Ago(pr.UpdatedAt)
                    </div>
                </div>
                <div class="issue-right">
                    @if (approvals > 0) { <span class="review-chip approved" title="Approvals">✓ @approvals</span> }
                    @if (changes > 0) { <span class="review-chip changes" title="Changes requested">✎ @changes</span> }
                    @if (commentCounts.GetValueOrDefault(pr.Id) is var n and > 0) { <span class="count" title="Comments">💬 @n</span> }
                    <PrStateBadge State="pr.State" />
                </div>
            </a>
        }
    </div>
}

@code {
    [Parameter] public string Key { get; set; } = "";
    [Parameter] public string? Slug { get; set; }
    [SupplyParameterFromQuery(Name = "state")] public string? State { get; set; }
    [SupplyParameterFromQuery(Name = "repo")] public string? RepoFilter { get; set; }

    private Project? project;
    private Repository? scopedRepo;
    private List<RepoSummary> repos = [];
    private List<PullRequest> prs = [];
    private Dictionary<int, int> commentCounts = [];
    private PullRequestCounts counts = new(0, 0, 0);
    private bool notFound, canCreate;

    private PullRequestState CurrentState => Enum.TryParse<PullRequestState>(State, true, out var s) ? s : PullRequestState.Open;

    protected override async Task OnParametersSetAsync()
    {
        project = await Issues.GetProjectAsync(Key);
        scopedRepo = Slug != null && project != null ? await Repos.GetRepositoryAsync(Key, Slug) : null;
        notFound = project == null || (Slug != null && scopedRepo == null);
        if (notFound) return;

        repos = await Repos.GetRepositoriesAsync(project!.Id);
        canCreate = await Access.CanAsync(project.Id, Permission.CreatePullRequest);
        var repoId = scopedRepo?.Id ?? repos.FirstOrDefault(r => r.Repository.Slug == RepoFilter)?.Repository.Id;
        prs = await PRs.ListAsync(project.Id, CurrentState, repoId);
        counts = await PRs.CountAsync(project.Id, repoId);
        commentCounts = await PRs.CommentCountsAsync(prs.Select(p => p.Id));
    }

    private string StateUrl(PullRequestState s)
    {
        var state = s == PullRequestState.Open ? null : s.ToString().ToLowerInvariant();
        return scopedRepo != null ? RepoUrls.RepoPullRequests(scopedRepo, state) : RepoUrls.PullRequests(project!.Key, state, RepoFilter);
    }

    private void FilterRepo(ChangeEventArgs e)
    {
        var slug = e.Value?.ToString();
        var state = CurrentState == PullRequestState.Open ? null : CurrentState.ToString().ToLowerInvariant();
        Nav.NavigateTo(RepoUrls.PullRequests(project!.Key, state, string.IsNullOrEmpty(slug) ? null : slug));
    }
}
