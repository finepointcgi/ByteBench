@page "/p/{Key}/pull-requests"
@page "/p/{Key}/repos/{Slug}/pull-requests"
@inject IssueService Issues
@inject RepositoryService Repos
@inject PullRequestService PRs
@inject NavigationManager Nav
@inject LiveEvents Live
@implements IDisposable
@inject ProjectAccess Access
@inject ReviewerService Reviewers
@inject CurrentUser Me
@inject RepositorySettingsService RepoSettings
@inject GitBench.Services.MergeQueue.MergeQueueService MergeQueues

<PageTitle>Pull requests · @project?.Name</PageTitle>

@if (notFound)
{
    <ProjectNotFound Message="@(Slug != null ? "This repository does not exist." : "This project does not exist.")" />
}
else if (project != null)
{
    @if (scopedRepo != null)
    {
        <RepoHeader Repo="scopedRepo" Active="prs" />
    }
    else
    {
        <div class="pr-page-header">
            <MudText Typo="Typo.h5" HtmlTag="h1" Class="gb-bold">Pull requests</MudText>
            <MudText Class="mud-text-secondary" Typo="Typo.body2">@project.Name · all repositories</MudText>
        </div>
    }

    <div class="pr-bar">
        <nav class="gb-tabs pr-state-tabs" aria-label="Pull request state">
            @foreach (var s in Enum.GetValues<PullRequestState>())
            {
                <TabLink Active="@(CurrentState == s)" Href="@StateUrl(s)"
                         Count="@(s switch { PullRequestState.Open => counts.Open, PullRequestState.Merged => counts.Merged, _ => counts.Declined })">@s</TabLink>
            }
        </nav>
        <div class="pr-actions">
            <MudButton Href="@Nav.GetUriWithQueryParameters(new Dictionary<string, object?> { ["filter"] = ReviewRequested ? null : "review-requested", ["state"] = null })"
                       Variant="@(ReviewRequested ? Variant.Filled : Variant.Outlined)" Color="@(ReviewRequested ? Color.Primary : Color.Default)" Size="Size.Small"
                       StartIcon="@Icons.Material.Outlined.RateReview" title="Open pull requests waiting for your review" Class="gb-nowrap">
                Review requested <span class="gb-tab-count">@awaitingReview.Count</span>
            </MudButton>
            @if (CurrentState == PullRequestState.Open)
            {
                <MudSelect T="string" Value="@(DraftFilter ?? "")" ValueChanged="FilterDrafts" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true"
                           OuterClass="pr-draft-filter" aria-label="Filter drafts">
                    <MudSelectItem T="string" Value="@("")">Drafts and ready</MudSelectItem>
                    <MudSelectItem T="string" Value="@("ready")">Ready for review</MudSelectItem>
                    <MudSelectItem T="string" Value="@("only")">Drafts only</MudSelectItem>
                </MudSelect>
            }
            @if (scopedRepo == null)
            {
                <MudSelect T="string" Value="@(RepoFilter ?? "")" ValueChanged="FilterRepo" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true"
                           OuterClass="pr-repo-filter" aria-label="Filter by repository">
                    <MudSelectItem T="string" Value="@("")">All repositories</MudSelectItem>
                    @foreach (var r in repos) { <MudSelectItem T="string" Value="@r.Repository.Slug">@r.Repository.Name</MudSelectItem> }
                </MudSelect>
            }
            @if (scopedRepo != null && queueBranches.Count > 0)
            {
                <MudButton Href="@GitBench.Services.MergeQueue.MergeQueueUrls.Queue(scopedRepo)" Variant="Variant.Outlined" Size="Size.Small"
                           StartIcon="@Icons.Material.Outlined.Train" Class="gb-nowrap">Merge queue</MudButton>
            }
            @if (repos.Count > 0 && canCreate)
            {
                <MudButton Href="@RepoUrls.NewPullRequest(project.Key, scopedRepo?.Slug ?? RepoFilter)" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Add" Class="gb-nowrap">Create pull request</MudButton>
            }
        </div>
    </div>

    <div class="gb-rows">
        @if (repos.Count == 0)
        {
            <div class="empty">This project has no repositories yet. <a href="@RepoUrls.List(project.Key)">Create one</a> to open pull requests.</div>
        }
        else if (prs.Count == 0)
        {
            <div class="empty">No @(DraftFilter == "only" ? "draft" : CurrentState.ToString().ToLowerInvariant()) pull requests@(DraftFilter == "ready" ? " ready for review" : "")@(ReviewRequested ? " waiting for your review" : "").</div>
        }
        @foreach (var pr in prs)
        {
            var approvals = pr.Reviews.Count(r => r.State == ReviewState.Approved);
            var changes = pr.Reviews.Count(r => r.State == ReviewState.ChangesRequested);
            <a class="gb-row pr-row" href="@RepoUrls.PullRequest(pr)" @key="pr.Id">
                <Avatar User="pr.Author" Size="28" />
                <div class="gb-row-main">
                    <div class="gb-row-title">@pr.Title</div>
                    <div class="gb-row-meta">
                        <span class="mono">@pr.Repository.Slug#@pr.Number</span>
                        · <span class="branch-pill">@pr.SourceLabel</span> → <span class="branch-pill">@pr.TargetBranch</span>
                        · opened @Display.Ago(pr.CreatedAt) by @pr.Author.DisplayName
                        · updated @Display.Ago(pr.UpdatedAt)
                    </div>
                </div>
                <div class="gb-row-right">
                    @if (approvals > 0) { <span class="pr-stat approved" title="Approvals"><MudIcon Icon="@Icons.Material.Filled.Check" Style="font-size: 14px" /> @approvals</span> }
                    @if (changes > 0) { <span class="pr-stat changes" title="Changes requested"><MudIcon Icon="@Icons.Material.Outlined.Edit" Style="font-size: 14px" /> @changes</span> }
                    @if (commentCounts.GetValueOrDefault(pr.Id) is var n and > 0) { <span class="pr-stat" title="Comments"><MudIcon Icon="@Icons.Material.Outlined.ChatBubbleOutline" Style="font-size: 14px" /> @n</span> }
                    <PrStateBadge State="pr.State" Draft="pr.IsDraft" />
                </div>
            </a>
        }
    </div>
}

@code {
    [Parameter] public string Key { get; set; } = "";
    [Parameter] public string? Slug { get; set; }
    [SupplyParameterFromQuery(Name = "state")] public string? State { get; set; }
    [SupplyParameterFromQuery(Name = "repo")] public string? RepoFilter { get; set; }
    [SupplyParameterFromQuery(Name = "filter")] public string? Filter { get; set; }
    /// <summary>"only" (drafts only) or "ready" (no drafts); open pull requests only.</summary>
    [SupplyParameterFromQuery(Name = "draft")] public string? DraftFilter { get; set; }

    private bool ReviewRequested => Filter == "review-requested";
    private HashSet<int> awaitingReview = [];

    private Project? project;
    private Repository? scopedRepo;
    private List<RepoSummary> repos = [];
    private List<PullRequest> prs = [];
    private Dictionary<int, int> commentCounts = [];
    private PullRequestCounts counts = new(0, 0, 0);
    private bool notFound, canCreate;

    private PullRequestState CurrentState => Enum.TryParse<PullRequestState>(State, true, out var s) ? s : PullRequestState.Open;

    private List<string> queueBranches = [];

    protected override async Task OnParametersSetAsync()
    {
        project = await Issues.GetProjectAsync(Key);
        scopedRepo = Slug != null && project != null ? await Repos.GetRepositoryAsync(Key, Slug) : null;
        if (Slug != null && project != null && scopedRepo == null && await RepoSettings.RedirectUrlAsync(Nav.Uri, Key, Slug) is { } moved)
        {
            Nav.NavigateTo(moved, replace: true); // renamed repository
            return;
        }
        notFound = project == null || (Slug != null && scopedRepo == null);
        if (notFound) return;

        repos = await Repos.GetRepositoriesAsync(project!.Id);
        queueBranches = scopedRepo != null ? await MergeQueues.BranchesAsync(scopedRepo) : [];
        canCreate = await Access.CanAsync(project.Id, Permission.CreatePullRequest);
        var repoId = scopedRepo?.Id ?? repos.FirstOrDefault(r => r.Repository.Slug == RepoFilter)?.Repository.Id;
        prs = await PRs.ListAsync(project.Id, CurrentState, repoId);
        awaitingReview = await Reviewers.AwaitingReviewAsync(project.Id, Me.Id, repoId);
        if (ReviewRequested) prs = prs.Where(p => awaitingReview.Contains(p.Id)).ToList();
        if (CurrentState == PullRequestState.Open && DraftFilter is "only" or "ready") prs = prs.Where(p => p.IsDraft == (DraftFilter == "only")).ToList();
        counts = await PRs.CountAsync(project.Id, repoId);
        commentCounts = await PRs.CommentCountsAsync(prs.Select(p => p.Id));
    }

    // ----- Live updates: any PR in this project changed -----
    private IDisposable? liveSubscription;

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender) liveSubscription = Live.Subscribe<PullRequestChanged>(OnPullRequestChanged);
    }

    private Task OnPullRequestChanged(PullRequestChanged e) => project?.Id != e.ProjectId ? Task.CompletedTask : InvokeAsync(async () =>
    {
        await OnParametersSetAsync();
        StateHasChanged();
    });

    public void Dispose() => liveSubscription?.Dispose();

    private string StateUrl(PullRequestState s)
    {
        var state = s == PullRequestState.Open ? null : s.ToString().ToLowerInvariant();
        return scopedRepo != null ? RepoUrls.RepoPullRequests(scopedRepo, state) : RepoUrls.PullRequests(project!.Key, state, RepoFilter);
    }

    private void FilterDrafts(string? value) =>
        Nav.NavigateTo(Nav.GetUriWithQueryParameter("draft", string.IsNullOrEmpty(value) ? null : value));

    private void FilterRepo(string? slug)
    {
        var state = CurrentState == PullRequestState.Open ? null : CurrentState.ToString().ToLowerInvariant();
        Nav.NavigateTo(RepoUrls.PullRequests(project!.Key, state, string.IsNullOrEmpty(slug) ? null : slug));
    }
}
