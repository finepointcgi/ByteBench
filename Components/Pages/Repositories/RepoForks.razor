@page "/p/{Key}/repos/{Slug}/forks"
@using ByteBench.Services.Forks
@inherits RepoPageBase
@inject ForkService Forks

<PageTitle>Forks · @Repo?.Name</PageTitle>

@if (NotFound)
{
    <ProjectNotFound Message="This repository does not exist." />
}
else if (Repo != null)
{
    <RepoHeader Repo="Repo" Active="source" />

    <MudText Typo="Typo.h6" HtmlTag="h2" Class="gb-bold mb-2">Forks</MudText>
    @if (forks == null)
    {
        <MudText Class="mud-text-secondary">Loading…</MudText>
    }
    else if (forks.Count == 0)
    {
        <div class="empty">No forks yet, at least none in projects you can see. Click <b>Fork</b> above to make one.</div>
    }
    else
    {
        <MudPaper Outlined="true">
            <MudList T="string" Dense="true">
                @foreach (var f in forks)
                {
                    <MudListItem T="string" @key="f.Id" Href="@RepoUrls.Base(f)" Icon="@Icons.Material.Outlined.CallSplit">
                        <span class="mono">@f.Project.Key/@f.Slug</span>
                        <span class="mud-text-secondary small"> · @f.Project.Name · forked @Display.Ago(f.CreatedAt)</span>
                    </MudListItem>
                }
            </MudList>
        </MudPaper>
        <MudText Typo="Typo.caption" HtmlTag="div" Class="mud-text-secondary mt-2">Only forks in projects you can see are listed.</MudText>
    }
}

@code {
    private List<Repository>? forks;

    protected override async Task OnParametersSetAsync()
    {
        if (!await LoadRepoAsync()) return;
        forks = await Forks.ListForksAsync(Repo!);
    }
}
