@page "/p/{Key}/repos/{Slug}/settings"
@inherits RepoPageBase
@inject ProjectAccess Access
@inject IDialogService Dialogs
@inject ISnackbar Snackbar

<PageTitle>Settings · @Repo?.Name</PageTitle>

@if (NotFound)
{
    <ProjectNotFound Message="This repository does not exist." />
}
else if (Repo != null && !canManage)
{
    <RepoHeader Repo="Repo" Active="settings" />
    <Forbidden Message="Only Maintainers and Owners can change repository settings." BackHref="@RepoUrls.Source(Repo)" />
}
else if (Repo != null)
{
    <RepoHeader Repo="Repo" Active="settings" />

    <div class="settings-layout">
        <RepoSettingsNav Repo="Repo" Active="general" />
        <div class="gb-min0">
            @if (error != null) { <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3">@error</MudAlert> }

            <MudPaper Outlined="true" Class="pa-5 settings-section">
                <MudText Typo="Typo.h6" HtmlTag="h2" Class="mb-3">General</MudText>
                <MudStack Spacing="3">
                    <MudTextField T="string" Label="Name" @bind-Value="name" MaxLength="100" Variant="Variant.Outlined" Margin="Margin.Dense" InputId="repo-name" />
                    <MudTextField T="string" Label="Description" @bind-Value="description" Lines="2" Variant="Variant.Outlined" Margin="Margin.Dense" InputId="repo-desc" />
                    @if (branches.Count == 0)
                    {
                        <MudText Class="mud-text-secondary" Typo="Typo.body2">Default branch: this repository has no branches yet.</MudText>
                    }
                    else
                    {
                        <MudSelect T="string" Label="Default branch" @bind-Value="defaultBranch" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true"
                                   HelperText="Used for the source browser, new pull requests and clones (HEAD)." OuterClass="default-branch gb-mono-input">
                            @foreach (var b in branches) { <MudSelectItem T="string" Value="@b"><span class="mono">@b</span></MudSelectItem> }
                        </MudSelect>
                    }
                    <div>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" Disabled="@(busy || string.IsNullOrWhiteSpace(name))" OnClick="SaveGeneral">Save changes</MudButton>
                    </div>
                </MudStack>
            </MudPaper>

            <MudPaper Outlined="true" Class="pa-5 settings-section">
                <MudText Typo="Typo.h6" HtmlTag="h2" Class="mb-1">Rename</MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">
                    Changes the repository's URL and clone URL. Old links and
                    <span class="mono">@RepoUrls.CloneUrl(Nav.BaseUri, Repo)</span> keep working, but update your remotes:
                    <span class="mono">git remote set-url origin &lt;new URL&gt;</span>.
                </MudText>
                <div class="rename-row">
                    <MudTextField T="string" @bind-Value="newSlug" Immediate="true" MaxLength="100" Variant="Variant.Outlined" Margin="Margin.Dense"
                                  Adornment="Adornment.Start" AdornmentText="@($"/p/{Repo.Project.Key}/repos/")" aria-label="New slug" Class="slug-input gb-mono-input" />
                    <MudButton Variant="Variant.Outlined" Size="Size.Small" Disabled="@(busy || string.IsNullOrWhiteSpace(newSlug) || newSlug.Trim().ToLowerInvariant() == Repo.Slug)" OnClick="Rename">Rename</MudButton>
                </div>
            </MudPaper>

            <MudPaper Outlined="true" Class="pa-5 settings-section danger-zone">
                <MudText Typo="Typo.h6" HtmlTag="h2" Color="Color.Error" Class="mb-1">Danger zone</MudText>
                <div class="settings-row">
                    <div>
                        <b>@(Repo.IsArchived ? "Unarchive this repository" : "Archive this repository")</b>
                        <div class="small muted">
                            @if (Repo.IsArchived)
                            {
                                <span>Make it writable again: pushes, new branches and pull requests are allowed.</span>
                            }
                            else
                            {
                                <span>Make it read-only. Pushes are rejected and pull requests can't be created or merged. You can undo this.</span>
                            }
                        </div>
                    </div>
                    <MudButton Variant="Variant.Outlined" Color="Color.Warning" Size="Size.Small" Class="gb-nowrap" Disabled="@busy" OnClick="ToggleArchive"
                               StartIcon="@(Repo.IsArchived ? Icons.Material.Outlined.Unarchive : Icons.Material.Outlined.Archive)">@(Repo.IsArchived ? "Unarchive" : "Archive")</MudButton>
                </div>
                <div class="settings-row">
                    <div>
                        <b>Delete this repository</b>
                        <div class="small muted">Permanently deletes the Git data, its pull requests, reviews and comments. This can't be undone.</div>
                    </div>
                    <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small" Class="gb-nowrap" Disabled="@busy" OnClick="Delete"
                               StartIcon="@Icons.Material.Outlined.DeleteForever">Delete…</MudButton>
                </div>
            </MudPaper>
        </div>
    </div>
}

@code {
    private bool canManage, busy;
    private string name = "", newSlug = "";
    private string? description, defaultBranch, error;
    private List<string> branches = [];

    protected override async Task OnParametersSetAsync()
    {
        if (!await LoadRepoAsync()) return;
        canManage = await Access.CanAsync(Repo!.ProjectId, Permission.ManageRepositories);
        if (!canManage) return;
        name = Repo.Name;
        description = Repo.Description;
        defaultBranch = Repo.DefaultBranch;
        newSlug = Repo.Slug;
        branches = await Git(path => GitOps.Exists(path) ? GitOps.ListBranches(path, Repo.DefaultBranch).Select(b => b.Name).ToList() : []);
        if (!branches.Contains(Repo.DefaultBranch) && branches.Count > 0) branches.Insert(0, Repo.DefaultBranch);
    }

    private async Task Run(Func<Task> action, string? success = null)
    {
        busy = true;
        error = null;
        try
        {
            await action();
            if (success != null) Snackbar.Add(success, Severity.Success);
        }
        catch (InvalidOperationException ex) { error = ex.Message; }
        finally { busy = false; }
    }

    private async Task Reload()
    {
        InvalidateRepo();
        await OnParametersSetAsync();
    }

    private Task SaveGeneral() => Run(async () =>
    {
        await RepoSettings.UpdateGeneralAsync(Repo!.Id, name, description, defaultBranch ?? Repo.DefaultBranch);
        await Reload();
    }, "Settings saved.");

    private Task Rename() => Run(async () =>
    {
        var slug = await RepoSettings.RenameAsync(Repo!.Id, newSlug);
        Nav.NavigateTo($"/p/{Repo.Project.Key}/repos/{slug}/settings");
    });

    private Task ToggleArchive() => Run(async () =>
    {
        var archive = !Repo!.IsArchived;
        await RepoSettings.SetArchivedAsync(Repo.Id, archive);
        await Reload();
        Snackbar.Add(archive ? "Repository archived. It is now read-only." : "Repository unarchived.", Severity.Success);
    });

    private async Task Delete()
    {
        error = null;
        var typed = await Dialogs.TypeToConfirmAsync("Delete repository",
            $"This permanently deletes {Repo!.Name}: its Git data, pull requests, reviews and comments. This can't be undone.",
            Repo.Name, "Delete repository");
        if (typed == null) return;
        await Run(async () =>
        {
            var key = Repo!.Project.Key;
            await RepoSettings.DeleteAsync(Repo.Id, typed);
            Nav.NavigateTo(RepoUrls.List(key));
        });
    }
}
