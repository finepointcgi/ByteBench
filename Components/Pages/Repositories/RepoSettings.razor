@page "/p/{Key}/repos/{Slug}/settings"
@inherits RepoPageBase
@inject ProjectAccess Access

<PageTitle>Settings · @Repo?.Name</PageTitle>

@if (NotFound)
{
    <ProjectNotFound Message="This repository does not exist." />
}
else if (Repo != null && !canManage)
{
    <RepoHeader Repo="Repo" Active="settings" />
    <Forbidden Message="Only Maintainers and Owners can change repository settings." BackHref="@RepoUrls.Source(Repo)" />
}
else if (Repo != null)
{
    <RepoHeader Repo="Repo" Active="settings" />

    <div class="settings-layout">
        <RepoSettingsNav Repo="Repo" Active="general" />
        <div class="min-w-0">
            @if (error != null) { <div class="alert alert-danger py-2">@error</div> }
            @if (notice != null) { <div class="alert alert-success py-2">@notice</div> }

            <div class="card-panel settings-section">
                <h2>General</h2>
                <div class="mb-3">
                    <label class="form-label" for="repo-name">Name</label>
                    <input id="repo-name" class="form-control" maxlength="100" @bind="name" />
                </div>
                <div class="mb-3">
                    <label class="form-label" for="repo-desc">Description</label>
                    <textarea id="repo-desc" class="form-control" rows="2" @bind="description"></textarea>
                </div>
                <div class="mb-3">
                    <label class="form-label" for="repo-default">Default branch</label>
                    @if (branches.Count == 0)
                    {
                        <div class="form-text">This repository has no branches yet.</div>
                    }
                    else
                    {
                        <select id="repo-default" class="form-select ref-select" @bind="defaultBranch">
                            @foreach (var b in branches) { <option value="@b">@b</option> }
                        </select>
                        <div class="form-text">Used for the source browser, new pull requests and clones (HEAD).</div>
                    }
                </div>
                <button class="btn btn-primary btn-sm" disabled="@(busy || string.IsNullOrWhiteSpace(name))" @onclick="SaveGeneral">Save changes</button>
            </div>

            <div class="card-panel settings-section">
                <h2>Rename</h2>
                <p class="small muted mb-2">
                    Changes the repository's URL and clone URL. Old links and
                    <span class="mono">@RepoUrls.CloneUrl(Nav.BaseUri, Repo)</span> keep working, but update your remotes:
                    <span class="mono">git remote set-url origin &lt;new URL&gt;</span>.
                </p>
                <div class="d-flex gap-2 align-items-center flex-wrap">
                    <span class="mono muted">/p/@Repo.Project.Key/repos/</span>
                    <input class="form-control form-control-sm mono branch-name-input" maxlength="100" @bind="newSlug" @bind:event="oninput" aria-label="New slug" />
                    <button class="btn btn-outline-secondary btn-sm" disabled="@(busy || string.IsNullOrWhiteSpace(newSlug) || newSlug.Trim().ToLowerInvariant() == Repo.Slug)" @onclick="Rename">Rename</button>
                </div>
            </div>

            <div class="card-panel settings-section danger-zone">
                <h2>Danger zone</h2>
                <div class="settings-row">
                    <div>
                        <b>@(Repo.IsArchived ? "Unarchive this repository" : "Archive this repository")</b>
                        <div class="small muted">
                            @if (Repo.IsArchived)
                            {
                                <span>Make it writable again: pushes, new branches and pull requests are allowed.</span>
                            }
                            else
                            {
                                <span>Make it read-only. Pushes are rejected and pull requests can't be created or merged. You can undo this.</span>
                            }
                        </div>
                    </div>
                    <button class="btn btn-outline-warning btn-sm text-nowrap" disabled="@busy" @onclick="ToggleArchive">@(Repo.IsArchived ? "Unarchive" : "Archive")</button>
                </div>
                <div class="settings-row">
                    <div>
                        <b>Delete this repository</b>
                        <div class="small muted">Permanently deletes the Git data, its pull requests, reviews and comments. This can't be undone.</div>
                    </div>
                    @if (!confirmingDelete)
                    {
                        <button class="btn btn-outline-danger btn-sm text-nowrap" @onclick="() => { confirmingDelete = true; confirmName = null; }">Delete…</button>
                    }
                </div>
                @if (confirmingDelete)
                {
                    <div class="mt-2">
                        <label class="form-label small" for="confirm-name">Type <b>@Repo.Name</b> to confirm.</label>
                        <div class="d-flex gap-2">
                            <input id="confirm-name" class="form-control form-control-sm" autocomplete="off" @bind="confirmName" @bind:event="oninput" />
                            <button class="btn btn-danger btn-sm text-nowrap" disabled="@(busy || confirmName?.Trim() != Repo.Name)" @onclick="Delete">Delete repository</button>
                            <button class="btn btn-outline-secondary btn-sm" @onclick="() => confirmingDelete = false">Cancel</button>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
}

@code {
    private bool canManage, busy, confirmingDelete;
    private string name = "", newSlug = "";
    private string? description, defaultBranch, confirmName, error, notice;
    private List<string> branches = [];

    protected override async Task OnParametersSetAsync()
    {
        if (!await LoadRepoAsync()) return;
        canManage = await Access.CanAsync(Repo!.ProjectId, Permission.ManageRepositories);
        if (!canManage) return;
        name = Repo.Name;
        description = Repo.Description;
        defaultBranch = Repo.DefaultBranch;
        newSlug = Repo.Slug;
        branches = await Git(path => GitOps.Exists(path) ? GitOps.ListBranches(path, Repo.DefaultBranch).Select(b => b.Name).ToList() : []);
        if (!branches.Contains(Repo.DefaultBranch) && branches.Count > 0) branches.Insert(0, Repo.DefaultBranch);
    }

    private async Task Run(Func<Task> action, string? success = null)
    {
        busy = true;
        error = notice = null;
        try
        {
            await action();
            if (success != null) notice = success;
        }
        catch (InvalidOperationException ex) { error = ex.Message; }
        finally { busy = false; }
    }

    private async Task Reload()
    {
        InvalidateRepo();
        await OnParametersSetAsync();
    }

    private Task SaveGeneral() => Run(async () =>
    {
        await RepoSettings.UpdateGeneralAsync(Repo!.Id, name, description, defaultBranch ?? Repo.DefaultBranch);
        await Reload();
    }, "Settings saved.");

    private Task Rename() => Run(async () =>
    {
        var slug = await RepoSettings.RenameAsync(Repo!.Id, newSlug);
        Nav.NavigateTo($"/p/{Repo.Project.Key}/repos/{slug}/settings");
    });

    private Task ToggleArchive() => Run(async () =>
    {
        var archive = !Repo!.IsArchived;
        await RepoSettings.SetArchivedAsync(Repo.Id, archive);
        await Reload();
        notice = archive ? "Repository archived. It is now read-only." : "Repository unarchived.";
    });

    private Task Delete() => Run(async () =>
    {
        var key = Repo!.Project.Key;
        await RepoSettings.DeleteAsync(Repo.Id, confirmName ?? "");
        Nav.NavigateTo(RepoUrls.List(key));
    });
}
