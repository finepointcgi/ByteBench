    // ---------- palette ----------

    private async Task OpenPalette(PaletteMode mode)
    {
        palette = mode;
        paletteQuery = "";
        paletteIndex = 0;
        if (mode != PaletteMode.Commands) await AllFilesAsync();
        Filter();
        focusPalette = true; // focus moves from Monaco to the palette after it renders
        StateHasChanged();
    }

    private async Task ClosePalette()
    {
        palette = PaletteMode.None;
        if (module != null) await module.InvokeVoidAsync("focusEditor");
    }

    private void PaletteFilter(string? q)
    {
        paletteQuery = q ?? "";
        paletteIndex = 0;
        Filter();
    }

    private void Filter()
    {
        var q = paletteQuery.Trim();
        if (palette == PaletteMode.Commands)
        {
            if (q.StartsWith('>')) q = q[1..].Trim();
            paletteItems = Commands().Where(c => Fuzzy(c.Label, q) >= 0).ToList();
            return;
        }
        paletteItems = (allFiles ?? [])
            .Select(f => (File: f, Score: Fuzzy(f, q)))
            .Where(x => x.Score >= 0)
            .OrderBy(x => x.Score).ThenBy(x => x.File.Length).ThenBy(x => x.File, StringComparer.Ordinal)
            .Take(50)
            .Select(x => new PaletteItem(EditorPaths.Name(x.File), x.File, palette == PaletteMode.Attach
                ? () => { AttachToChat(x.File); return Task.CompletedTask; }
                : () => OpenFile(x.File)))
            .ToList();
    }

    /// <summary>Subsequence match: -1 if <paramref name="q"/> isn't a subsequence of <paramref name="text"/>, else a score (lower is better).</summary>
    private static int Fuzzy(string text, string q)
    {
        if (q.Length == 0) return 0;
        var t = text.ToLowerInvariant();
        var query = q.ToLowerInvariant();
        if (t.Contains(query)) return t.EndsWith(query) || t.Contains("/" + query) ? 0 : 1;
        int ti = 0, gaps = 0;
        foreach (var ch in query)
        {
            var found = t.IndexOf(ch, ti);
            if (found < 0) return -1;
            gaps += found - ti;
            ti = found + 1;
        }
        return 2 + gaps;
    }

    private IEnumerable<PaletteItem> Commands()
    {
        yield return new("Go to file…", "Ctrl/Cmd+P", () => OpenPalette(PaletteMode.Files));
        yield return new("Find in files", "Ctrl/Cmd+Shift+F", FindInFiles);
        if (ctx?.CanEdit == true) yield return new("New file…", null, () => NewFile(null));
        yield return new("Save all", "Ctrl/Cmd+S", async () => { if (module != null) await module.InvokeVoidAsync("flushAll"); });
        yield return new("Show explorer", null, () => { SetActivity("explorer"); return Task.CompletedTask; });
        yield return new("Show source control", null, () => { SetActivity("scm"); return Task.CompletedTask; });
        if (ctx?.CanEdit == true && changes.Count > 0)
        {
            yield return new("Commit…", null, () => { SetActivity("scm"); return Task.CompletedTask; });
            yield return new("Discard all changes", null, DiscardAll);
        }
        if (status is { BranchMoved: true }) yield return new("Update workspace (rebase)", null, () => { SetActivity("scm"); return Task.CompletedTask; });
        yield return new(chatOpen ? "Hide the assistant" : "Show the assistant", "Ctrl/Cmd+Shift+L", () => { ToggleChat(); return Task.CompletedTask; });
        if (aiStatus is { Enabled: true } && activeTab is { Kind: TabKind.File, Editable: true })
        {
            yield return new("AI: Explain", null, () => InlineAction("explain"));
            yield return new("AI: Refactor…", null, () => InlineAction("refactor"));
            yield return new("AI: Add comments", null, () => InlineAction("comments"));
            yield return new("AI: Write tests", null, () => InlineAction("tests"));
            yield return new("AI: Fix", null, () => InlineAction("fix"));
        }
        if (aiStatus is { CompletionsAvailable: true }) yield return new(completions ? "AI: Turn ghost-text completions off" : "AI: Turn ghost-text completions on", null, ToggleCompletions);
        yield return new("Back to the repository", null, () => { Nav.NavigateTo(RepoUrls.Source(Repo!, ctx!.Branch)); return Task.CompletedTask; });
    }

    private async Task PaletteKey(KeyboardEventArgs e)
    {
        switch (e.Key)
        {
            case "ArrowDown": paletteIndex = Math.Min(paletteIndex + 1, Math.Max(0, paletteItems.Count - 1)); break;
            case "ArrowUp": paletteIndex = Math.Max(0, paletteIndex - 1); break;
            case "Escape": await ClosePalette(); break;
            case "Enter":
                if (paletteIndex < paletteItems.Count) await PickPalette(paletteItems[paletteIndex]);
                break;
        }
    }

    private async Task PickPalette(PaletteItem item)
    {
        palette = PaletteMode.None;
        await item.Run();
    }

    private static string? FirstLine(string? s) => s?.Split('\n')[0].Trim() is { Length: > 0 } l ? l : null;

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (module != null)
            {
                await module.InvokeVoidAsync("flushAll");
                await module.InvokeVoidAsync("dispose");
                await module.DisposeAsync();
            }
        }
        catch (JSDisconnectedException) { }
        catch (JSException) { }
        catch (TaskCanceledException) { }
        selfRef?.Dispose();
    }
}
