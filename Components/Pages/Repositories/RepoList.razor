@page "/p/{Key}/repos"
@inject IssueService Issues
@inject RepositoryService Repos
@inject CurrentUser Me
@inject NavigationManager Nav
@inject ProjectAccess Access

<PageTitle>Repositories · @project?.Name</PageTitle>

@if (notFound)
{
    <ProjectNotFound />
}
else if (project != null)
{
    <div class="repo-page-header">
        <div>
            <MudText Typo="Typo.h5" HtmlTag="h1" Class="gb-bold">Repositories</MudText>
            <MudText Class="mud-text-secondary" Typo="Typo.body2">@project.Name</MudText>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <MudButton Href="@RepoUrls.PullRequests(project.Key)" Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.MergeType">Pull requests</MudButton>
            @if (canCreate)
            {
                <MudButton Href="@RepoUrls.Import(project.Key)" Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.CloudDownload">Import repository</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                           OnClick="() => { creating = !creating; error = null; }">Create repository</MudButton>
            }
        </div>
    </div>

    @if (creating)
    {
        <MudPaper Outlined="true" Class="pa-5 mb-4" Style="max-width: 720px">
            <MudText Typo="Typo.h6" Class="mb-3">Create repository</MudText>
            <MudStack Spacing="3">
                <MudTextField T="string" Label="Name" @bind-Value="name" @bind-Value:after="NameChanged" Immediate="true"
                              Placeholder="e.g. Web App" MaxLength="100" Variant="Variant.Outlined" Margin="Margin.Dense" />
                <MudTextField T="string" Label="Slug" @bind-Value="slug" @bind-Value:after="() => slugEdited = true" Immediate="true" MaxLength="100"
                              Variant="Variant.Outlined" Margin="Margin.Dense" Class="gb-mono-input"
                              Adornment="Adornment.Start" AdornmentText="@($"{project.Key} /")"
                              HelperText="Lowercase letters, digits, '.', '_' and '-'. Used in URLs and the clone address (…/slug.git)." />
                <MudTextField T="string" Label="Description (optional)" @bind-Value="description" Variant="Variant.Outlined" Margin="Margin.Dense" />
                <MudText Class="mud-text-secondary" Typo="Typo.body2">The repository starts with a <code>README.md</code> on the <code>main</code> branch.</MudText>
                @if (error != null) { <MudAlert Severity="Severity.Error" Dense="true">@error</MudAlert> }
                <div class="d-flex gap-2">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(busy || string.IsNullOrWhiteSpace(name))" OnClick="Create">Create repository</MudButton>
                    <MudButton Variant="Variant.Outlined" OnClick="() => creating = false">Cancel</MudButton>
                </div>
            </MudStack>
        </MudPaper>
    }

    <div class="gb-rows">
        @if (repos.Count == 0)
        {
            <div class="empty">No repositories yet. Create one to start hosting code for @project.Key.</div>
        }
        @foreach (var r in repos)
        {
            <a class="gb-row repo-row" href="@RepoUrls.Base(r.Repository)" @key="r.Repository.Id">
                <span class="repo-icon"><MudIcon Icon="@Icons.Material.Outlined.Inventory2" Size="Size.Small" /></span>
                <div class="gb-row-main">
                    <div class="gb-row-title">
                        @r.Repository.Name <span class="muted mono small">@project.Key/@r.Repository.Slug</span>
                        @if (r.Repository.IsArchived) { <span class="archived-tag">Archived</span> }
                    </div>
                    <div class="gb-row-meta">
                        @(r.Repository.Description ?? "No description")
                        · created @Display.Ago(r.Repository.CreatedAt)
                    </div>
                </div>
                <div class="gb-row-right">
                    @if (r.OpenPullRequests > 0)
                    {
                        <span class="repo-stat" title="Open pull requests"><MudIcon Icon="@Icons.Material.Outlined.MergeType" Size="Size.Small" /> @r.OpenPullRequests open</span>
                    }
                    <span class="repo-stat mono" title="Default branch"><MudIcon Icon="@Icons.Material.Outlined.AccountTree" Size="Size.Small" /> @r.Repository.DefaultBranch</span>
                </div>
            </a>
        }
    </div>
}

@code {
    [Parameter] public string Key { get; set; } = "";

    private Project? project;
    private List<RepoSummary> repos = [];
    private bool notFound, creating, busy, slugEdited, canCreate;
    private string? name, slug, description, error;

    protected override async Task OnParametersSetAsync()
    {
        project = await Issues.GetProjectAsync(Key);
        notFound = project == null;
        if (project == null) return;
        repos = await Repos.GetRepositoriesAsync(project.Id);
        canCreate = await Access.CanAsync(project.Id, Permission.ManageRepositories);
    }

    private void NameChanged()
    {
        if (!slugEdited || string.IsNullOrEmpty(slug)) { slug = RepositoryService.Slugify(name ?? ""); slugEdited = false; }
    }

    private async Task Create()
    {
        busy = true;
        error = null;
        try
        {
            var repo = await Repos.CreateAsync(project!.Id, name ?? "", slug, description, Me.User!);
            Nav.NavigateTo(RepoUrls.Base(repo));
        }
        catch (InvalidOperationException ex) { error = ex.Message; }
        finally { busy = false; }
    }
}
