@page "/p/{Key}/repos/{Slug}/settings/branches"
@inherits RepoPageBase
@inject BranchProtectionService Protection
@inject ReviewerService Reviewers
@inject ProjectAccess Access
@inject IJSRuntime JS

<PageTitle>Branch protection · @Repo?.Name</PageTitle>

@if (NotFound)
{
    <ProjectNotFound Message="This repository does not exist." />
}
else if (Repo != null && !perms.Can(Permission.ManageRepositories))
{
    <RepoHeader Repo="Repo" Active="protection" />
    <Forbidden Message="Only Maintainers and Owners can manage branch protection." BackHref="@RepoUrls.Branches(Repo)" />
}
else if (Repo != null)
{
    <RepoHeader Repo="Repo" Active="protection" />

    <div class="page-header">
        <div>
            <h2 class="section-title mb-1">🔒 Branch protection rules</h2>
            <div class="muted small">
                Rules apply to branches whose name matches the pattern: an exact name such as <code>main</code>, or a glob such as
                <code>release/*</code> (<code>*</code> and <code>?</code> stay within one path segment, <code>**</code> matches across <code>/</code>).
                When several rules match a branch, the strictest setting of each wins. They are enforced on git push, branch creation and deletion, and pull request merges.
            </div>
        </div>
        @if (draft == null)
        {
            <button class="btn btn-primary btn-sm text-nowrap" @onclick="StartAdd">+ Add rule</button>
        }
    </div>

    @if (Error != null) { <div class="alert alert-danger py-2">@Error</div> }
    @if (message != null) { <div class="alert alert-success py-2">@message</div> }

    @if (draft != null)
    {
        <div class="card-panel mb-3">
            <h3 class="section-title">@(draft.Id == 0 ? "New rule" : "Edit rule")</h3>
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">Branch name pattern</label>
                    <input class="form-control form-control-sm mono" placeholder="main or release/*" @bind="draft.Pattern" @bind:event="oninput" />
                    <div class="form-text">
                        @if (!string.IsNullOrWhiteSpace(draft.Pattern))
                        {
                            var matching = branchNames.Where(b => BranchPatterns.Matches(draft.Pattern.Trim(), b)).ToList();
                            @if (matching.Count == 0) { <span>Matches no existing branch.</span> }
                            else { <span>Matches: <span class="mono">@string.Join(", ", matching.Take(8))</span>@(matching.Count > 8 ? $" and {matching.Count - 8} more" : "")</span> }
                        }
                    </div>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Required approvals</label>
                    <input type="number" min="0" max="10" class="form-control form-control-sm" @bind="draft.RequiredApprovals" />
                </div>
            </div>
            <div class="row mt-2">
                <div class="col-md-6">
                    <label class="form-check"><input class="form-check-input" type="checkbox" @bind="draft.BlockDirectPushes" /> <span class="form-check-label"><b>Block direct pushes</b> <span class="muted small">(changes only through pull requests; also blocks creating matching branches)</span></span></label>
                    <label class="form-check"><input class="form-check-input" type="checkbox" @bind="draft.BlockForcePushes" /> <span class="form-check-label"><b>Block force pushes</b></span></label>
                    <label class="form-check"><input class="form-check-input" type="checkbox" @bind="draft.BlockDeletion" /> <span class="form-check-label"><b>Block deletion</b></span></label>
                </div>
                <div class="col-md-6">
                    <label class="form-check"><input class="form-check-input" type="checkbox" @bind="draft.RequireChecksToPass" /> <span class="form-check-label"><b>Require checks to pass</b> <span class="muted small">(pending or failed checks such as pipelines block merging)</span></span></label>
                    <label class="form-check"><input class="form-check-input" type="checkbox" @bind="draft.DismissStaleApprovals" /> <span class="form-check-label"><b>Dismiss approvals when new commits are pushed</b></span></label>
                    <label class="form-check"><input class="form-check-input" type="checkbox" @bind="draft.AllowAdminBypass" /> <span class="form-check-label"><b>Allow admins to bypass</b> <span class="muted small">(site admins and project Owners)</span></span></label>
                </div>
            </div>
            <div class="mt-3">
                <label class="form-label mb-1">Default reviewers <span class="muted small">(added to new pull requests that target a matching branch)</span></label>
                <div class="d-flex flex-wrap gap-3">
                    @foreach (var u in candidates)
                    {
                        <label class="form-check small" @key="u.Id">
                            <input class="form-check-input" type="checkbox" checked="@draft.DefaultReviewerIds.Contains(u.Id)" @onchange="e => ToggleReviewer(u.Id, e)" />
                            <span class="form-check-label">@u.DisplayName</span>
                        </label>
                    }
                </div>
            </div>
            <div class="d-flex gap-2 mt-3">
                <button class="btn btn-primary btn-sm" disabled="@string.IsNullOrWhiteSpace(draft.Pattern)" @onclick="Save">@(draft.Id == 0 ? "Create rule" : "Save rule")</button>
                <button class="btn btn-outline-secondary btn-sm" @onclick="() => draft = null">Cancel</button>
            </div>
        </div>
    }

    <div class="issue-list">
        @if (rules.Count == 0)
        {
            <div class="empty">No branches are protected yet. Add a rule for <span class="mono">@Repo.DefaultBranch</span> to require pull requests and reviews.</div>
        }
        @foreach (var r in rules)
        {
            var matching = branchNames.Where(b => BranchPatterns.Matches(r.Pattern, b)).ToList();
            <div class="issue-row" @key="r.Id">
                <div class="issue-main">
                    <div class="issue-title"><span class="mono">🔒 @r.Pattern</span></div>
                    <div class="issue-meta">
                        @string.Join(" · ", Summary(r))
                        <br /><span>@(matching.Count == 0 ? "Matches no existing branch" : "Matches " + string.Join(", ", matching.Take(6)) + (matching.Count > 6 ? $" and {matching.Count - 6} more" : ""))</span>
                    </div>
                </div>
                <div class="issue-right">
                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => StartEdit(r)">Edit</button>
                    <button class="btn btn-sm btn-outline-danger" @onclick="() => Delete(r)">Delete</button>
                </div>
            </div>
        }
    </div>
}

@code {
    private ProjectPermissions perms = ProjectPermissions.None;
    private List<BranchProtectionRule> rules = [];
    private List<string> branchNames = [];
    private List<User> candidates = [];
    private BranchProtectionRule? draft;
    private string? message;

    protected override async Task OnParametersSetAsync()
    {
        if (!await LoadRepoAsync()) return;
        perms = await Access.GetPermissionsAsync(Repo!.ProjectId);
        if (!perms.Can(Permission.ManageRepositories)) return;
        candidates = await Reviewers.CandidatesAsync(Repo.ProjectId);
        await Load();
    }

    private async Task Load()
    {
        rules = await Protection.ListAsync(Repo!.Id);
        var r = Repo;
        branchNames = (await Git(path => GitOps.ListBranches(path, r.DefaultBranch))).Select(b => b.Name).ToList();
    }

    private IEnumerable<string> Summary(BranchProtectionRule r)
    {
        if (r.RequiredApprovals > 0) yield return $"{r.RequiredApprovals} approval{(r.RequiredApprovals == 1 ? "" : "s")} required";
        if (r.BlockDirectPushes) yield return "pull requests only";
        if (r.BlockForcePushes) yield return "no force pushes";
        if (r.BlockDeletion) yield return "no deletion";
        if (r.RequireChecksToPass) yield return "checks must pass";
        if (r.DismissStaleApprovals) yield return "stale approvals dismissed";
        if (r.AllowAdminBypass) yield return "admins can bypass";
        if (r.DefaultReviewerIds.Count > 0)
            yield return "default reviewers: " + string.Join(", ", candidates.Where(u => r.DefaultReviewerIds.Contains(u.Id)).Select(u => u.DisplayName));
    }

    private void StartAdd()
    {
        Error = message = null;
        draft = new BranchProtectionRule { Pattern = rules.Any(x => x.Pattern == Repo!.DefaultBranch) ? "" : Repo!.DefaultBranch };
    }

    private void StartEdit(BranchProtectionRule r)
    {
        Error = message = null;
        draft = new BranchProtectionRule
        {
            Id = r.Id, Pattern = r.Pattern, RequiredApprovals = r.RequiredApprovals, BlockDirectPushes = r.BlockDirectPushes,
            BlockForcePushes = r.BlockForcePushes, BlockDeletion = r.BlockDeletion, RequireChecksToPass = r.RequireChecksToPass,
            DismissStaleApprovals = r.DismissStaleApprovals, AllowAdminBypass = r.AllowAdminBypass, DefaultReviewerIds = [.. r.DefaultReviewerIds],
        };
    }

    private void ToggleReviewer(int id, ChangeEventArgs e)
    {
        draft!.DefaultReviewerIds.Remove(id);
        if (e.Value is true) draft.DefaultReviewerIds.Add(id);
    }

    private async Task Save()
    {
        Error = message = null;
        try
        {
            var saved = await Protection.SaveAsync(Repo!.Id, draft!, Me.Id);
            message = $"Saved the rule for '{saved.Pattern}'.";
            draft = null;
            await Load();
        }
        catch (InvalidOperationException ex) { Error = ex.Message; }
    }

    private async Task Delete(BranchProtectionRule r)
    {
        Error = message = null;
        if (!await JS.InvokeAsync<bool>("confirm", $"Delete the protection rule for '{r.Pattern}'?")) return;
        try
        {
            await Protection.DeleteAsync(Repo!.Id, r.Id, Me.Id);
            message = $"Deleted the rule for '{r.Pattern}'.";
            await Load();
        }
        catch (InvalidOperationException ex) { Error = ex.Message; }
    }
}
