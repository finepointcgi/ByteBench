@page "/p/{Key}/repos/{Slug}/settings/branches"
@inherits RepoPageBase
@inject BranchProtectionService Protection
@inject ReviewerService Reviewers
@inject ProjectAccess Access
@inject IDialogService Dialogs
@inject ISnackbar Snackbar

<PageTitle>Branch protection · @Repo?.Name</PageTitle>

@if (NotFound)
{
    <ProjectNotFound Message="This repository does not exist." />
}
else if (Repo != null && !perms.Can(Permission.ManageRepositories))
{
    <RepoHeader Repo="Repo" Active="settings" />
    <Forbidden Message="Only Maintainers and Owners can manage branch protection." BackHref="@RepoUrls.Branches(Repo)" />
}
else if (Repo != null)
{
    <RepoHeader Repo="Repo" Active="settings" />

    <div class="settings-layout">
        <RepoSettingsNav Repo="Repo" Active="branches" />
        <div class="gb-min0">

    <div class="bp-header">
        <div class="gb-min0">
            <MudText Typo="Typo.h6" HtmlTag="h2" Class="d-flex align-center gap-2 mb-1"><MudIcon Icon="@Icons.Material.Outlined.Lock" /> Branch protection rules</MudText>
            <MudText Class="mud-text-secondary" Typo="Typo.body2">
                Rules apply to branches whose name matches the pattern: an exact name such as <code>main</code>, or a glob such as
                <code>release/*</code> (<code>*</code> and <code>?</code> stay within one path segment, <code>**</code> matches across <code>/</code>).
                When several rules match a branch, the strictest setting of each wins. They are enforced on git push, branch creation and deletion, and pull request merges.
            </MudText>
        </div>
        @if (draft == null)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Add" Class="gb-nowrap" OnClick="StartAdd">Add rule</MudButton>
        }
    </div>

    @if (Error != null) { <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3">@Error</MudAlert> }

    @if (draft != null)
    {
        <MudPaper Outlined="true" Class="pa-5 mb-4">
            <MudText Typo="Typo.subtitle1" HtmlTag="h3" Class="gb-bold mb-3">@(draft.Id == 0 ? "New rule" : "Edit rule")</MudText>
            <MudGrid Spacing="3">
                <MudItem xs="12" md="6">
                    <MudTextField T="string" Label="Branch name pattern" Placeholder="main or release/*" @bind-Value="draft.Pattern" Immediate="true"
                                  Variant="Variant.Outlined" Margin="Margin.Dense" Class="gb-mono-input" />
                    <MudText Typo="Typo.caption" HtmlTag="div" Class="mud-text-secondary mt-1">
                        @if (!string.IsNullOrWhiteSpace(draft.Pattern))
                        {
                            var matching = branchNames.Where(b => BranchPatterns.Matches(draft.Pattern.Trim(), b)).ToList();
                            @if (matching.Count == 0) { <span>Matches no existing branch.</span> }
                            else { <span>Matches: <span class="mono">@string.Join(", ", matching.Take(8))</span>@(matching.Count > 8 ? $" and {matching.Count - 8} more" : "")</span> }
                        }
                    </MudText>
                </MudItem>
                <MudItem xs="12" sm="6" md="4">
                    <MudNumericField T="int" Label="Required approvals" @bind-Value="draft.RequiredApprovals" Min="0" Max="10" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudCheckBox T="bool" @bind-Value="draft.BlockDirectPushes" Color="Color.Primary" Dense="true">
                        <b>Block direct pushes</b> <span class="muted small">(changes only through pull requests; also blocks creating matching branches)</span>
                    </MudCheckBox>
                    <MudCheckBox T="bool" @bind-Value="draft.BlockForcePushes" Color="Color.Primary" Dense="true"><b>Block force pushes</b></MudCheckBox>
                    <MudCheckBox T="bool" @bind-Value="draft.BlockDeletion" Color="Color.Primary" Dense="true"><b>Block deletion</b></MudCheckBox>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudCheckBox T="bool" @bind-Value="draft.RequireChecksToPass" Color="Color.Primary" Dense="true">
                        <b>Require checks to pass</b> <span class="muted small">(pending or failed checks such as pipelines block merging)</span>
                    </MudCheckBox>
                    <MudCheckBox T="bool" @bind-Value="draft.DismissStaleApprovals" Color="Color.Primary" Dense="true"><b>Dismiss approvals when new commits are pushed</b></MudCheckBox>
                    <MudCheckBox T="bool" @bind-Value="draft.RequireThreadResolution" Color="Color.Primary" Dense="true">
                        <b>Require all threads resolved</b> <span class="muted small">(every inline comment thread must be resolved before merging)</span>
                    </MudCheckBox>
                    <MudCheckBox T="bool" @bind-Value="draft.RequireCodeOwnerApproval" Color="Color.Primary" Dense="true">
                        <b>Require code owner approval</b> <span class="muted small">(each changed file listed in CODEOWNERS needs an approval from one of its owners)</span>
                    </MudCheckBox>
                    <MudCheckBox T="bool" @bind-Value="draft.AllowAdminBypass" Color="Color.Primary" Dense="true">
                        <b>Allow admins to bypass</b> <span class="muted small">(site admins and project Owners)</span>
                    </MudCheckBox>
                </MudItem>
                <MudItem xs="12">
                    <span class="gb-section-label">Default reviewers <span class="muted small">(added to new pull requests that target a matching branch)</span></span>
                    <div class="d-flex flex-wrap gap-3">
                        @foreach (var u in candidates)
                        {
                            <MudCheckBox T="bool" @key="u.Id" Value="@draft.DefaultReviewerIds.Contains(u.Id)" ValueChanged="v => ToggleReviewer(u.Id, v)"
                                         Size="Size.Small" Dense="true" Color="Color.Primary" Label="@u.DisplayName" />
                        }
                    </div>
                </MudItem>
            </MudGrid>
            <div class="d-flex gap-2 mt-4">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" Disabled="@string.IsNullOrWhiteSpace(draft.Pattern)" OnClick="Save">@(draft.Id == 0 ? "Create rule" : "Save rule")</MudButton>
                <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="() => draft = null">Cancel</MudButton>
            </div>
        </MudPaper>
    }

    <div class="gb-rows">
        @if (rules.Count == 0)
        {
            <div class="empty">No branches are protected yet. Add a rule for <span class="mono">@Repo.DefaultBranch</span> to require pull requests and reviews.</div>
        }
        @foreach (var r in rules)
        {
            var matching = branchNames.Where(b => BranchPatterns.Matches(r.Pattern, b)).ToList();
            <div class="gb-row bp-row" @key="r.Id">
                <MudIcon Icon="@Icons.Material.Outlined.Lock" Size="Size.Small" Class="muted" />
                <div class="gb-row-main">
                    <div class="gb-row-title"><span class="mono">@r.Pattern</span></div>
                    <div class="gb-row-meta">
                        @string.Join(" · ", Summary(r))
                        <br /><span>@(matching.Count == 0 ? "Matches no existing branch" : "Matches " + string.Join(", ", matching.Take(6)) + (matching.Count > 6 ? $" and {matching.Count - 6} more" : ""))</span>
                    </div>
                </div>
                <div class="gb-row-right">
                    <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Outlined.Edit" OnClick="() => StartEdit(r)">Edit</MudButton>
                    <MudTooltip Text="Delete rule">
                        <MudIconButton Icon="@Icons.Material.Outlined.Delete" Color="Color.Error" Variant="Variant.Outlined" Size="Size.Small"
                                       aria-label="@($"Delete the rule for {r.Pattern}")" OnClick="() => Delete(r)" />
                    </MudTooltip>
                </div>
            </div>
        }
    </div>
        </div>
    </div>
}

@code {
    private ProjectPermissions perms = ProjectPermissions.None;
    private List<BranchProtectionRule> rules = [];
    private List<string> branchNames = [];
    private List<User> candidates = [];
    private BranchProtectionRule? draft;

    protected override async Task OnParametersSetAsync()
    {
        if (!await LoadRepoAsync()) return;
        perms = await Access.GetPermissionsAsync(Repo!.ProjectId);
        if (!perms.Can(Permission.ManageRepositories)) return;
        candidates = await Reviewers.CandidatesAsync(Repo.ProjectId);
        await Load();
    }

    private async Task Load()
    {
        rules = await Protection.ListAsync(Repo!.Id);
        var r = Repo;
        branchNames = (await Git(path => GitOps.ListBranches(path, r.DefaultBranch))).Select(b => b.Name).ToList();
    }

    private IEnumerable<string> Summary(BranchProtectionRule r)
    {
        if (r.RequiredApprovals > 0) yield return $"{r.RequiredApprovals} approval{(r.RequiredApprovals == 1 ? "" : "s")} required";
        if (r.BlockDirectPushes) yield return "pull requests only";
        if (r.BlockForcePushes) yield return "no force pushes";
        if (r.BlockDeletion) yield return "no deletion";
        if (r.RequireChecksToPass) yield return "checks must pass";
        if (r.DismissStaleApprovals) yield return "stale approvals dismissed";
        if (r.RequireThreadResolution) yield return "threads must be resolved";
        if (r.RequireCodeOwnerApproval) yield return "code owners must approve";
        if (r.AllowAdminBypass) yield return "admins can bypass";
        if (r.DefaultReviewerIds.Count > 0)
            yield return "default reviewers: " + string.Join(", ", candidates.Where(u => r.DefaultReviewerIds.Contains(u.Id)).Select(u => u.DisplayName));
    }

    private void StartAdd()
    {
        Error = null;
        draft = new BranchProtectionRule { Pattern = rules.Any(x => x.Pattern == Repo!.DefaultBranch) ? "" : Repo!.DefaultBranch };
    }

    private void StartEdit(BranchProtectionRule r)
    {
        Error = null;
        draft = new BranchProtectionRule
        {
            Id = r.Id, Pattern = r.Pattern, RequiredApprovals = r.RequiredApprovals, BlockDirectPushes = r.BlockDirectPushes,
            BlockForcePushes = r.BlockForcePushes, BlockDeletion = r.BlockDeletion, RequireChecksToPass = r.RequireChecksToPass,
            DismissStaleApprovals = r.DismissStaleApprovals, AllowAdminBypass = r.AllowAdminBypass, DefaultReviewerIds = [.. r.DefaultReviewerIds],
            RequireThreadResolution = r.RequireThreadResolution, RequireCodeOwnerApproval = r.RequireCodeOwnerApproval,
        };
    }

    private void ToggleReviewer(int id, bool on)
    {
        draft!.DefaultReviewerIds.Remove(id);
        if (on) draft.DefaultReviewerIds.Add(id);
    }

    private async Task Save()
    {
        Error = null;
        try
        {
            var saved = await Protection.SaveAsync(Repo!.Id, draft!, Me.Id);
            Snackbar.Add($"Saved the rule for '{saved.Pattern}'.", Severity.Success);
            draft = null;
            await Load();
        }
        catch (InvalidOperationException ex) { Error = ex.Message; }
    }

    private async Task Delete(BranchProtectionRule r)
    {
        Error = null;
        if (!await Dialogs.ConfirmAsync("Delete protection rule", $"Delete the protection rule for '{r.Pattern}'?")) return;
        try
        {
            await Protection.DeleteAsync(Repo!.Id, r.Id, Me.Id);
            Snackbar.Add($"Deleted the rule for '{r.Pattern}'.", Severity.Success);
            await Load();
        }
        catch (InvalidOperationException ex) { Error = ex.Message; }
    }
}
