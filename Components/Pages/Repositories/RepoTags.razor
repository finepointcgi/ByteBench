@page "/p/{Key}/repos/{Slug}/tags"
@using ByteBench.Services.Releases
@inherits RepoPageBase
@inject ReleaseService Releases
@inject ProjectAccess Access
@inject IDialogService Dialogs
@inject ISnackbar Snackbar

<PageTitle>Tags · @Repo?.Name</PageTitle>

@if (NotFound)
{
    <ProjectNotFound Message="This repository does not exist." />
}
else if (Repo != null)
{
    <RepoHeader Repo="Repo" Active="tags" />

    <div class="repo-toolbar">
        @if (perms.Can(Permission.PushCode) && !Repo.IsArchived && branches.Count > 0)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Outlined.LocalOffer" OnClick="ToggleCreate">New tag</MudButton>
        }
        <MudButton Href="@ReleaseUrls.List(Repo)" Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Outlined.NewReleases">Releases</MudButton>
        <span class="toolbar-note muted small">@(tags?.Count ?? 0) tag@(tags?.Count == 1 ? "" : "s")</span>
    </div>
    @if (creating)
    {
        <MudPaper Outlined="true" Class="pa-4 mb-3">
            <MudGrid Spacing="2">
                <MudItem xs="12" md="4">
                    <MudTextField T="string" Label="Tag name" Placeholder="v1.2.0" @bind-Value="newName" Immediate="true" MaxLength="250"
                                  Variant="Variant.Outlined" Margin="Margin.Dense" ShrinkLabel="true" Class="gb-mono-input" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudAutocomplete T="string" Label="From branch or commit" @bind-Value="fromRef" SearchFunc="SearchBranches" CoerceValue="true"
                                     DebounceInterval="100" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" ShrinkLabel="true"
                                     Class="gb-mono-input" MaxItems="null" />
                </MudItem>
                <MudItem xs="12" md="4" Class="d-flex align-end">
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">With a message it's an annotated tag (tagger and date are recorded); without, a lightweight tag.</MudText>
                </MudItem>
                <MudItem xs="12">
                    <MudTextField T="string" Label="Message (optional)" Placeholder="Release 1.2.0" @bind-Value="newMessage" Lines="2"
                                  Variant="Variant.Outlined" Margin="Margin.Dense" ShrinkLabel="true" />
                </MudItem>
            </MudGrid>
            <div class="mt-3 d-flex gap-2">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" OnClick="Create"
                           Disabled="@(busy || string.IsNullOrWhiteSpace(newName) || string.IsNullOrWhiteSpace(fromRef))">Create tag</MudButton>
                <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="() => creating = false">Cancel</MudButton>
            </div>
        </MudPaper>
    }
    @if (Error != null) { <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3">@Error</MudAlert> }

    @if (tags == null)
    {
        <MudText Class="mud-text-secondary">Loading…</MudText>
    }
    else if (tags.Count == 0)
    {
        <div class="empty">No tags yet. Create one above, or push one: <code>git tag -a v1.0 -m "v1.0" &amp;&amp; git push origin v1.0</code></div>
    }
    else
    {
        <div class="gb-rows">
            @foreach (var t in tags)
            {
                var release = releases.GetValueOrDefault(t.Name);
                <div class="tag-row" @key="t.Name">
                    <div class="gb-row-main">
                        <div class="gb-row-title tag-title">
                            <MudIcon Icon="@Icons.Material.Outlined.LocalOffer" Size="Size.Small" Class="mud-text-secondary" aria-hidden="true" />
                            <a class="mono" href="@RepoUrls.Source(Repo, t.Name)">@t.Name</a>
                            @if (t.IsAnnotated) { <span class="tag-kind" title="Annotated tag">annotated</span> }
                            @if (release != null)
                            {
                                <a class="tag-release @(release.IsDraft ? "draft" : release.IsPrerelease ? "pre" : "")" href="@ReleaseUrls.Detail(Repo, release.Id)">
                                    @(release.IsDraft ? "Draft release" : release.IsPrerelease ? "Pre-release" : "Release")
                                </a>
                            }
                        </div>
                        <div class="gb-row-meta tag-meta">
                            @if (t.Commit is { } c)
                            {
                                <a class="sha-pill mono" href="@RepoUrls.Commit(Repo, c.Sha)">@c.ShortSha</a>
                                <span>@c.MessageShort</span>
                            }
                            @if (t.IsAnnotated)
                            {
                                <span> · tagged by <b>@t.TaggerName</b> @(t.TaggedAt is { } at ? Display.Ago(at.UtcDateTime) : "")</span>
                            }
                            else if (t.Commit is { } c2)
                            {
                                <span> · @Display.Ago(c2.When.UtcDateTime)</span>
                            }
                        </div>
                        @if (!string.IsNullOrWhiteSpace(t.Message))
                        {
                            <div class="tag-message">@t.Message</div>
                        }
                    </div>
                    <div class="tag-actions">
                        <MudButton Href="@ReleaseUrls.Archive(Repo, t.Name, ArchiveFormat.Zip)" download="" Variant="Variant.Outlined" Size="Size.Small"
                                   StartIcon="@Icons.Material.Outlined.FileDownload">zip</MudButton>
                        <MudButton Href="@ReleaseUrls.Archive(Repo, t.Name, ArchiveFormat.TarGz)" download="" Variant="Variant.Outlined" Size="Size.Small"
                                   StartIcon="@Icons.Material.Outlined.FileDownload">tar.gz</MudButton>
                        @if (release == null && perms.Can(Permission.PushCode) && !Repo.IsArchived)
                        {
                            <MudButton Href="@ReleaseUrls.New(Repo, t.Name)" Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small">Create release</MudButton>
                        }
                        @if (perms.Can(Permission.DeleteBranch) && !Repo.IsArchived)
                        {
                            <MudTooltip Text="@(release != null ? "Used by a release: delete the release first" : "Delete tag")">
                                <MudIconButton Icon="@Icons.Material.Outlined.Delete" Color="Color.Error" Size="Size.Small" Variant="Variant.Outlined"
                                               Disabled="@(release != null)" aria-label="@($"Delete tag {t.Name}")" OnClick="() => Delete(t.Name)" />
                            </MudTooltip>
                        }
                    </div>
                </div>
            }
        </div>
    }
}

@code {
    private List<TagInfo>? tags;
    private List<BranchInfo> branches = [];
    private Dictionary<string, Release> releases = [];
    private ProjectPermissions perms = ProjectPermissions.None;
    private string? newName, fromRef, newMessage;
    private bool creating, busy;

    protected override async Task OnParametersSetAsync()
    {
        if (!await LoadRepoAsync()) return;
        perms = await Access.GetPermissionsAsync(Repo!.ProjectId);
        await Load();
    }

    private async Task Load()
    {
        tags = await Releases.ListTagsAsync(Repo!);
        branches = await Git(path => GitOps.Exists(path) ? GitOps.ListBranches(path, Repo!.DefaultBranch) : []);
        releases = (await Releases.ListAsync(Repo!)).ToDictionary(r => r.TagName);
        fromRef ??= Repo!.DefaultBranch;
    }

    /// <summary>Branch suggestions for the "from" field; any other text (a commit SHA) is kept as typed.</summary>
    private Task<IEnumerable<string>> SearchBranches(string? text, CancellationToken _) =>
        Task.FromResult(branches.Select(b => b.Name)
            .Where(n => string.IsNullOrWhiteSpace(text) || branches.Any(b => b.Name == text) || n.Contains(text, StringComparison.OrdinalIgnoreCase)));

    private void ToggleCreate() => creating = !creating;

    private async Task Create()
    {
        Error = null;
        busy = true;
        try
        {
            var t = await Releases.CreateTagAsync(Repo!, newName!.Trim(), fromRef!.Trim(), newMessage);
            Snackbar.Add($"Created {(t.IsAnnotated ? "annotated" : "lightweight")} tag '{t.Name}' at {t.Commit?.ShortSha}.", Severity.Success);
            newName = newMessage = null;
            creating = false;
            await Load();
        }
        catch (InvalidOperationException ex) { Error = ex.Message; }
        finally { busy = false; }
    }

    private async Task Delete(string name)
    {
        Error = null;
        if (!await Dialogs.ConfirmAsync("Delete tag", $"Delete tag '{name}'? Clones that already fetched it keep their copy.")) return;
        try
        {
            await Releases.DeleteTagAsync(Repo!, name);
            Snackbar.Add($"Deleted tag '{name}'.", Severity.Success);
            await Load();
        }
        catch (InvalidOperationException ex) { Error = ex.Message; }
    }
}
