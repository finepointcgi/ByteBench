@page "/p/{Key}/repos/{Slug}/pull-requests/{Number:int}"
@inject PullRequestService PRs
@inject RepositoryService Repos
@inject CurrentUser Me
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject IDialogService Dialogs
@inject NotificationService Notifications
@inject LiveEvents Live
@implements IDisposable
@inject ProjectAccess Access
@inject MergeGate MergeGateSvc
@inject GitBench.Services.Ai.AiReviewService AiReviews
@inject RepositorySettingsService RepoSettings
@inject CodeOwnersService CodeOwners
@inject GitBench.Services.MergeQueue.MergeQueueService MergeQueues

<PageTitle>@(pr != null ? $"{pr.Repository.Slug}#{pr.Number} {pr.Title}" : "Pull request")</PageTitle>

@if (notFound)
{
    <ProjectNotFound Message="This pull request does not exist." />
}
else if (pr != null)
{
    var repo = pr.Repository;
    <MudBreadcrumbs Items="@Crumbs" Class="px-0 pt-0 pb-2" />

    <div class="pr-header">
        @if (editingTitle)
        {
            <div class="pr-title-edit">
                <MudTextField T="string" @bind-Value="titleDraft" MaxLength="200" Variant="Variant.Outlined" Margin="Margin.Dense" AutoFocus="true"
                              aria-label="Pull request title" Class="flex-grow-1" />
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveTitle">Save</MudButton>
                <MudButton Variant="Variant.Outlined" OnClick="() => editingTitle = false">Cancel</MudButton>
            </div>
        }
        else
        {
            <MudText Typo="Typo.h5" HtmlTag="h1" Class="pr-title">@pr.Title <span class="muted mono">@repo.Slug#@pr.Number</span></MudText>
            <div class="d-flex gap-2 align-center">
                <WatchButton Watching="watching" Count="watcherCount" OnToggle="ToggleWatch" PullRequestId="pr.Id" />
                @if (pr.State == PullRequestState.Open && (pr.IsCrossFork ? pr.SourceRepository?.Project : repo.Project) != null)
                {
                    <MudButton Href="@RepoUrls.Editor(pr.IsCrossFork ? pr.SourceRepository! : repo, pr.SourceBranch)" Variant="Variant.Outlined" Size="Size.Small"
                               StartIcon="@Icons.Material.Outlined.Code" title="Edit the source branch in the web editor">Open in editor</MudButton>
                }
                @if (CanEditPr && pr.State == PullRequestState.Open)
                {
                    <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Outlined.Edit"
                               OnClick="() => { titleDraft = pr.Title; editingTitle = true; }">Edit title</MudButton>
                }
            </div>
        }
    </div>
    <div class="pr-subhead">
        <PrStateBadge State="pr.State" Draft="pr.IsDraft" />
        <span class="muted">
            <UserLink User="pr.Author" />@(pr.State == PullRequestState.Merged ? "" : " ")
            @if (pr.State == PullRequestState.Merged)
            {
                <span>'s changes were merged by <UserLink User="pr.MergedBy" /> @Display.Ago(pr.ClosedAt ?? pr.UpdatedAt) ·</span>
            }
            else
            {
                <span> @(pr.State == PullRequestState.Open ? "wants to merge" : "proposed merging") @(changes?.Commits.Count ?? 0) commit@((changes?.Commits.Count ?? 0) == 1 ? "" : "s") ·</span>
            }
        </span>
        <span class="pr-branches">
            @if (!pr.IsCrossFork)
            {
                <a class="branch-pill" href="@RepoUrls.Source(repo, pr.SourceBranch)">@pr.SourceBranch</a>
            }
            else if (pr.SourceRepository?.Project != null)
            {
                <a class="branch-pill" href="@RepoUrls.Source(pr.SourceRepository, pr.SourceBranch)" title="A branch of the fork @pr.SourceRepository.Project.Key/@pr.SourceRepository.Slug">
                    <MudIcon Icon="@Icons.Material.Outlined.CallSplit" Style="font-size: 13px; vertical-align: -2px" /> @pr.SourceLabel
                </a>
            }
            else
            {
                <span class="branch-pill" title="The fork was deleted; the pull request keeps its commits">@pr.SourceLabel</span>
            }
            <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Style="font-size: 14px" Class="muted" />
            <a class="branch-pill" href="@RepoUrls.Source(repo, pr.TargetBranch)">@pr.TargetBranch</a>
        </span>
        <PipelineBadge Repo="repo" Branch="@pr.SourceRef" Sha="@(pr.State == PullRequestState.Open ? null : pr.SourceCommitSha)" />
        @if (threads.Unresolved > 0)
        {
            <a href="@TabUrl("files")" class="pr-threads-link" title="Inline comment threads that aren't resolved yet">
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning" Icon="@Icons.Material.Outlined.Forum" Class="ma-0">
                    @threads.Unresolved unresolved thread@(threads.Unresolved == 1 ? "" : "s")
                </MudChip>
            </a>
        }
        else if (pr.Comments.Any(c => c.IsThreadRoot))
        {
            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Success" Icon="@Icons.Material.Outlined.Forum" Class="ma-0">All threads resolved</MudChip>
        }
    </div>

    <nav class="gb-tabs" aria-label="Pull request">
        <TabLink Active="@(CurrentTab == "overview")" Href="@TabUrl(null)" Icon="@Icons.Material.Outlined.Forum">Overview</TabLink>
        <TabLink Active="@(CurrentTab == "commits")" Href="@TabUrl("commits")" Icon="@Icons.Material.Outlined.Commit" Count="@(changes?.Commits.Count ?? 0)">Commits</TabLink>
        <TabLink Active="@(CurrentTab == "files")" Href="@TabUrl("files")" Icon="@Icons.Material.Outlined.Difference" Count="@(changes?.Files.Count ?? 0)">Files changed</TabLink>
        <TabLink Active="@(CurrentTab == "security")" Href="@TabUrl("security")" Icon="@Icons.Material.Outlined.Shield">Security</TabLink>
    </nav>

    @if (actionError != null)
    {
        <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3">@actionError</MudAlert>
    }

    <div class="gb-detail-grid">
        <div class="gb-min0">
            @if (CurrentTab == "commits")
            {
                @if (changes == null) { <div class="empty">The commits for this pull request are no longer available.</div> }
                else { <CommitList Commits="changes.Commits" Repo="repo" Users="usersByEmail" /> }
            }
            else if (CurrentTab == "security")
            {
                <GitBench.Components.Security.PrSecurityPanel PullRequest="pr" />
            }
            else if (CurrentTab == "files")
            {
                @if (changes == null) { <div class="empty">The changes for this pull request are no longer available.</div> }
                else
                {
                    @if (owners.Warnings.Count > 0)
                    {
                        <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3">
                            <b>CODEOWNERS</b> (<span class="mono">@owners.FilePath</span>):
                            @foreach (var w in owners.Warnings) { <div class="small">@w</div> }
                        </MudAlert>
                    }
                    <DiffView Files="changes.Files" Comments="pr.Comments" CanComment="@canComment" OnComment="AddInlineComment"
                              Repo="repo" ViewRef="@changes.HeadSha" Outdated="threads.Outdated"
                              CanResolve="@(root => PullRequestService.CanResolve(pr, root, Me.Id, perms))" OnResolve="ResolveThread" OnDismiss="DismissFinding"
                              CanApplySuggestions="canApply" OnApplySuggestions="ApplySuggestions" FileOwners="owners.Owners" />
                }
            }
            else
            {
                <!-- Description -->
                <div class="pr-card">
                    <div class="pr-card-head">
                        <Avatar User="pr.Author" Size="22" Link /> <UserLink User="pr.Author" />
                        <span class="muted small">opened @Display.Ago(pr.CreatedAt)</span>
                        @if (CanEditPr && !editingDesc)
                        {
                            <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Primary" Class="ml-auto"
                                       OnClick="() => { descDraft = pr.Description; editingDesc = true; }">Edit</MudButton>
                        }
                    </div>
                    <div class="pr-card-body">
                        @if (editingDesc)
                        {
                            <MarkdownEditor @bind-Value="descDraft" Rows="8" ProjectId="pr.Repository.ProjectId" />
                            <div class="mt-2 d-flex gap-2">
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" OnClick="SaveDesc">Save</MudButton>
                                <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="() => editingDesc = false">Cancel</MudButton>
                            </div>
                        }
                        else if (string.IsNullOrWhiteSpace(pr.Description))
                        {
                            <span class="muted"><i>No description provided.</i></span>
                        }
                        else
                        {
                            <div class="markdown">@Display.Markdown(pr.Description)</div>
                        }
                    </div>
                </div>

                <MudText Typo="Typo.subtitle1" HtmlTag="h2" Class="gb-bold mt-6 mb-2">Activity</MudText>
                <div class="timeline">
                    @foreach (var entry in Timeline)
                    {
                        if (entry is PullRequestComment c)
                        {
                            <div class="pr-card" @key="(1, c.Id)">
                                <div class="pr-card-head">
                                    <Avatar User="c.Author" Size="22" Link /> <UserLink User="c.Author" /> <AiBadge User="c.Author" />
                                    <span class="muted small">
                                        @if (c.IsInline)
                                        {
                                            <span>@(c.ParentId != null ? "replied on" : "commented on") <a href="@TabUrl("files")" class="mono">@c.FilePath:@(c.Line ?? c.OldLine)</a>&nbsp;</span>
                                        }
                                        else { <span>commented&nbsp;</span> }
                                        @Display.Ago(c.CreatedAt)@(c.EditedAt != null ? " · edited" : "")
                                    </span>
                                    @if (c.IsThreadRoot && c.IsResolved) { <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Success" Class="ma-0">Resolved</MudChip> }
                                    @if (c.IsThreadRoot && threads.Outdated.Contains(c.Id)) { <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Warning" Class="ma-0">Outdated</MudChip> }
                                    @if (c.AuthorId == Me.Id && canComment && editingCommentId != c.Id)
                                    {
                                        <span class="ml-auto d-flex">
                                            <MudTooltip Text="Edit comment">
                                                <MudIconButton Icon="@Icons.Material.Outlined.Edit" Size="Size.Small" aria-label="Edit comment"
                                                               OnClick="() => { editingCommentId = c.Id; commentEditDraft = c.Body; }" />
                                            </MudTooltip>
                                            <MudTooltip Text="Delete comment">
                                                <MudIconButton Icon="@Icons.Material.Outlined.Delete" Size="Size.Small" Color="Color.Error" aria-label="Delete comment"
                                                               OnClick="() => DeleteComment(c)" />
                                            </MudTooltip>
                                        </span>
                                    }
                                </div>
                                <div class="pr-card-body">
                                    @if (editingCommentId == c.Id)
                                    {
                                        <MarkdownEditor @bind-Value="commentEditDraft" Rows="4" ProjectId="pr.Repository.ProjectId" />
                                        <div class="mt-2 d-flex gap-2">
                                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" OnClick="() => SaveCommentEdit(c)">Save</MudButton>
                                            <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="() => editingCommentId = null">Cancel</MudButton>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="markdown">@Display.Markdown(c.Body)</div>
                                    }
                                </div>
                            </div>
                        }
                        else if (entry is PullRequestActivity a)
                        {
                            <div class="pr-activity" @key="(2, a.Id)">
                                <Avatar User="a.Actor" Size="18" Link />
                                <UserLink User="a.Actor" /> <AiBadge User="a.Actor" /> <span class="md-inline">@Display.Markdown(a.Text)</span>
                                <span class="muted">@Display.Ago(a.CreatedAt)</span>
                            </div>
                        }
                    }
                </div>

                @if (canComment)
                {
                <div class="pr-card mt-3">
                    <div class="pr-card-head"><Avatar User="Me.User" Size="22" /> <b>Add a comment</b></div>
                    <div class="pr-card-body">
                        <MarkdownEditor @ref="commentEditor" @bind-Value="newComment" Rows="4" Placeholder="Leave a comment…" ProjectId="pr.Repository.ProjectId" />
                        <div class="mt-2">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" Disabled="@string.IsNullOrWhiteSpace(newComment)" OnClick="AddComment">Comment</MudButton>
                        </div>
                    </div>
                </div>
                }
            }
        </div>

        <!-- Sidebar -->
        <MudPaper Outlined="true" Class="gb-side" aria-label="Pull request details">
            <div class="gb-side-field">
                <span class="gb-section-label">Merge</span>
                @if (pr.State == PullRequestState.Open)
                {
                    @if (pr.IsDraft)
                    {
                        <MudAlert Severity="Severity.Info" Dense="true" Variant="Variant.Outlined" Class="merge-status mb-2" Icon="@Icons.Material.Outlined.EditNote">
                            This is a draft. It can't be merged, and reviewers aren't notified until it's ready for review.
                        </MudAlert>
                        @if (CanEditPr)
                        {
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Size="Size.Small" Class="mb-3" Disabled="@busy"
                                       StartIcon="@Icons.Material.Outlined.RateReview" OnClick="() => SetDraft(false)">Ready for review</MudButton>
                        }
                    }
                    <MudAlert Severity="@MergeSeverity" Dense="true" Variant="Variant.Outlined" Class="merge-status">@MergeText</MudAlert>
                    @if (mergeStatus?.Check == MergeCheck.Conflicts && mergeStatus.ConflictPaths.Count > 0)
                    {
                        <ul class="conflict-list mono">
                            @foreach (var p in mergeStatus.ConflictPaths) { <li>@p</li> }
                        </ul>
                    }
                    <MergeChecksList Gate="gate" Target="@pr.TargetBranch" />
                    @if (queue.Config != null)
                    {
                        <MergeQueueBox Pr="pr" Status="queue" Perms="perms" CanQueue="CanMerge" OnChanged="() => Reload(full: false)" />
                    }
                    @if (queue.AppliesToActor)
                    {
                        @* The merge queue replaces the merge button. *@
                    }
                    else if (perms.Can(Permission.MergePullRequest))
                    {
                    <MudSelect T="string" @bind-Value="strategy" Disabled="@(!CanMerge)" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true"
                               OuterClass="mt-3" aria-label="Merge strategy">
                        @foreach (var s in MergeStrategySettings.AllowedList(repo))
                        {
                            <MudSelectItem T="string" Value="@s.ToString().ToLowerInvariant()">@MergeStrategySettings.Label(s)</MudSelectItem>
                            @if (s == MergeStrategy.Merge)
                            {
                                <MudSelectItem T="string" Value="@("ff")">Fast-forward if possible</MudSelectItem>
                            }
                        }
                    </MudSelect>
                    <MudText Typo="Typo.caption" HtmlTag="div" Class="mud-text-secondary mt-1">@MergeStrategySettings.Describe(SelectedStrategy)</MudText>
                    @if (SelectedStrategy == MergeStrategy.Squash && CanMerge)
                    {
                        <MudTextField T="string" @bind-Value="squashMessage" Label="Commit message" Lines="5" Variant="Variant.Outlined" Margin="Margin.Dense"
                                      Class="mt-2" HelperText="Co-authored-by trailers for the other commit authors are added automatically." />
                    }
                    <MudCheckBox T="bool" @bind-Value="deleteSource" Disabled="@(!CanMerge || pr.IsCrossFork || pr.SourceBranch == repo.DefaultBranch)" Size="Size.Small" Dense="true"
                                 Color="Color.Primary" Class="mt-1">
                        <span class="small">Delete <span class="mono">@pr.SourceBranch</span> after merging</span>
                    </MudCheckBox>
                    <MudButton Variant="Variant.Filled" Color="Color.Success" FullWidth="true" Class="mt-2" StartIcon="@Icons.Material.Filled.Merge"
                               Disabled="@(!CanMerge || busy)" OnClick="Merge">@(queue.Config != null ? "Merge directly (bypass the queue)" : gate is { Blocked: true, CanBypass: true } ? "Merge (bypass protection)" : "Merge")</MudButton>
                    }
                    else
                    {
                        <MudText Typo="Typo.caption" HtmlTag="div" Class="mud-text-secondary mt-2">Only Maintainers and Owners can merge.</MudText>
                    }
                    @if (CanEditPr)
                    {
                        <MudButton Variant="Variant.Outlined" Color="Color.Error" FullWidth="true" Size="Size.Small" Class="mt-2"
                                   Disabled="@busy" OnClick="Decline">Decline</MudButton>
                        @if (!pr.IsDraft)
                        {
                            <MudButton Variant="Variant.Text" FullWidth="true" Size="Size.Small" Class="mt-1" StartIcon="@Icons.Material.Outlined.EditNote"
                                       Disabled="@busy" OnClick="() => SetDraft(true)">Convert to draft</MudButton>
                        }
                    }
                }
                else if (pr.State == PullRequestState.Merged)
                {
                    <MudAlert Severity="Severity.Success" Dense="true" Variant="Variant.Outlined" Class="merge-status" Icon="@Icons.Material.Filled.Merge">
                        @(pr.MergeStrategy switch { MergeStrategy.Squash => "Squashed and merged", MergeStrategy.Rebase => "Rebased and merged", _ => "Merged" })
                        into <span class="mono">@pr.TargetBranch</span> by <UserLink User="pr.MergedBy" />
                        @if (pr.MergeCommitSha != null)
                        {
                            <div class="mt-1"><a class="sha-pill" href="@RepoUrls.Commit(repo, pr.MergeCommitSha)">@pr.MergeCommitSha[..7]</a></div>
                        }
                    </MudAlert>
                    @if (pr.MergeCommitSha != null)
                    {
                        <div class="mt-2">
                            <span class="gb-section-label">Deployments</span>
                            <GitBench.Components.Pipelines.DeployedToPanel PullRequest="pr" ShowEmpty="true" EmptyText="The merge commit isn't deployed yet." />
                        </div>
                    }
                }
                else
                {
                    <MudAlert Severity="Severity.Normal" Dense="true" Variant="Variant.Outlined" Class="merge-status" Icon="@Icons.Material.Outlined.Block">Declined @Display.Ago(pr.ClosedAt ?? pr.UpdatedAt).</MudAlert>
                    @if (CanEditPr)
                    {
                        <MudButton Variant="Variant.Outlined" FullWidth="true" Size="Size.Small" Class="mt-2" StartIcon="@Icons.Material.Outlined.Replay"
                                   Disabled="@busy" OnClick="Reopen">Reopen</MudButton>
                    }
                }
            </div>

            <div class="gb-side-field">
                <span class="gb-section-label">Reviewers</span>
                <PrReviewersPanel Pr="pr" HeadSha="@changes?.HeadSha" CanEdit="CanEditPr" OnChanged="() => Reload(full: false)" />
                @if (pr.State == PullRequestState.Open && pr.AuthorId != Me.Id && perms.Can(Permission.ReviewPullRequest))
                {
                    var mine = pr.Reviews.FirstOrDefault(r => r.UserId == Me.Id)?.State;
                    <div class="review-actions mt-2">
                        @if (mine == ReviewState.Approved)
                        {
                            <MudButton Variant="Variant.Outlined" Color="Color.Success" Size="Size.Small" OnClick="() => Review(null)">Unapprove</MudButton>
                        }
                        else
                        {
                            <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small" StartIcon="@Icons.Material.Filled.Check" OnClick="() => Review(ReviewState.Approved)">Approve</MudButton>
                        }
                        @if (mine == ReviewState.ChangesRequested)
                        {
                            <MudButton Variant="Variant.Outlined" Color="Color.Warning" Size="Size.Small" OnClick="() => Review(null)">Withdraw</MudButton>
                        }
                        else
                        {
                            <MudButton Variant="Variant.Outlined" Color="Color.Warning" Size="Size.Small" OnClick="() => Review(ReviewState.ChangesRequested)">Request changes</MudButton>
                        }
                    </div>
                }
                else if (pr.State == PullRequestState.Open && pr.AuthorId == Me.Id)
                {
                    <MudText Typo="Typo.caption" HtmlTag="div" Class="mud-text-secondary mt-1">You can't review your own pull request.</MudText>
                }
            </div>

            @if (owners.FilePath != null)
            {
                <div class="gb-side-field">
                    <span class="gb-section-label">Code owners</span>
                    @if (!owners.Owners.Any())
                    {
                        <div class="mud-text-secondary small">No changed file has owners in <span class="mono">@owners.FilePath</span>.</div>
                    }
                    else
                    {
                        <div class="small">@string.Join(", ", owners.Owners.Values.SelectMany(o => o).DistinctBy(u => u.Id).Select(u => u.DisplayName))</div>
                        <div class="mud-text-secondary small">Own @owners.Owners.Count of the changed files (<a href="@TabUrl("files")">see files</a>).</div>
                    }
                    @if (owners.Warnings.Count > 0)
                    {
                        <div class="small mt-1 pr-owner-warning">
                            <MudIcon Icon="@Icons.Material.Outlined.WarningAmber" Size="Size.Small" Color="Color.Warning" />
                            @owners.Warnings.Count CODEOWNERS warning@(owners.Warnings.Count == 1 ? "" : "s"): @owners.Warnings[0]
                        </div>
                    }
                </div>
            }

            <AiReviewPanel PullRequest="pr" OnReviewFinished="() => Reload(full: false)" />

            <div class="gb-side-field">
                <span class="gb-section-label">Linked issues</span>
                @if (linked.Count == 0)
                {
                    <div class="muted small">None. Mention <code>@repo.Project.Key-123</code> in the title, branch or commits.</div>
                }
                @foreach (var i in linked)
                {
                    <a class="linked-issue" href="/p/@i.Project.Key/issues/@i.Number" @key="i.Id">
                        <span title="@i.Type">@i.Type.Icon()</span>
                        <span class="mono">@i.Key</span>
                        <span class="linked-title">@i.Title</span>
                        <StatusBadge Issue="i" />
                    </a>
                }
            </div>

            <div class="gb-side-field muted small">
                Created @pr.CreatedAt.ToLocalTime().ToString("g")<br />
                Updated @Display.Ago(pr.UpdatedAt)
                @if (changes != null)
                {
                    <br /><span>@changes.Ahead ahead, @changes.Behind behind @pr.TargetBranch</span>
                }
            </div>
        </MudPaper>
    </div>
}

@code {
    [Parameter] public string Key { get; set; } = "";
    [Parameter] public string Slug { get; set; } = "";
    [Parameter] public int Number { get; set; }
    [SupplyParameterFromQuery(Name = "tab")] public string? Tab { get; set; }

    private PullRequest? pr;
    private CompareResult? changes;
    private MergeStatus? mergeStatus;
    private List<Issue> linked = [];
    private Dictionary<string, User> usersByEmail = [];
    private bool notFound, busy, editingTitle, editingDesc, deleteSource;
    private string strategy = "merge";
    private string? squashMessage;
    private ThreadSummary threads = new(new HashSet<int>(), 0);
    private CodeOwnersReport owners = CodeOwnersReport.None;
    private bool canApply;
    private MergeStrategy SelectedStrategy => strategy == "ff" ? MergeStrategy.Merge : MergeStrategySettings.Parse(strategy) ?? MergeStrategy.Merge;
    private string titleDraft = "";
    private string? descDraft, newComment, commentEditDraft, actionError;
    private int? editingCommentId;
    private MarkdownEditor? commentEditor;
    private string? loadedFor;
    private ProjectPermissions perms = ProjectPermissions.None;
    // The author (with CreatePullRequest) or a Maintainer+ (MergePullRequest) may edit, decline and reopen.
    private bool CanEditPr => pr != null && ((pr.AuthorId == Me.Id && (perms.Can(Permission.CreatePullRequest) || pr.IsCrossFork)) || perms.Can(Permission.MergePullRequest));
    // A fork PR's author may comment on it with ViewProject alone (see PullRequestService.Forks.cs).
    private bool canComment;

    private string CurrentTab => Tab is "commits" or "files" or "security" ? Tab : "overview";
    private string TabUrl(string? tab) => RepoUrls.PullRequest(pr!) + (tab == null ? "" : "?tab=" + tab);
    private bool CanMerge => pr?.State == PullRequestState.Open && mergeStatus?.Check == MergeCheck.Clean && !pr.Repository.IsArchived
                             && (gate == null || !gate.Blocked || gate.CanBypass);
    private MergeGateResult? gate; // branch protection + IMergeCheck results (open PRs only)

    private Severity MergeSeverity => mergeStatus?.Check switch
    {
        MergeCheck.Clean => Severity.Success,
        MergeCheck.Conflicts or MergeCheck.MissingBranch => Severity.Error,
        _ => Severity.Normal,
    };

    private List<BreadcrumbItem> Crumbs =>
    [
        new(pr!.Repository.Project.Name, $"/p/{pr.Repository.Project.Key}/issues"),
        new(pr.Repository.Name, RepoUrls.Base(pr.Repository)),
        new("Pull requests", RepoUrls.RepoPullRequests(pr.Repository)),
        new($"#{pr.Number}", null, disabled: true),
    ];

    private string MergeText => pr?.Repository.IsArchived == true ? "This repository is archived (read-only), so pull requests can't be merged." : mergeStatus?.Check switch
    {
        MergeCheck.Clean => mergeStatus.CanFastForward ? "Ready to merge (can fast-forward)." : "Ready to merge. No conflicts.",
        MergeCheck.Conflicts => "This pull request has conflicts and can't be merged. Resolve them locally and push.",
        MergeCheck.UpToDate => "Nothing to merge: " + mergeStatus.Message,
        MergeCheck.MissingBranch => mergeStatus.Message ?? "",
        _ => "Checking…",
    };

    private IEnumerable<object> Timeline => pr!.Comments.Select(c => (when: c.CreatedAt, item: (object)c))
        .Concat(pr.Activities.Where(a => a.Text != "opened this pull request").Select(a => (when: a.CreatedAt, item: (object)a)))
        .OrderBy(x => x.when).Select(x => x.item);

    protected override async Task OnParametersSetAsync()
    {
        var id = $"{Key}/{Slug}/{Number}".ToLowerInvariant();
        if (id == loadedFor) return; // tab switches only change the query string
        loadedFor = id;
        if (usersByEmail.Count == 0) usersByEmail = await Repos.GetUsersByEmailAsync();
        await Reload(full: true);
    }

    private async Task Reload(bool full)
    {
        pr = await PRs.GetAsync(Key, Slug, Number);
        if (pr == null && full && await RepoSettings.RedirectUrlAsync(Nav.Uri, Key, Slug) is { } moved)
        {
            Nav.NavigateTo(moved, replace: true); // renamed repository
            return;
        }
        notFound = pr == null;
        if (pr == null) return;
        watching = await Notifications.IsWatchingPullRequestAsync(Me.Id, pr.Id);
        watcherCount = await Notifications.CountPullRequestWatchersAsync(pr.Id);
        perms = await Access.GetPermissionsAsync(pr.Repository.ProjectId);
        canComment = perms.Can(Permission.Comment) || (pr.IsCrossFork && pr.AuthorId == Me.Id);
        gate = pr.State == PullRequestState.Open ? await MergeGateSvc.EvaluateAsync(pr.Id, Me.Id) : null;
        queue = pr.State == PullRequestState.Open ? await MergeQueues.StatusAsync(pr.Id, Me.Id) : GitBench.Services.MergeQueue.MergeQueueStatus.None;
        if (full)
        {
            changes = await PRs.GetChangesAsync(pr);
            mergeStatus = pr.State == PullRequestState.Open ? await PRs.CheckMergeAsync(pr) : null;
            linked = await PRs.GetLinkedIssuesAsync(pr, changes?.Commits);
            owners = changes == null ? CodeOwnersReport.None
                : await CodeOwners.ForPullRequestAsync(pr, changes.Files.SelectMany(f => f.OldPath != null ? new[] { f.Path, f.OldPath } : [f.Path]));
            canApply = await PRs.CanApplySuggestionsAsync(pr, Me.Id);
            strategy = MergeStrategySettings.Default(pr.Repository).ToString().ToLowerInvariant();
            squashMessage = PullRequestService.DefaultSquashMessage(pr, changes?.Commits);
        }
        threads = await PRs.ThreadsAsync(pr, changes?.HeadSha);
    }

    // ----- Watching -----
    private bool watching;
    private int watcherCount;

    private async Task ToggleWatch()
    {
        await Notifications.SetPullRequestWatchAsync(Me.Id, pr!.Id, !watching);
        await Reload(full: false);
    }

    // ----- Live updates -----
    // Reload replaces `pr` (and, when the state changed, diff/merge status); drafts and editing flags are separate
    // fields, and DiffView keeps its own inline-comment drafts, so unsaved edits survive.
    private IDisposable? liveSubscription, pipelineSubscription, queueSubscription;
    private GitBench.Services.MergeQueue.MergeQueueStatus queue = GitBench.Services.MergeQueue.MergeQueueStatus.None;

    protected override void OnAfterRender(bool firstRender)
    {
        if (!firstRender) return;
        liveSubscription = Live.Subscribe<PullRequestChanged>(OnPullRequestChanged);
        pipelineSubscription = Live.Subscribe<PipelineChanged>(OnPipelineChanged);
        queueSubscription = Live.Subscribe<GitBench.Services.MergeQueue.MergeQueueChanged>(OnQueueChanged);
    }

    // The target's merge queue moved on (built, tested, merged, reordered): refresh this PR's place in it.
    private Task OnQueueChanged(GitBench.Services.MergeQueue.MergeQueueChanged e) =>
        pr == null || pr.RepositoryId != e.RepositoryId || pr.TargetBranch != e.TargetBranch || pr.State != PullRequestState.Open ? Task.CompletedTask : InvokeAsync(async () =>
        {
            queue = await MergeQueues.StatusAsync(pr.Id, Me.Id);
            StateHasChanged();
        });

    // A pipeline in this PR's repository changed: re-evaluate the merge gate (its pipeline check may have flipped).
    private Task OnPipelineChanged(PipelineChanged e) =>
        pr == null || pr.RepositoryId != e.RepositoryId || pr.State != PullRequestState.Open ? Task.CompletedTask : InvokeAsync(async () =>
        {
            gate = await MergeGateSvc.EvaluateAsync(pr.Id, Me.Id);
            if (queue.Active?.PipelineId == e.PipelineId) queue = await MergeQueues.StatusAsync(pr.Id, Me.Id);
            StateHasChanged();
        });

    private Task OnPullRequestChanged(PullRequestChanged e) => pr?.Id != e.PullRequestId ? Task.CompletedTask : InvokeAsync(async () =>
    {
        var state = pr?.State;
        var title = pr?.Title;
        await Reload(full: false);
        if (pr != null && (pr.State != state || pr.Title != title)) await Reload(full: true);
        StateHasChanged();
    });

    public void Dispose() { liveSubscription?.Dispose(); pipelineSubscription?.Dispose(); queueSubscription?.Dispose(); }

    private async Task Run(Func<Task> action, bool full)
    {
        busy = true;
        actionError = null;
        try
        {
            await action();
            await Reload(full);
        }
        catch (InvalidOperationException ex) { actionError = ex.Message; }
        finally { busy = false; }
    }

    private Task Merge() => Run(async () =>
    {
        var outcome = await PRs.MergeAsync(pr!.Id, Me.User!, new MergeRequest(SelectedStrategy, deleteSource, strategy == "ff",
            SelectedStrategy == MergeStrategy.Squash ? squashMessage : null));
        if (!outcome.Success)
        {
            actionError = outcome.Error;
            if (outcome.ConflictPaths.Count > 0) actionError += " Conflicting files: " + string.Join(", ", outcome.ConflictPaths);
        }
    }, full: true);

    private Task Decline() => Run(() => PRs.DeclineAsync(pr!.Id, Me.Id), full: true);
    private Task Reopen() => Run(() => PRs.ReopenAsync(pr!.Id, Me.Id), full: true);
    private Task Review(ReviewState? state) => Run(() => PRs.SetReviewAsync(pr!.Id, Me.Id, state), full: false);

    private Task SaveTitle() => Run(async () =>
    {
        await PRs.UpdateAsync(pr!.Id, Me.Id, titleDraft, pr.Description);
        editingTitle = false;
    }, full: true); // the title can add or remove linked issues

    private Task SaveDesc() => Run(async () =>
    {
        await PRs.UpdateAsync(pr!.Id, Me.Id, pr.Title, descDraft);
        editingDesc = false;
    }, full: false);

    private async Task AddComment()
    {
        if (string.IsNullOrWhiteSpace(newComment)) return;
        await Run(() => PRs.AddCommentAsync(pr!.Id, Me.Id, newComment), full: false);
        newComment = null;
        commentEditor?.ShowWrite();
    }

    private Task AddInlineComment(DiffView.InlineCommentRequest req) =>
        Run(() => PRs.AddCommentAsync(pr!.Id, Me.Id, req.Body, req.Path, req.Line, req.OldLine, req.ParentId), full: false);

    private Task ResolveThread((int CommentId, bool Resolved) req) =>
        Run(() => PRs.SetThreadResolvedAsync(req.CommentId, Me.Id, req.Resolved), full: false);

    private Task DismissFinding(int commentId) =>
        Run(() => AiReviews.DismissFindingAsync(commentId, Me.Id), full: false);

    private Task SetDraft(bool draft) => Run(() => PRs.SetDraftAsync(pr!.Id, Me.Id, draft), full: false);

    private Task ApplySuggestions(IReadOnlyList<int> ids) => Run(async () =>
    {
        var sha = await PRs.ApplySuggestionsAsync(pr!.Id, Me.User!, ids.ToList());
        Snackbar.Add($"Committed {(ids.Count == 1 ? "the suggestion" : ids.Count + " suggestions")} to {pr.SourceBranch} as {sha[..7]}.", Severity.Success);
    }, full: true);

    private async Task SaveCommentEdit(PullRequestComment c)
    {
        if (string.IsNullOrWhiteSpace(commentEditDraft)) return;
        await Run(() => PRs.EditCommentAsync(c.Id, Me.Id, commentEditDraft), full: false);
        editingCommentId = null;
    }

    private async Task DeleteComment(PullRequestComment c)
    {
        if (!await Dialogs.ConfirmAsync("Delete comment", "Delete this comment? This can't be undone.")) return;
        await Run(() => PRs.DeleteCommentAsync(c.Id, Me.Id), full: false);
    }
}
