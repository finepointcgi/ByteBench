@page "/p/{Key}/repos/{Slug}"
@inherits RepoPageBase
@inject ByteBench.Services.Releases.ReleaseService Releases
@inject ByteBench.Services.Lfs.LfsStorage Lfs

<PageTitle>@(string.IsNullOrEmpty(Path) ? Repo?.Name : $"{Path} · {Repo?.Name}")</PageTitle>

@if (NotFound)
{
    <ProjectNotFound Message="This repository does not exist." />
}
else if (Repo != null)
{
    <RepoHeader Repo="Repo" Active="source" Ref="@Ref">
        <CloneBox Repo="Repo" />
    </RepoHeader>

    <div class="repo-toolbar">
        <RefSelector Branches="branches" Tags="tags" Value="@CurrentRef" ValueChanged="SwitchRef" />
        <div class="repo-path mono">
            <a href="@RepoUrls.Source(Repo, Ref)">@Repo.Slug</a>
            @foreach (var (name, full) in Crumbs)
            {
                <span class="sep">/</span>
                @if (full == CleanPath) { <b>@name</b> }
                else { <a href="@RepoUrls.Source(Repo, Ref, full)">@name</a> }
            }
        </div>
        <div class="toolbar-actions">
            @if (latestRelease != null)
            {
                <MudTooltip Text="@($"Latest release: {latestRelease.Title}")">
                    <MudButton Href="@ByteBench.Services.Releases.ReleaseUrls.Detail(Repo, latestRelease.Id)" Variant="Variant.Text" Size="Size.Small"
                               StartIcon="@Icons.Material.Outlined.LocalOffer" Color="Color.Primary">
                        Latest&nbsp;<span class="mono">@latestRelease.TagName</span>
                    </MudButton>
                </MudTooltip>
            }
            <MudButton Href="@RepoUrls.Commits(Repo, Ref, CleanPath)" Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Outlined.History">History</MudButton>
            @if (blob is { IsBinary: false, TooLarge: false } && lfsPointer == null)
            {
                <MudButton Href="@ByteBench.Services.Code.CodeUrls.Blame(Repo, CurrentRef, blob.Path)" Variant="Variant.Outlined" Size="Size.Small"
                           StartIcon="@Icons.Material.Outlined.Person">Blame</MudButton>
            }
            @if (!IsTag && branches.Any(b => b.Name == CurrentRef))
            {
                <MudButton Href="@RepoUrls.Editor(Repo, CurrentRef, blob != null ? CleanPath : null)" Variant="Variant.Outlined" Size="Size.Small"
                           StartIcon="@Icons.Material.Outlined.Code">Open in editor</MudButton>
            }
            @if (!empty)
            {
                <MudButton Href="@($"/p/{Repo.Project.Key}/repos/{Repo.Slug}/workspace?ref={Uri.EscapeDataString(CurrentRef)}")" Variant="Variant.Outlined" Size="Size.Small"
                           StartIcon="@Icons.Material.Outlined.Terminal" data-testid="open-in-workspace">Open in workspace</MudButton>
            }
            @if (!IsTag && !Repo.IsArchived && branches.Any(b => b.Name == CurrentRef) && CurrentRef != Repo.DefaultBranch)
            {
                <MudButton Href="@RepoUrls.NewPullRequest(Repo.Project.Key, Repo.Slug, CurrentRef, Repo.DefaultBranch)" Variant="Variant.Outlined" Color="Color.Primary"
                           Size="Size.Small" StartIcon="@Icons.Material.Outlined.MergeType">Create pull request</MudButton>
            }
        </div>
    </div>

    @if (empty)
    {
        <div class="empty">This repository is empty. Push a branch to get started:<br />
            <code>git push @RepoUrls.CloneUrl(Nav.BaseUri, Repo) main</code></div>
    }
    else if (missing)
    {
        <div class="empty">
            <b>@(CleanPath ?? CurrentRef)</b> doesn't exist at <span class="mono">@CurrentRef</span>.
            <div class="mt-2"><a href="@RepoUrls.Source(Repo)">Back to @Repo.DefaultBranch</a></div>
        </div>
    }
    else
    {
        <div class="source-box">
            @if (lastCommit != null)
            {
                <div class="last-commit-bar">
                    <GitAvatar Name="@lastCommit.AuthorName" Email="@lastCommit.AuthorEmail" Users="UsersByEmail" Size="22" />
                    <b class="gb-nowrap">@lastCommit.AuthorName</b>
                    <a class="gb-truncate commit-msg" href="@RepoUrls.Commit(Repo, lastCommit.Sha)">@lastCommit.MessageShort</a>
                    <span class="last-commit-when muted small">
                        <a class="sha-pill" href="@RepoUrls.Commit(Repo, lastCommit.Sha)">@lastCommit.ShortSha</a>
                        @Display.Ago(lastCommit.When.UtcDateTime)
                    </span>
                </div>
            }

            @if (tree != null)
            {
                <div class="file-tree">
                    @if (!string.IsNullOrEmpty(CleanPath))
                    {
                        <a class="tree-row" href="@RepoUrls.Source(Repo, Ref, ParentPath)">
                            <MudIcon Icon="@Icons.Material.Filled.Folder" Size="Size.Small" Class="tree-icon tree-icon-dir" /><span class="tree-name">..</span>
                        </a>
                    }
                    @foreach (var e in tree)
                    {
                        <div class="tree-row" @key="e.Path">
                            <MudIcon Icon="@(e.IsDirectory ? Icons.Material.Filled.Folder : e.IsSubmodule ? Icons.Material.Outlined.Link : Icons.Material.Outlined.InsertDriveFile)"
                                     Size="Size.Small" Class="@(e.IsDirectory ? "tree-icon tree-icon-dir" : "tree-icon")" />
                            @if (e.IsSubmodule) { <span class="tree-name">@e.Name</span> }
                            else { <a class="tree-name" href="@RepoUrls.Source(Repo, Ref, e.Path)">@e.Name</a> }
                            @if (e.LastCommit is { } lc)
                            {
                                <a class="tree-commit" href="@RepoUrls.Commit(Repo, lc.Sha)" title="@lc.Message">@lc.MessageShort</a>
                                <span class="tree-when muted">@Display.Ago(lc.When.UtcDateTime)</span>
                            }
                            else
                            {
                                <span class="tree-commit"></span><span class="tree-when"></span>
                            }
                        </div>
                    }
                </div>
            }
            else if (blob != null)
            {
                <div class="file-view">
                    <div class="file-view-head">
                        <MudIcon Icon="@Icons.Material.Outlined.InsertDriveFile" Size="Size.Small" Class="tree-icon" />
                        <span class="mono gb-truncate"><b>@blob.Path.Split('/').Last()</b></span>
                        <span class="muted small gb-nowrap">
                            @if (blob.Text != null) { <span>@blob.Lines.Length lines · </span> }
                            @FormatSize(blob.Size)
                        </span>
                        @if (IsMarkdown && blob.Text != null)
                        {
                            <MudToggleGroup T="bool" @bind-Value="showSource" Size="Size.Small" Outlined="true" CheckMark="false" Class="file-mode">
                                <MudToggleItem T="bool" Value="false" Text="Preview" />
                                <MudToggleItem T="bool" Value="true" Text="Code" />
                            </MudToggleGroup>
                        }
                    </div>
                    @if (lfsPointer != null)
                    {
                        <div class="diff-note lfs-note">
                            <MudIcon Icon="@Icons.Material.Outlined.CloudQueue" Size="Size.Small" />
                            <span>Stored with Git LFS · @FormatSize(lfsPointer.Size)</span>
                            @if (lfsAvailable)
                            {
                                <MudButton Href="@LfsDownloadUrl" Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Outlined.Download"
                                           rel="nofollow">Download</MudButton>
                            }
                            else
                            {
                                <span class="muted small">(the object hasn't been uploaded to this repository)</span>
                            }
                        </div>
                    }
                    else if (blob.TooLarge)
                    {
                        <div class="diff-note">This file is too large to display (@FormatSize(blob.Size); limit 1 MB).</div>
                    }
                    else if (blob.IsBinary)
                    {
                        <div class="diff-note">Binary file not shown.</div>
                    }
                    else if (IsMarkdown && !showSource)
                    {
                        <div class="markdown readme-body">@Display.MarkdownUnderPageTitle(blob.Text)</div>
                    }
                    else
                    {
                        var lineBase = LineLinkBase;
                        <table class="code-table mono" data-linkable data-hl-lang="@CodeLanguages.ForFile(blob.Path, blob.Size)" @key="blob.Sha">
                            @{ var n = 0; }
                            @foreach (var line in blob.Lines)
                            {
                                n++;
                                <tr id="L@(n)"><td class="ln"><a class="ln-link" href="@(lineBase)#L@(n)" data-line="@n">@n</a></td><td class="code">@CodeLanguages.Line(line)</td></tr>
                            }
                        </table>
                    }
                </div>
            }
        </div>

        @if (tree != null && readme?.Text != null)
        {
            <div class="readme-card">
                <div class="readme-head"><MudIcon Icon="@Icons.Material.Outlined.MenuBook" Size="Size.Small" /> @readme.Path.Split('/').Last()</div>
                <div class="markdown readme-body">@Display.MarkdownUnderPageTitle(readme.Text)</div>
            </div>
        }
    }
}

@code {
    [SupplyParameterFromQuery(Name = "ref")] public string? Ref { get; set; }
    [SupplyParameterFromQuery(Name = "path")] public string? Path { get; set; }

    private List<BranchInfo> branches = [];
    private List<string> tags = [];
    private List<TreeItem>? tree;
    private BlobInfo? blob, readme;
    private ByteBench.Services.Lfs.LfsPointer? lfsPointer;
    private bool lfsAvailable;
    private CommitInfo? lastCommit;
    private bool empty, missing, showSource;
    private Release? latestRelease;
    private int? latestFor;

    private string CurrentRef => string.IsNullOrEmpty(Ref) ? Repo!.DefaultBranch : Ref;
    private string? CleanPath => string.IsNullOrEmpty(Path?.Trim('/')) ? null : Path.Trim('/');
    private string? ParentPath => CleanPath?.Contains('/') == true ? CleanPath[..CleanPath.LastIndexOf('/')] : null;
    private bool IsTag => tags.Contains(CurrentRef);
    private bool IsMarkdown => blob?.Path.EndsWith(".md", StringComparison.OrdinalIgnoreCase) == true;
    /// <summary>This page's URL without a fragment: line links must be absolute because of &lt;base href="/"&gt;.</summary>
    private string LineLinkBase
    {
        get
        {
            var rel = Nav.ToBaseRelativePath(Nav.Uri);
            var i = rel.IndexOf('#');
            return "/" + (i >= 0 ? rel[..i] : rel);
        }
    }

    private IEnumerable<(string Name, string Full)> Crumbs
    {
        get
        {
            if (CleanPath == null) yield break;
            var parts = CleanPath.Split('/');
            for (var i = 0; i < parts.Length; i++) yield return (parts[i], string.Join('/', parts[..(i + 1)]));
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!await LoadRepoAsync()) return;
        if (latestFor != Repo!.Id) { latestRelease = await Releases.GetLatestAsync(Repo); latestFor = Repo.Id; }
        var r = CurrentRef;
        var p = CleanPath;
        tree = null; blob = null; readme = null; lastCommit = null; missing = false; showSource = false; lfsPointer = null; lfsAvailable = false;

        (branches, tags, var kind, var log) = await Git(path => (
            GitOps.ListBranches(path, Repo!.DefaultBranch),
            GitOps.ListTags(path),
            GitOps.PathKind(path, r, p),
            GitOps.Log(path, r, p, 0, 1)));
        empty = branches.Count == 0;
        if (empty) return;
        lastCommit = log.Items.FirstOrDefault();

        if (kind == "tree")
        {
            (tree, readme) = await Git(path =>
            {
                var items = GitOps.ListTree(path, r, p);
                var readmeItem = items?.FirstOrDefault(i => !i.IsDirectory && i.Name.Equals("README.md", StringComparison.OrdinalIgnoreCase));
                return (items, readmeItem == null ? null : GitOps.GetBlob(path, r, readmeItem.Path));
            });
        }
        else if (kind == "blob")
        {
            blob = await Git(path => GitOps.GetBlob(path, r, p!));
            lfsPointer = ByteBench.Services.Lfs.LfsPointer.TryParse(blob?.Text);
            if (lfsPointer != null) lfsAvailable = await Lfs.RepositoryHasAsync(Repo.Id, lfsPointer.Oid);
        }
        missing = tree == null && blob == null;
    }

    private string LfsDownloadUrl => ByteBench.Services.Lfs.LfsEndpoints.ObjectPath(Repo!.Project.Key, Repo.Slug, lfsPointer!.Oid)
        + "?download=" + Uri.EscapeDataString(blob!.Path.Split('/').Last());

    private void SwitchRef(string newRef) => Nav.NavigateTo(RepoUrls.Source(Repo!, newRef, CleanPath));

    private static string FormatSize(long bytes) => bytes switch
    {
        < 1024 => $"{bytes} B",
        < 1024 * 1024 => $"{bytes / 1024.0:0.#} KB",
        _ => $"{bytes / (1024.0 * 1024):0.#} MB",
    };
}
