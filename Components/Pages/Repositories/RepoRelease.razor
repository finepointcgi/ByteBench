@page "/p/{Key}/repos/{Slug}/releases/{Id:int}"
@using ByteBench.Services.Releases
@using ByteBench.Services.Attachments
@using ByteBench.Components.Releases
@inherits RepoPageBase
@inject ReleaseService Releases
@inject ProjectAccess Access
@inject IDialogService Dialogs
@inject ISnackbar Snackbar

<PageTitle>@(release?.Title ?? "Release") · @Repo?.Name</PageTitle>

@if (NotFound || (Repo != null && loaded && release == null))
{
    <ProjectNotFound Message="This release does not exist." />
}
else if (Repo != null && release != null)
{
    <RepoHeader Repo="Repo" Active="releases" />

    <div class="rel-breadcrumbs mb-2 small"><a href="@ReleaseUrls.List(Repo)">Releases</a> / <span class="mono">@release.TagName</span></div>
    @if (Error != null) { <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3">@Error</MudAlert> }

    <ReleaseCard Repo="Repo" Release="release" IsLatest="isLatest" CanDeleteAssets="CanEdit" OnDeleteAsset="DeleteAsset">
        @if (CanEdit)
        {
            <span class="rel-actions">
                @if (release.IsDraft)
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Outlined.Publish" Disabled="@busy" OnClick="Publish">Publish</MudButton>
                }
                <MudButton Href="@ReleaseUrls.Edit(Repo, release.Id)" Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Outlined.Edit">Edit</MudButton>
                @if (perms.Can(Permission.DeleteBranch))
                {
                    <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small" StartIcon="@Icons.Material.Outlined.Delete" Disabled="@busy" OnClick="Delete">Delete</MudButton>
                }
            </span>
        }
    </ReleaseCard>

    <MudPaper Outlined="true" Class="pa-4 mt-3 mb-3">
        <MudText Typo="Typo.subtitle2" HtmlTag="h2" Class="mb-1">Deployed to</MudText>
        <ByteBench.Components.Pipelines.DeployedToPanel Repo="Repo" Tag="@release.TagName" ShowEmpty="true" EmptyText="This release's tag isn't deployed to any environment yet." />
    </MudPaper>

    @if (CanEdit)
    {
        <div class="rel-upload-wrap">
        <MudPaper Outlined="true" Class="rel-upload pa-4">
            <MudButton HtmlTag="label" Variant="Variant.Outlined" Size="Size.Small" Disabled="@busy"
                       StartIcon="@(busy ? null : Icons.Material.Filled.AttachFile)">
                @if (busy) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" Style="width:14px;height:14px" /> }
                @(busy ? "Uploading…" : "Upload assets")
                <InputFile OnChange="Upload" multiple class="rel-upload-input" disabled="@busy" />
            </MudButton>
            <MudText Typo="Typo.caption" Class="mud-text-secondary">Binaries, packages or checksums: up to @AttachmentFormat.Size(Releases.MaxAssetBytes) per file, @ReleaseService.MaxAssetsPerRelease per release.</MudText>
        </MudPaper>
        </div>
    }
}

@code {
    [Parameter] public int Id { get; set; }

    private Release? release;
    private bool loaded, isLatest, busy;
    private ProjectPermissions perms = ProjectPermissions.None;
    private bool CanEdit => perms.Can(Permission.PushCode) && Repo?.IsArchived == false;

    protected override async Task OnParametersSetAsync()
    {
        if (!await LoadRepoAsync()) return;
        perms = await Access.GetPermissionsAsync(Repo!.ProjectId);
        await Load();
    }

    private async Task Load()
    {
        release = await Releases.GetAsync(Repo!, Id);
        isLatest = release != null && (await Releases.GetLatestAsync(Repo!))?.Id == release.Id;
        loaded = true;
    }

    private async Task Publish()
    {
        Error = null;
        busy = true;
        try
        {
            await Releases.PublishAsync(Repo!, Id);
            Snackbar.Add("Release published.", Severity.Success);
            await Load();
        }
        catch (InvalidOperationException ex) { Error = ex.Message; }
        finally { busy = false; }
    }

    private async Task Delete()
    {
        Error = null;
        var deleteTag = false;
        var text = $"Delete the release '{release!.Title}' and its {release.Assets.Count} asset(s)? This can't be undone.";
        if (perms.Can(Permission.DeleteBranch))
        {
            // One dialog for both questions: delete the release with or without its tag, or cancel.
            var choice = await Dialogs.ShowMessageBoxAsync(
                new MessageBoxOptions
                {
                    Title = "Delete release", Message = text + $" You can also delete the tag '{release.TagName}'.",
                    YesText = "Delete release and tag", NoText = "Delete release only", CancelText = "Cancel",
                },
                new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true });
            if (choice == null) return;
            deleteTag = choice == true;
        }
        else if (!await Dialogs.ConfirmAsync("Delete release", text)) return;
        busy = true;
        try
        {
            await Releases.DeleteAsync(Repo!, Id, deleteTag);
            Nav.NavigateTo(ReleaseUrls.List(Repo!));
        }
        catch (InvalidOperationException ex) { Error = ex.Message; }
        finally { busy = false; }
    }

    private async Task Upload(InputFileChangeEventArgs e)
    {
        Error = null;
        busy = true;
        var done = new List<string>();
        try
        {
            foreach (var file in e.GetMultipleFiles(20))
            {
                if (file.Size > Releases.MaxAssetBytes) { Error = $"{file.Name} is larger than {AttachmentFormat.Size(Releases.MaxAssetBytes)}."; continue; }
                await using var stream = file.OpenReadStream(Releases.MaxAssetBytes);
                await Releases.UploadAssetAsync(Repo!, Id, file.Name, stream);
                done.Add(file.Name);
            }
        }
        catch (InvalidOperationException ex) { Error = ex.Message; }
        catch (IOException ex) { Error = "Upload failed: " + ex.Message; }
        finally
        {
            busy = false;
            if (done.Count > 0) Snackbar.Add($"Uploaded {string.Join(", ", done)}.", Severity.Success);
            await Load();
        }
    }

    private async Task DeleteAsset(ReleaseAsset a)
    {
        Error = null;
        if (!await Dialogs.ConfirmAsync("Delete asset", $"Delete the asset '{a.FileName}'?")) return;
        try
        {
            await Releases.DeleteAssetAsync(Repo!, a.Id);
            Snackbar.Add($"Deleted {a.FileName}.", Severity.Success);
            await Load();
        }
        catch (InvalidOperationException ex) { Error = ex.Message; }
    }
}
