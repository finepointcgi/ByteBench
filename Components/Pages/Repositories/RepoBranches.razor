@page "/p/{Key}/repos/{Slug}/branches"
@inherits RepoPageBase
@inject PullRequestService PRs
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject ProjectAccess Access
@inject BranchProtectionService Protection
@inject PipelineService Pipelines

<PageTitle>Branches · @Repo?.Name</PageTitle>

@if (NotFound)
{
    <ProjectNotFound Message="This repository does not exist." />
}
else if (Repo != null)
{
    <RepoHeader Repo="Repo" Active="branches" />

    <div class="repo-toolbar">
        @if (perms.Can(Permission.PushCode) && !Repo.IsArchived)
        {
            <MudTextField T="string" @bind-Value="newName" Immediate="true" Placeholder="new-branch-name" Variant="Variant.Outlined" Margin="Margin.Dense"
                          Class="branch-name-input gb-mono-input" aria-label="New branch name" />
            <span class="muted small">from</span>
            <MudSelect T="string" @bind-Value="fromRef" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" OuterClass="gb-ref-select gb-mono-input" aria-label="Create from branch">
                @foreach (var b in branches) { <MudSelectItem T="string" Value="@b.Name">@b.Name</MudSelectItem> }
            </MudSelect>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Add"
                       Disabled="@string.IsNullOrWhiteSpace(newName)" OnClick="Create">Create branch</MudButton>
        }
        <span class="toolbar-note muted small">Ahead/behind relative to <span class="mono">@Repo.DefaultBranch</span></span>
    </div>
    @if (Error != null) { <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3">@Error</MudAlert> }

    <div class="gb-rows">
        @foreach (var b in branches)
        {
            var pr = openPrs.FirstOrDefault(p => p.SourceBranch == b.Name);
            var max = Math.Max(1, branches.Max(x => Math.Max(x.Ahead, x.Behind)));
            <div class="branch-row" @key="b.Name">
                <div class="gb-row-main">
                    <div class="gb-row-title branch-title">
                        @if (ciStatus.GetValueOrDefault(b.Name) is { } ci)
                        {
                            <PipelineStatusIcon Status="ci.Status" Href="@PipelineUrls.Detail(Repo, ci.Id)" Title="@($"Pipeline #{ci.Id}")" />
                        }
                        <a class="mono" href="@RepoUrls.Source(Repo, b.Name)">@b.Name</a>
                        @if (b.IsDefault) { <span class="branch-tag">default</span> }
                        @if (protectionRules.Where(r => BranchPatterns.Matches(r.Pattern, b.Name)).Select(r => r.Pattern).ToList() is { Count: > 0 } by)
                        {
                            <span class="branch-tag" title="Protected by rule@(by.Count == 1 ? "" : "s") @string.Join(", ", by)"><MudIcon Icon="@Icons.Material.Outlined.Lock" Style="font-size: 13px" /> protected</span>
                        }
                        <IssueKeyLinks ProjectKey="@Repo.Project.Key" Text="@b.Name" />
                    </div>
                    @if (b.Tip is { } t)
                    {
                        <div class="gb-row-meta">
                            Updated @Display.Ago(t.When.UtcDateTime) by <b>@t.AuthorName</b> ·
                            <a href="@RepoUrls.Commit(Repo, t.Sha)">@t.MessageShort</a>
                        </div>
                    }
                </div>
                @if (!b.IsDefault)
                {
                    <div class="ahead-behind" title="@b.Behind behind, @b.Ahead ahead of @Repo.DefaultBranch">
                        <div class="ab-side behind"><span>@b.Behind</span><div class="ab-bar" style="width:@(b.Behind * 100 / max)%"></div></div>
                        <div class="ab-side ahead"><div class="ab-bar" style="width:@(b.Ahead * 100 / max)%"></div><span>@b.Ahead</span></div>
                    </div>
                }
                else
                {
                    <div class="ahead-behind ab-default muted small">default branch</div>
                }
                <div class="branch-actions">
                    @if (pr != null)
                    {
                        <a href="@RepoUrls.PullRequest(pr)" class="branch-pr"><PrStateBadge State="pr.State" Compact="true" /> #@pr.Number</a>
                    }
                    else if (!b.IsDefault && b.Ahead > 0 && perms.Can(Permission.CreatePullRequest) && !Repo.IsArchived)
                    {
                        <MudButton Href="@RepoUrls.NewPullRequest(Repo.Project.Key, Repo.Slug, b.Name, Repo.DefaultBranch)" Variant="Variant.Outlined" Size="Size.Small">Create PR</MudButton>
                    }
                    @if (!b.IsDefault && perms.Can(Permission.DeleteBranch) && !Repo.IsArchived)
                    {
                        <MudTooltip Text="Delete branch">
                            <MudIconButton Icon="@Icons.Material.Outlined.Delete" Color="Color.Error" Size="Size.Small" Variant="Variant.Outlined"
                                           aria-label="@($"Delete branch {b.Name}")" OnClick="() => Delete(b.Name)" />
                        </MudTooltip>
                    }
                </div>
            </div>
        }
    </div>
}

@code {
    private List<BranchDivergence> branches = [];
    private List<PullRequest> openPrs = [];
    private List<BranchProtectionRule> protectionRules = [];
    private Dictionary<string, PipelineBadgeInfo> ciStatus = [];
    private string? newName, fromRef;
    private ProjectPermissions perms = ProjectPermissions.None;

    protected override async Task OnParametersSetAsync()
    {
        if (!await LoadRepoAsync()) return;
        perms = await Access.GetPermissionsAsync(Repo!.ProjectId);
        await Load();
    }

    private async Task Load()
    {
        branches = await Git(path => GitOps.ListBranchesWithDivergence(path, Repo!.DefaultBranch));
        openPrs = await PRs.ListAsync(Repo!.ProjectId, PullRequestState.Open, Repo.Id);
        protectionRules = await Protection.ListAsync(Repo.Id);
        ciStatus = await Pipelines.LatestForBranchesAsync(Repo, branches.Where(b => b.Tip != null).Select(b => (b.Name, b.Tip!.Sha)));
        if (fromRef == null || branches.All(b => b.Name != fromRef)) fromRef = Repo.DefaultBranch;
    }

    private async Task Create()
    {
        Error = null;
        var name = newName!.Trim();
        var from = fromRef ?? Repo!.DefaultBranch;
        try
        {
            await Repos.CreateBranchAsync(Repo!, name, from);
            Snackbar.Add($"Created branch '{name}' from '{from}'.", Severity.Success);
            newName = null;
            await Load();
        }
        catch (InvalidOperationException ex) { Error = ex.Message; }
    }

    private async Task Delete(string name)
    {
        Error = null;
        if (!await Dialogs.ConfirmAsync("Delete branch", $"Delete branch '{name}'? Commits only on this branch become unreachable.")) return;
        try
        {
            await Repos.DeleteBranchAsync(Repo!, name);
            Snackbar.Add($"Deleted branch '{name}'.", Severity.Success);
            await Load();
        }
        catch (InvalidOperationException ex) { Error = ex.Message; }
    }
}
