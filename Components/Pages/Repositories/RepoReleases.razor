@page "/p/{Key}/repos/{Slug}/releases"
@using GitBench.Services.Releases
@using GitBench.Components.Releases
@inherits RepoPageBase
@inject ReleaseService Releases
@inject ProjectAccess Access

<PageTitle>Releases · @Repo?.Name</PageTitle>

@if (NotFound)
{
    <ProjectNotFound Message="This repository does not exist." />
}
else if (Repo != null)
{
    <RepoHeader Repo="Repo" Active="releases" />

    <div class="repo-toolbar">
        @if (perms.Can(Permission.PushCode) && !Repo.IsArchived)
        {
            <a class="btn btn-sm btn-primary" href="@ReleaseUrls.New(Repo)">New release</a>
        }
        <a class="btn btn-sm btn-outline-secondary" href="@ReleaseUrls.Tags(Repo)">🏷 Tags</a>
        <span class="ms-auto muted small">@releases?.Count(r => !r.IsDraft) release@(releases?.Count(r => !r.IsDraft) == 1 ? "" : "s")</span>
    </div>

    @if (releases == null)
    {
        <div class="muted">Loading…</div>
    }
    else if (releases.Count == 0)
    {
        <div class="empty">
            No releases yet.
            @if (perms.Can(Permission.PushCode) && !Repo.IsArchived)
            {
                <span>Releases package a tag with notes and downloadable files. <a href="@ReleaseUrls.New(Repo)">Create the first one</a>.</span>
            }
        </div>
    }
    else
    {
        @foreach (var r in releases)
        {
            <ReleaseCard @key="r.Id" Repo="Repo" Release="r" IsLatest="@(r.Id == latestId)" Link Collapse />
        }
    }
}

@code {
    private List<Release>? releases;
    private int? latestId;
    private ProjectPermissions perms = ProjectPermissions.None;

    protected override async Task OnParametersSetAsync()
    {
        if (!await LoadRepoAsync()) return;
        perms = await Access.GetPermissionsAsync(Repo!.ProjectId);
        releases = await Releases.ListAsync(Repo!);
        latestId = (await Releases.GetLatestAsync(Repo!))?.Id;
    }
}
