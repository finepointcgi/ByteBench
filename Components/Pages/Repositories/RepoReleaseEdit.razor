@page "/p/{Key}/repos/{Slug}/releases/new"
@page "/p/{Key}/repos/{Slug}/releases/{Id:int}/edit"
@using ByteBench.Services.Releases
@inherits RepoPageBase
@inject ReleaseService Releases
@inject ProjectAccess Access
@inject ReleaseNotesService DraftNotes

<PageTitle>@(Id == null ? "New release" : "Edit release") · @Repo?.Name</PageTitle>

@if (NotFound || (loaded && Id != null && existing == null))
{
    <ProjectNotFound Message="This release does not exist." />
}
else if (Repo != null && loaded)
{
    <RepoHeader Repo="Repo" Active="releases" />

    @if (!perms.Can(Permission.PushCode) || Repo.IsArchived)
    {
        <Forbidden Message="@(Repo.IsArchived ? "This repository is archived." : "Creating and editing releases needs the Developer role or higher.")" />
    }
    else
    {
        <div class="rel-form">
        <MudPaper Outlined="true" Class="pa-5">
            <MudText Typo="Typo.h6" HtmlTag="h2" Class="mb-3">@(existing == null ? "New release" : $"Edit release {existing.TagName}")</MudText>
            @if (Error != null) { <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3">@Error</MudAlert> }

            <MudGrid Spacing="3">
                <MudItem xs="12" md="5">
                    @if (existing != null)
                    {
                        <MudTextField T="string" Label="Tag" Value="existing.TagName" Disabled="true" Variant="Variant.Outlined" Margin="Margin.Dense" Class="gb-mono-input" />
                    }
                    else
                    {
                        <MudAutocomplete T="string" Label="Tag" Placeholder="v1.0.0" @bind-Value="input.TagName" SearchFunc="SearchTags" CoerceValue="true"
                                         DebounceInterval="100" MaxLength="250" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" ShrinkLabel="true"
                                         Class="gb-mono-input" MaxItems="null" Error="@TagTaken" />
                        <MudText Typo="Typo.caption" HtmlTag="div" Class="@(TagTaken ? "mud-error-text mt-1" : "mud-text-secondary mt-1")">
                            @if (string.IsNullOrWhiteSpace(input.TagName)) { <span>Pick an existing tag or type a new one.</span> }
                            else if (TagIsNew) { <span class="d-inline-flex align-center gap-1"><MudIcon Icon="@Icons.Material.Outlined.AutoAwesome" Style="font-size:14px" /> A new tag will be created when you save.</span> }
                            else if (TagTaken) { <span>This tag already has a release.</span> }
                            else { <span>Existing tag.</span> }
                        </MudText>
                    }
                </MudItem>
                @if (existing == null && TagIsNew)
                {
                    <MudItem xs="12" sm="6" md="4">
                        <MudAutocomplete T="string" Label="Create from" @bind-Value="input.Target" SearchFunc="SearchBranches" CoerceValue="true"
                                         DebounceInterval="100" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" ShrinkLabel="true"
                                         Class="gb-mono-input" MaxItems="null" HelperText="A branch or commit SHA." />
                    </MudItem>
                    <MudItem xs="12" sm="6" md="3">
                        <MudTextField T="string" Label="Tag message" Placeholder="optional (annotated)" @bind-Value="input.TagMessage"
                                      Variant="Variant.Outlined" Margin="Margin.Dense" ShrinkLabel="true" />
                    </MudItem>
                }
                <MudItem xs="12">
                    <MudTextField T="string" Label="Title" MaxLength="200" Placeholder="@(string.IsNullOrWhiteSpace(input.TagName) ? "Release title" : input.TagName)"
                                  @bind-Value="input.Title" Variant="Variant.Outlined" Margin="Margin.Dense" ShrinkLabel="true" />
                </MudItem>
                <MudItem xs="12">
                    <div class="notes-head">
                        <span class="gb-section-label mb-0">Release notes</span>
                        <div class="notes-actions">
                            <MudTooltip Text="Build notes from the commits and merged pull requests since the previous release">
                                <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Outlined.AutoFixHigh"
                                           Disabled="@(busy || string.IsNullOrWhiteSpace(NotesSource))" OnClick="Generate">Generate notes</MudButton>
                            </MudTooltip>
                            <MudTooltip Text="A plain list of the merged pull requests and commits, grouped by label (no AI)">
                                <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Outlined.Checklist" id="notes-from-prs"
                                           Disabled="@(busy || string.IsNullOrWhiteSpace(NotesSource))" OnClick="GeneratePlain">Generate from merged PRs</MudButton>
                            </MudTooltip>
                            <MudTooltip Text="@(aiReason ?? "Group the changes into Features, Fixes, Breaking changes and Other with AI. You review and edit the draft; nothing is saved automatically.")">
                                <span>
                                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Outlined.AutoAwesome" id="notes-with-ai"
                                               Disabled="@(busy || !aiAvailable || string.IsNullOrWhiteSpace(NotesSource))" OnClick="GenerateAi">@(lastMode == "ai" ? "Regenerate with AI" : "Generate notes with AI")</MudButton>
                                </span>
                            </MudTooltip>
                        </div>
                    </div>
                    @if (lastMode == "ai")
                    {
                        <MudAlert Severity="Severity.Info" Dense="true" Variant="Variant.Outlined" Class="mb-2" id="ai-draft-banner">
                            AI draft: check it against the changes and edit it. It is only in the editor; nothing is saved until you publish or save the release. Use the Preview tab to see how it reads.
                        </MudAlert>
                    }
                    @if (generatedInfo != null) { <MudText Typo="Typo.caption" HtmlTag="div" Class="mud-text-secondary mb-1">@generatedInfo</MudText> }
                    <MarkdownEditor @bind-Value="input.Notes" Rows="14" Placeholder="Describe this release (Markdown)" />
                </MudItem>
                <MudItem xs="12">
                    <MudCheckBox T="bool" @bind-Value="input.IsPrerelease" Color="Color.Primary" Dense="true">
                        This is a pre-release (not production-ready; never shown as the latest release)
                    </MudCheckBox>
                </MudItem>
            </MudGrid>

            <div class="mt-4 d-flex flex-wrap gap-2">
                @if (existing == null || existing.IsDraft)
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(busy || !CanSave)" OnClick="() => Save(draft: false)">Publish release</MudButton>
                    <MudButton Variant="Variant.Outlined" Disabled="@(busy || !CanSave)" OnClick="() => Save(draft: true)">Save draft</MudButton>
                }
                else
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(busy || !CanSave)" OnClick="() => Save(draft: false)">Update release</MudButton>
                }
                <MudButton Variant="Variant.Text" Href="@(existing == null ? ReleaseUrls.List(Repo) : ReleaseUrls.Detail(Repo, existing.Id))">Cancel</MudButton>
            </div>
        </MudPaper>
        </div>
    }
}

@code {
    [Parameter] public int? Id { get; set; }
    [SupplyParameterFromQuery(Name = "tag")] public string? TagQuery { get; set; }

    private ReleaseInput input = new();
    private Release? existing;
    private List<BranchInfo> branches = [];
    private List<string> allTags = [], freeTags = [];
    private HashSet<string> usedTags = [];
    private ProjectPermissions perms = ProjectPermissions.None;
    private bool loaded, busy;
    private string? generatedInfo;
    private bool aiAvailable;
    private string? aiReason, lastDraft, lastMode;

    private bool TagTaken => existing == null && !string.IsNullOrWhiteSpace(input.TagName) && usedTags.Contains(input.TagName.Trim());
    private bool TagIsNew => !string.IsNullOrWhiteSpace(input.TagName) && !allTags.Contains(input.TagName.Trim());
    private bool CanSave => existing != null || (!string.IsNullOrWhiteSpace(input.TagName) && !usedTags.Contains(input.TagName.Trim())
                                                 && (!TagIsNew || !string.IsNullOrWhiteSpace(input.Target)));
    /// <summary>What the notes are generated for: the tag if it exists, else the branch it will be created from.</summary>
    private string? NotesSource => existing?.TagName ?? (TagIsNew ? input.Target : input.TagName?.Trim());

    protected override async Task OnParametersSetAsync()
    {
        if (!await LoadRepoAsync()) return;
        perms = await Access.GetPermissionsAsync(Repo!.ProjectId);
        (branches, allTags) = await Git(path => GitOps.Exists(path)
            ? (GitOps.ListBranches(path, Repo!.DefaultBranch), GitOps.ListTags(path))
            : (new List<BranchInfo>(), new List<string>()));
        var releases = await Releases.ListAsync(Repo!);
        usedTags = releases.Select(r => r.TagName).ToHashSet();
        freeTags = allTags.Where(t => !usedTags.Contains(t)).ToList();

        if (Id is { } id)
        {
            existing = await Releases.GetAsync(Repo!, id);
            if (existing != null)
                input = new ReleaseInput
                {
                    TagName = existing.TagName, Title = existing.Title, Notes = existing.Notes,
                    IsPrerelease = existing.IsPrerelease, IsDraft = existing.IsDraft,
                };
        }
        else if (!loaded)
        {
            input = new ReleaseInput { TagName = TagQuery ?? "", Target = Repo!.DefaultBranch };
        }
        (aiAvailable, aiReason) = await DraftNotes.GetAiAvailabilityAsync();
        loaded = true;
    }

    /// <summary>Puts a draft into the editor: replaces the previous draft, fills empty notes, or goes below what is already written.</summary>
    private void InsertDraft(string markdown, string mode)
    {
        if (lastDraft != null && input.Notes != null && input.Notes.Contains(lastDraft, StringComparison.Ordinal)) input.Notes = input.Notes.Replace(lastDraft, markdown);
        else if (string.IsNullOrWhiteSpace(input.Notes)) input.Notes = markdown;
        else input.Notes = input.Notes.TrimEnd() + "\n\n" + markdown;
        lastDraft = markdown;
        lastMode = mode;
    }

    private Task GeneratePlain() => RunDraft(() => DraftNotes.GeneratePlainAsync(Repo!, NotesSource!, existing?.TagName ?? input.TagName?.Trim()));
    private Task GenerateAi() => RunDraft(() => DraftNotes.GenerateWithAiAsync(Repo!, NotesSource!, existing?.TagName ?? input.TagName?.Trim()));

    private async Task RunDraft(Func<Task<ReleaseNotesDraft>> make)
    {
        Error = null;
        busy = true;
        try
        {
            var draft = await make();
            InsertDraft(draft.Markdown, draft.Mode);
            generatedInfo = (draft.PreviousTag == null ? "From every change in the repository (no earlier release tag found)" : $"From the changes since {draft.PreviousTag}")
                            + $": {draft.PullRequests} merged pull request(s), {draft.Commits} direct commit(s)." + (draft.Notice == null ? "" : " " + draft.Notice);
        }
        catch (InvalidOperationException ex) { Error = ex.Message; }
        finally { busy = false; }
    }

    /// <summary>Tags without a release; any other text becomes a new tag.</summary>
    private Task<IEnumerable<string>> SearchTags(string? text, CancellationToken _) =>
        Task.FromResult(freeTags.Where(t => string.IsNullOrWhiteSpace(text) || freeTags.Contains(text) || t.Contains(text, StringComparison.OrdinalIgnoreCase)));

    /// <summary>Branch suggestions for a new tag's target; a commit SHA is kept as typed.</summary>
    private Task<IEnumerable<string>> SearchBranches(string? text, CancellationToken _) =>
        Task.FromResult(branches.Select(b => b.Name)
            .Where(n => string.IsNullOrWhiteSpace(text) || branches.Any(b => b.Name == text) || n.Contains(text, StringComparison.OrdinalIgnoreCase)));

    private async Task Generate()
    {
        Error = null;
        busy = true;
        try
        {
            var notes = await Releases.GenerateNotesAsync(Repo!, NotesSource!, existing?.TagName ?? input.TagName?.Trim());
            if (!string.IsNullOrWhiteSpace(input.Notes) && input.Notes.Trim() != notes.Markdown.Trim())
                input.Notes = input.Notes.TrimEnd() + "\n\n" + notes.Markdown;
            else
                input.Notes = notes.Markdown;
            generatedInfo = notes.PreviousTag == null
                ? $"Generated from all {notes.CommitCount} commit(s) (no earlier release tag found)."
                : $"Generated from {notes.CommitCount} commit(s) and {notes.PullRequestCount} merged pull request(s) since {notes.PreviousTag}.";
        }
        catch (InvalidOperationException ex) { Error = ex.Message; }
        finally { busy = false; }
    }

    private async Task Save(bool draft)
    {
        Error = null;
        busy = true;
        try
        {
            input.IsDraft = draft;
            var saved = existing == null
                ? await Releases.CreateAsync(Repo!, input)
                : await Releases.UpdateAsync(Repo!, existing.Id, input);
            Nav.NavigateTo(ReleaseUrls.Detail(Repo!, saved.Id));
        }
        catch (InvalidOperationException ex) { Error = ex.Message; }
        finally { busy = false; }
    }
}
