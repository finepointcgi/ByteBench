@page "/p/{Key}/pull-requests/new"
@inject IssueService Issues
@inject RepositoryService Repos
@inject PullRequestService PRs
@inject CurrentUser Me
@inject NavigationManager Nav
@inject GitBench.Services.Ai.AiClient Ai
@inject GitBench.Services.Ai.AiReviewService AiReviews
@inject ProjectAccess Access
@inject ReviewerService Reviewers
@inject BranchProtectionService Protection

<PageTitle>New pull request · @project?.Name</PageTitle>

@if (notFound)
{
    <ProjectNotFound />
}
else if (project != null && !canCreate)
{
    <Forbidden Message="You need the Developer role or higher to create pull requests in this project." BackHref="@RepoUrls.PullRequests(project.Key)" />
}
else if (project != null)
{
    <MudBreadcrumbs Items="@Crumbs" Class="px-0 pt-0 pb-2" />
    <MudText Typo="Typo.h5" HtmlTag="h1" Class="gb-bold mb-4">Create pull request</MudText>

    @if (repos.Count == 0)
    {
        <div class="empty">This project has no repositories yet. <a href="@RepoUrls.List(project.Key)">Create one</a> first.</div>
    }
    else
    {
        <MudPaper Outlined="true" Class="pa-4">
            <div class="pr-compare-bar">
                <MudSelect T="string" Label="Repository" Value="@repo?.Slug" ValueChanged="v => Go(v, null, null)" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" OuterClass="compare-field">
                    @foreach (var r in repos) { <MudSelectItem T="string" Value="@r.Repository.Slug">@r.Repository.Name</MudSelectItem> }
                </MudSelect>
                <MudSelect T="string" Label="Source branch" Value="@(Source ?? "")" ValueChanged="v => Go(repo?.Slug, v, Target)" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true"
                           OuterClass="compare-field gb-mono-input">
                    <MudSelectItem T="string" Value="@("")">Choose a branch…</MudSelectItem>
                    @foreach (var b in branches) { <MudSelectItem T="string" Value="@b.Name"><span class="mono">@b.Name</span></MudSelectItem> }
                </MudSelect>
                <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Class="compare-arrow" />
                <MudSelect T="string" Label="Target branch" Value="@TargetOrDefault" ValueChanged="v => Go(repo?.Slug, Source, v)" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true"
                           OuterClass="compare-field gb-mono-input">
                    @foreach (var b in branches) { <MudSelectItem T="string" Value="@b.Name"><span class="mono">@b.Name</span></MudSelectItem> }
                </MudSelect>
            </div>
        </MudPaper>

        @if (string.IsNullOrEmpty(Source))
        {
            <div class="empty mt-3">Choose the branch with your changes to see a preview.</div>
        }
        else if (Source == TargetOrDefault)
        {
            <div class="empty mt-3">Source and target are the same branch. Pick a different branch to compare.</div>
        }
        else if (compare == null)
        {
            <div class="empty mt-3">One of these branches doesn't exist.</div>
        }
        else
        {
            @if (existing != null)
            {
                <MudAlert Severity="Severity.Info" Dense="true" Class="mt-3">
                    There's already an open pull request for these branches:
                    <a href="@RepoUrls.PullRequest(existing)">@existing.Repository.Slug#@existing.Number @existing.Title</a>
                </MudAlert>
            }
            else if (compare.Commits.Count == 0)
            {
                <div class="empty mt-3">
                    <span class="mono">@TargetOrDefault</span> is up to date with all commits from <span class="mono">@Source</span>. Nothing to merge.
                </div>
            }
            else
            {
                @if (mergeStatus?.Check == MergeCheck.Conflicts)
                {
                    <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-3">These branches have conflicts. You can still open the pull request, but it can't be merged until they're resolved.</MudAlert>
                }
                else
                {
                    <MudAlert Severity="Severity.Success" Dense="true" Class="mt-3">Able to merge. These branches can be merged automatically.</MudAlert>
                }

                <div class="gb-detail-grid mt-3">
                    <MudPaper Outlined="true" Class="pa-4">
                        <MudStack Spacing="3">
                            <MudTextField T="string" Label="Title" @bind-Value="title" Immediate="true" MaxLength="200" Variant="Variant.Outlined" Margin="Margin.Dense" />
                            <div>
                                <div class="desc-head">
                                    <span class="gb-section-label mb-0">Description</span>
                                    @if (Ai.IsConfigured)
                                    {
                                        <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" Disabled="@writing" OnClick="WriteDescriptionWithAi" Class="ml-auto"
                                                   StartIcon="@Icons.Material.Outlined.AutoAwesome"
                                                   title="Replaces the description with one written by GitBench AI from the commits and diff. You can edit it before creating the pull request.">
                                            @(writing ? "Writing…" : "Write description with AI")
                                        </MudButton>
                                    }
                                </div>
                                <MarkdownEditor @bind-Value="description" Rows="8" Placeholder="What does this change and why?" ProjectId="project.Id" />
                                @if (templatePath != null)
                                {
                                    <MudText Typo="Typo.caption" HtmlTag="div" Class="mud-text-secondary mt-1">Prefilled from <span class="mono">@templatePath</span> on <span class="mono">@TargetOrDefault</span>.</MudText>
                                }
                            </div>
                            @if (error != null) { <MudAlert Severity="Severity.Error" Dense="true">@error</MudAlert> }
                            @if (repo?.IsArchived == true)
                            {
                                <MudAlert Severity="Severity.Warning" Dense="true">@repo.Name is archived, so pull requests can't be created.</MudAlert>
                            }
                            <div>
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.MergeType"
                                           Disabled="@(busy || string.IsNullOrWhiteSpace(title) || repo?.IsArchived == true)" OnClick="() => Create(false)">Create pull request</MudButton>
                                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.EditNote" Class="ml-2"
                                           title="A draft can't be merged, and reviewers aren't notified until you mark it ready for review"
                                           Disabled="@(busy || string.IsNullOrWhiteSpace(title) || repo?.IsArchived == true)" OnClick="() => Create(true)">Create draft</MudButton>
                            </div>
                        </MudStack>
                    </MudPaper>
                    <MudPaper Outlined="true" Class="gb-side">
                        <div class="gb-side-field">
                            <span class="gb-section-label">Summary</span>
                            <div><b>@compare.Commits.Count</b> commit@(compare.Commits.Count == 1 ? "" : "s"), <b>@compare.Files.Count</b> file@(compare.Files.Count == 1 ? "" : "s") changed</div>
                            <div class="muted small">@Source is @compare.Ahead ahead, @compare.Behind behind @TargetOrDefault</div>
                        </div>
                        <div class="gb-side-field">
                            <span class="gb-section-label">Reviewers</span>
                            @if (reviewerCandidates.Count == 0) { <div class="muted small">No other project members can review.</div> }
                            @foreach (var u in reviewerCandidates)
                            {
                                <MudCheckBox T="bool" @key="u.Id" Value="@selectedReviewers.Contains(u.Id)" Size="Size.Small" Dense="true" Color="Color.Primary"
                                             ValueChanged="v => { if (v) selectedReviewers.Add(u.Id); else selectedReviewers.Remove(u.Id); }">
                                    <span class="small">@u.DisplayName</span>
                                </MudCheckBox>
                            }
                        </div>
                        <div class="gb-side-field">
                            <span class="gb-section-label">Linked issues</span>
                            @if (linkedNumbers.Count == 0) { <div class="muted small">None detected. Mention <code>@project.Key-123</code> in the title, branch or commits.</div> }
                            @foreach (var n in linkedNumbers) { <a class="issue-key-chip" href="/p/@project.Key/issues/@n">@project.Key-@n</a> }
                        </div>
                    </MudPaper>
                </div>

                <nav class="gb-tabs mt-6" aria-label="Changes">
                    <TabLink Active="@(tab == "commits")" OnClick='() => tab = "commits"' Icon="@Icons.Material.Outlined.Commit" Count="compare.Commits.Count">Commits</TabLink>
                    <TabLink Active="@(tab == "files")" OnClick='() => tab = "files"' Icon="@Icons.Material.Outlined.Difference" Count="compare.Files.Count">Files changed</TabLink>
                </nav>
                @if (tab == "commits")
                {
                    <CommitList Commits="compare.Commits" Repo="repo!" Users="usersByEmail" />
                }
                else
                {
                    <DiffView Files="compare.Files" Repo="repo" ViewRef="@Source" />
                }
            }
        }
    }
}

@code {
    [Parameter] public string Key { get; set; } = "";
    [SupplyParameterFromQuery(Name = "repo")] public string? RepoSlug { get; set; }
    [SupplyParameterFromQuery(Name = "source")] public string? Source { get; set; }
    [SupplyParameterFromQuery(Name = "target")] public string? Target { get; set; }

    private Project? project;
    private Repository? repo;
    private List<RepoSummary> repos = [];
    private List<BranchInfo> branches = [];
    private CompareResult? compare;
    private MergeStatus? mergeStatus;
    private PullRequest? existing;
    private Dictionary<string, User> usersByEmail = [];
    private SortedSet<int> linkedNumbers = [];
    private bool notFound, busy, canCreate;
    private string? title, description, error;
    private string tab = "commits";
    private string? previewKey;
    private string? templatePath;
    private List<User> reviewerCandidates = [];
    private HashSet<int> selectedReviewers = [];

    private string TargetOrDefault => string.IsNullOrEmpty(Target) ? repo?.DefaultBranch ?? "main" : Target;

    private List<BreadcrumbItem> Crumbs =>
    [
        new(project!.Name, $"/p/{project.Key}/issues"),
        new("Pull requests", RepoUrls.PullRequests(project.Key)),
        new("New", null, disabled: true),
    ];

    protected override async Task OnParametersSetAsync()
    {
        project ??= await Issues.GetProjectAsync(Key);
        notFound = project == null;
        if (notFound) return;
        canCreate = await Access.CanAsync(project!.Id, Permission.CreatePullRequest);
        if (!canCreate) return;
        if (repos.Count == 0) repos = await Repos.GetRepositoriesAsync(project!.Id);
        if (usersByEmail.Count == 0) usersByEmail = await Repos.GetUsersByEmailAsync();

        repo = repos.FirstOrDefault(r => r.Repository.Slug == RepoSlug)?.Repository ?? repos.FirstOrDefault()?.Repository;
        if (repo == null) return;
        var r = repo;
        branches = await Repos.Git(r, path => GitOps.ListBranches(path, r.DefaultBranch));

        var key = $"{r.Slug}|{Source}|{TargetOrDefault}";
        if (key == previewKey) return;
        previewKey = key;
        compare = null; mergeStatus = null; existing = null; error = null;
        if (string.IsNullOrEmpty(Source) || Source == TargetOrDefault) return;

        var source = Source;
        var target = TargetOrDefault;
        (compare, mergeStatus) = await Repos.Git(r, path =>
        {
            var c = GitOps.Compare(path, target, source);
            return (c, c == null || c.Commits.Count == 0 ? null : GitOps.CheckMerge(path, source, target));
        });
        existing = (await PRs.ListAsync(project!.Id, PullRequestState.Open, r.Id))
            .FirstOrDefault(p => p.SourceBranch == source && p.TargetBranch == target);

        // Sensible defaults: single commit → its subject; otherwise a humanised branch name.
        if (compare != null)
        {
            title = compare.Commits.Count == 1 ? compare.Commits[0].MessageShort : Humanize(source);
            description = compare.Commits.Count > 1
                ? string.Join("\n", compare.Commits.AsEnumerable().Reverse().Select(c => $"- {c.MessageShort}"))
                : compare.Commits.FirstOrDefault()?.Body;
            linkedNumbers = IssueKeys.Numbers(project.Key, compare.Commits.Select(c => c.Message).Append(source).Append(title));

            // A description template on the target branch replaces the commit-list default.
            var template = await Repos.Git(r, path => PullRequestTemplates.Find(path, target));
            templatePath = template?.Path;
            if (template is { } t) description = t.Text;

            // Reviewers: project members who can review, preselecting the default reviewers of matching branch rules.
            if (reviewerCandidates.Count == 0)
                reviewerCandidates = (await Reviewers.CandidatesAsync(project.Id)).Where(u => u.Id != Me.Id).ToList();
            selectedReviewers = (await Protection.ForBranchAsync(r.Id, target)).Rules
                .SelectMany(x => x.DefaultReviewerIds).Where(id => id != Me.Id).ToHashSet();
        }
    }

    private static string Humanize(string branch)
    {
        var last = branch.Contains('/') ? branch[(branch.LastIndexOf('/') + 1)..] : branch;
        var m = System.Text.RegularExpressions.Regex.Match(last, @"^([A-Za-z][A-Za-z0-9]+-\d+)[-_]?(.*)$");
        var words = (m.Success ? m.Groups[2].Value : last).Replace('-', ' ').Replace('_', ' ').Trim();
        if (words.Length > 0) words = char.ToUpperInvariant(words[0]) + words[1..];
        return m.Success ? $"{m.Groups[1].Value.ToUpperInvariant()}: {words}".TrimEnd(' ', ':') : words;
    }

    private void Go(string? repoSlug, string? source, string? target) =>
        Nav.NavigateTo(RepoUrls.NewPullRequest(project!.Key, repoSlug, string.IsNullOrEmpty(source) ? null : source, string.IsNullOrEmpty(target) ? null : target));

    private bool writing;

    /// <summary>Streams an AI-written description into the editor; the user can edit it before creating the PR.</summary>
    private async Task WriteDescriptionWithAi()
    {
        if (compare == null || repo == null || string.IsNullOrEmpty(Source)) return;
        writing = true;
        error = null;
        description = "";
        var lastRender = DateTime.UtcNow;
        try
        {
            await foreach (var chunk in AiReviews.StreamDescriptionAsync(repo, compare, Source, TargetOrDefault, title, Me.Id))
            {
                description += chunk;
                if ((DateTime.UtcNow - lastRender).TotalMilliseconds >= 50)
                {
                    lastRender = DateTime.UtcNow;
                    StateHasChanged();
                }
            }
            description = description?.Trim();
        }
        catch (Exception ex) { error = "Couldn't write a description: " + ex.Message; }
        finally { writing = false; }
    }

    private async Task Create(bool draft)
    {
        busy = true;
        error = null;
        try
        {
            var pr = await PRs.CreateAsync(repo!, title ?? "", description, Source!, TargetOrDefault, Me.Id, selectedReviewers, draft);
            Nav.NavigateTo(RepoUrls.PullRequest(repo!, pr.Number));
        }
        catch (InvalidOperationException ex) { error = ex.Message; }
        finally { busy = false; }
    }
}
