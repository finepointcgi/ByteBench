@page "/p/{Key}/milestones"
@inject IssueService Issues
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject ProjectAccess Access

<PageTitle>Milestones · @project?.Name</PageTitle>

@if (notFound)
{
    <ProjectNotFound />
}
else if (project != null)
{
    <div class="mst-page">
        <div class="d-flex align-center justify-space-between flex-wrap gap-4 mb-4">
            <div>
                <MudText Typo="Typo.h5" Class="mst-heading">Milestones &amp; sprints</MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary">@project.Name</MudText>
            </div>
            @if (canManage)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                           OnClick="() => editing = new Milestone { ProjectId = project.Id, StartDate = DateTime.Today, DueDate = DateTime.Today.AddDays(14) }">New milestone</MudButton>
            }
        </div>

        @if (error != null) { <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3">@error</MudAlert> }
        @if (editing != null)
        {
            <MudPaper Outlined="true" Class="pa-4 mb-3">
                <EditForm Model="editing" OnValidSubmit="Save" FormName="milestone">
                    <DataAnnotationsValidator />
                    <MudGrid Spacing="2">
                        <MudItem xs="12" md="4">
                            <MudTextField T="string" @bind-Value="editing.Title" For="() => editing.Title" Label="Title" Placeholder="Sprint 3"
                                          Variant="Variant.Outlined" Margin="Margin.Dense" />
                        </MudItem>
                        <MudItem xs="12" sm="6" md="2">
                            <MudDatePicker @bind-Date="editing.StartDate" Label="Start" Variant="Variant.Outlined" Margin="Margin.Dense"
                                           Editable="true" Clearable="true" DateFormat="yyyy-MM-dd" />
                        </MudItem>
                        <MudItem xs="12" sm="6" md="2">
                            <MudDatePicker @bind-Date="editing.DueDate" Label="Due" Variant="Variant.Outlined" Margin="Margin.Dense"
                                           Editable="true" Clearable="true" DateFormat="yyyy-MM-dd" />
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudTextField T="string" @bind-Value="editing.Description" Label="Description" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        </MudItem>
                    </MudGrid>
                    <div class="mt-3 d-flex gap-2">
                        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small">@(editing.Id == 0 ? "Create" : "Save")</MudButton>
                        <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="() => editing = null">Cancel</MudButton>
                    </div>
                </EditForm>
            </MudPaper>
        }

        @if (milestones.Count == 0)
        {
            <div class="mst-empty">No milestones yet.</div>
        }
        <MudStack Spacing="3">
            @foreach (var ms in milestones)
            {
                var m = ms.Milestone;
                var overdue = !m.IsClosed && m.DueDate < DateTime.Today && ms.Open > 0;
                <MudPaper Outlined="true" Class="@("mst-row" + (m.IsClosed ? " mst-closed" : ""))" @key="m.Id">
                    <div class="mst-info">
                        <div class="mst-title">
                            <MudIcon Icon="@Icons.Material.Outlined.Flag" Size="Size.Small" Class="mst-flag" />
                            <span>@m.Title</span>
                            @if (m.IsClosed) { <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Text" Class="ma-0">Closed</MudChip> }
                            @if (m.GroupId != null) { <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Icon="@Icons.Material.Outlined.Workspaces" Class="ma-0" title="Group milestone: managed on the group's Labels & milestones page">Group</MudChip> }
                            @if (overdue) { <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Text" Class="ma-0">Overdue</MudChip> }
                        </div>
                        <div class="mst-sub">
                            @if (m.StartDate is { } s) { <span>@s.ToString("MMM d") – </span> }
                            @(m.DueDate?.ToString("MMM d, yyyy") ?? "No due date")
                            @if (!string.IsNullOrEmpty(m.Description)) { <span> · @m.Description</span> }
                        </div>
                    </div>
                    <div class="mst-progress">
                        <MudProgressLinear Value="ms.Percent" Color="Color.Success" Rounded="true" Size="Size.Small" Class="my-2"
                                           aria-label="@($"{m.Title}: {ms.Percent}% complete")" />
                        <div class="mst-sub">
                            <b>@ms.Percent%</b> complete · @ms.Open open · @ms.Closed closed
                            @if (ms.Points > 0) { <span> · @ms.DonePoints/@ms.Points pts</span> }
                        </div>
                    </div>
                    <div class="mst-actions">
                        <GitBench.Components.Ai.ReleaseNotesButton Project="project" Milestone="m" />
                        <MudButton Href="@($"/p/{project.Key}/board")" Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Outlined.ViewKanban">Board</MudButton>
                        @if (canManage && m.GroupId == null)
                        {
                            <MudTooltip Text="Edit">
                                <MudIconButton Icon="@Icons.Material.Outlined.Edit" Size="Size.Small" Variant="Variant.Outlined" OnClick="() => Edit(m)" aria-label="@($"Edit {m.Title}")" />
                            </MudTooltip>
                            <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="() => ToggleClosed(m)">@(m.IsClosed ? "Reopen" : "Close")</MudButton>
                            <MudTooltip Text="Delete">
                                <MudIconButton Icon="@Icons.Material.Outlined.Delete" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error" OnClick="() => Delete(m)" aria-label="@($"Delete {m.Title}")" />
                            </MudTooltip>
                        }
                    </div>
                </MudPaper>
            }
        </MudStack>
    </div>
}

@code {
    [Parameter] public string Key { get; set; } = "";

    private Project? project;
    private bool notFound, canManage;
    private string? error;
    private List<MilestoneSummary> milestones = [];
    private Milestone? editing;

    protected override async Task OnParametersSetAsync()
    {
        project = await Issues.GetProjectAsync(Key);
        notFound = project == null;
        canManage = project != null && await Access.CanAsync(project.Id, Permission.ManageLabelsAndMilestones);
        await Load();
    }

    private async Task Load()
    {
        if (project != null) milestones = await Issues.GetMilestonesAsync(project.Id);
    }

    private void Edit(Milestone m) => editing = new Milestone
    {
        Id = m.Id, ProjectId = m.ProjectId, Title = m.Title, Description = m.Description,
        StartDate = m.StartDate, DueDate = m.DueDate, IsClosed = m.IsClosed
    };

    private async Task Save()
    {
        error = null;
        try { await Issues.SaveMilestoneAsync(editing!); }
        catch (InvalidOperationException ex) { error = ex.Message; return; }
        editing = null;
        Snackbar.Add("Milestone saved.", Severity.Success);
        await Load();
    }

    private async Task ToggleClosed(Milestone m)
    {
        Edit(m);
        editing!.IsClosed = !m.IsClosed;
        await Save();
    }

    private async Task Delete(Milestone m)
    {
        var ok = await Dialogs.ShowMessageBoxAsync("Delete milestone", $"Delete milestone \"{m.Title}\"? Issues will be kept.",
            yesText: "Delete", cancelText: "Cancel");
        if (ok != true) return;
        error = null;
        try { await Issues.DeleteMilestoneAsync(m.Id); }
        catch (InvalidOperationException ex) { error = ex.Message; }
        await Load();
    }
}
