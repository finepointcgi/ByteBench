@page "/p/{Key}/members"
@inject IssueService Issues
@inject MemberService MemberSvc
@inject ProjectAccess Access
@inject CurrentUser Me
@inject ISnackbar Snackbar

<PageTitle>Members · @project?.Name</PageTitle>

<div class="members-page">
@if (notFound)
{
    <ProjectNotFound />
}
else if (project != null)
{
    <div class="page-header">
        <div>
            <MudText Typo="Typo.h5" HtmlTag="h1">Members</MudText>
            <MudText Class="mud-text-secondary" Typo="Typo.body2">
                @project.Name ·
                @(project.Visibility == ProjectVisibility.Internal
                    ? "Internal: every signed-in user can view this project."
                    : "Private: only members can view this project.")
                @if (perms.Role is { } r) { <span> You are <b>@r</b>.</span> }
            </MudText>
        </div>
    </div>

    @if (error != null) { <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3">@error</MudAlert> }

    @if (canManage)
    {
        <MudPaper Outlined="true" Class="pa-4 mb-3">
            <MudText Typo="Typo.subtitle1" HtmlTag="h2" Class="members-title">Add a member</MudText>
            <div class="add-member">
                <MudTextField T="string" Placeholder="Username or e-mail" @bind-Value="newLogin" Immediate="true" Variant="Variant.Outlined"
                              Margin="Margin.Dense" Class="add-login" aria-label="Username or e-mail" />
                <MudSelect T="ProjectRole" @bind-Value="newRole" Variant="Variant.Outlined" Margin="Margin.Dense" Class="add-role"
                           AnchorOrigin="Origin.BottomLeft" aria-label="Role">
                    @foreach (var role in Roles) { <MudSelectItem Value="role">@role</MudSelectItem> }
                </MudSelect>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.PersonAdd"
                           Disabled="@string.IsNullOrWhiteSpace(newLogin)" OnClick="Add">Add member</MudButton>
            </div>
        </MudPaper>
    }

    <MudPaper Outlined="true" Class="member-list">
        @foreach (var m in members)
        {
            @* Keyed by load version so a rejected role change resets the select. *@
            <div class="member-row" @key="(m.Id, version)">
                <Avatar User="m.User" Size="28" />
                <div class="member-main">
                    <div class="member-name">@m.User.DisplayName @if (m.UserId == Me.User?.Id) { <span class="member-meta ml-1">(you)</span> }</div>
                    <div class="member-meta">@@@m.User.UserName · @m.User.Email · member since @m.CreatedAt.ToLocalTime().ToString("d")</div>
                </div>
                <div class="member-right">
                    @if (canManage)
                    {
                        <MudSelect T="ProjectRole" Value="m.Role" ValueChanged="role => ChangeRole(m, role)" Variant="Variant.Outlined"
                                   Margin="Margin.Dense" Dense="true" Class="member-role" AnchorOrigin="Origin.BottomLeft"
                                   aria-label="@($"Role of {m.User.DisplayName}")">
                            @foreach (var role in Roles) { <MudSelectItem Value="role">@role</MudSelectItem> }
                        </MudSelect>
                        <MudTooltip Text="Remove from project">
                            <MudIconButton Icon="@Icons.Material.Outlined.PersonRemove" Color="Color.Error" Size="Size.Small"
                                           aria-label="@($"Remove {m.User.DisplayName}")" OnClick="() => Remove(m)" />
                        </MudTooltip>
                    }
                    else
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text">@m.Role</MudChip>
                    }
                </div>
            </div>
        }
    </MudPaper>

    <MudText Typo="Typo.subtitle1" HtmlTag="h2" Class="members-title mt-6">What each role can do</MudText>
    <MudPaper Outlined="true" Class="role-table">
        <MudSimpleTable Dense="true" Elevation="0">
            <thead><tr><th>Permission</th>@foreach (var role in Roles) { <th class="role-col">@role</th> }</tr></thead>
            <tbody>
                @foreach (var p in Enum.GetValues<Permission>())
                {
                    <tr>
                        <td>@p</td>
                        @foreach (var role in Roles)
                        {
                            <td class="role-col">
                                @if (ProjectAccess.RoleHas(role, p))
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" Color="Color.Success" aria-label="Yes" />
                                }
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </MudSimpleTable>
    </MudPaper>
}
</div>

@code {
    [Parameter] public string Key { get; set; } = "";

    private static readonly ProjectRole[] Roles = Enum.GetValues<ProjectRole>();

    private Project? project;
    private ProjectPermissions perms = ProjectPermissions.None;
    private List<ProjectMember> members = [];
    private bool notFound;
    private bool canManage => perms.Can(Permission.ManageMembers);
    private string? newLogin, error;
    private ProjectRole newRole = ProjectRole.Developer;

    protected override async Task OnParametersSetAsync()
    {
        await Me.EnsureLoadedAsync();
        project = await Issues.GetProjectAsync(Key);
        notFound = project == null;
        await Load();
    }

    private async Task Load()
    {
        if (project == null) return;
        perms = await Access.GetPermissionsAsync(project.Id);
        members = await MemberSvc.GetMembersAsync(project.Id);
        version++;
    }

    private int version;

    private async Task Run(Func<Task> action, string success)
    {
        error = null;
        try
        {
            await action();
            Snackbar.Add(success, Severity.Success);
        }
        catch (InvalidOperationException ex) { error = ex.Message; }
        await Load();
    }

    private async Task Add()
    {
        var login = newLogin?.Trim() ?? "";
        await Run(() => MemberSvc.AddMemberAsync(project!.Id, login, newRole), $"Added {login} as {newRole}.");
        if (error == null) newLogin = null;
    }

    private Task ChangeRole(ProjectMember m, ProjectRole role)
    {
        return Run(() => MemberSvc.ChangeRoleAsync(project!.Id, m.UserId, role), $"{m.User.DisplayName} is now {role}.");
    }

    private Task Remove(ProjectMember m) =>
        Run(() => MemberSvc.RemoveMemberAsync(project!.Id, m.UserId), $"Removed {m.User.DisplayName}.");
}
