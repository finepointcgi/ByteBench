@page "/p/{Key}/issues/{Number:int}"
@inject IssueService Issues
@inject CurrentUser Me
@inject NavigationManager Nav
@inject IDialogService Dialogs
@inject NotificationService Notifications
@inject LiveEvents Live
@implements IDisposable
@inject ProjectAccess Access
@inject LinkedWorkService LinkedWork
@inject WorkflowService Workflows
@inject GitBench.Services.ServiceDesk.ServiceDeskService Desk

<PageTitle>@issue?.Key @issue?.Title</PageTitle>

@if (notFound)
{
    <ProjectNotFound Message="This issue does not exist." />
}
else if (issue != null && project != null)
{
<div class="id-page">
    <MudBreadcrumbs Items="Crumbs" Class="px-0 pt-0 pb-1" />
    <GitBench.Components.LinkedWork.ParentBreadcrumb Issue="issue" />

    <div class="id-header">
        @if (editingTitle)
        {
            <div class="id-title-edit">
                <MudTextField T="string" @bind-Value="titleDraft" Immediate="true" OnKeyDown="TitleKey" AutoFocus="true" MaxLength="200"
                              Variant="Variant.Outlined" Margin="Margin.Dense" Typo="Typo.h6" aria-label="Issue title" Class="flex-grow-1" />
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveTitle">Save</MudButton>
                <MudButton Variant="Variant.Outlined" OnClick="() => editingTitle = false">Cancel</MudButton>
            </div>
        }
        else
        {
            <h1 class="id-title">
                <span title="@issue.Type">@issue.Type.Icon()</span>
                @issue.Title <span class="id-key mono">@issue.Key</span>
            </h1>
            @if (CanEdit)
            {
            <div class="id-actions">
                <WatchButton Watching="watching" Count="watcherCount" OnToggle="ToggleWatch" IssueId="issue.Id" />
                <GitBench.Components.Automation.AutomationMenu IssueId="issue.Id" />
                <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Outlined.Edit" OnClick="StartEditTitle">Edit title</MudButton>
                @if (issue.Status.IsClosed())
                {
                    @if (ReopenTarget is { } reopen)
                    {
                        <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Outlined.Replay" title="@($"Move to {reopen.Name}")"
                                   OnClick="() => SetWorkflowStatus(reopen.Id)">Reopen</MudButton>
                    }
                }
                else if (CloseTarget is { } close)
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small" StartIcon="@Icons.Material.Outlined.CheckCircle"
                               title="@($"Move to {close.Name}")" OnClick="() => SetWorkflowStatus(close.Id)">Close issue</MudButton>
                }
            </div>
            }
        }
    </div>
    @if (error != null) { <MudAlert Severity="Severity.Error" Dense="true" ShowCloseIcon="true" CloseIconClicked="() => error = null" Class="mb-3">@error</MudAlert> }
    <GitBench.Components.LinkedWork.BlockedStatusWarning Issue="issue" />
    <div class="id-subhead">
        <StatusBadge Issue="issue" />
        <span class="id-muted">
            <UserLink User="issue.Reporter" /> opened this @Display.Ago(issue.CreatedAt)
            @if (issue.ClosedAt is { } ca) { <span> · closed @Display.Ago(ca)</span> }
        </span>
    </div>

    <MudGrid Spacing="4">
        <MudItem xs="12" md="8" lg="9" Class="id-main">
            <GitBench.Components.Ai.AiSummary Issue="issue" />
            <!-- Description -->
            <MudPaper Outlined="true" Class="id-card">
                <div class="id-card-head">
                    <Avatar User="issue.Reporter" Size="22" Link /> <UserLink User="issue.Reporter" />
                    <span class="id-muted id-small">@Display.Ago(issue.CreatedAt)</span>
                    @if (!editingDesc && CanEdit)
                    {
                        <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Outlined.Edit" Class="ml-auto id-text-btn" data-shortcut="edit" OnClick="StartEditDesc">Edit</MudButton>
                    }
                </div>
                <div class="id-card-body">
                    @if (editingDesc)
                    {
                        <MarkdownEditor @bind-Value="descDraft" Rows="10" AttachToIssueId="issue.Id" ProjectId="issue.ProjectId" />
                        <div class="mt-2 d-flex gap-2">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" OnClick="SaveDesc">Save</MudButton>
                            <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="() => editingDesc = false">Cancel</MudButton>
                        </div>
                    }
                    else if (string.IsNullOrWhiteSpace(issue.Description))
                    {
                        <span class="id-muted"><i>No description provided.</i></span>
                    }
                    else
                    {
                        <div class="markdown">@Display.Markdown(issue.Description)</div>
                    }
                </div>
            </MudPaper>

            <GitBench.Components.LinkedWork.ChildIssuesPanel Issue="issue" />
            <GitBench.Components.LinkedWork.LinkedIssuesPanel Issue="issue" />
            <AttachmentsPanel IssueId="issue.Id" Perms="perms" />

            <!-- Timeline: comments + activity -->
            <MudText Typo="Typo.subtitle1" Class="id-section-title">Activity</MudText>
            <div class="id-timeline">
                @foreach (var entry in Timeline)
                {
                    if (entry is Comment c)
                    {
                        <MudPaper Outlined="true" Class="id-card" @key="(1, c.Id)">
                            <div class="id-card-head">
                                @if (c.ServiceDeskContactId != null && desk != null)
                                {
                                    <MudIcon Icon="@Icons.Material.Outlined.Email" Size="Size.Small" Class="mud-text-secondary" />
                                    <b>@(desk.RequesterNames.GetValueOrDefault(c.Id) ?? "Requester")</b>
                                    <span class="id-muted id-small">requester · wrote @Display.Ago(c.CreatedAt)</span>
                                }
                                else
                                {
                                    <Avatar User="c.Author" Size="22" Link /> <UserLink User="c.Author" />
                                    <span class="id-muted id-small">commented @Display.Ago(c.CreatedAt)@(c.EditedAt != null ? " · edited" : "")</span>
                                }
                                @if (c.IsPublicReply)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined" Class="ma-0" title="Emailed to the requester and shown on their tracking page">Reply to requester</MudChip>
                                }
                                else if (desk != null && c.ServiceDeskContactId == null)
                                {
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Class="ma-0" title="Not visible to the requester">Internal</MudChip>
                                }
                                @if (CanModerate(c) && editingCommentId != c.Id)
                                {
                                    <span class="ml-auto d-flex">
                                        <MudIconButton Icon="@Icons.Material.Outlined.Edit" Size="Size.Small" title="Edit comment" aria-label="Edit comment"
                                                       OnClick="() => { editingCommentId = c.Id; commentEditDraft = c.Body; }" />
                                        <MudIconButton Icon="@Icons.Material.Outlined.Delete" Size="Size.Small" Color="Color.Error" title="Delete comment" aria-label="Delete comment"
                                                       OnClick="() => DeleteComment(c)" />
                                    </span>
                                }
                            </div>
                            <div class="id-card-body">
                                @if (editingCommentId == c.Id)
                                {
                                    <MarkdownEditor @bind-Value="commentEditDraft" Rows="4" AttachToIssueId="issue.Id" ProjectId="issue.ProjectId" AttachFromComment />
                                    <div class="mt-2 d-flex gap-2">
                                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" OnClick="() => SaveCommentEdit(c)">Save</MudButton>
                                        <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="() => editingCommentId = null">Cancel</MudButton>
                                    </div>
                                }
                                else
                                {
                                    <div class="markdown">@Display.Markdown(c.Body)</div>
                                }
                            </div>
                        </MudPaper>
                    }
                    else if (entry is Activity a)
                    {
                        <div class="id-activity" @key="(2, a.Id)">
                            <Avatar User="a.Actor" Size="18" Link />
                            <span><UserLink User="a.Actor" /> <span class="md-inline">@Display.Markdown(a.Text)</span>
                            <span class="id-muted">@Display.Ago(a.CreatedAt)</span></span>
                        </div>
                    }
                }
            </div>

            <!-- New comment -->
            @if (perms.Can(Permission.Comment))
            {
            <MudPaper Outlined="true" Class="id-card mt-3">
                <div class="id-card-head"><Avatar User="Me.User" Size="22" /> <b>Add a comment</b>
                    @if (desk != null)
                    {
                        <MudToggleGroup T="bool" @bind-Value="replyToRequester" Size="Size.Small" Class="ml-auto" Outlined="true" aria-label="Comment mode">
                            <MudToggleItem Value="false">Internal comment</MudToggleItem>
                            <MudToggleItem Value="true">Reply to requester</MudToggleItem>
                        </MudToggleGroup>
                    }
                </div>
                <div class="id-card-body">
                    @if (desk != null && replyToRequester)
                    {
                        <MudAlert Severity="Severity.Info" Dense="true" Class="mb-2">
                            @if (desk.EmailEnabled) { <span>This reply is emailed to <b>@desk.Ticket.Contact.DisplayName</b> and shown on their tracking page.</span> }
                            else { <span>Email is turned off for this site: the reply is shown on the requester's tracking page but not emailed.</span> }
                        </MudAlert>
                    }
                    <MarkdownEditor @ref="commentEditor" @bind-Value="newComment" Rows="4" Placeholder="@(desk != null && replyToRequester ? "Reply to the requester…" : "Leave a comment…")" AttachToIssueId="issue.Id" ProjectId="issue.ProjectId" AttachFromComment />
                    <div class="mt-2 d-flex flex-wrap gap-2">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" Disabled="@string.IsNullOrWhiteSpace(newComment)" OnClick="AddComment">@(desk != null && replyToRequester ? "Send reply" : "Comment")</MudButton>
                        @if (!issue.Status.IsClosed() && CanEdit && CloseTarget != null)
                        {
                            <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Outlined.CheckCircle" OnClick="CommentAndClose">
                                @(string.IsNullOrWhiteSpace(newComment) ? "Close issue" : "Comment & close")
                            </MudButton>
                        }
                    </div>
                </div>
            </MudPaper>
            }
        </MudItem>

        <!-- Sidebar -->
        <MudItem xs="12" md="4" lg="3">
            <MudPaper Outlined="true" Class="id-side" aria-label="Issue fields">
                @* Viewers see the fields read-only (disabled); the service rejects edits anyway. Inputs are re-keyed after a failed
                   change so they show the issue's real value again. *@
                <MudStack Spacing="4">
                    <MudSelect T="int" @key="(nameof(SetWorkflowStatus), fieldsVersion)" Value="@(workflow.Effective(issue)?.Id ?? 0)" ValueChanged="SetWorkflowStatus"
                               Label="Status" Disabled="@(!CanEdit)" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true"
                               ToStringFunc="@(id => workflow.Statuses.FirstOrDefault(s => s.Id == id)?.Name ?? issue.Status.Name())">
                        @* Workflow statuses; moves the project's workflow doesn't allow are disabled. *@
                        @foreach (var s in workflow.Statuses)
                        {
                            <MudSelectItem Value="s.Id" Disabled="@(!workflow.IsAllowed(workflow.Effective(issue)?.Id, s.Id))">@s.Name</MudSelectItem>
                        }
                    </MudSelect>
                    <div>
                        <div class="d-flex align-center gap-2">
                            <Avatar User="issue.Assignee" Size="24" Link />
                            @* 0 stands for "Unassigned". *@
                            <MudSelect T="int" @key="(nameof(SetAssigneeId), fieldsVersion)" Value="@(issue.AssigneeId ?? 0)" ValueChanged="v => SetAssigneeId(v == 0 ? null : v)"
                                       Label="Assignee" Disabled="@(!CanEdit)" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" ToStringFunc="AssigneeName">
                                <MudSelectItem Value="0">Unassigned</MudSelectItem>
                                @foreach (var u in users) { <MudSelectItem Value="u.Id">@u.DisplayName</MudSelectItem> }
                            </MudSelect>
                        </div>
                        @if (issue.AssigneeId != Me.Id && CanEdit)
                        {
                            <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Primary" Class="id-link-btn" data-shortcut="assign-me" OnClick="() => SetAssigneeId(Me.Id)">Assign to me</MudButton>
                        }
                    </div>
                    <MudSelect T="IssuePriority" @key="(nameof(SetPriority), fieldsVersion)" Value="issue.Priority" ValueChanged="SetPriority" Label="Priority"
                               Disabled="@(!CanEdit)" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                        @foreach (var p in Enum.GetValues<IssuePriority>().Reverse())
                        {
                            <MudSelectItem Value="p"><span class="d-inline-flex align-center gap-2"><PriorityIcon Priority="p" /> @p</span></MudSelectItem>
                        }
                    </MudSelect>
                    <MudSelect T="IssueType" @key="(nameof(SetType), fieldsVersion)" Value="issue.Type" ValueChanged="SetType" Label="Type"
                               Disabled="@(!CanEdit)" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" ToStringFunc="@(t => $"{t.Icon()} {t}")">
                        @foreach (var t in Enum.GetValues<IssueType>()) { <MudSelectItem Value="t">@t.Icon() @t</MudSelectItem> }
                    </MudSelect>
                    <GitBench.Components.LinkedWork.ParentField Issue="issue" />
                    @* 0 stands for "None". *@
                    <MudSelect T="int" @key="(nameof(SetMilestone), fieldsVersion)" Value="@(issue.MilestoneId ?? 0)" ValueChanged="SetMilestone" Label="Milestone"
                               Disabled="@(!CanEdit)" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true"
                               ToStringFunc="@(id => id == 0 ? "None" : project.Milestones.FirstOrDefault(m => m.Id == id)?.Title ?? "")">
                        <MudSelectItem Value="0">None</MudSelectItem>
                        @foreach (var m in project.Milestones.Where(m => !m.IsClosed || m.Id == issue.MilestoneId)) { <MudSelectItem Value="m.Id">@m.Title</MudSelectItem> }
                    </MudSelect>
                    <IssueSprintField Issue="issue" />
                    <div>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary id-label">Labels</MudText>
                        <div class="id-labels">
                            @foreach (var l in project.Labels)
                            {
                                var on = issue.Labels.Any(x => x.Id == l.Id);
                                <MudChip T="string" Size="Size.Small" Class="ma-0" Disabled="@(!CanEdit)" OnClick="() => ToggleLabel(l)" aria-pressed="@(on ? "true" : "false")"
                                         Variant="@(on ? Variant.Filled : Variant.Outlined)" Icon="@(on ? Icons.Material.Filled.Check : null)"
                                         Style="@(on ? $"background:{l.Color};color:{Display.TextOn(l.Color)}" : $"border-color:{l.Color};color:var(--mud-palette-text-primary)")">@l.Name</MudChip>
                            }
                            @if (project.Labels.Count == 0)
                            {
                                <a class="id-small" href="/p/@project.Key/settings">Create labels</a>
                            }
                        </div>
                    </div>
                    <MudNumericField T="int?" @key="(nameof(SetPoints), fieldsVersion)" Value="issue.StoryPoints" ValueChanged="SetPoints" Label="Story points"
                                     Min="0" Max="100" Disabled="@(!CanEdit)" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    <MudDatePicker @key="(nameof(SetStart), fieldsVersion)" Date="issue.StartDate" DateChanged="SetStart" Label="Start date" Disabled="@(!CanEdit)"
                                   Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" DateFormat="yyyy-MM-dd" Editable="true" />
                    <MudDatePicker @key="(nameof(SetDue), fieldsVersion)" Date="issue.DueDate" DateChanged="SetDue" Label="Due date" Disabled="@(!CanEdit)"
                                   Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" DateFormat="yyyy-MM-dd" Editable="true" />
                </MudStack>
                <GitBench.Components.Fields.IssueFieldsPanel Issue="issue" />
                <GitBench.Components.Workbench.WorkbenchIssuePanel Issue="issue" Project="project" Perms="perms" />
                <GitBench.Components.Repositories.DevelopmentPanel Issue="issue" />
                @if (desk != null) { <GitBench.Components.ServiceDesk.ServiceDeskIssuePanel Info="desk" /> }
                <div class="id-reporter">
                    <div>Reporter: <Avatar User="issue.Reporter" Size="18" ShowName Link /></div>
                    <div>Created @issue.CreatedAt.ToLocalTime().ToString("g")</div>
                    <div>Updated @Display.Ago(issue.UpdatedAt)</div>
                </div>
                @if (perms.Role >= ProjectRole.Maintainer)
                {
                    <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small" FullWidth="true" StartIcon="@Icons.Material.Outlined.Delete"
                               OnClick="Delete" Class="mt-3">Delete issue</MudButton>
                }
            </MudPaper>
        </MudItem>
    </MudGrid>
</div>
}

@code {
    [Parameter] public string Key { get; set; } = "";
    [Parameter] public int Number { get; set; }

    private Issue? issue;
    private Project? project;
    private List<User> users = [];
    private bool notFound;
    private ProjectPermissions perms = ProjectPermissions.None;
    private string? error;
    private int fieldsVersion; // bumped when a change fails, so the side panel's inputs re-render with the stored values
    private bool CanEdit => perms.Can(Permission.EditIssues);
    private ProjectWorkflow workflow = ProjectWorkflow.Empty;
    private IEnumerable<WorkflowStatus> AllowedTargets => workflow.AllowedFrom(workflow.Effective(issue!));
    // "Close issue": the first Done status the workflow allows; "Reopen": the first allowed open status, preferring To Do.
    private WorkflowStatus? CloseTarget => AllowedTargets.FirstOrDefault(s => s.Category == IssueStatus.Done);
    private WorkflowStatus? ReopenTarget => AllowedTargets.Where(s => s.Category != IssueStatus.Done)
        .OrderBy(s => s.Category == IssueStatus.Todo ? 0 : 1).FirstOrDefault();
    // Authors edit/delete their own comments; Maintainers and above can moderate anyone's.
    private bool CanModerate(Comment c) => (c.AuthorId == Me.Id && perms.Can(Permission.Comment)) || perms.Role >= ProjectRole.Maintainer;

    private List<BreadcrumbItem> Crumbs =>
    [
        new(project!.Name, $"/p/{project.Key}/issues"),
        new("Issues", $"/p/{project.Key}/issues"),
        new(issue!.Key, null, disabled: true),
    ];

    private string AssigneeName(int id) => id == 0 ? "Unassigned" : users.FirstOrDefault(u => u.Id == id)?.DisplayName ?? "";

    private bool editingTitle, editingDesc;
    private string titleDraft = "";
    private string? descDraft, newComment, commentEditDraft;
    private int? editingCommentId;
    private MarkdownEditor? commentEditor;
    private GitBench.Services.ServiceDesk.ServiceDeskIssueInfo? desk; // set when the issue came in through the service desk
    private bool replyToRequester;

    private IEnumerable<object> Timeline => issue!.Comments.Select(c => (when: c.CreatedAt, item: (object)c))
        .Concat(issue.Activities.Where(a => a.Text != "created this issue").Select(a => (when: a.CreatedAt, item: (object)a)))
        .OrderBy(x => x.when).Select(x => x.item);

    protected override async Task OnParametersSetAsync()
    {
        users = await Issues.GetUsersAsync();
        project = await Issues.GetProjectAsync(Key);
        perms = project == null ? ProjectPermissions.None : await Access.GetPermissionsAsync(project.Id);
        workflow = project == null ? ProjectWorkflow.Empty : await Workflows.GetAsync(project.Id);
        await Reload();
    }

    /// <summary>Shows permission (ForbiddenException) and validation errors instead of crashing the circuit.</summary>
    private async Task<bool> Guard(Func<Task> action)
    {
        error = null;
        try { await action(); return true; }
        catch (InvalidOperationException ex) { error = ex.Message; fieldsVersion++; return false; }
    }

    private async Task Reload()
    {
        issue = await Issues.GetIssueAsync(Key, Number);
        notFound = issue == null;
        if (issue != null)
        {
            watching = await Notifications.IsWatchingIssueAsync(Me.Id, issue.Id);
            watcherCount = await Notifications.CountIssueWatchersAsync(issue.Id);
            desk = await Desk.GetIssueInfoAsync(issue.Id);
        }
    }

    // ----- Watching -----
    private bool watching;
    private int watcherCount;

    private async Task ToggleWatch()
    {
        await Notifications.SetIssueWatchAsync(Me.Id, issue!.Id, !watching);
        await Reload();
    }

    // ----- Live updates -----
    // Reload replaces only `issue`; the drafts (titleDraft, descDraft, newComment, commentEditDraft) and editing
    // flags are separate fields, so someone else's change never clobbers what this user is typing.
    private IDisposable? liveSubscription;

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender) liveSubscription = Live.Subscribe<IssueChanged>(OnIssueChanged);
    }

    private Task OnIssueChanged(IssueChanged e) => issue?.Id != e.IssueId ? Task.CompletedTask : InvokeAsync(async () =>
    {
        await Reload();
        StateHasChanged();
    });

    public void Dispose() => liveSubscription?.Dispose();

    private async Task Change(Func<Issue, AppDbContext, Task<string?>> change)
    {
        await Guard(() => Issues.UpdateIssueAsync(issue!.Id, Me.Id, change));
        await Reload();
    }

    private Task Change(Func<Issue, string?> change) => Change((i, _) => Task.FromResult(change(i)));

    // ----- Title / description -----
    private void StartEditTitle() { titleDraft = issue!.Title; editingTitle = true; }

    private async Task TitleKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await SaveTitle();
        if (e.Key == "Escape") editingTitle = false;
    }

    private async Task SaveTitle()
    {
        var t = (titleDraft ?? "").Trim();
        if (t.Length is 0 or > 200) return;
        await Change(i => { if (i.Title == t) return null; var old = i.Title; i.Title = t; return $"changed the title from ~~{old}~~ to **{t}**"; });
        editingTitle = false;
    }

    private void StartEditDesc() { descDraft = issue!.Description; editingDesc = true; }

    private async Task SaveDesc()
    {
        await Change(i => { if (i.Description == descDraft) return null; i.Description = descDraft; return "updated the description"; });
        editingDesc = false;
    }

    // ----- Sidebar fields -----
    private async Task SetStatus(IssueStatus s)
    {
        await Guard(() => Issues.SetStatusAsync(issue!.Id, s, Me.Id));
        await Reload();
    }

    private async Task SetWorkflowStatus(int workflowStatusId)
    {
        await Guard(() => Issues.SetWorkflowStatusAsync(issue!.Id, workflowStatusId, Me.Id));
        await Reload();
    }

    private Task SetAssigneeId(int? id) => Change(i =>
    {
        if (i.AssigneeId == id) return null;
        i.AssigneeId = id;
        var u = users.FirstOrDefault(x => x.Id == id);
        return u == null ? "removed the assignee" : u.Id == Me.Id ? "self-assigned this issue" : $"assigned to **{u.DisplayName}**";
    });

    private Task SetPriority(IssuePriority p) => Change(i =>
    {
        if (i.Priority == p) return null;
        i.Priority = p;
        return $"set priority to **{p}**";
    });

    private Task SetType(IssueType t) => Change(i =>
    {
        if (i.Type == t) return null;
        i.Type = t;
        return $"changed type to **{t}**";
    });

    private Task SetMilestone(int value) => Change(i =>
    {
        int? id = value == 0 ? null : value;
        if (i.MilestoneId == id) return null;
        i.MilestoneId = id;
        var m = project!.Milestones.FirstOrDefault(x => x.Id == id);
        return m == null ? "removed the milestone" : $"added to milestone **{m.Title}**";
    });

    private Task ToggleLabel(Label label) => Change(async (i, db) =>
    {
        var existing = i.Labels.FirstOrDefault(l => l.Id == label.Id);
        if (existing != null)
        {
            i.Labels.Remove(existing);
            return $"removed label **{label.Name}**";
        }
        i.Labels.Add((await db.Labels.FindAsync(label.Id))!);
        return $"added label **{label.Name}**";
    });

    private Task SetPoints(int? value) => Change(i =>
    {
        int? p = value is { } v ? Math.Clamp(v, 0, 100) : null;
        if (i.StoryPoints == p) return null;
        var old = i.StoryPoints;
        i.StoryPoints = p;
        return SprintHistory.EstimateText(old, p);
    });

    // Start date (roadmap): must not be after the due date.
    private Task SetStart(DateTime? value) => Change(i =>
    {
        DateTime? d = value?.Date;
        if (d != null && i.DueDate is { } due && d > due.Date) throw new InvalidOperationException("The start date must be on or before the due date.");
        var text = GitBench.Services.Roadmap.RoadmapService.DatesText(i.StartDate, i.DueDate, d, i.DueDate);
        i.StartDate = d;
        return text;
    });

    private Task SetDue(DateTime? value) => Change(i =>
    {
        DateTime? d = value?.Date;
        if (i.DueDate == d) return null;
        i.DueDate = d;
        return d == null ? "removed the due date" : $"set the due date to **{d:MMM d, yyyy}**";
    });

    // ----- Comments -----
    private async Task AddComment()
    {
        if (string.IsNullOrWhiteSpace(newComment)) return;
        // Only "Reply to requester" ever emails a service desk requester; ordinary comments stay internal.
        var sendToRequester = desk != null && replyToRequester;
        if (!await Guard(() => sendToRequester ? (Task)Desk.ReplyToRequesterAsync(issue!.Id, newComment.Trim()) : Issues.AddCommentAsync(issue!.Id, Me.Id, newComment.Trim()))) return;
        newComment = null;
        replyToRequester = false;
        commentEditor?.ShowWrite();
        await Reload();
    }

    private async Task CommentAndClose()
    {
        var sendToRequester = desk != null && replyToRequester;
        if (!string.IsNullOrWhiteSpace(newComment)
            && !await Guard(() => sendToRequester ? (Task)Desk.ReplyToRequesterAsync(issue!.Id, newComment.Trim()) : Issues.AddCommentAsync(issue!.Id, Me.Id, newComment.Trim()))) return;
        newComment = null;
        replyToRequester = false;
        if (CloseTarget is { } close) await SetWorkflowStatus(close.Id);
        else await SetStatus(IssueStatus.Done);
    }

    private async Task SaveCommentEdit(Comment c)
    {
        if (string.IsNullOrWhiteSpace(commentEditDraft)) return;
        if (!await Guard(() => Issues.EditCommentAsync(c.Id, commentEditDraft.Trim()))) return;
        editingCommentId = null;
        await Reload();
    }

    private async Task DeleteComment(Comment c)
    {
        if (await Dialogs.ShowMessageBoxAsync("Delete comment", "Delete this comment?", yesText: "Delete", cancelText: "Cancel") != true) return;
        await Guard(() => Issues.DeleteCommentAsync(c.Id));
        await Reload();
    }

    private async Task Delete()
    {
        var text = await LinkedWork.DeleteConfirmTextAsync(issue!.Id, issue.Key);
        if (await Dialogs.ShowMessageBoxAsync($"Delete {issue.Key}?", text, yesText: "Delete issue", cancelText: "Cancel") != true) return;
        if (!await Guard(() => Issues.DeleteIssueAsync(issue.Id))) return;
        Nav.NavigateTo($"/p/{project!.Key}/issues");
    }
}
