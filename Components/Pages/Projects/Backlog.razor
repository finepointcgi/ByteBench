@page "/p/{Key}/backlog"
@implements IDisposable
@inject IssueService Issues
@inject SprintService Sprints
@inject ProjectAccess Access
@inject LiveEvents Live
@inject IDialogService Dialogs

<PageTitle>Backlog · @project?.Name</PageTitle>

@if (notFound)
{
    <ProjectNotFound />
}
else if (project != null)
{
    <div class="bl-page">
    <div class="d-flex align-center justify-space-between flex-wrap gap-4 mb-4">
        <div>
            <MudText Typo="Typo.h5" Class="bl-heading">Backlog</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary">@project.Name · plan sprints by dragging issues, or use each issue's “Move” menu</MudText>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <MudButton Href="@($"/p/{project.Key}/reports")" Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Outlined.Insights">Reports</MudButton>
            @if (perms.Can(Permission.ManageLabelsAndMilestones) && !creating)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Add" OnClick="StartCreate">Create sprint</MudButton>
            }
        </div>
    </div>

    @if (error != null) { <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3" role="alert">@error</MudAlert> }

    @if (creating)
    {
        <form class="sprint-panel sprint-inline-create" @onsubmit="CreateSprint" @onsubmit:preventDefault>
            <MudTextField T="string" @bind-Value="newName" MaxLength="100" Label="Sprint name" Variant="Variant.Outlined" Margin="Margin.Dense" Class="sprint-inline-field" />
            <MudTextField T="string" @bind-Value="newGoal" MaxLength="500" Label="Goal (optional)" Variant="Variant.Outlined" Margin="Margin.Dense" Class="sprint-inline-field" />
            <div class="d-flex align-center gap-2">
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small">Create</MudButton>
                <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="() => creating = false">Cancel</MudButton>
            </div>
        </form>
    }

    @foreach (var section in sections)
    {
        var s = section.Sprint;
        var isOver = dragOver == section.DomId;
        <section class="bl-section @(s == null ? "bl-backlog" : "bl-" + s.State.ToString().ToLowerInvariant()) @(isOver ? "drag-over" : "")"
                 id="@section.DomId" aria-label="@(s?.Name ?? "Backlog")"
                 @ondragover:preventDefault
                 @ondragenter="() => dragOver = section.DomId"
                 @ondrop="() => Drop(section, null)">
            <header class="bl-head">
                <div class="bl-title">
                    <h2 class="bl-name">@(s?.Name ?? "Backlog")</h2>
                    @if (s?.State == SprintState.Active) { <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Text" Class="ma-0">Active</MudChip> }
                    @if (s != null && (s.StartDate != null || s.EndDate != null))
                    {
                        <span class="bl-dates">@s.StartDate?.ToString("MMM d") – @s.EndDate?.ToString("MMM d, yyyy")@DaysLeft(s)</span>
                    }
                </div>
                <div class="bl-stats">
                    <span class="bl-pill" title="Issues">@section.Issues.Count @(section.Issues.Count == 1 ? "issue" : "issues")</span>
                    <span class="bl-pill" title="Story points">@section.Points pts</span>
                    <GitBench.Components.Fields.TimeSpentPill Issues="section.Issues" />
                    @if (s?.State == SprintState.Active)
                    {
                        <span class="bl-dates">@section.DoneCount/@section.Issues.Count done · @section.DonePoints/@section.Points pts</span>
                    }
                </div>
                @if (s != null && perms.Can(Permission.ManageLabelsAndMilestones))
                {
                    <div class="bl-actions">
                        @if (s.State == SprintState.Planned)
                        {
                            <MudTooltip Text="@(Active != null ? "Complete the active sprint first" : "")" Disabled="@(Active == null)">
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" Disabled="@(Active != null)"
                                           StartIcon="@Icons.Material.Filled.PlayArrow" OnClick="() => OpenPanel(s, Panel.Start)">Start sprint</MudButton>
                            </MudTooltip>
                        }
                        @if (s.State == SprintState.Active)
                        {
                            <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small" StartIcon="@Icons.Material.Filled.Check"
                                       OnClick="() => OpenPanel(s, Panel.Complete)">Complete sprint</MudButton>
                        }
                        <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Outlined.Edit" OnClick="() => OpenPanel(s, Panel.Edit)">Edit</MudButton>
                        <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small" StartIcon="@Icons.Material.Outlined.Delete" OnClick="() => DeleteSprint(s)">Delete</MudButton>
                    </div>
                }
                @if (!string.IsNullOrEmpty(s?.Goal))
                {
                    <div class="bl-goal"><MudIcon Icon="@Icons.Material.Outlined.TrackChanges" Size="Size.Small" /> @s.Goal</div>
                }
            </header>

            @if (s != null && panelFor == s.Id)
            {
                @if (panel is Panel.Start or Panel.Edit)
                {
                    <form class="sprint-panel" @onsubmit="SubmitPanel" @onsubmit:preventDefault>
                        <div class="sprint-form-grid">
                            @if (panel == Panel.Edit)
                            {
                                <MudTextField T="string" @bind-Value="draftName" MaxLength="100" Required="true" Label="Name" Variant="Variant.Outlined" Margin="Margin.Dense" />
                            }
                            <MudDatePicker @bind-Date="draftStart" Label="Start date" Required="@(panel == Panel.Start)" Variant="Variant.Outlined" Margin="Margin.Dense"
                                           Editable="true" Clearable="@(panel == Panel.Edit)" DateFormat="yyyy-MM-dd" />
                            <MudDatePicker @bind-Date="draftEnd" Label="End date" Required="@(panel == Panel.Start)" Variant="Variant.Outlined" Margin="Margin.Dense"
                                           Editable="true" Clearable="@(panel == Panel.Edit)" DateFormat="yyyy-MM-dd" />
                            <div class="sprint-form-wide">
                                <MudTextField T="string" @bind-Value="draftGoal" MaxLength="500" Label="Sprint goal" Placeholder="What should this sprint achieve?"
                                              Variant="Variant.Outlined" Margin="Margin.Dense" />
                            </div>
                        </div>
                        @if (panel == Panel.Start)
                        {
                            <MudText Typo="Typo.body2" Class="mud-text-secondary mb-2">@section.Issues.Count issues (@section.Points story points) will be committed to this sprint.</MudText>
                        }
                        <div class="d-flex gap-2">
                            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small">@(panel == Panel.Start ? "Start sprint" : "Save")</MudButton>
                            <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="ClosePanel">Cancel</MudButton>
                        </div>
                    </form>
                }
                else if (panel == Panel.Complete)
                {
                    var openCount = section.Issues.Count - section.DoneCount;
                    <div class="sprint-panel">
                        <div class="sprint-complete-stats">
                            <div><strong>@section.DoneCount</strong> done <span class="bl-muted">(@section.DonePoints pts)</span></div>
                            <div><strong>@openCount</strong> open <span class="bl-muted">(@(section.Points - section.DonePoints) pts)</span></div>
                        </div>
                        @if (openCount > 0)
                        {
                            <div class="sprint-carry">
                                <MudSelect T="string" @bind-Value="carryTarget" @bind-Value:after="SuggestCarryNameAsync" Label="Move the open issues to"
                                           Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Class="mb-2">
                                    @foreach (var p in Planned) { <MudSelectItem T="string" Value="@($"s:{p.Id}")">@p.Name</MudSelectItem> }
                                    <MudSelectItem T="string" Value="@("new")">A new sprint</MudSelectItem>
                                    <MudSelectItem T="string" Value="@("backlog")">The backlog</MudSelectItem>
                                </MudSelect>
                                @if (carryTarget == "new")
                                {
                                    <MudTextField T="string" @bind-Value="carryNewName" MaxLength="100" Label="New sprint name" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-2" />
                                }
                            </div>
                        }
                        else
                        {
                            <MudText Typo="Typo.body2" Class="mb-2">🎉 Every issue in this sprint is done.</MudText>
                        }
                        <div class="d-flex gap-2">
                            <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small" OnClick="() => CompleteSprint(s)">Complete sprint</MudButton>
                            <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="ClosePanel">Cancel</MudButton>
                        </div>
                    </div>
                }
            }

            <div class="bl-issues" role="list">
                @foreach (var i in section.Issues)
                {
                    var idx = section.Issues.IndexOf(i);
                    <div class="bl-row @(i.Status == IssueStatus.Done ? "done" : "") @(dragging?.Id == i.Id ? "dragging" : "")" role="listitem" @key="i.Id"
                         draggable="@(canEdit ? "true" : "false")"
                         @ondragstart="() => dragging = i"
                         @ondragend="() => { dragging = null; dragOver = null; }"
                         @ondrop="() => Drop(section, i.Id)" @ondrop:stopPropagation>
                        @if (canEdit) { <MudIcon Icon="@Icons.Material.Filled.DragIndicator" Size="Size.Small" Class="bl-grip" aria-hidden="true" /> }
                        <span class="issue-type" title="@i.Type">@i.Type.Icon()</span>
                        <a class="mono bl-key" href="/p/@project.Key/issues/@i.Number" draggable="false">@i.Key</a>
                        <a class="bl-issue-title" href="/p/@project.Key/issues/@i.Number" draggable="false">@i.Title</a>
                        <span class="bl-labels">@foreach (var l in i.Labels.OrderBy(l => l.Name)) { <LabelChip Label="l" /> }</span>
                        <span class="bl-meta">
                            <StatusBadge Status="i.Status" />
                            <PriorityIcon Priority="i.Priority" />
                            <span class="bl-pill" title="Story points">@(i.StoryPoints?.ToString() ?? "–")</span>
                            <Avatar User="i.Assignee" Size="22" />
                            @if (canEdit)
                            {
                                <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small" Dense="true" AriaLabel="@($"Move {i.Key}")"
                                         AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                                    @if (idx > 0)
                                    {
                                        <MudMenuItem Icon="@Icons.Material.Filled.VerticalAlignTop" OnClick="() => MoveVia(section, idx, MoveTop)">To top</MudMenuItem>
                                        <MudMenuItem Icon="@Icons.Material.Filled.ArrowUpward" OnClick="() => MoveVia(section, idx, MoveUp)">Up</MudMenuItem>
                                    }
                                    @if (idx < section.Issues.Count - 1)
                                    {
                                        <MudMenuItem Icon="@Icons.Material.Filled.ArrowDownward" OnClick="() => MoveVia(section, idx, MoveDown)">Down</MudMenuItem>
                                        <MudMenuItem Icon="@Icons.Material.Filled.VerticalAlignBottom" OnClick="() => MoveVia(section, idx, MoveBottom)">To bottom</MudMenuItem>
                                    }
                                    @if (section.Issues.Count > 1) { <MudDivider /> }
                                    @foreach (var other in sections.Where(x => x != section))
                                    {
                                        var target = other.Sprint is { } os ? $"s:{os.Id}" : "backlog";
                                        <MudMenuItem Icon="@Icons.Material.Filled.ArrowForward" OnClick="() => MoveVia(section, idx, target)">Move to @(other.Sprint?.Name ?? "the backlog")</MudMenuItem>
                                    }
                                </MudMenu>
                            }
                        </span>
                    </div>
                }
                @if (section.Issues.Count == 0)
                {
                    <div class="bl-empty">@(s == null ? "The backlog is empty." : canEdit ? "Plan this sprint by dragging issues here." : "No issues in this sprint.")</div>
                }
            </div>
        </section>
    }
    </div>
}

@code {
    [Parameter] public string Key { get; set; } = "";

    private enum Panel { None, Start, Edit, Complete }

    private Project? project;
    private bool notFound, canEdit;
    private ProjectPermissions perms = ProjectPermissions.None;
    private List<BacklogSection> sections = [];
    private string? error;

    private Issue? dragging;
    private string? dragOver;
    private const string MoveTop = "top", MoveUp = "up", MoveDown = "down", MoveBottom = "bottom";

    private bool creating;
    private string? newName, newGoal;

    private Panel panel;
    private int? panelFor;
    private string draftName = "";
    private string? draftGoal;
    private DateTime? draftStart, draftEnd;
    private string carryTarget = "backlog";
    private string? carryNewName;

    private Sprint? Active => sections.Select(x => x.Sprint).FirstOrDefault(s => s?.State == SprintState.Active);
    private IEnumerable<Sprint> Planned => sections.Select(x => x.Sprint).OfType<Sprint>().Where(s => s.State == SprintState.Planned);

    protected override async Task OnParametersSetAsync()
    {
        if (project?.Key == Key.ToUpperInvariant()) return;
        project = await Issues.GetProjectAsync(Key);
        notFound = project == null;
        if (project == null) return;
        perms = await Access.GetPermissionsAsync(project.Id);
        canEdit = perms.Can(Permission.EditIssues);
        await Load();
    }

    private async Task Load()
    {
        if (project == null) return;
        sections = await Sprints.GetBacklogAsync(project.Id);
    }

    private static string DaysLeft(Sprint s)
    {
        if (s.State != SprintState.Active || s.EndDate is not { } end) return "";
        var d = (end.Date - DateTime.UtcNow.Date).Days;
        return d < 0 ? $" · ended {-d}d ago" : d == 0 ? " · ends today" : $" · {d}d left";
    }

    // ----- Live updates: anyone changed sprints, issues or the board in this project -----
    private IDisposable? liveSubscription;

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender) liveSubscription = Live.Subscribe(OnLive);
    }

    private Task OnLive(LiveEvent e)
    {
        var pid = e switch { SprintChanged x => x.ProjectId, BoardChanged x => x.ProjectId, IssueChanged x => x.ProjectId, _ => -1 };
        if (pid != project?.Id || dragging != null) return Task.CompletedTask;
        return InvokeAsync(async () => { await Load(); StateHasChanged(); });
    }

    public void Dispose() => liveSubscription?.Dispose();

    private async Task Guard(Func<Task> action)
    {
        error = null;
        try { await action(); }
        catch (InvalidOperationException ex) { error = ex.Message; }
        await Load();
    }

    // ----- Planning -----

    private async Task Drop(BacklogSection target, int? beforeId)
    {
        var moved = dragging;
        dragging = null;
        dragOver = null;
        if (moved == null || moved.Id == beforeId) return;

        // Optimistic local move so the UI responds instantly.
        foreach (var sec in sections) sec.Issues.RemoveAll(x => x.Id == moved.Id);
        var idx = beforeId is { } b ? target.Issues.FindIndex(x => x.Id == b) : -1;
        if (idx < 0) target.Issues.Add(moved); else target.Issues.Insert(idx, moved);

        await Guard(() => Sprints.MoveIssueAsync(moved.Id, target.Sprint?.Id, beforeId));
    }

    private async Task MoveVia(BacklogSection section, int idx, string value)
    {
        var list = section.Issues;
        if (value == "" || idx < 0 || idx >= list.Count) return;
        var issue = list[idx];
        int? sid = section.Sprint?.Id;
        switch (value)
        {
            case "top": await Guard(() => Sprints.MoveIssueAsync(issue.Id, sid, list[0].Id)); break;
            case "up": await Guard(() => Sprints.MoveIssueAsync(issue.Id, sid, list[idx - 1].Id)); break;
            case "down": await Guard(() => Sprints.MoveIssueAsync(issue.Id, sid, idx + 2 < list.Count ? list[idx + 2].Id : null)); break;
            case "bottom": await Guard(() => Sprints.MoveIssueAsync(issue.Id, sid, null)); break;
            case "backlog": await Guard(() => Sprints.MoveIssueAsync(issue.Id, null, null)); break;
            default:
                if (value.StartsWith("s:") && int.TryParse(value[2..], out var target))
                    await Guard(() => Sprints.MoveIssueAsync(issue.Id, target, null));
                break;
        }
    }

    // ----- Sprints -----

    private async Task StartCreate()
    {
        newName = await Sprints.SuggestNameAsync(project!.Id);
        newGoal = null;
        creating = true;
    }

    private async Task CreateSprint()
    {
        await Guard(async () =>
        {
            await Sprints.CreateSprintAsync(project!.Id, newName, newGoal);
            creating = false;
        });
    }

    private void OpenPanel(Sprint s, Panel p)
    {
        error = null;
        panel = p;
        panelFor = s.Id;
        draftName = s.Name;
        draftGoal = s.Goal;
        var today = DateTime.UtcNow.Date;
        draftStart = s.StartDate;
        draftEnd = s.EndDate;
        if (p == Panel.Start)
        {
            // Starting now: begin today and keep the planned length (two weeks by default).
            var length = s.StartDate is { } ps && s.EndDate is { } pe && pe >= ps ? (pe - ps).Days : 13;
            draftStart = today;
            draftEnd = today.AddDays(length);
        }
        carryTarget = Planned.FirstOrDefault(x => x.Id != s.Id) is { } next ? $"s:{next.Id}" : "new";
        carryNewName = null;
        if (carryTarget == "new") _ = SuggestCarryNameAsync();
    }

    private async Task SuggestCarryNameAsync()
    {
        if (carryTarget != "new" || !string.IsNullOrWhiteSpace(carryNewName)) return;
        carryNewName = await Sprints.SuggestNameAsync(project!.Id);
        await InvokeAsync(StateHasChanged);
    }

    private void ClosePanel() { panel = Panel.None; panelFor = null; }

    private async Task SubmitPanel()
    {
        if (panelFor is not { } id) return;
        if (panel == Panel.Start)
        {
            if (draftStart is not { } start || draftEnd is not { } end) { error = "Pick a start and an end date."; return; }
            await Guard(async () => { await Sprints.StartSprintAsync(id, start, end, draftGoal); ClosePanel(); });
        }
        else
        {
            await Guard(async () => { await Sprints.UpdateSprintAsync(id, draftName, draftGoal, draftStart, draftEnd); ClosePanel(); });
        }
    }

    private async Task CompleteSprint(Sprint s)
    {
        var (mode, target) = carryTarget switch
        {
            "backlog" => (CarryOver.Backlog, (int?)null),
            "new" => (CarryOver.NewSprint, null),
            var v when v.StartsWith("s:") && int.TryParse(v[2..], out var t) => (CarryOver.ExistingSprint, t),
            _ => (CarryOver.Backlog, null),
        };
        await Guard(async () => { await Sprints.CompleteSprintAsync(s.Id, mode, target, carryNewName); ClosePanel(); });
    }

    private async Task DeleteSprint(Sprint s)
    {
        var ok = await Dialogs.ShowMessageBoxAsync("Delete sprint", $"Delete sprint \"{s.Name}\"? Its issues go back to the backlog.",
            yesText: "Delete", cancelText: "Cancel");
        if (ok != true) return;
        await Guard(() => Sprints.DeleteSprintAsync(s.Id));
    }
}
