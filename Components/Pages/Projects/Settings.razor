@page "/p/{Key}/settings"
@inject IssueService Issues
@inject GroupService GroupSvc
@inject ProjectAccess Access
@inject NavigationManager Nav
@inject IDialogService Dialogs
@inject ISnackbar Snackbar

<PageTitle>Settings · @project?.Name</PageTitle>

<div class="settings-page">
@if (notFound)
{
    <ProjectNotFound />
}
else if (project != null && !perms.Can(Permission.ManageLabelsAndMilestones))
{
    <Forbidden Message="Only Maintainers and Owners can change this project's settings." />
}
else if (project != null)
{
    <div class="page-header"><MudText Typo="Typo.h5" HtmlTag="h1">Project settings</MudText></div>
    @if (error != null) { <MudAlert Severity="Severity.Error" Dense="true" Class="settings-card mb-4">@error</MudAlert> }

    @if (perms.Can(Permission.ManageProjectSettings))
    {
        <MudPaper Outlined="true" Class="settings-card pa-5 mb-4">
            <MudText Typo="Typo.subtitle1" HtmlTag="h2" Class="settings-title">General</MudText>
            <MudStack Spacing="3">
                <MudTextField T="string" Label="Name" @bind-Value="name" Immediate="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
                <MudTextField T="string" Label="Key" Value="project.Key" Disabled="true" Variant="Variant.Outlined" Margin="Margin.Dense"
                              Class="settings-mono" HelperText="Keys can't be changed after creation." />
                <MudTextField T="string" Label="Description" @bind-Value="description" Lines="3" Sizing="InputSizing.Auto" Variant="Variant.Outlined" Margin="Margin.Dense" />
                <MudSelect T="ProjectVisibility" Label="Visibility" @bind-Value="visibility" Variant="Variant.Outlined" Margin="Margin.Dense"
                           AnchorOrigin="Origin.BottomLeft" aria-label="Visibility">
                    <MudSelectItem Value="ProjectVisibility.Private">Private: only members can see it</MudSelectItem>
                    <MudSelectItem Value="ProjectVisibility.Internal">Internal: every signed-in user can see it (as Viewer)</MudSelectItem>
                </MudSelect>
                <div>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" Disabled="@string.IsNullOrWhiteSpace(name)"
                               OnClick="SaveGeneral">Save</MudButton>
                </div>
            </MudStack>
        </MudPaper>
    }

    <MudPaper Outlined="true" Class="settings-card pa-5 mb-4">
        <MudText Typo="Typo.subtitle1" HtmlTag="h2" Class="settings-title">Labels</MudText>
        <div class="label-list">
            @foreach (var l in project.Labels.Where(l => l.ProjectId == project.Id))
            {
                <div class="label-line" @key="l.Id">
                    @if (editLabel?.Id == l.Id)
                    {
                        <input type="color" class="color-input" aria-label="Label colour" @bind="editLabel.Color" />
                        <MudTextField T="string" @bind-Value="editLabel.Name" Immediate="true" Variant="Variant.Outlined" Margin="Margin.Dense"
                                      Class="label-name-input" aria-label="Label name" />
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" OnClick="SaveLabel">Save</MudButton>
                        <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="() => editLabel = null">Cancel</MudButton>
                    }
                    else
                    {
                        <LabelChip Label="l" />
                        <span class="label-spacer"></span>
                        <MudTooltip Text="Edit">
                            <MudIconButton Icon="@Icons.Material.Outlined.Edit" Size="Size.Small" aria-label="@($"Edit label {l.Name}")"
                                           OnClick="() => editLabel = new Label { Id = l.Id, ProjectId = l.ProjectId, Name = l.Name, Color = l.Color }" />
                        </MudTooltip>
                        <MudTooltip Text="Delete">
                            <MudIconButton Icon="@Icons.Material.Outlined.Delete" Size="Size.Small" Color="Color.Error" aria-label="@($"Delete label {l.Name}")"
                                           OnClick="() => DeleteLabel(l)" />
                        </MudTooltip>
                    }
                </div>
            }
        </div>
        @foreach (var l in project.Labels.Where(l => l.GroupId != null))
        {
            <div class="label-line" @key="l.Id">
                <LabelChip Label="l" />
                <span class="label-spacer"></span>
                <MudText Typo="Typo.caption" Class="mud-text-secondary">Group label (read-only here)</MudText>
            </div>
        }
        <div class="label-line label-new">
            <input type="color" class="color-input" aria-label="New label colour" @bind="newLabel.Color" />
            <MudTextField T="string" Placeholder="New label name" @bind-Value="newLabel.Name" Immediate="true" Variant="Variant.Outlined"
                          Margin="Margin.Dense" Class="label-name-input" aria-label="New label name" />
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Add"
                       Disabled="@string.IsNullOrWhiteSpace(newLabel.Name)" OnClick="AddLabel">Add label</MudButton>
        </div>
        @if (labelError != null) { <MudText Typo="Typo.caption" Color="Color.Error" HtmlTag="div" Class="mt-2">@labelError</MudText> }
    </MudPaper>

    <AiReviewSettings Project="project" />

    @if (perms.Can(GitBench.Services.Webhooks.WebhookService.RequiredPermission))
    {
        <MudPaper Outlined="true" Class="settings-card pa-5 mb-4">
            <MudText Typo="Typo.subtitle1" HtmlTag="h2" Class="settings-title">Webhooks</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">Notify other services about pushes, issues, pull requests and pipelines in this project.</MudText>
            <MudButton Href="@($"/p/{project.Key}/settings/webhooks")" Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                       StartIcon="@Icons.Material.Outlined.Webhook">Manage webhooks</MudButton>
        </MudPaper>
    }

    @if (perms.Role >= ProjectRole.Maintainer)
    {
        <MudPaper Outlined="true" Class="settings-card pa-5 mb-4">
            <MudText Typo="Typo.subtitle1" HtmlTag="h2" Class="settings-title">Automation</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">Rules that react to issues, pull requests, pipelines or a schedule: transition, assign, label, comment, notify and more.</MudText>
            <MudButton Href="@($"/p/{project.Key}/settings/automation")" Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                       StartIcon="@Icons.Material.Outlined.Bolt">Automation rules</MudButton>
        </MudPaper>
    }

    @if (perms.Can(Permission.ManageRepositories))
    {
        <MudPaper Outlined="true" Class="settings-card pa-5 mb-4" id="ci-variables">
            <MudText Typo="Typo.subtitle1" HtmlTag="h2" Class="settings-title">CI variables</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">
                Secret environment variables for every repository's pipelines in this project. A repository variable with the same
                name (repository Settings → CI variables) overrides these. Values are encrypted, masked as <code>***</code> in logs,
                and never shown again after saving.
            </MudText>
            <CiVariablesEditor ProjectId="project.Id" />
        </MudPaper>
    }

    @if (perms.Can(Permission.ManageProjectSettings))
    {
        <MudPaper Outlined="true" Class="settings-card pa-5 mb-4">
            <MudText Typo="Typo.subtitle1" HtmlTag="h2" Class="settings-title">Workflow &amp; audit log</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">Customise this project's issue statuses and the moves allowed between them, and see who changed what.</MudText>
            <div class="d-flex flex-wrap gap-2">
                <MudButton Href="@($"/p/{project.Key}/settings/workflow")" Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                           StartIcon="@Icons.Material.Outlined.AccountTree">Edit workflow</MudButton>
                <MudButton Href="@($"/p/{project.Key}/settings/audit")" Variant="Variant.Outlined" Size="Size.Small"
                           StartIcon="@Icons.Material.Outlined.Policy">Audit log</MudButton>
            </div>
        </MudPaper>
    }

    @if (perms.Can(Permission.ManageProjectSettings))
    {
        <MudPaper Outlined="true" Class="settings-card pa-5 mb-4">
            <MudText Typo="Typo.subtitle1" HtmlTag="h2" Class="settings-title">Group</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">
                @(currentGroup == null ? "This is a top-level project." : $"This project belongs to {currentGroup}.")
                Transfer it to a group where you are a Maintainer or Owner. Its key and URLs don't change; members of the old group lose
                the access they inherited, and group labels and milestones it uses are copied into the project.
            </MudText>
            <div class="d-flex flex-wrap gap-2 align-center">
                <MudSelect T="int?" Label="Group" @bind-Value="transferTo" Variant="Variant.Outlined" Margin="Margin.Dense" AnchorOrigin="Origin.BottomLeft"
                           OuterClass="flex-grow-1" ToStringFunc="@(id => id is { } g ? transferTargets.FirstOrDefault(x => x.Id == g)?.FullPath ?? currentGroup ?? "" : "None (top-level project)")">
                    <MudSelectItem T="int?" Value="null">None (top-level project)</MudSelectItem>
                    @foreach (var g in transferTargets) { <MudSelectItem T="int?" Value="g.Id">@g.FullPath</MudSelectItem> }
                </MudSelect>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Outlined.DriveFileMove"
                           Disabled="@(transferTo == project.GroupId)" OnClick="Transfer">Transfer</MudButton>
            </div>
        </MudPaper>
    }

    @if (perms.Can(Permission.DeleteProject))
    {
        <MudPaper Outlined="true" Class="settings-card danger-card pa-5">
            <MudText Typo="Typo.subtitle1" HtmlTag="h2" Class="settings-title" Color="Color.Error">Danger zone</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">Deleting a project permanently removes all of its issues, comments, labels and milestones.</MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Error" Size="Size.Small" StartIcon="@Icons.Material.Outlined.DeleteForever"
                       OnClick="DeleteProject">Delete project</MudButton>
        </MudPaper>
    }
}
</div>

@code {
    [Parameter] public string Key { get; set; } = "";

    private Project? project;
    private ProjectPermissions perms = ProjectPermissions.None;
    private bool notFound;
    private string name = "";
    private string? description, labelError, error;
    private ProjectVisibility visibility;
    private Label newLabel = NewLabel();
    private Label? editLabel;
    private List<GroupSummary> transferTargets = [];
    private int? transferTo;
    private string? currentGroup;

    private static Label NewLabel() => new() { Color = $"#{Random.Shared.Next(0x1000000):x6}" };

    protected override async Task OnParametersSetAsync() => await Load();

    private async Task Load()
    {
        project = await Issues.GetProjectAsync(Key);
        notFound = project == null;
        if (project == null) return;
        perms = await Access.GetPermissionsAsync(project.Id);
        name = project.Name;
        description = project.Description;
        visibility = project.Visibility;
        transferTo = project.GroupId;
        if (perms.Can(Permission.ManageProjectSettings))
        {
            transferTargets = await GroupSvc.CreatableInAsync();
            currentGroup = project.GroupId is { } gid ? (await GroupSvc.CrumbsAsync(gid)).LastOrDefault()?.FullPath : null;
        }
    }

    private async Task Transfer()
    {
        var target = transferTo is { } t ? transferTargets.FirstOrDefault(x => x.Id == t)?.FullPath : null;
        var ok = await Dialogs.ShowMessageBoxAsync("Transfer project?",
            $"Move {project!.Name} {(target == null ? "out of its group, to the top level" : $"into {target}")}?", yesText: "Transfer", cancelText: "Cancel");
        if (ok != true) return;
        if (await Try(() => GroupSvc.TransferProjectAsync(project.Id, transferTo)))
        {
            Snackbar.Add(target == null ? "Project is now top-level." : $"Project transferred to {target}.", Severity.Success);
            Nav.NavigateTo($"/p/{project.Key}/settings", forceLoad: false);
            await Load();
        }
    }

    /// <summary>Runs a change, turning permission (ForbiddenException) and validation errors into a message.</summary>
    private async Task<bool> Try(Func<Task> action)
    {
        error = null;
        try { await action(); return true; }
        catch (InvalidOperationException ex) { error = ex.Message; return false; }
    }

    private async Task SaveGeneral()
    {
        if (await Try(() => Issues.UpdateProjectAsync(project!.Id, name.Trim(), description, visibility)))
            Snackbar.Add("Project settings saved.", Severity.Success);
    }

    private async Task AddLabel()
    {
        labelError = null;
        if (project!.Labels.Any(l => l.Name.Equals(newLabel.Name.Trim(), StringComparison.OrdinalIgnoreCase)))
        {
            labelError = "A label with that name already exists.";
            return;
        }
        newLabel.ProjectId = project.Id;
        newLabel.Name = newLabel.Name.Trim();
        if (!await Try(() => Issues.SaveLabelAsync(newLabel))) return;
        newLabel = NewLabel();
        await Load();
    }

    private async Task SaveLabel()
    {
        labelError = null;
        if (string.IsNullOrWhiteSpace(editLabel!.Name)) return;
        if (project!.Labels.Any(l => l.Id != editLabel.Id && l.Name.Equals(editLabel.Name.Trim(), StringComparison.OrdinalIgnoreCase)))
        {
            labelError = "A label with that name already exists.";
            return;
        }
        editLabel.Name = editLabel.Name.Trim();
        if (!await Try(() => Issues.SaveLabelAsync(editLabel))) return;
        editLabel = null;
        await Load();
    }

    private async Task DeleteLabel(Label l)
    {
        var ok = await Dialogs.ShowMessageBoxAsync("Delete label?", $"Delete label \"{l.Name}\"? It will be removed from all issues.",
            yesText: "Delete", cancelText: "Cancel");
        if (ok != true) return;
        if (await Try(() => Issues.DeleteLabelAsync(l.Id))) await Load();
    }

    private async Task DeleteProject()
    {
        var dialog = await Dialogs.ShowAsync<DeleteProjectDialog>("Delete project", new DialogParameters<DeleteProjectDialog>
        {
            { d => d.ProjectKey, project!.Key },
            { d => d.ProjectName, project.Name },
        }, new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true });
        var result = await dialog.Result;
        if (result is null || result.Canceled) return;
        if (await Try(() => Issues.DeleteProjectAsync(project.Id))) Nav.NavigateTo("/");
    }
}
