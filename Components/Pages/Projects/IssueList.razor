@page "/p/{Key}"
@page "/p/{Key}/issues"
@inject IssueService Issues
@inject LiveEvents Live
@implements IDisposable
@inject ProjectAccess Access
@inject WorkflowService Workflows
@inject NavigationManager Nav

<PageTitle>Issues · @project?.Name</PageTitle>

@if (notFound)
{
    <ProjectNotFound />
}
else if (project != null)
{
<div class="il-page">
    <div class="il-header">
        <div>
            <MudText Typo="Typo.h5" Class="il-title">Issues</MudText>
            <MudText Class="mud-text-secondary" Typo="Typo.body2">@project.Name</MudText>
        </div>
        <div class="il-header-actions">
            <SavedFiltersMenu Project="project" Perms="perms" Query="@IssueFilterQuery.ToQueryString(filter)" />
            @if (canCreate)
            {
                <MudButton Href="@($"/p/{project.Key}/issues/new")" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add">New issue</MudButton>
            }
        </div>
    </div>

    <div class="il-tabs" role="tablist" aria-label="Open or closed">
        <button type="button" role="tab" aria-selected="@(IsTab(true) ? "true" : "false")" class="il-tab @(IsTab(true) ? "active" : "")" @onclick="() => SetOpen(true)">
            <MudIcon Icon="@Icons.Material.Outlined.RadioButtonUnchecked" Size="Size.Small" /> Open <span class="il-count">@counts.open</span>
        </button>
        <button type="button" role="tab" aria-selected="@(IsTab(false) ? "true" : "false")" class="il-tab @(IsTab(false) ? "active" : "")" @onclick="() => SetOpen(false)">
            <MudIcon Icon="@Icons.Material.Outlined.CheckCircle" Size="Size.Small" /> Closed <span class="il-count">@counts.closed</span>
        </button>
        <button type="button" role="tab" aria-selected="@(IsTab(null) ? "true" : "false")" class="il-tab @(IsTab(null) ? "active" : "")" @onclick="() => SetOpen(null)">
            All <span class="il-count">@(counts.open + counts.closed)</span>
        </button>
    </div>

    <MudPaper Outlined="true" Class="il-filters">
        <MudTextField T="string" @bind-Value="filter.Search" @bind-Value:after="Apply" Immediate="true" Placeholder="@($"Search title, description or {project.Key}-123…")"
                      Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Small"
                      Clearable="true" Class="il-search" aria-label="Search issues" />
        <GitBench.Components.Ai.AiSearchBox Project="project" Users="users" Filter="filter" OnApplied="Apply" />

        @* "c:{category}" = any status in that category, "w:{id}" = one workflow status. *@
        <MudSelect T="string" @bind-Value="StatusFilter" @bind-Value:after="Apply" Label="Status" Clearable="true" Dense="true"
                   Variant="Variant.Outlined" Margin="Margin.Dense" ToStringFunc="StatusName" aria-label="Status">
            <MudSelectItem T="string" Value="@("__h_cat")" Disabled="true" Class="il-select-heading">Category</MudSelectItem>
            @foreach (var s in Enum.GetValues<IssueStatus>()) { <MudSelectItem T="string" Value="@($"c:{s}")">Any @s.Name() status</MudSelectItem> }
            @foreach (var g in workflow.Statuses.GroupBy(s => s.Category).OrderBy(g => g.Key))
            {
                <MudSelectItem T="string" Value="@($"__h_{g.Key}")" Disabled="true" Class="il-select-heading">@g.Key.Name()</MudSelectItem>
                @foreach (var ws in g) { <MudSelectItem T="string" Value="@($"w:{ws.Id}")">@ws.Name</MudSelectItem> }
            }
        </MudSelect>
        <MudSelect T="int?" @bind-Value="filter.AssigneeId" @bind-Value:after="Apply" Label="Assignee" Clearable="true" Dense="true"
                   Variant="Variant.Outlined" Margin="Margin.Dense" ToStringFunc="AssigneeName">
            <MudSelectItem T="int?" Value="0">Unassigned</MudSelectItem>
            @foreach (var u in users) { <MudSelectItem T="int?" Value="u.Id">@u.DisplayName</MudSelectItem> }
        </MudSelect>
        <MudSelect T="int?" @bind-Value="filter.LabelId" @bind-Value:after="Apply" Label="Label" Clearable="true" Dense="true"
                   Variant="Variant.Outlined" Margin="Margin.Dense" ToStringFunc="@(id => project.Labels.FirstOrDefault(l => l.Id == id)?.Name ?? "")">
            @foreach (var l in project.Labels) { <MudSelectItem T="int?" Value="l.Id"><LabelChip Label="l" /></MudSelectItem> }
        </MudSelect>
        <MudSelect T="int?" @bind-Value="filter.MilestoneId" @bind-Value:after="Apply" Label="Milestone" Clearable="true" Dense="true"
                   Variant="Variant.Outlined" Margin="Margin.Dense" ToStringFunc="MilestoneName">
            <MudSelectItem T="int?" Value="0">No milestone</MudSelectItem>
            @foreach (var m in project.Milestones) { <MudSelectItem T="int?" Value="m.Id">@m.Title</MudSelectItem> }
        </MudSelect>
        <IssueSprintFilter ProjectId="project.Id" Filter="filter" OnChanged="Apply" />
        <MudSelect T="IssueType?" @bind-Value="filter.Type" @bind-Value:after="Apply" Label="Type" Clearable="true" Dense="true"
                   Variant="Variant.Outlined" Margin="Margin.Dense" ToStringFunc="@(t => t is { } v ? $"{v.Icon()} {v}" : "")">
            @foreach (var t in Enum.GetValues<IssueType>()) { <MudSelectItem T="IssueType?" Value="t">@t.Icon() @t</MudSelectItem> }
        </MudSelect>
        <GitBench.Components.LinkedWork.HierarchyFilters Project="project" Filter="filter" OnChanged="Apply" />
        <GitBench.Components.Fields.IssueFieldFilters Project="project" Filter="filter" Issues="issues" Data="columnData" OnChanged="Apply" OnDataLoaded="StateHasChanged" />
        <MudSelect T="IssuePriority?" @bind-Value="filter.Priority" @bind-Value:after="Apply" Label="Priority" Clearable="true" Dense="true"
                   Variant="Variant.Outlined" Margin="Margin.Dense" ToStringFunc="@(p => p?.ToString() ?? "")">
            @foreach (var p in Enum.GetValues<IssuePriority>().Reverse())
            {
                <MudSelectItem T="IssuePriority?" Value="p"><span class="d-inline-flex align-center gap-2"><PriorityIcon Priority="p" /> @p</span></MudSelectItem>
            }
        </MudSelect>
        <MudSelect T="string" @bind-Value="filter.Sort" @bind-Value:after="Apply" Label="Sort" Dense="true"
                   Variant="Variant.Outlined" Margin="Margin.Dense" ToStringFunc="SortName" AdornmentIcon="@Icons.Material.Filled.Sort">
            @foreach (var s in SortOptions) { <MudSelectItem T="string" Value="s.Value">@s.Name</MudSelectItem> }
        </MudSelect>
        @if (IsFiltered)
        {
            <MudButton Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.FilterListOff" OnClick="Reset" Class="il-clear">Clear filters</MudButton>
        }
    </MudPaper>

    @if (CanBulkEdit && selected.Count > 0)
    {
        <BulkActionBar Project="project" Workflow="workflow" Users="users" Perms="perms" SelectedIds="SelectedOnPage" OnClear="() => selected.Clear()" OnDone="AfterBulk" />
    }
    <MudPaper Outlined="true" Class="il-list">
        @if (CanBulkEdit && issues.Count > 0)
        {
            <div class="il-bulk-header">
                <MudCheckBox T="bool" Value="@(SelectedOnPage.Count == issues.Count)" ValueChanged="ToggleAll" Dense="true" Size="Size.Small"
                             AriaLabel="Select all on this page" title="Select all on this page" />
                <span class="il-muted">@(SelectedOnPage.Count > 0 ? $"{SelectedOnPage.Count} of {issues.Count} selected" : $"{issues.Count} issues")</span>
            </div>
        }
        @if (issues.Count == 0)
        {
            <div class="il-empty">
                <MudIcon Icon="@Icons.Material.Outlined.Inbox" Size="Size.Large" />
                <div>No issues match these filters.</div>
            </div>
        }
        @foreach (var i in issues)
        {
            @if (CanBulkEdit)
            {
                <div class="il-row @(selected.Contains(i.Id) ? "selected" : "")" @key="i.Id">
                    <MudCheckBox T="bool" Value="@selected.Contains(i.Id)" ValueChanged="_ => Toggle(i.Id)" Dense="true" Size="Size.Small"
                                 AriaLabel="@($"Select {i.Key}")" Class="il-row-check" />
                    <IssueRow Issue="i" /><GitBench.Components.Fields.IssueFieldCells Issue="i" Data="columnData" />
                </div>
            }
            else
            {
                <div class="il-row" @key="i.Id"><IssueRow Issue="i" /><GitBench.Components.Fields.IssueFieldCells Issue="i" Data="columnData" /></div>
            }
        }
    </MudPaper>
</div>
}

@code {
    [Parameter] public string Key { get; set; } = "";

    private Project? project;
    private bool notFound, canCreate;
    private ProjectPermissions perms = ProjectPermissions.None;
    private List<User> users = [];
    private List<Issue> issues = [];
    // The whole filter state. It round-trips through the URL query string (IssueFilterQuery), so a filter is
    // addressable and a saved filter is just a stored query string; new IssueFilter properties come along for free.
    private IssueFilter filter = new();
    private readonly GitBench.Components.Fields.IssueColumnData columnData = new(); // optional columns (IssueFieldFilters loads, IssueFieldCells shows)
    private (int open, int closed) counts;
    private readonly HashSet<int> selected = [];

    private static readonly (string Value, string Name)[] SortOptions =
        [("updated", "Recently updated"), ("created", "Newest"), ("priority", "Priority"), ("due", "Due date"), ("number", "Issue number")];

    private bool CanBulkEdit => perms.Can(Permission.EditIssues);
    /// <summary>Selected issues that are still in the current list.</summary>
    private List<int> SelectedOnPage => issues.Where(i => selected.Contains(i.Id)).Select(i => i.Id).ToList();

    private ProjectWorkflow workflow = ProjectWorkflow.Empty;
    private bool NoStatus => filter.Status == null && filter.WorkflowStatusId == null;

    private bool IsTab(bool? open) => filter.Open == open && NoStatus;

    /// <summary>The status menu's value: "c:{category}" (any status in it), "w:{id}" (one workflow status) or null.</summary>
    private string? StatusFilter
    {
        get => filter.WorkflowStatusId is { } w ? $"w:{w}" : filter.Status is { } s ? $"c:{s}" : null;
        set
        {
            filter.Status = null;
            filter.WorkflowStatusId = null;
            if (value?.StartsWith("w:") == true && int.TryParse(value[2..], out var id)) filter.WorkflowStatusId = id;
            else if (value?.StartsWith("c:") == true && Enum.TryParse<IssueStatus>(value[2..], out var c)) filter.Status = c;
            if (!NoStatus) filter.Open = null;
        }
    }

    private string StatusName(string? value) =>
        value?.StartsWith("w:") == true && int.TryParse(value[2..], out var id) ? workflow.Find(id)?.Name ?? ""
        : value?.StartsWith("c:") == true && Enum.TryParse<IssueStatus>(value[2..], out var c) ? $"Any {c.Name()} status" : "";

    private string AssigneeName(int? id) => id switch
    {
        null => "",
        0 => "Unassigned",
        _ => users.FirstOrDefault(u => u.Id == id)?.DisplayName ?? $"#{id}",
    };

    private string MilestoneName(int? id) => id switch
    {
        null => "",
        0 => "No milestone",
        _ => project?.Milestones.FirstOrDefault(m => m.Id == id)?.Title ?? $"#{id}",
    };

    private static string SortName(string? value) => SortOptions.FirstOrDefault(s => s.Value == value).Name ?? value ?? "";

    private bool IsFiltered => !string.IsNullOrEmpty(filter.Search) || !NoStatus || filter.AssigneeId != null
        || filter.LabelId != null || filter.MilestoneId != null || filter.Type != null || filter.Priority != null
        || filter.EpicId != null || filter.HideSubtasks || filter.SprintId != null || filter.HasFieldFilters;

    protected override async Task OnParametersSetAsync()
    {
        if (project?.Key == Key.ToUpper()) return;
        filter = IssueFilterQuery.FromUri(Nav.Uri);
        selected.Clear();
        project = await Issues.GetProjectAsync(Key);
        notFound = project == null;
        if (project == null) return;
        perms = await Access.GetPermissionsAsync(project.Id);
        canCreate = perms.Can(Permission.EditIssues);
        users = await Issues.GetUsersAsync();
        await Load();
    }

    private async Task Load()
    {
        if (project == null) return;
        workflow = await Workflows.GetAsync(project.Id);
        issues = await Issues.GetIssuesAsync(project.Id, filter);
        counts = await Issues.CountAsync(project.Id);
    }

    /// <summary>The filter changed on this page: reflect it in the URL (without a history entry) and reload.</summary>
    private async Task Apply()
    {
        if (project == null) return;
        var q = IssueFilterQuery.ToQueryString(filter);
        var target = $"p/{project.Key}/issues" + (q.Length > 0 ? "?" + q : "");
        if (Nav.ToBaseRelativePath(Nav.Uri) != target) Nav.NavigateTo(target, replace: true);
        await Load();
    }

    // ----- URL → filter: links to this page with another query (saved filters, sidebar, back/forward) -----
    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        if (project == null) return;
        var path = Nav.ToBaseRelativePath(e.Location).Split('?', '#')[0].TrimEnd('/');
        if (!path.Equals($"p/{project.Key}", StringComparison.OrdinalIgnoreCase) && !path.Equals($"p/{project.Key}/issues", StringComparison.OrdinalIgnoreCase)) return;
        var parsed = IssueFilterQuery.FromUri(e.Location);
        if (IssueFilterQuery.ToQueryString(parsed) == IssueFilterQuery.ToQueryString(filter)) return;
        _ = InvokeAsync(async () =>
        {
            filter = parsed;
            await Load();
            StateHasChanged();
        });
    }

    // ----- Live updates: any issue in this project changed -----
    private IDisposable? liveSubscription;
    private int reloadQueued;

    protected override void OnAfterRender(bool firstRender)
    {
        if (!firstRender) return;
        liveSubscription = Live.Subscribe<IssueChanged>(OnIssueChanged);
        Nav.LocationChanged += OnLocationChanged;
    }

    // A bulk edit publishes one IssueChanged per issue in a single batch; coalesce them into one reload.
    private Task OnIssueChanged(IssueChanged e)
    {
        if (project?.Id != e.ProjectId || Interlocked.Exchange(ref reloadQueued, 1) == 1) return Task.CompletedTask;
        return InvokeAsync(async () =>
        {
            Volatile.Write(ref reloadQueued, 0);
            await Load();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        liveSubscription?.Dispose();
        Nav.LocationChanged -= OnLocationChanged;
    }

    private async Task SetOpen(bool? open)
    {
        filter.Status = null;
        filter.WorkflowStatusId = null;
        filter.Open = open;
        await Apply();
    }

    private async Task Reset()
    {
        filter = new() { Sort = filter.Sort, Columns = filter.Columns };
        await Apply();
    }

    // ----- Selection & bulk edit -----
    private void Toggle(int id)
    {
        if (!selected.Remove(id)) selected.Add(id);
    }

    private void ToggleAll(bool all)
    {
        if (all) foreach (var i in issues) selected.Add(i.Id);
        else foreach (var i in issues) selected.Remove(i.Id);
    }

    private async Task AfterBulk(bool deleted)
    {
        if (deleted) selected.Clear();
        await Load();
        selected.IntersectWith(issues.Select(i => i.Id));
    }
}
