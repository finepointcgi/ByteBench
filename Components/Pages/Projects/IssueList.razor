@page "/p/{Key}"
@page "/p/{Key}/issues"
@inject IssueService Issues
@inject LiveEvents Live
@implements IDisposable
@inject ProjectAccess Access
@inject NavigationManager Nav

<PageTitle>Issues · @project?.Name</PageTitle>

@if (notFound)
{
    <ProjectNotFound />
}
else if (project != null)
{
    <div class="page-header">
        <div>
            <h1>Issues</h1>
            <div class="muted">@project.Name</div>
        </div>
        <div class="d-flex gap-2 align-items-center">
            <SavedFiltersMenu Project="project" Perms="perms" Query="@IssueFilterQuery.ToQueryString(filter)" />
            @if (canCreate)
            {
                <a class="btn btn-primary" href="/p/@project.Key/issues/new">+ New issue</a>
            }
        </div>
    </div>

    <div class="tabs">
        <button class="tab @(filter.Open == true && filter.Status == null ? "active" : "")" @onclick="() => SetOpen(true)">Open <span class="count">@counts.open</span></button>
        <button class="tab @(filter.Open == false && filter.Status == null ? "active" : "")" @onclick="() => SetOpen(false)">Closed <span class="count">@counts.closed</span></button>
        <button class="tab @(filter.Open == null && filter.Status == null ? "active" : "")" @onclick="() => SetOpen(null)">All <span class="count">@(counts.open + counts.closed)</span></button>
    </div>

    <div class="filter-bar">
        <input class="form-control form-control-sm search" placeholder="Search title, description or @project.Key-123…"
               @bind="filter.Search" @bind:event="oninput" @bind:after="Apply" />
        <GitBench.Components.Ai.AiSearchBox Project="project" Users="users" Filter="filter" OnApplied="Apply" />

        <select class="form-select form-select-sm" @bind="StatusFilter" @bind:after="Apply">
            <option value="">Any status</option>
            @foreach (var s in Enum.GetValues<IssueStatus>()) { <option value="@s">@s.Name()</option> }
        </select>
        <select class="form-select form-select-sm" @bind="filter.AssigneeId" @bind:after="Apply">
            <option value="">Any assignee</option>
            <option value="0">Unassigned</option>
            @foreach (var u in users) { <option value="@u.Id">@u.DisplayName</option> }
        </select>
        <select class="form-select form-select-sm" @bind="filter.LabelId" @bind:after="Apply">
            <option value="">Any label</option>
            @foreach (var l in project.Labels) { <option value="@l.Id">@l.Name</option> }
        </select>
        <select class="form-select form-select-sm" @bind="filter.MilestoneId" @bind:after="Apply">
            <option value="">Any milestone</option>
            <option value="0">No milestone</option>
            @foreach (var m in project.Milestones) { <option value="@m.Id">@m.Title</option> }
        </select>
        <select class="form-select form-select-sm" @bind="filter.Type" @bind:after="Apply">
            <option value="">Any type</option>
            @foreach (var t in Enum.GetValues<IssueType>()) { <option value="@t">@t.Icon() @t</option> }
        </select>
        <select class="form-select form-select-sm" @bind="filter.Priority" @bind:after="Apply">
            <option value="">Any priority</option>
            @foreach (var p in Enum.GetValues<IssuePriority>().Reverse()) { <option value="@p">@p</option> }
        </select>
        <select class="form-select form-select-sm" @bind="filter.Sort" @bind:after="Apply">
            <option value="updated">Recently updated</option>
            <option value="created">Newest</option>
            <option value="priority">Priority</option>
            <option value="due">Due date</option>
            <option value="number">Issue number</option>
        </select>
        @if (IsFiltered)
        {
            <button class="btn btn-sm btn-link" @onclick="Reset">Clear filters</button>
        }
    </div>

    @if (CanBulkEdit && selected.Count > 0)
    {
        <BulkActionBar Project="project" Users="users" Perms="perms" SelectedIds="SelectedOnPage" OnClear="() => selected.Clear()" OnDone="AfterBulk" />
    }
    <div class="issue-list">
        @if (CanBulkEdit && issues.Count > 0)
        {
            <div class="bulk-header">
                <input type="checkbox" class="form-check-input" title="Select all on this page" aria-label="Select all on this page"
                       checked="@(SelectedOnPage.Count == issues.Count)" @onchange="ToggleAll" />
                <span class="muted small">@(SelectedOnPage.Count > 0 ? $"{SelectedOnPage.Count} of {issues.Count} selected" : $"{issues.Count} issues")</span>
            </div>
        }
        @if (issues.Count == 0)
        {
            <div class="empty">No issues match these filters.</div>
        }
        @foreach (var i in issues)
        {
            @if (CanBulkEdit)
            {
                <div class="bulk-row @(selected.Contains(i.Id) ? "selected" : "")" @key="i.Id">
                    <input type="checkbox" class="form-check-input" aria-label="Select @i.Key" checked="@selected.Contains(i.Id)" @onchange="() => Toggle(i.Id)" />
                    <IssueRow Issue="i" />
                </div>
            }
            else
            {
                <IssueRow Issue="i" @key="i.Id" />
            }
        }
    </div>
}

@code {
    [Parameter] public string Key { get; set; } = "";

    private Project? project;
    private bool notFound, canCreate;
    private ProjectPermissions perms = ProjectPermissions.None;
    private List<User> users = [];
    private List<Issue> issues = [];
    // The whole filter state. It round-trips through the URL query string (IssueFilterQuery), so a filter is
    // addressable and a saved filter is just a stored query string; new IssueFilter properties come along for free.
    private IssueFilter filter = new();
    private (int open, int closed) counts;
    private readonly HashSet<int> selected = [];

    private bool CanBulkEdit => perms.Can(Permission.EditIssues);
    /// <summary>Selected issues that are still in the current list.</summary>
    private List<int> SelectedOnPage => issues.Where(i => selected.Contains(i.Id)).Select(i => i.Id).ToList();

    private IssueStatus? StatusFilter
    {
        get => filter.Status;
        set { filter.Status = value; if (value != null) filter.Open = null; }
    }

    private bool IsFiltered => !string.IsNullOrEmpty(filter.Search) || filter.Status != null || filter.AssigneeId != null
        || filter.LabelId != null || filter.MilestoneId != null || filter.Type != null || filter.Priority != null;

    protected override async Task OnParametersSetAsync()
    {
        if (project?.Key == Key.ToUpper()) return;
        filter = IssueFilterQuery.FromUri(Nav.Uri);
        selected.Clear();
        project = await Issues.GetProjectAsync(Key);
        notFound = project == null;
        if (project == null) return;
        perms = await Access.GetPermissionsAsync(project.Id);
        canCreate = perms.Can(Permission.EditIssues);
        users = await Issues.GetUsersAsync();
        await Load();
    }

    private async Task Load()
    {
        if (project == null) return;
        issues = await Issues.GetIssuesAsync(project.Id, filter);
        counts = await Issues.CountAsync(project.Id);
    }

    /// <summary>The filter changed on this page: reflect it in the URL (without a history entry) and reload.</summary>
    private async Task Apply()
    {
        if (project == null) return;
        var q = IssueFilterQuery.ToQueryString(filter);
        var target = $"p/{project.Key}/issues" + (q.Length > 0 ? "?" + q : "");
        if (Nav.ToBaseRelativePath(Nav.Uri) != target) Nav.NavigateTo(target, replace: true);
        await Load();
    }

    // ----- URL → filter: links to this page with another query (saved filters, sidebar, back/forward) -----
    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        if (project == null) return;
        var path = Nav.ToBaseRelativePath(e.Location).Split('?', '#')[0].TrimEnd('/');
        if (!path.Equals($"p/{project.Key}", StringComparison.OrdinalIgnoreCase) && !path.Equals($"p/{project.Key}/issues", StringComparison.OrdinalIgnoreCase)) return;
        var parsed = IssueFilterQuery.FromUri(e.Location);
        if (IssueFilterQuery.ToQueryString(parsed) == IssueFilterQuery.ToQueryString(filter)) return;
        _ = InvokeAsync(async () =>
        {
            filter = parsed;
            await Load();
            StateHasChanged();
        });
    }

    // ----- Live updates: any issue in this project changed -----
    private IDisposable? liveSubscription;
    private int reloadQueued;

    protected override void OnAfterRender(bool firstRender)
    {
        if (!firstRender) return;
        liveSubscription = Live.Subscribe<IssueChanged>(OnIssueChanged);
        Nav.LocationChanged += OnLocationChanged;
    }

    // A bulk edit publishes one IssueChanged per issue in a single batch; coalesce them into one reload.
    private Task OnIssueChanged(IssueChanged e)
    {
        if (project?.Id != e.ProjectId || Interlocked.Exchange(ref reloadQueued, 1) == 1) return Task.CompletedTask;
        return InvokeAsync(async () =>
        {
            Volatile.Write(ref reloadQueued, 0);
            await Load();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        liveSubscription?.Dispose();
        Nav.LocationChanged -= OnLocationChanged;
    }

    private async Task SetOpen(bool? open)
    {
        filter.Status = null;
        filter.Open = open;
        await Apply();
    }

    private async Task Reset()
    {
        filter = new() { Sort = filter.Sort };
        await Apply();
    }

    // ----- Selection & bulk edit -----
    private void Toggle(int id)
    {
        if (!selected.Remove(id)) selected.Add(id);
    }

    private void ToggleAll(ChangeEventArgs e)
    {
        if (e.Value is true) foreach (var i in issues) selected.Add(i.Id);
        else foreach (var i in issues) selected.Remove(i.Id);
    }

    private async Task AfterBulk(bool deleted)
    {
        if (deleted) selected.Clear();
        await Load();
        selected.IntersectWith(issues.Select(i => i.Id));
    }
}
