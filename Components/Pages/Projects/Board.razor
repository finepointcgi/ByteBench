@page "/p/{Key}/board"
@inject IssueService Issues
@inject CurrentUser Me
@inject LiveEvents Live
@implements IDisposable
@inject ProjectAccess Access
@inject WorkflowService Workflows

<PageTitle>Board · @project?.Name</PageTitle>

@if (notFound)
{
    <ProjectNotFound />
}
else if (project != null)
{
    <div class="gb-board-page">
        <div class="d-flex align-center justify-space-between flex-wrap gap-4 mb-4">
            <div>
                <MudText Typo="Typo.h5" Class="board-heading">Board</MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary">@project.Name</MudText>
            </div>
            <div class="board-filters">
                <div class="board-filter">
                    <BoardSprintSelect ProjectId="project.Id" @bind-SprintId="sprintId" />
                </div>
                <div class="board-filter">
                    <MudSelect T="int" Value="@(milestoneId ?? 0)" ValueChanged="SetMilestone" Dense="true" Variant="Variant.Outlined" Margin="Margin.Dense"
                               aria-label="Milestone">
                        <MudSelectItem T="int" Value="0">All milestones</MudSelectItem>
                        @foreach (var m in project.Milestones.Where(m => !m.IsClosed)) { <MudSelectItem T="int" Value="@m.Id">@m.Title</MudSelectItem> }
                    </MudSelect>
                </div>
                <div class="board-filter">
                    <MudSelect T="int" Value="@(assigneeId ?? 0)" ValueChanged="SetAssignee" Dense="true" Variant="Variant.Outlined" Margin="Margin.Dense"
                               aria-label="Assignee">
                        <MudSelectItem T="int" Value="0">Everyone</MudSelectItem>
                        @foreach (var u in users) { <MudSelectItem T="int" Value="@u.Id">@u.DisplayName</MudSelectItem> }
                    </MudSelect>
                </div>
                <div class="board-filter">
                    <MudTextField T="string" @bind-Value="search" Immediate="true" Placeholder="Filter cards…" Variant="Variant.Outlined" Margin="Margin.Dense"
                                  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Clearable="true" aria-label="Filter cards" />
                </div>
            </div>
        </div>

        @if (error != null) { <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3">@error</MudAlert> }
        @if (warning != null) { <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3">@warning</MudAlert> }
        <div class="board" style="grid-template-columns: repeat(@Math.Max(workflow.Statuses.Count, 1), minmax(220px, 1fr))">
            @foreach (var status in workflow.Statuses)
            {
                var col = Visible.Where(i => workflow.Effective(i)?.Id == status.Id).ToList();
                var allowed = CanDropOn(status);
                @* Columns the workflow doesn't allow the dragged card to move to don't accept the drop. *@
                <div class="board-col @(dragOverStatus == status.Id && allowed ? "drag-over" : "") @(allowed ? "" : "drop-disabled")"
                     @ondragover:preventDefault="allowed"
                     @ondragenter="() => dragOverStatus = status.Id"
                     @ondrop="() => Drop(status, null)">
                    <div class="board-col-head" title="@status.Category.Name()">
                        <span class="status-dot" style="background:@status.Color"></span>
                        <span class="board-col-name">@status.Name</span>
                        <span class="board-count" title="Issues">@col.Count</span>
                        <span class="board-col-pts" title="Story points">@col.Sum(i => i.StoryPoints ?? 0) pts</span>
                    </div>
                    <div class="board-cards">
                        @foreach (var i in col)
                        {
                            <div class="board-card @(dragging?.Id == i.Id ? "dragging" : "")" draggable="@(canEdit ? "true" : "false")" @key="i.Id"
                                 @ondragstart="() => dragging = i"
                                 @ondragend="() => { dragging = null; dragOverStatus = null; }"
                                 @ondrop="() => Drop(status, i.Id)" @ondrop:stopPropagation>
                                <a class="board-card-title" href="/p/@project.Key/issues/@i.Number" draggable="false">@i.Title</a>
                                @if (i.Labels.Count > 0)
                                {
                                    <div class="board-card-labels">
                                        @foreach (var l in i.Labels) { <LabelChip Label="l" /> }
                                    </div>
                                }
                                <div class="board-card-foot">
                                    <span title="@i.Type">@i.Type.Icon()</span>
                                    <span class="mono board-key">@i.Key</span>
                                    <GitBench.Components.LinkedWork.IssueWorkChips Issue="i" Links Compact />
                                    <PriorityIcon Priority="i.Priority" />
                                    @if (i.StoryPoints is { } sp) { <span class="board-points" title="Story points">@sp</span> }
                                    <span class="board-assignee"><Avatar User="i.Assignee" Size="22" /></span>
                                </div>
                            </div>
                        }
                        @if (col.Count == 0)
                        {
                            <div class="board-empty">Drop issues here</div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
}

@code {
    [Parameter] public string Key { get; set; } = "";

    private Project? project;
    private bool notFound, canEdit;
    private string? error, warning;
    private List<User> users = [];
    private List<Issue> issues = [];
    private int? milestoneId, assigneeId;
    private string? search;
    private Issue? dragging;
    private int? dragOverStatus;
    private ProjectWorkflow workflow = ProjectWorkflow.Empty;

    /// <summary>While dragging: whether the workflow lets the dragged issue move to <paramref name="status"/>.</summary>
    private bool CanDropOn(WorkflowStatus status) => dragging == null || workflow.IsAllowed(workflow.Effective(dragging)?.Id, status.Id);

    private int? sprintId; // set by BoardSprintSelect (defaults to the active sprint); null = all issues
    private IEnumerable<Issue> SprintIssues => sprintId is { } sid ? issues.Where(i => i.SprintId == sid) : issues;

    private IEnumerable<Issue> Visible => string.IsNullOrWhiteSpace(search)
        ? SprintIssues
        : SprintIssues.Where(i => i.Title.Contains(search, StringComparison.OrdinalIgnoreCase) || i.Key.Contains(search, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnParametersSetAsync()
    {
        project = await Issues.GetProjectAsync(Key);
        notFound = project == null;
        if (project == null) return;
        canEdit = await Access.CanAsync(project.Id, Permission.EditIssues);
        users = await Issues.GetUsersAsync();
        await Load();
    }

    private async Task Load()
    {
        if (project == null) return;
        workflow = await Workflows.GetAsync(project.Id);
        issues = await Issues.GetBoardAsync(project.Id, milestoneId, assigneeId);
    }

    private async Task SetMilestone(int id)
    {
        milestoneId = id == 0 ? null : id;
        await Load();
    }

    private async Task SetAssignee(int id)
    {
        assigneeId = id == 0 ? null : id;
        await Load();
    }

    // ----- Live updates: another user moved, created or edited a card in this project -----
    private IDisposable? liveSubscription;

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender) liveSubscription = Live.Subscribe<BoardChanged>(OnBoardChanged);
    }

    private Task OnBoardChanged(BoardChanged e) => project?.Id != e.ProjectId ? Task.CompletedTask : InvokeAsync(async () =>
    {
        await Load();
        StateHasChanged();
    });

    public void Dispose() => liveSubscription?.Dispose();

    private async Task Drop(WorkflowStatus status, int? beforeId)
    {
        var moved = dragging;
        var allowed = CanDropOn(status);
        dragging = null;
        dragOverStatus = null;
        if (moved == null || moved.Id == beforeId || !allowed) return;

        // Optimistic local reorder so the UI responds instantly.
        issues.Remove(moved);
        warning = moved.WorkflowStatusId == status.Id ? null : HierarchyRules.BlockedMoveWarning(moved.Key, status.Category, moved.Work?.BlockedBy ?? []);
        (moved.Status, moved.WorkflowStatusId, moved.WorkflowStatus) = (status.Category, status.Id, status);
        var idx = beforeId is { } b ? issues.FindIndex(x => x.Id == b) : -1;
        if (idx < 0) issues.Add(moved); else issues.Insert(idx, moved);

        error = null;
        try { await Issues.MoveOnBoardAsync(moved.Id, status.Id, beforeId, Me.Id); }
        catch (InvalidOperationException ex) { error = ex.Message; }
        await Load();
    }
}
