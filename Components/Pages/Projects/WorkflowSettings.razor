@page "/p/{Key}/settings/workflow"
@inject IssueService Issues
@inject ProjectAccess Access
@inject WorkflowService Workflows
@inject IDialogService Dialogs
@inject ISnackbar Snackbar

<PageTitle>Workflow · @project?.Name</PageTitle>

<div class="wf-page">
@if (notFound)
{
    <ProjectNotFound />
}
else if (project != null && !perms.Can(Permission.ManageProjectSettings))
{
    <Forbidden Message="Only project Owners can change this project's workflow." BackHref="@($"/p/{Key}/settings")" />
}
else if (project != null)
{
    <div class="page-header">
        <div>
            <MudText Typo="Typo.h5" HtmlTag="h1">Workflow</MudText>
            <MudText Class="mud-text-secondary" Typo="Typo.body2">@project.Name</MudText>
        </div>
        <MudButton Href="@($"/p/{project.Key}/settings")" Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.ArrowBack">Settings</MudButton>
    </div>
    <MudText Typo="Typo.body2" Class="mud-text-secondary wf-narrow mb-4">
        Statuses are the board's columns, in this order. Each belongs to a <b>category</b>: Done-category statuses count as closed,
        and sprints, filters and the API work with categories. Setting only a category (e.g. "Close issue") picks that category's
        first status. The workflow needs at least one Done status and at least one open status.
    </MudText>
    @if (error != null) { <MudAlert Severity="Severity.Error" Dense="true" Class="wf-narrow mb-3">@error</MudAlert> }

    <MudPaper Outlined="true" Class="wf-narrow pa-5 mb-4">
        <MudText Typo="Typo.subtitle1" HtmlTag="h2" Class="wf-title">Statuses</MudText>
        <div class="wf-scroll">
            <MudSimpleTable Dense="true" Elevation="0" Class="wf-table">
                <thead>
                    <tr><th style="width:80px">Order</th><th style="width:56px">Colour</th><th>Name</th><th style="width:160px">Category</th><th style="width:60px">Issues</th><th style="width:150px"></th></tr>
                </thead>
                <tbody>
                    @for (var idx = 0; idx < workflow.Statuses.Count; idx++)
                    {
                        var s = workflow.Statuses[idx];
                        var d = drafts[s.Id];
                        var count = counts.GetValueOrDefault(s.Id);
                        var first = idx == 0;
                        var last = idx == workflow.Statuses.Count - 1;
                        <tr @key="s.Id">
                            <td class="nowrap">
                                <MudIconButton Icon="@Icons.Material.Filled.ArrowUpward" Size="Size.Small" title="Move left on the board" aria-label="Move left on the board"
                                               Disabled="@first" OnClick="() => Move(s, -1)" />
                                <MudIconButton Icon="@Icons.Material.Filled.ArrowDownward" Size="Size.Small" title="Move right on the board" aria-label="Move right on the board"
                                               Disabled="@last" OnClick="() => Move(s, 1)" />
                            </td>
                            <td><input type="color" class="color-input" aria-label="Colour of @s.Name" @bind="d.Color" /></td>
                            <td>
                                <MudTextField T="string" @bind-Value="d.Name" Immediate="true" MaxLength="40" Variant="Variant.Outlined" Margin="Margin.Dense"
                                              Class="wf-input" aria-label="Name" />
                            </td>
                            <td>
                                <MudSelect T="IssueStatus" @bind-Value="d.Category" Variant="Variant.Outlined" Margin="Margin.Dense" Class="wf-input"
                                           AnchorOrigin="Origin.BottomLeft" aria-label="@($"Category of {s.Name}")">
                                    @foreach (var c in Enum.GetValues<IssueStatus>()) { <MudSelectItem Value="c">@c.Name()</MudSelectItem> }
                                </MudSelect>
                            </td>
                            <td>@count</td>
                            <td class="nowrap right">
                                @if (d.Name.Trim() != s.Name || !d.Color.Equals(s.Color, StringComparison.OrdinalIgnoreCase) || d.Category != s.Category)
                                {
                                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" OnClick="() => SaveStatus(s)">Save</MudButton>
                                }
                                <MudTooltip Text="Delete status">
                                    <MudIconButton Icon="@Icons.Material.Outlined.Delete" Size="Size.Small" Color="Color.Error" aria-label="@($"Delete {s.Name}")"
                                                   OnClick="() => StartDelete(s, count)" />
                                </MudTooltip>
                            </td>
                        </tr>
                        @if (deleting?.Id == s.Id)
                        {
                            <tr @key="(s.Id, 'd')" class="wf-delete-row">
                                <td colspan="6">
                                    <div class="wf-delete">
                                        <span><b>@count</b> issue@(count == 1 ? "" : "s") @(count == 1 ? "has" : "have") the status <b>@s.Name</b>. Move @(count == 1 ? "it" : "them") to</span>
                                        <MudSelect T="int" @bind-Value="moveTo" Variant="Variant.Outlined" Margin="Margin.Dense" Class="wf-move-to"
                                                   AnchorOrigin="Origin.BottomLeft" aria-label="Move issues to">
                                            @foreach (var other in workflow.Statuses.Where(o => o.Id != s.Id)) { <MudSelectItem Value="other.Id">@other.Name</MudSelectItem> }
                                        </MudSelect>
                                        <MudButton Variant="Variant.Filled" Color="Color.Error" Size="Size.Small" OnClick="() => Delete(s, moveTo)">Move issues &amp; delete</MudButton>
                                        <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="() => deleting = null">Cancel</MudButton>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </MudSimpleTable>
        </div>
        <div class="wf-add">
            <input type="color" class="color-input" aria-label="New status colour" @bind="newColor" />
            <MudTextField T="string" Placeholder="New status name" @bind-Value="newName" Immediate="true" MaxLength="40"
                          Variant="Variant.Outlined" Margin="Margin.Dense" Class="wf-add-name" aria-label="New status name" />
            <MudSelect T="IssueStatus" @bind-Value="newCategory" Variant="Variant.Outlined" Margin="Margin.Dense" Class="wf-add-cat"
                       AnchorOrigin="Origin.BottomLeft" aria-label="New status category">
                @foreach (var c in Enum.GetValues<IssueStatus>()) { <MudSelectItem Value="c">@c.Name()</MudSelectItem> }
            </MudSelect>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Add"
                       Disabled="@string.IsNullOrWhiteSpace(newName)" OnClick="AddStatus">Add status</MudButton>
        </div>
    </MudPaper>

    <MudPaper Outlined="true" Class="wf-narrow pa-5 mb-4">
        <MudText Typo="Typo.subtitle1" HtmlTag="h2" Class="wf-title">Transitions</MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">
            Tick the statuses an issue may move <b>to</b> from each status. A row with nothing ticked allows any move.
            The board and the status picker only offer allowed moves, and the API refuses the others.
        </MudText>
        <div class="wf-scroll">
            <MudSimpleTable Dense="true" Bordered="true" Elevation="0" Class="wf-matrix">
                <thead>
                    <tr>
                        <th class="wf-corner">From ↓ / To →</th>
                        @foreach (var to in workflow.Statuses) { <th class="rot">@to.Name</th> }
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var from in workflow.Statuses)
                    {
                        var set = matrix[from.Id];
                        <tr @key="from.Id">
                            <th class="rot"><span class="wf-dot" style="background:@from.Color"></span> @from.Name</th>
                            @foreach (var to in workflow.Statuses)
                            {
                                <td class="cell">
                                    @if (to.Id == from.Id) { <span class="wf-muted">—</span> }
                                    else
                                    {
                                        <MudCheckBox T="bool" Value="@set.Contains(to.Id)" ValueChanged="on => Toggle(set, to.Id, on)" Color="Color.Primary"
                                                     Dense="true" Size="Size.Small" aria-label="@($"{from.Name} to {to.Name}")" />
                                    }
                                </td>
                            }
                            <td class="wf-muted wf-small nowrap">@(set.Count == 0 ? "any move" : "")</td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        </div>
        <div class="d-flex flex-wrap gap-2 mt-3">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" Disabled="@(!matrixDirty)" OnClick="SaveTransitions">Save transitions</MudButton>
            <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="ClearTransitions">Allow every move</MudButton>
        </div>
    </MudPaper>
}
</div>

@code {
    [Parameter] public string Key { get; set; } = "";

    private sealed class Draft { public string Name = ""; public string Color = ""; public IssueStatus Category; }

    private Project? project;
    private ProjectPermissions perms = ProjectPermissions.None;
    private bool notFound, matrixDirty;
    private string? error;
    private ProjectWorkflow workflow = ProjectWorkflow.Empty;
    private Dictionary<int, int> counts = [];
    private Dictionary<int, Draft> drafts = [];
    private Dictionary<int, HashSet<int>> matrix = [];
    private WorkflowStatus? deleting;
    private int moveTo;
    private string newName = "", newColor = "#64748b";
    private IssueStatus newCategory = IssueStatus.InProgress;

    protected override async Task OnParametersSetAsync()
    {
        project = await Issues.GetProjectAsync(Key);
        notFound = project == null;
        if (project == null) return;
        perms = await Access.GetPermissionsAsync(project.Id);
        await Load();
    }

    private async Task Load()
    {
        workflow = await Workflows.GetAsync(project!.Id);
        counts = await Workflows.CountIssuesAsync(project.Id);
        drafts = workflow.Statuses.ToDictionary(s => s.Id, s => new Draft { Name = s.Name, Color = s.Color, Category = s.Category });
        matrix = workflow.Statuses.ToDictionary(s => s.Id, s => workflow.Transitions.Where(t => t.FromStatusId == s.Id).Select(t => t.ToStatusId).ToHashSet());
        matrixDirty = false;
    }

    private async Task Run(Func<Task> action, string? success = null)
    {
        error = null;
        try
        {
            await action();
            if (success != null) Snackbar.Add(success, Severity.Success);
        }
        catch (InvalidOperationException ex) { error = ex.Message; }
        await Load();
    }

    private Task SaveStatus(WorkflowStatus s)
    {
        var d = drafts[s.Id];
        return Run(() => Workflows.UpdateStatusAsync(project!.Id, s.Id, d.Name, d.Color, d.Category), $"Saved \"{d.Name.Trim()}\".");
    }

    private Task Move(WorkflowStatus s, int delta) => Run(() => Workflows.MoveStatusAsync(project!.Id, s.Id, delta));

    private async Task AddStatus()
    {
        var name = newName.Trim();
        await Run(() => Workflows.AddStatusAsync(project!.Id, name, newColor, newCategory), $"Added \"{name}\".");
        if (error == null) newName = "";
    }

    private async Task StartDelete(WorkflowStatus s, int count)
    {
        error = null;
        if (count > 0)
        {
            deleting = s;
            moveTo = workflow.Statuses.Where(o => o.Id != s.Id).OrderBy(o => o.Category == s.Category ? 0 : 1).First().Id;
            return;
        }
        if (await Dialogs.ShowMessageBoxAsync("Delete status?", $"Delete the status \"{s.Name}\"?", yesText: "Delete", cancelText: "Cancel") == true)
            await Delete(s, null);
    }

    private async Task Delete(WorkflowStatus s, int? target)
    {
        var moved = 0;
        await Run(async () => moved = await Workflows.DeleteStatusAsync(project!.Id, s.Id, target));
        if (error == null)
        {
            Snackbar.Add(moved > 0 ? $"Moved {moved} issue{(moved == 1 ? "" : "s")} and deleted \"{s.Name}\"." : $"Deleted \"{s.Name}\".", Severity.Success);
            deleting = null;
        }
    }

    private void Toggle(HashSet<int> set, int id, bool on)
    {
        if (on) set.Add(id); else set.Remove(id);
        matrixDirty = true;
    }

    private Task SaveTransitions() => Run(() => Workflows.SetTransitionsAsync(project!.Id, matrix), "Transitions saved.");

    private void ClearTransitions()
    {
        foreach (var set in matrix.Values) set.Clear();
        matrixDirty = true;
    }
}
