@page "/p/{Key}/filters"
@implements IDisposable
@inject IssueService Issues
@inject SavedFilterService Filters
@inject ProjectAccess Access
@inject WorkflowService Workflows
@inject LiveEvents Live
@inject IDialogService Dialogs

<PageTitle>Saved filters · @project?.Name</PageTitle>

@if (notFound)
{
    <ProjectNotFound />
}
else if (project != null)
{
<div class="sf-page">
    <MudBreadcrumbs Items="crumbs" Class="px-0 pt-0 pb-1" />
    <div class="sf-header">
        <MudText Typo="Typo.h5" HtmlTag="h1" Class="sf-title">Saved filters</MudText>
        <MudText Class="mud-text-secondary" Typo="Typo.body2">
            Your filters and the ones shared with @project.Name. Starred filters appear in the sidebar.
            To create one, set up the <a href="/p/@project.Key/issues">issue list</a> and use <b>Filters → Save current filter</b>.
        </MudText>
    </div>
    @if (error != null) { <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3">@error</MudAlert> }

    @if (filters.Count == 0)
    {
        <MudPaper Outlined="true" Class="sf-empty">
            <MudIcon Icon="@Icons.Material.Outlined.FilterList" Size="Size.Large" />
            <div>No saved filters yet.</div>
        </MudPaper>
    }
    else
    {
        <MudPaper Outlined="true" Class="sf-table-wrap">
            <MudSimpleTable Dense="true" Hover="true" Elevation="0" Class="sf-table">
                <thead>
                    <tr><th style="width:44px"><span class="sf-sr">Star</span></th><th>Name</th><th>Conditions</th><th>Owner</th><th>Visibility</th><th><span class="sf-sr">Actions</span></th></tr>
                </thead>
                <tbody>
                    @foreach (var f in filters)
                    {
                        <tr @key="f.Id">
                            <td>
                                <MudIconButton Icon="@(f.IsStarred ? Icons.Material.Filled.Star : Icons.Material.Outlined.StarBorder)" Size="Size.Small"
                                               Color="@(f.IsStarred ? Color.Warning : Color.Default)" title="@(f.IsStarred ? "Unstar" : "Star (show in sidebar)")"
                                               aria-label="@(f.IsStarred ? $"Unstar {f.Name}" : $"Star {f.Name}")" OnClick="() => Run(() => Filters.SetStarAsync(f.Id, !f.IsStarred))" />
                            </td>
                            <td class="sf-name">
                                @if (renamingId == f.Id)
                                {
                                    <div class="sf-rename">
                                        <MudTextField T="string" @bind-Value="renameDraft" Immediate="true" MaxLength="100" OnKeyDown="e => RenameKey(e, f)" AutoFocus="true"
                                                      Variant="Variant.Outlined" Margin="Margin.Dense" aria-label="Filter name" />
                                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" OnClick="() => Rename(f)">Save</MudButton>
                                        <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="() => renamingId = null">Cancel</MudButton>
                                    </div>
                                }
                                else
                                {
                                    <a href="@Href(f)"><b>@f.Name</b></a>
                                }
                            </td>
                            <td>
                                <div class="sf-chips">
                                    @foreach (var c in Describe(f.Query)) { <span class="sf-chip">@c</span> }
                                </div>
                            </td>
                            <td class="sf-small">@f.OwnerName@(f.IsMine ? " (you)" : "")</td>
                            <td>
                                @if (f.IsShared)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Text" Icon="@Icons.Material.Outlined.Group" Class="ma-0">Shared</MudChip>
                                }
                                else
                                {
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Icon="@Icons.Material.Outlined.Lock" Class="ma-0">Private</MudChip>
                                }
                            </td>
                            <td class="sf-actions">
                                @if (f.CanManage)
                                {
                                    <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Primary" OnClick="() => { renamingId = f.Id; renameDraft = f.Name; }">Rename</MudButton>
                                    @if (f.IsShared)
                                    {
                                        <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Primary" OnClick="() => Run(() => Filters.SetSharedAsync(f.Id, false))">Unshare</MudButton>
                                    }
                                    else if (perms.Role >= ProjectRole.Developer)
                                    {
                                        <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Primary" OnClick="() => Run(() => Filters.SetSharedAsync(f.Id, true))">Share</MudButton>
                                    }
                                    <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Error" OnClick="() => Delete(f)">Delete</MudButton>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        </MudPaper>
    }
</div>
}

@code {
    [Parameter] public string Key { get; set; } = "";

    private Project? project;
    private ProjectPermissions perms = ProjectPermissions.None;
    private List<User> users = [];
    private ProjectWorkflow workflow = ProjectWorkflow.Empty;
    private List<SavedFilterView> filters = [];
    private List<BreadcrumbItem> crumbs = [];
    private bool notFound;
    private string? error, renameDraft;
    private int? renamingId;
    private IDisposable? liveSubscription;

    protected override async Task OnParametersSetAsync()
    {
        project = await Issues.GetProjectAsync(Key);
        notFound = project == null;
        if (project == null) return;
        crumbs = [new(project.Name, $"/p/{project.Key}/issues"), new("Issues", $"/p/{project.Key}/issues"), new("Saved filters", null, disabled: true)];
        perms = await Access.GetPermissionsAsync(project.Id);
        users = await Issues.GetUsersAsync();
        workflow = await Workflows.GetAsync(project.Id);
        await Load();
    }

    private async Task Load() => filters = project == null ? [] : await Filters.ListAsync(project.Id);

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender) liveSubscription = Live.Subscribe<SavedFiltersChanged>(e => e.ProjectId != project?.Id ? Task.CompletedTask : InvokeAsync(async () =>
        {
            await Load();
            StateHasChanged();
        }));
    }

    public void Dispose() => liveSubscription?.Dispose();

    private string Href(SavedFilterView f) => $"/p/{project!.Key}/issues" + (f.Query.Length > 0 ? "?" + f.Query : "");

    private async Task Run(Func<Task> action)
    {
        error = null;
        try { await action(); }
        catch (InvalidOperationException ex) { error = ex.Message; }
        await Load();
    }

    private async Task Rename(SavedFilterView f)
    {
        await Run(() => Filters.RenameAsync(f.Id, renameDraft ?? ""));
        if (error == null) renamingId = null;
    }

    private async Task RenameKey(KeyboardEventArgs e, SavedFilterView f)
    {
        if (e.Key == "Enter") await Rename(f);
        if (e.Key == "Escape") renamingId = null;
    }

    private async Task Delete(SavedFilterView f)
    {
        if (await Dialogs.ShowMessageBoxAsync("Delete filter", $"Delete the filter “{f.Name}”{(f.IsShared ? " for everyone in the project" : "")}?",
                yesText: "Delete", cancelText: "Cancel") != true) return;
        await Run(() => Filters.DeleteAsync(f.Id));
    }

    /// <summary>Human-readable conditions of a stored query.</summary>
    private IEnumerable<string> Describe(string query)
    {
        var f = IssueFilterQuery.Parse(query);
        if (f.Gql != null) { yield return "GQL: " + f.Gql; yield break; } // advanced filters store gql=… instead of the basic fields
        if (f.WorkflowStatusId is { } ws) yield return "status: " + (workflow.Find(ws)?.Name ?? $"#{ws}");
        if (f.Status is { } s) yield return $"status: any {s.Name()}";
        else if (f.WorkflowStatusId == null) yield return f.Open switch { true => "open", false => "closed", null => "open & closed" };
        if (f.AssigneeId is { } a) yield return "assignee: " + (a == 0 ? "unassigned" : users.FirstOrDefault(u => u.Id == a)?.DisplayName ?? $"#{a}");
        if (f.LabelId is { } l) yield return "label: " + (project!.Labels.FirstOrDefault(x => x.Id == l)?.Name ?? $"#{l}");
        if (f.MilestoneId is { } m) yield return "milestone: " + (m == 0 ? "none" : project!.Milestones.FirstOrDefault(x => x.Id == m)?.Title ?? $"#{m}");
        if (f.Type is { } t) yield return $"type: {t}";
        if (f.Priority is { } p) yield return $"priority: {p}";
        if (!string.IsNullOrWhiteSpace(f.Search)) yield return $"text: “{f.Search}”";
        if (f.Sort != new IssueFilter().Sort) yield return $"sort: {f.Sort}";
    }
}
