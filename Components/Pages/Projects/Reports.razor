@page "/p/{Key}/reports"
@implements IDisposable
@inject IssueService Issues
@inject SprintService Sprints
@inject LiveEvents Live

<PageTitle>Reports · @project?.Name</PageTitle>

@if (notFound)
{
    <ProjectNotFound />
}
else if (project != null)
{
    <div class="rp-page">
        <div class="d-flex align-center justify-space-between flex-wrap gap-4 mb-4">
            <div>
                <MudText Typo="Typo.h5" HtmlTag="h1" Class="rp-heading">Reports</MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary">@project.Name · sprint burndown and velocity</MudText>
            </div>
            <div class="d-flex align-center flex-wrap gap-2">
                <MudToggleGroup T="bool" Value="countMode" ValueChanged="v => countMode = v" Size="Size.Small" Color="Color.Primary" Outlined="true"
                                CheckMark="false" aria-label="Measure">
                    <MudToggleItem T="bool" Value="false" Text="Story points" />
                    <MudToggleItem T="bool" Value="true" Text="Issue count" />
                </MudToggleGroup>
                <MudButton Href="@($"/p/{project.Key}/reports/delivery")" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Outlined.QueryStats">Delivery reports</MudButton>
                <MudButton Href="@($"/p/{project.Key}/backlog")" Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Outlined.DirectionsRun">Backlog</MudButton>
            </div>
        </div>

        <MudPaper Outlined="true" Class="pa-5 mb-4">
            <div class="d-flex align-center justify-space-between flex-wrap gap-2 mb-3">
                <MudText Typo="Typo.h6" Class="rp-section">Burndown</MudText>
                @if (started.Count > 0)
                {
                    <div class="rp-sprint">
                        <MudSelect T="int" @bind-Value="sprintId" @bind-Value:after="LoadBurndown" Dense="true" Variant="Variant.Outlined" Margin="Margin.Dense"
                                   aria-label="Sprint">
                            @foreach (var s in started)
                            {
                                <MudSelectItem T="int" Value="@s.Id">@s.Name@(s.State == SprintState.Active ? " (active)" : "")</MudSelectItem>
                            }
                        </MudSelect>
                    </div>
                }
            </div>
            @if (burndown is { } b)
            {
                var last = b.Days.LastOrDefault(d => d.RemainingPoints != null);
                var completed = b.Sprint.State == SprintState.Completed;
                <div class="report-stats">
                    <div><span class="rp-label">Committed</span><strong>@(countMode ? b.StartCount : b.StartPoints)</strong></div>
                    <div><span class="rp-label">@(completed ? "Final scope" : "Scope now")</span><strong>@(countMode ? last?.ScopeCount : last?.ScopePoints)</strong></div>
                    <div><span class="rp-label">@(completed ? "Left open" : "Remaining")</span><strong>@(countMode ? last?.RemainingCount : last?.RemainingPoints)</strong></div>
                    <div><span class="rp-label">Dates</span><strong class="rp-dates">@b.Days[0].Date.ToString("MMM d") – @b.Days[^1].Date.ToString("MMM d")</strong></div>
                </div>
                @if (!string.IsNullOrEmpty(b.Sprint.Goal))
                {
                    <div class="rp-goal"><MudIcon Icon="@Icons.Material.Outlined.TrackChanges" Size="Size.Small" /> @b.Sprint.Goal</div>
                }
                <BurndownChart Data="b" CountMode="countMode" />
                <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mt-2">
                    Rebuilt from issue activity: status changes to and from Done, estimate changes and sprint membership. Issues without an estimate count as 0 points.
                </MudText>
            }
            else
            {
                <div class="rp-empty">No sprint has been started yet. Plan and start one on the <a href="/p/@project.Key/backlog">backlog</a>.</div>
            }
        </MudPaper>

        <MudPaper Outlined="true" Class="pa-5">
            <MudText Typo="Typo.h6" Class="rp-section mb-2">Velocity</MudText>
            @if (velocity.Count > 0)
            {
                <MudText Typo="Typo.body2" Class="mud-text-secondary mb-2">Committed: in the sprint when it started. Completed: done when it was completed. Last @velocity.Count completed sprints.</MudText>
                <VelocityChart Data="velocity" CountMode="countMode" />
            }
            else
            {
                <div class="rp-empty">Velocity appears once a sprint has been completed.</div>
            }
        </MudPaper>
    </div>
}

@code {
    [Parameter] public string Key { get; set; } = "";

    private Project? project;
    private bool notFound, countMode;
    private List<Sprint> started = [];
    private int sprintId;
    private Burndown? burndown;
    private List<VelocityEntry> velocity = [];

    protected override async Task OnParametersSetAsync()
    {
        if (project?.Key == Key.ToUpperInvariant()) return;
        project = await Issues.GetProjectAsync(Key);
        notFound = project == null;
        if (project == null) return;
        sprintId = 0;
        await Load();
    }

    private async Task Load()
    {
        if (project == null) return;
        started = (await Sprints.GetSprintsAsync(project.Id)).Where(s => s.State != SprintState.Planned).ToList();
        if (started.All(s => s.Id != sprintId)) sprintId = started.FirstOrDefault()?.Id ?? 0;
        velocity = await Sprints.GetVelocityAsync(project.Id, 8);
        await LoadBurndown();
    }

    private async Task LoadBurndown() =>
        burndown = sprintId == 0 || project == null ? null : await Sprints.GetBurndownAsync(project.Id, sprintId);

    // ----- Live updates: issues or sprints changed in this project -----
    private IDisposable? liveSubscription;

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender) liveSubscription = Live.Subscribe(OnLive);
    }

    private Task OnLive(LiveEvent e)
    {
        var pid = e switch { SprintChanged x => x.ProjectId, IssueChanged x => x.ProjectId, _ => -1 };
        return pid != project?.Id ? Task.CompletedTask : InvokeAsync(async () => { await Load(); StateHasChanged(); });
    }

    public void Dispose() => liveSubscription?.Dispose();
}
