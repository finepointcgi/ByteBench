@page "/p/{Key}/settings/integrations"
@using GitBench.Services.ChatIntegrations
@using GitBench.Services.Webhooks
@inject IssueService Issues
@inject ProjectAccess Access
@inject ChatIntegrationService Integrations
@inject ISnackbar Snackbar

<PageTitle>Chat integrations · @project?.Name</PageTitle>

<div class="chat-page">
@if (notFound)
{
    <ProjectNotFound />
}
else if (project != null && !perms.Can(ChatIntegrationService.RequiredPermission))
{
    <Forbidden Message="Only Maintainers and Owners can manage this project's chat integrations." BackHref="@($"/p/{Key}/settings")" />
}
else if (project != null)
{
    <div class="page-header">
        <MudText Typo="Typo.h5" HtmlTag="h1">Slack &amp; Microsoft Teams</MudText>
        <MudButton Href="@($"/p/{project.Key}/settings")" Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.ArrowBack">Settings</MudButton>
    </div>
    <MudText Typo="Typo.body2" Class="mud-text-secondary chat-narrow mb-4">
        Post updates from <b>@project.Key</b> to Slack or Teams channels. Messages go out through the same queue as
        <MudLink Href="@($"/p/{project.Key}/settings/webhooks")" Typo="Typo.body2">webhooks</MudLink>: retried up to 3 times, logged
        below, and turned off after @WebhookService.MaxConsecutiveFailures failures in a row. Webhook URLs and tokens are stored
        encrypted and never shown again.
    </MudText>

    @if (inherited.Count > 0)
    {
        <MudPaper Outlined="true" Class="chat-narrow pa-4 mb-4" data-testid="inherited-integrations">
            <MudText Typo="Typo.subtitle1" HtmlTag="h2" Class="chat-title">From the group</MudText>
            <MudText Typo="Typo.caption" HtmlTag="div" Class="mud-text-secondary mb-2">
                These integrations belong to the project's group and also announce this project's events. Turn one off to opt this project out;
                the group's owners manage them.
            </MudText>
            @foreach (var i in inherited)
            {
                <div class="d-flex align-center gap-2 mb-1" @key="i.Integration.Id">
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="@(i.Integration.Kind == WebhookKind.Teams ? Color.Info : Color.Secondary)">@(i.Integration.Kind == WebhookKind.Teams ? "Teams" : "Slack")</MudChip>
                    <b>@i.Integration.Name</b>
                    <span class="mud-text-secondary">from <span class="mono">@i.GroupPath</span></span>
                    <MudSpacer />
                    <MudSwitch T="bool" Value="@(!i.OptedOut)" ValueChanged="on => SetInherited(i, on)" Color="Color.Primary" Label="@(i.OptedOut ? "Opted out" : "Announcing")" />
                </div>
            }
            @if (error != null) { <MudText Typo="Typo.caption" Color="Color.Error">@error</MudText> }
        </MudPaper>
    }

    <ChatIntegrationsManager Scope="@ChatScope.Project(project.Id)" />
}
</div>

@code {
    [Parameter] public string Key { get; set; } = "";

    private Project? project;
    private ProjectPermissions perms = ProjectPermissions.None;
    private bool notFound;
    private string? error;
    private List<InheritedChatIntegration> inherited = [];

    protected override async Task OnParametersSetAsync()
    {
        project = await Issues.GetProjectAsync(Key);
        notFound = project == null;
        if (project == null) return;
        perms = await Access.GetPermissionsAsync(project.Id);
        if (perms.Can(ChatIntegrationService.RequiredPermission)) inherited = await Integrations.ListInheritedAsync(project.Id);
    }

    private async Task SetInherited(InheritedChatIntegration i, bool announcing)
    {
        error = null;
        try
        {
            await Integrations.SetOptOutAsync(project!.Id, i.Integration.Id, optOut: !announcing);
            inherited = await Integrations.ListInheritedAsync(project.Id);
            Snackbar.Add(announcing ? $"{i.Integration.Name} announces this project again." : $"This project opted out of {i.Integration.Name}.", Severity.Success);
        }
        catch (InvalidOperationException ex) { error = ex.Message; }
    }
}
