@page "/projects/new"
@inject IssueService Issues
@inject GroupService GroupSvc
@inject NavigationManager Nav

<PageTitle>New project · GitBench</PageTitle>

<div class="new-project">
<div class="page-header"><MudText Typo="Typo.h5" HtmlTag="h1">New project</MudText></div>

<MudPaper Outlined="true" Class="pa-5" Style="max-width:720px">
    <EditForm Model="model" OnValidSubmit="Create" FormName="new-project">
        <DataAnnotationsValidator />
        <MudStack Spacing="3">
            <MudSelect T="int?" Label="Group" @bind-Value="model.GroupId" Variant="Variant.Outlined" Margin="Margin.Dense" AnchorOrigin="Origin.BottomLeft"
                       ToStringFunc="@(id => id is { } g ? groups.FirstOrDefault(x => x.Id == g)?.FullPath ?? "" : "None (top-level project)")"
                       HelperText="Members of the group get their group role in the project. You need Maintainer or Owner in the group.">
                <MudSelectItem T="int?" Value="null">None (top-level project)</MudSelectItem>
                @foreach (var g in groups) { <MudSelectItem T="int?" Value="g.Id">@g.FullPath</MudSelectItem> }
            </MudSelect>
            <MudTextField T="string" Label="Name" Value="model.Name" ValueChanged="NameChanged" Immediate="true" For="() => model.Name"
                          Placeholder="My awesome project" Variant="Variant.Outlined" Margin="Margin.Dense" />
            <MudTextField T="string" Label="Key" Value="model.Key" ValueChanged="KeyChanged" Immediate="true" For="() => model.Key"
                          Placeholder="MAP" Variant="Variant.Outlined" Margin="Margin.Dense" Class="gb-mono-input"
                          HelperText="@($"Prefix for issue keys, e.g. {(string.IsNullOrEmpty(model.Key) ? "KEY" : model.Key.ToUpper())}-1")" />
            <MudTextField T="string" Label="Description" @bind-Value="model.Description" Lines="3" Sizing="InputSizing.Auto"
                          Variant="Variant.Outlined" Margin="Margin.Dense" />
            @if (error != null)
            {
                <MudAlert Severity="Severity.Error" Dense="true">@error</MudAlert>
            }
            <div class="d-flex gap-2">
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary">Create project</MudButton>
                <MudButton Href="/" Variant="Variant.Text">Cancel</MudButton>
            </div>
        </MudStack>
    </EditForm>
</MudPaper>
</div>

@code {
    [SupplyParameterFromQuery(Name = "group")] public int? Group { get; set; }

    private Project model = new();
    private List<GroupSummary> groups = [];

    protected override async Task OnInitializedAsync()
    {
        groups = await GroupSvc.CreatableInAsync();
        if (Group is { } g && groups.Any(x => x.Id == g)) model.GroupId = g;
    }
    private bool keyTouched;
    private string? error;

    private void NameChanged(string? value)
    {
        model.Name = value ?? "";
        SuggestKey();
    }

    private void KeyChanged(string? value)
    {
        keyTouched = true;
        model.Key = (value ?? "").ToUpperInvariant();
    }

    private void SuggestKey()
    {
        if (keyTouched || string.IsNullOrWhiteSpace(model.Name)) return;
        var words = model.Name.Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .Select(w => new string(w.Where(char.IsLetterOrDigit).ToArray())).Where(w => w.Length > 0).ToList();
        var key = words.Count > 1 ? string.Concat(words.Select(w => w[0])) : (words.FirstOrDefault() ?? "");
        key = new string(key.ToUpperInvariant().Take(6).ToArray());
        if (key.Length > 0 && char.IsLetter(key[0])) model.Key = key.Length == 1 ? key + "P" : key;
    }

    private async Task Create()
    {
        model.Key = model.Key.ToUpperInvariant();
        try
        {
            var p = await Issues.CreateProjectAsync(model);
            Nav.NavigateTo($"/p/{p.Key}/issues");
        }
        catch (InvalidOperationException ex) { error = ex.Message; }
    }
}
