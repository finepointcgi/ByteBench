@page "/p/{Key}/settings/webhooks"
@using GitBench.Services.Webhooks
@implements IDisposable
@inject IssueService Issues
@inject ProjectAccess Access
@inject WebhookService Hooks
@inject IJSRuntime JS

<PageTitle>Webhooks · @project?.Name</PageTitle>

@if (notFound)
{
    <ProjectNotFound />
}
else if (project != null && !perms.Can(WebhookService.RequiredPermission))
{
    <Forbidden Message="Only Maintainers and Owners can manage this project's webhooks." BackHref="@($"/p/{Key}/settings")" />
}
else if (project != null)
{
    <div class="page-header">
        <h1>Webhooks</h1>
        <a class="btn btn-outline-secondary btn-sm" href="/p/@project.Key/settings">← Settings</a>
    </div>
    <p class="muted small narrow" style="max-width:720px">
        GitBench POSTs a JSON payload to each webhook's URL when a subscribed event happens in <b>@project.Key</b>. Each request is
        signed: <code>X-GitBench-Signature-256: sha256=&lt;HMAC-SHA256(secret, body)&gt;</code>. Deliveries time out after 10 seconds and
        are retried up to 3 times on network errors and 5xx responses. A webhook is turned off after @WebhookService.MaxConsecutiveFailures
        failed deliveries in a row.
    </p>
    @if (error != null) { <div class="alert alert-danger py-2" style="max-width:720px">@error</div> }
    @if (shownSecret != null)
    {
        <div class="alert alert-success" style="max-width:720px">
            <div class="mb-2"><b>Copy the secret now.</b> It won't be shown again.</div>
            <div class="input-group">
                <input id="hook-secret" class="form-control mono" readonly value="@shownSecret" onfocus="this.select()" />
                <button type="button" class="btn btn-outline-secondary"
                        onclick="navigator.clipboard.writeText(document.getElementById('hook-secret').value); this.textContent='Copied';">Copy</button>
            </div>
        </div>
    }

    @foreach (var h in hooks)
    {
        <div class="card-panel narrow mb-3" @key="h.Id">
            <div class="d-flex align-items-start gap-2">
                <div class="flex-grow-1" style="min-width:0">
                    <div class="mono text-truncate" title="@h.Url">@h.Url</div>
                    <div class="small mt-1">
                        @if (h.IsActive) { <span class="badge text-bg-success">Active</span> }
                        else if (h.DisabledAt != null) { <span class="badge text-bg-danger" title="Turned off @h.DisabledAt.Value.ToLocalTime().ToString("g")">Disabled after @WebhookService.MaxConsecutiveFailures failures</span> }
                        else { <span class="badge text-bg-secondary">Inactive</span> }
                        @if (h.ConsecutiveFailures > 0) { <span class="text-danger ms-2">@h.ConsecutiveFailures failed in a row</span> }
                        <span class="muted ms-2">Secret <span class="mono">@WebhookService.Mask(h.Secret)</span></span>
                    </div>
                    <div class="small muted mt-1">@string.Join(", ", WebhookEventNames.Parse(h.Events))</div>
                </div>
                <div class="d-flex flex-wrap gap-1 justify-content-end" style="max-width:300px">
                    <button class="btn btn-outline-primary btn-sm" disabled="@busy" @onclick="() => Ping(h)">Send test ping</button>
                    <button class="btn btn-outline-secondary btn-sm" @onclick="() => StartEdit(h)">Edit</button>
                    <button class="btn btn-outline-secondary btn-sm" @onclick="() => Regenerate(h)">New secret</button>
                    <button class="btn btn-outline-danger btn-sm" @onclick="() => Delete(h)">Delete</button>
                </div>
            </div>
            @if (h.DisabledAt != null && !h.IsActive)
            {
                <div class="small text-danger mt-2">
                    GitBench turned this webhook off because its last @WebhookService.MaxConsecutiveFailures deliveries failed.
                    Fix the receiver, then edit the webhook and tick <i>Active</i> to turn it back on.
                </div>
            }

            <button class="btn btn-link btn-sm px-0 mt-2" @onclick="() => ToggleDeliveries(h.Id)">@(openHookId == h.Id ? "▾" : "▸") Recent deliveries</button>
                @if (openHookId == h.Id && deliveries.TryGetValue(h.Id, out var list))
                {
                    @if (list.Count == 0) { <div class="small muted mt-2">No deliveries yet. Send a test ping to try it out.</div> }
                    else
                    {
                        <table class="table table-sm small mt-2 mb-0">
                            <thead><tr><th>When</th><th>Event</th><th>Result</th><th>Time</th><th></th></tr></thead>
                            <tbody>
                                @foreach (var d in list)
                                {
                                    <tr @key="d.Id">
                                        <td title="@d.DeliveryId">@d.CreatedAt.ToLocalTime().ToString("g")@if (d.IsRedelivery) { <span class="badge text-bg-light ms-1">redelivery</span> }</td>
                                        <td class="mono">@d.Event</td>
                                        <td>
                                            @if (d.Success == null) { <span class="muted">pending…</span> }
                                            else if (d.Success == true) { <span class="text-success">✓ @d.StatusCode</span> }
                                            else { <span class="text-danger">✗ @(d.StatusCode?.ToString() ?? "")</span> <span class="muted">@d.Error</span> }
                                            @if (d.Attempts > 1) { <span class="muted"> (@d.Attempts attempts)</span> }
                                        </td>
                                        <td>@(d.Success == null ? "" : $"{d.DurationMs} ms")</td>
                                        <td class="text-end text-nowrap">
                                            <button class="btn btn-link btn-sm p-0 me-2" @onclick="() => expanded = expanded == d.Id ? null : d.Id">Details</button>
                                            <button class="btn btn-link btn-sm p-0" disabled="@(d.Success == null)" @onclick="() => Redeliver(h, d)">Redeliver</button>
                                        </td>
                                    </tr>
                                    @if (expanded == d.Id)
                                    {
                                        <tr>
                                            <td colspan="5">
                                                <div class="small muted">Delivery <span class="mono">@d.DeliveryId</span></div>
                                                <div class="small fw-semibold mt-1">Payload</div>
                                                <pre class="mono small border rounded p-2 mb-2" style="max-height:240px;overflow:auto;white-space:pre-wrap">@Pretty(d.Payload)</pre>
                                                <div class="small fw-semibold">Response body (first 4 KB)</div>
                                                <pre class="mono small border rounded p-2 mb-0" style="max-height:160px;overflow:auto;white-space:pre-wrap">@(d.ResponseBody ?? "(empty)")</pre>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    }
                    <button class="btn btn-link btn-sm px-0" @onclick="() => LoadDeliveries(h.Id)">Refresh</button>
                }
        </div>
    }

    <div class="card-panel narrow mb-4">
        <h2 class="section-title">@(editing == null ? "Add webhook" : "Edit webhook")</h2>
        <div class="mb-3">
            <label class="form-label" for="hook-url">Payload URL</label>
            <input id="hook-url" class="form-control mono" placeholder="https://example.com/hooks/gitbench" @bind="url" />
        </div>
        <div class="mb-3">
            <label class="form-label" for="hook-secret-in">Secret</label>
            <input id="hook-secret-in" class="form-control mono" type="password" autocomplete="new-password" @bind="secret"
                   placeholder="@(editing == null ? "Leave blank to generate a random secret" : "Leave blank to keep the current secret")" />
            <div class="form-text">Used to sign each delivery. At least 16 characters.</div>
        </div>
        <div class="mb-3">
            <span class="form-label d-block">Events</span>
            @foreach (var (name, description) in WebhookEventNames.Subscribable)
            {
                <label class="form-check">
                    <input class="form-check-input" type="checkbox" checked="@selected.Contains(name)" @onchange="e => Toggle(name, (bool)e.Value!)" />
                    <span class="form-check-label"><code>@name</code> <span class="muted small">@description</span></span>
                </label>
            }
            <button type="button" class="btn btn-link btn-sm px-0" @onclick="SelectAll">Select all</button>
        </div>
        <label class="form-check mb-3">
            <input class="form-check-input" type="checkbox" @bind="active" />
            <span class="form-check-label">Active</span>
        </label>
        <div>
            <button class="btn btn-primary btn-sm" disabled="@(busy || string.IsNullOrWhiteSpace(url))" @onclick="Save">@(editing == null ? "Add webhook" : "Save changes")</button>
            @if (editing != null) { <button class="btn btn-outline-secondary btn-sm ms-2" @onclick="ResetForm">Cancel</button> }
        </div>
        @if (error != null) { <div class="text-danger small mt-2">@error</div> }
    </div>
}

@code {
    [Parameter] public string Key { get; set; } = "";

    private Project? project;
    private ProjectPermissions perms = ProjectPermissions.None;
    private bool notFound, busy;
    private string? error, shownSecret;
    private List<Webhook> hooks = [];
    private readonly Dictionary<int, List<WebhookDelivery>> deliveries = [];
    private int? openHookId, expanded;
    private CancellationTokenSource? polling;

    // Form
    private Webhook? editing;
    private string url = "";
    private string? secret;
    private bool active = true;
    private HashSet<string> selected = [WebhookEventNames.Push];

    protected override async Task OnParametersSetAsync()
    {
        project = await Issues.GetProjectAsync(Key);
        notFound = project == null;
        if (project == null) return;
        perms = await Access.GetPermissionsAsync(project.Id);
        if (perms.Can(WebhookService.RequiredPermission)) await LoadHooks();
    }

    private async Task LoadHooks()
    {
        hooks = await Hooks.ListAsync(project!.Id);
        foreach (var id in deliveries.Keys.ToList()) await LoadDeliveries(id);
    }

    private async Task LoadDeliveries(int hookId)
    {
        if (hooks.All(h => h.Id != hookId)) { deliveries.Remove(hookId); return; }
        deliveries[hookId] = await Hooks.RecentDeliveriesAsync(project!.Id, hookId);
    }

    private async Task ToggleDeliveries(int hookId)
    {
        openHookId = openHookId == hookId ? null : hookId;
        if (openHookId == hookId) await LoadDeliveries(hookId);
    }

    private async Task<bool> Try(Func<Task> action)
    {
        error = null;
        try { await action(); return true; }
        catch (InvalidOperationException ex) { error = ex.Message; return false; }
    }

    private void Toggle(string name, bool on) { if (on) selected.Add(name); else selected.Remove(name); }
    private void SelectAll() => selected = WebhookEventNames.Subscribable.Select(e => e.Name).ToHashSet();

    private void StartEdit(Webhook h)
    {
        editing = h;
        url = h.Url;
        secret = null;
        active = h.IsActive;
        selected = WebhookEventNames.Parse(h.Events).ToHashSet();
        shownSecret = null;
    }

    private void ResetForm()
    {
        editing = null;
        url = "";
        secret = null;
        active = true;
        selected = [WebhookEventNames.Push];
    }

    private async Task Save()
    {
        busy = true;
        shownSecret = null;
        var ok = await Try(async () =>
        {
            if (editing == null)
            {
                var created = await Hooks.CreateAsync(project!.Id, url, secret, selected, active);
                shownSecret = string.IsNullOrWhiteSpace(secret) ? created.Secret : null;
            }
            else await Hooks.UpdateAsync(project!.Id, editing.Id, url, secret, selected, active);
        });
        busy = false;
        if (!ok) return;
        ResetForm();
        await LoadHooks();
    }

    private async Task Regenerate(Webhook h)
    {
        if (!await JS.InvokeAsync<bool>("confirm", "Replace this webhook's secret? Receivers must be updated with the new one.")) return;
        await Try(async () => shownSecret = await Hooks.RegenerateSecretAsync(project!.Id, h.Id));
        await LoadHooks();
    }

    private async Task Delete(Webhook h)
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"Delete the webhook for {h.Url}? Its delivery history is deleted too.")) return;
        if (await Try(() => Hooks.DeleteAsync(project!.Id, h.Id)))
        {
            if (editing?.Id == h.Id) ResetForm();
            await LoadHooks();
        }
    }

    private async Task Ping(Webhook h)
    {
        if (!await Try(() => Hooks.PingAsync(project!.Id, h.Id))) return;
        openHookId = h.Id;
        await LoadDeliveries(h.Id);
        StartPolling(h.Id);
    }

    private async Task Redeliver(Webhook h, WebhookDelivery d)
    {
        if (!await Try(() => Hooks.RedeliverAsync(project!.Id, d.Id))) return;
        await LoadDeliveries(h.Id);
        StartPolling(h.Id);
    }

    /// <summary>Deliveries finish in the background: refresh the list for a little while (stops once nothing is pending).</summary>
    private void StartPolling(int hookId)
    {
        polling?.Cancel();
        var cts = polling = new CancellationTokenSource();
        _ = InvokeAsync(async () =>
        {
            for (var i = 0; i < 30 && !cts.IsCancellationRequested; i++)
            {
                try { await Task.Delay(1000, cts.Token); } catch (OperationCanceledException) { return; }
                await LoadDeliveries(hookId);
                hooks = await Hooks.ListAsync(project!.Id);
                StateHasChanged();
                if (i >= 1 && deliveries.GetValueOrDefault(hookId)?.All(d => d.Success != null) == true) return;
            }
        });
    }

    private static string Pretty(string json)
    {
        try { return System.Text.Json.Nodes.JsonNode.Parse(json)?.ToJsonString(new System.Text.Json.JsonSerializerOptions { WriteIndented = true }) ?? json; }
        catch (System.Text.Json.JsonException) { return json; }
    }

    public void Dispose() => polling?.Cancel();
}
