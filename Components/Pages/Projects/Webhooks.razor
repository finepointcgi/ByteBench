@page "/p/{Key}/settings/webhooks"
@using ByteBench.Services.Webhooks
@implements IDisposable
@inject IssueService Issues
@inject ProjectAccess Access
@inject WebhookService Hooks
@inject IDialogService Dialogs
@inject ISnackbar Snackbar

<PageTitle>Webhooks · @project?.Name</PageTitle>

<div class="hooks-page">
@if (notFound)
{
    <ProjectNotFound />
}
else if (project != null && !perms.Can(WebhookService.RequiredPermission))
{
    <Forbidden Message="Only Maintainers and Owners can manage this project's webhooks." BackHref="@($"/p/{Key}/settings")" />
}
else if (project != null)
{
    <div class="page-header">
        <MudText Typo="Typo.h5" HtmlTag="h1">Webhooks</MudText>
        <MudButton Href="@($"/p/{project.Key}/settings")" Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.ArrowBack">Settings</MudButton>
    </div>
    <MudText Typo="Typo.body2" Class="mud-text-secondary hooks-narrow mb-4">
        ByteBench POSTs a JSON payload to each webhook's URL when a subscribed event happens in <b>@project.Key</b>. Each request is
        signed: <code>X-ByteBench-Signature-256: sha256=&lt;HMAC-SHA256(secret, body)&gt;</code>. Deliveries time out after 10 seconds and
        are retried up to 3 times on network errors and 5xx responses. A webhook is turned off after @WebhookService.MaxConsecutiveFailures
        failed deliveries in a row.
    </MudText>
    @if (error != null) { <MudAlert Severity="Severity.Error" Dense="true" Class="hooks-narrow mb-3">@error</MudAlert> }
    @if (shownSecret != null)
    {
        <MudAlert Severity="Severity.Success" Class="hooks-narrow mb-3">
            <div class="mb-2"><b>Copy the secret now.</b> It won't be shown again.</div>
            <div class="secret-row">
                <input id="hook-secret" class="secret-input mono" readonly value="@shownSecret" data-select-on-focus aria-label="Webhook secret" />
                @* Handled by wwwroot/js/forms.js (data-copy-from), not a Blazor handler: the clipboard needs the click's user gesture, which a server round trip loses. *@
                <button type="button" class="mud-button-root mud-button mud-button-outlined mud-button-outlined-default mud-button-outlined-size-small"
                        data-copy-from="hook-secret">Copy</button>
            </div>
        </MudAlert>
    }

    @foreach (var h in hooks)
    {
        <MudPaper Outlined="true" Class="hooks-narrow pa-4 mb-3" @key="h.Id">
            <div class="hook-head">
                <div class="hook-info">
                    <div class="mono hook-url" title="@h.Url">@h.Url</div>
                    <div class="hook-status">
                        @if (h.IsActive) { <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Text">Active</MudChip> }
                        else if (h.DisabledAt != null)
                        {
                            <MudTooltip Text="@($"Turned off {h.DisabledAt.Value.ToLocalTime():g}")">
                                <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Text">Disabled after @WebhookService.MaxConsecutiveFailures failures</MudChip>
                            </MudTooltip>
                        }
                        else { <MudChip T="string" Size="Size.Small" Variant="Variant.Text">Inactive</MudChip> }
                        @if (h.ConsecutiveFailures > 0) { <span class="hook-error">@h.ConsecutiveFailures failed in a row</span> }
                        <span class="hook-muted">Secret <span class="mono">@h.Secret</span></span>
                    </div>
                    <div class="hook-muted hook-events">@string.Join(", ", WebhookEventNames.Parse(h.Events))</div>
                </div>
                <div class="hook-actions">
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Outlined.Send"
                               Disabled="@busy" OnClick="() => Ping(h)">Send test ping</MudButton>
                    <MudTooltip Text="Edit">
                        <MudIconButton Icon="@Icons.Material.Outlined.Edit" Size="Size.Small" aria-label="Edit webhook" OnClick="() => StartEdit(h)" />
                    </MudTooltip>
                    <MudTooltip Text="New secret">
                        <MudIconButton Icon="@Icons.Material.Outlined.Key" Size="Size.Small" aria-label="New secret" OnClick="() => Regenerate(h)" />
                    </MudTooltip>
                    <MudTooltip Text="Delete">
                        <MudIconButton Icon="@Icons.Material.Outlined.Delete" Size="Size.Small" Color="Color.Error" aria-label="Delete webhook" OnClick="() => Delete(h)" />
                    </MudTooltip>
                </div>
            </div>
            @if (h.DisabledAt != null && !h.IsActive)
            {
                <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-2">
                    ByteBench turned this webhook off because its last @WebhookService.MaxConsecutiveFailures deliveries failed.
                    Fix the receiver, then edit the webhook and tick <i>Active</i> to turn it back on.
                </MudAlert>
            }

            <MudButton Variant="Variant.Text" Size="Size.Small" Class="mt-2"
                       StartIcon="@(openHookId == h.Id ? Icons.Material.Filled.ExpandMore : Icons.Material.Filled.ChevronRight)"
                       aria-expanded="@(openHookId == h.Id ? "true" : "false")" OnClick="() => ToggleDeliveries(h.Id)">Recent deliveries</MudButton>
            @if (openHookId == h.Id && deliveries.TryGetValue(h.Id, out var list))
            {
                @if (list.Count == 0) { <MudText Typo="Typo.caption" HtmlTag="div" Class="mud-text-secondary mt-2">No deliveries yet. Send a test ping to try it out.</MudText> }
                else
                {
                    <div class="deliveries">
                        <MudSimpleTable Dense="true" Elevation="0">
                            <thead><tr><th>When</th><th>Event</th><th>Result</th><th>Time</th><th></th></tr></thead>
                            <tbody>
                                @foreach (var d in list)
                                {
                                    <tr @key="d.Id">
                                        <td title="@d.DeliveryId" class="nowrap">@d.CreatedAt.ToLocalTime().ToString("g")@if (d.IsRedelivery) { <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Class="ml-1">redelivery</MudChip> }</td>
                                        <td class="mono">@d.Event</td>
                                        <td>
                                            @if (d.Success == null) { <span class="hook-muted">pending…</span> }
                                            else if (d.Success == true) { <span class="hook-ok"><MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" Class="result-icon" /> @d.StatusCode</span> }
                                            else { <span class="hook-error"><MudIcon Icon="@Icons.Material.Filled.Cancel" Size="Size.Small" Class="result-icon" /> @(d.StatusCode?.ToString() ?? "")</span> <span class="hook-muted">@d.Error</span> }
                                            @if (d.Attempts > 1) { <span class="hook-muted"> (@d.Attempts attempts)</span> }
                                        </td>
                                        <td class="nowrap">@(d.Success == null ? "" : $"{d.DurationMs} ms")</td>
                                        <td class="nowrap right">
                                            <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Primary"
                                                       aria-expanded="@(expanded == d.Id ? "true" : "false")"
                                                       OnClick="() => expanded = expanded == d.Id ? null : d.Id">Details</MudButton>
                                            <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Primary" Disabled="@(d.Success == null)"
                                                       OnClick="() => Redeliver(h, d)">Redeliver</MudButton>
                                        </td>
                                    </tr>
                                    @if (expanded == d.Id)
                                    {
                                        <tr class="detail-row">
                                            <td colspan="5">
                                                <div class="hook-muted">Delivery <span class="mono">@d.DeliveryId</span></div>
                                                <div class="detail-label">Payload</div>
                                                <pre class="code-box mono" style="max-height:240px">@Pretty(d.Payload)</pre>
                                                <div class="detail-label">Response body (first 4 KB)</div>
                                                <pre class="code-box mono" style="max-height:160px">@(d.ResponseBody ?? "(empty)")</pre>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </MudSimpleTable>
                    </div>
                }
                <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Filled.Refresh" OnClick="() => LoadDeliveries(h.Id)">Refresh</MudButton>
            }
        </MudPaper>
    }

    <MudPaper Outlined="true" Class="hooks-narrow pa-5 mb-4">
        <MudText Typo="Typo.subtitle1" HtmlTag="h2" Class="hooks-title">@(editing == null ? "Add webhook" : "Edit webhook")</MudText>
        <MudStack Spacing="3">
            <MudTextField T="string" Label="Payload URL" @bind-Value="url" Immediate="true" Placeholder="https://example.com/hooks/bytebench"
                          Variant="Variant.Outlined" Margin="Margin.Dense" Class="hooks-mono" id="hook-url" />
            <MudTextField T="string" Label="Secret" @bind-Value="secret" InputType="InputType.Password" autocomplete="new-password"
                          Placeholder="@(editing == null ? "Leave blank to generate a random secret" : "Leave blank to keep the current secret")"
                          HelperText="Used to sign each delivery. At least 16 characters." Variant="Variant.Outlined" Margin="Margin.Dense"
                          Class="hooks-mono" id="hook-secret-in" />
            <div>
                <MudText Typo="Typo.body2" Class="hooks-label">Events</MudText>
                @foreach (var (name, description) in WebhookEventNames.Subscribable)
                {
                    <MudCheckBox T="bool" Value="@selected.Contains(name)" ValueChanged="on => Toggle(name, on)" Color="Color.Primary" Dense="true">
                        <code>@name</code> <span class="hook-muted">@description</span>
                    </MudCheckBox>
                }
                <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Primary" OnClick="SelectAll">Select all</MudButton>
            </div>
            <MudCheckBox T="bool" @bind-Value="active" Color="Color.Primary" Dense="true" Label="Active" />
            <div class="d-flex gap-2">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" Disabled="@(busy || string.IsNullOrWhiteSpace(url))"
                           OnClick="Save">@(editing == null ? "Add webhook" : "Save changes")</MudButton>
                @if (editing != null) { <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="ResetForm">Cancel</MudButton> }
            </div>
            @if (error != null) { <MudText Typo="Typo.caption" Color="Color.Error">@error</MudText> }
        </MudStack>
    </MudPaper>
}
</div>

@code {
    [Parameter] public string Key { get; set; } = "";

    private Project? project;
    private ProjectPermissions perms = ProjectPermissions.None;
    private bool notFound, busy;
    private string? error, shownSecret;
    private List<Webhook> hooks = [];
    private readonly Dictionary<int, List<WebhookDelivery>> deliveries = [];
    private int? openHookId, expanded;
    private CancellationTokenSource? polling;

    // Form
    private Webhook? editing;
    private string url = "";
    private string? secret;
    private bool active = true;
    private HashSet<string> selected = [WebhookEventNames.Push];

    protected override async Task OnParametersSetAsync()
    {
        project = await Issues.GetProjectAsync(Key);
        notFound = project == null;
        if (project == null) return;
        perms = await Access.GetPermissionsAsync(project.Id);
        if (perms.Can(WebhookService.RequiredPermission)) await LoadHooks();
    }

    private async Task LoadHooks()
    {
        hooks = await Hooks.ListAsync(project!.Id);
        foreach (var id in deliveries.Keys.ToList()) await LoadDeliveries(id);
    }

    private async Task LoadDeliveries(int hookId)
    {
        if (hooks.All(h => h.Id != hookId)) { deliveries.Remove(hookId); return; }
        deliveries[hookId] = await Hooks.RecentDeliveriesAsync(project!.Id, hookId);
    }

    private async Task ToggleDeliveries(int hookId)
    {
        openHookId = openHookId == hookId ? null : hookId;
        if (openHookId == hookId) await LoadDeliveries(hookId);
    }

    private async Task<bool> Try(Func<Task> action)
    {
        error = null;
        try { await action(); return true; }
        catch (InvalidOperationException ex) { error = ex.Message; return false; }
    }

    private void Toggle(string name, bool on) { if (on) selected.Add(name); else selected.Remove(name); }
    private void SelectAll() => selected = WebhookEventNames.Subscribable.Select(e => e.Name).ToHashSet();

    private void StartEdit(Webhook h)
    {
        editing = h;
        url = h.Url;
        secret = null;
        active = h.IsActive;
        selected = WebhookEventNames.Parse(h.Events).ToHashSet();
        shownSecret = null;
    }

    private void ResetForm()
    {
        editing = null;
        url = "";
        secret = null;
        active = true;
        selected = [WebhookEventNames.Push];
    }

    private async Task Save()
    {
        busy = true;
        shownSecret = null;
        var ok = await Try(async () =>
        {
            if (editing == null)
            {
                var created = await Hooks.CreateAsync(project!.Id, url, secret, selected, active);
                shownSecret = string.IsNullOrWhiteSpace(secret) ? created.Secret : null;
            }
            else await Hooks.UpdateAsync(project!.Id, editing.Id, url, secret, selected, active);
        });
        busy = false;
        if (!ok) return;
        Snackbar.Add(editing == null ? "Webhook added." : "Webhook saved.", Severity.Success);
        ResetForm();
        await LoadHooks();
    }

    private async Task Regenerate(Webhook h)
    {
        if (await Dialogs.ShowMessageBoxAsync("Replace secret?", "Replace this webhook's secret? Receivers must be updated with the new one.",
                yesText: "Replace secret", cancelText: "Cancel") != true) return;
        await Try(async () => shownSecret = await Hooks.RegenerateSecretAsync(project!.Id, h.Id));
        await LoadHooks();
    }

    private async Task Delete(Webhook h)
    {
        if (await Dialogs.ShowMessageBoxAsync("Delete webhook?", $"Delete the webhook for {h.Url}? Its delivery history is deleted too.",
                yesText: "Delete", cancelText: "Cancel") != true) return;
        if (await Try(() => Hooks.DeleteAsync(project!.Id, h.Id)))
        {
            if (editing?.Id == h.Id) ResetForm();
            await LoadHooks();
        }
    }

    private async Task Ping(Webhook h)
    {
        if (!await Try(() => Hooks.PingAsync(project!.Id, h.Id))) return;
        openHookId = h.Id;
        await LoadDeliveries(h.Id);
        StartPolling(h.Id);
    }

    private async Task Redeliver(Webhook h, WebhookDelivery d)
    {
        if (!await Try(() => Hooks.RedeliverAsync(project!.Id, d.Id))) return;
        await LoadDeliveries(h.Id);
        StartPolling(h.Id);
    }

    /// <summary>Deliveries finish in the background: refresh the list for a little while (stops once nothing is pending).</summary>
    private void StartPolling(int hookId)
    {
        polling?.Cancel();
        var cts = polling = new CancellationTokenSource();
        _ = InvokeAsync(async () =>
        {
            for (var i = 0; i < 30 && !cts.IsCancellationRequested; i++)
            {
                try { await Task.Delay(1000, cts.Token); } catch (OperationCanceledException) { return; }
                await LoadDeliveries(hookId);
                hooks = await Hooks.ListAsync(project!.Id);
                StateHasChanged();
                if (i >= 1 && deliveries.GetValueOrDefault(hookId)?.All(d => d.Success != null) == true) return;
            }
        });
    }

    private static string Pretty(string json)
    {
        try { return System.Text.Json.Nodes.JsonNode.Parse(json)?.ToJsonString(new System.Text.Json.JsonSerializerOptions { WriteIndented = true }) ?? json; }
        catch (System.Text.Json.JsonException) { return json; }
    }


    public void Dispose() => polling?.Cancel();
}
