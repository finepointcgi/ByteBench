@page "/p/{Key}/epics"
@inject IssueService Issues
@inject LinkedWorkService LinkedWork
@inject ProjectAccess Access
@inject LiveEvents Live
@implements IDisposable

<PageTitle>Epics · @project?.Name</PageTitle>

@if (notFound)
{
    <ProjectNotFound />
}
else if (project != null)
{
    <div class="page-header">
        <div>
            <h1>Epics</h1>
            <div class="muted">@project.Name</div>
        </div>
        @if (canCreate)
        {
            <a class="btn btn-primary" href="/p/@project.Key/issues/new">+ New issue</a>
        }
    </div>

    @if (epics.Count == 0)
    {
        <div class="empty">No epics yet. Create an issue with type <b>Epic</b> to group stories and tasks.</div>
    }
    else
    {
        <div class="lw-epics">
            @foreach (var e in epics)
            {
                <div class="lw-epic @(e.Epic.Status == IssueStatus.Done ? "lw-done-row" : "")" @key="e.Epic.Id">
                    <div class="lw-epic-head">
                        <span>⚡</span>
                        <a class="mono small" href="@e.Epic.Url">@e.Epic.Key</a>
                        <a class="lw-epic-title" href="@e.Epic.Url">@e.Epic.Title</a>
                        <StatusBadge Status="e.Epic.Status" />
                        <Avatar User="e.Epic.Assignee" Size="22" />
                    </div>
                    <div class="progress-thin" title="@e.Done of @e.Total child issues done"><div style="width:@(e.Percent)%"></div></div>
                    <div class="lw-epic-stats small muted">
                        <span><b>@e.Done</b>/@e.Total child issues done (@e.Percent%)</span>
                        <span>· <b>@e.DonePoints</b>/@e.Points points</span>
                        @if (canCreate)
                        {
                            <a class="ms-auto" href="/p/@project.Key/issues/new?parent=@e.Epic.Key">+ Add child issue</a>
                        }
                    </div>
                </div>
            }
        </div>
    }
}

@code {
    [Parameter] public string Key { get; set; } = "";

    private Project? project;
    private bool notFound, canCreate;
    private List<EpicSummary> epics = [];
    private IDisposable? liveSubscription;

    protected override async Task OnParametersSetAsync()
    {
        project = await Issues.GetProjectAsync(Key);
        notFound = project == null;
        if (project == null) return;
        canCreate = await Access.CanAsync(project.Id, Permission.EditIssues);
        epics = await LinkedWork.GetEpicsAsync(project.Id);
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender) liveSubscription = Live.Subscribe<BoardChanged>(e => project?.Id != e.ProjectId ? Task.CompletedTask : InvokeAsync(async () =>
        {
            epics = await LinkedWork.GetEpicsAsync(project.Id);
            StateHasChanged();
        }));
    }

    public void Dispose() => liveSubscription?.Dispose();
}
