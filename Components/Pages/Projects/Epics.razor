@page "/p/{Key}/epics"
@inject IssueService Issues
@inject LinkedWorkService LinkedWork
@inject ProjectAccess Access
@inject LiveEvents Live
@implements IDisposable

<PageTitle>Epics · @project?.Name</PageTitle>

@if (notFound)
{
    <ProjectNotFound />
}
else if (project != null)
{
    <div class="ep-page">
        <div class="d-flex align-center justify-space-between flex-wrap gap-4 mb-4">
            <div>
                <MudText Typo="Typo.h5" HtmlTag="h1" Class="ep-heading">Epics</MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary">@project.Name</MudText>
            </div>
            @if (canCreate)
            {
                <MudButton Href="@($"/p/{project.Key}/issues/new")" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add">New issue</MudButton>
            }
        </div>

        @if (epics.Count == 0)
        {
            <div class="ep-empty">No epics yet. Create an issue with type <b>Epic</b> to group stories and tasks.</div>
        }
        else
        {
            <MudStack Spacing="3">
                @foreach (var e in epics)
                {
                    <MudPaper Outlined="true" Class="@("ep-epic" + (e.Epic.Status == IssueStatus.Done ? " ep-done" : ""))" @key="e.Epic.Id">
                        <div class="ep-epic-head">
                            <MudIcon Icon="@Icons.Material.Filled.Bolt" Size="Size.Small" Class="ep-bolt" />
                            <a class="mono ep-key" href="@e.Epic.Url">@e.Epic.Key</a>
                            <a class="ep-title" href="@e.Epic.Url">@e.Epic.Title</a>
                            <StatusBadge Status="e.Epic.Status" />
                            <Avatar User="e.Epic.Assignee" Size="22" />
                        </div>
                        <MudTooltip Text="@($"{e.Done} of {e.Total} child issues done")" RootClass="d-block">
                            <MudProgressLinear Value="e.Percent" Color="Color.Success" Rounded="true" Size="Size.Small" Class="my-2"
                                               aria-label="@($"{e.Done} of {e.Total} child issues done")" />
                        </MudTooltip>
                        <div class="ep-stats">
                            <span><b>@e.Done</b>/@e.Total child issues done (@e.Percent%)</span>
                            <span>· <b>@e.DonePoints</b>/@e.Points points</span>
                            @if (canCreate)
                            {
                                <MudButton Href="@($"/p/{project.Key}/issues/new?parent={e.Epic.Key}")" Variant="Variant.Text" Size="Size.Small" Color="Color.Primary"
                                           StartIcon="@Icons.Material.Filled.Add" Class="ep-add">Add child issue</MudButton>
                            }
                        </div>
                    </MudPaper>
                }
            </MudStack>
        }
    </div>
}

@code {
    [Parameter] public string Key { get; set; } = "";

    private Project? project;
    private bool notFound, canCreate;
    private List<EpicSummary> epics = [];
    private IDisposable? liveSubscription;

    protected override async Task OnParametersSetAsync()
    {
        project = await Issues.GetProjectAsync(Key);
        notFound = project == null;
        if (project == null) return;
        canCreate = await Access.CanAsync(project.Id, Permission.EditIssues);
        epics = await LinkedWork.GetEpicsAsync(project.Id);
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender) liveSubscription = Live.Subscribe<BoardChanged>(e => project?.Id != e.ProjectId ? Task.CompletedTask : InvokeAsync(async () =>
        {
            epics = await LinkedWork.GetEpicsAsync(project.Id);
            StateHasChanged();
        }));
    }

    public void Dispose() => liveSubscription?.Dispose();
}
