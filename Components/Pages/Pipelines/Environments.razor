@page "/p/{Key}/repos/{Slug}/environments"
@inherits RepoPageBase
@inject ProjectAccess Access

<PageTitle>Environments · @Repo?.Name</PageTitle>

@if (NotFound)
{
    <ProjectNotFound Message="This repository does not exist." />
}
else if (Repo != null)
{
    <RepoHeader Repo="Repo" Active="environments" />

    <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">
        A job with <span class="mono">environment: { name: production, url: … }</span> in <span class="mono">@CiFile.FileName</span> records a deployment
        each time it runs (<span class="mono">action: stop</span> makes a stop job). Deploys to <b>protected</b> environments wait for approval.
        <a href="@($"/p/{Repo.Project.Key}/environments")">All environments in @Repo.Project.Name</a>
    </MudText>
    <ByteBench.Components.Pipelines.EnvironmentsView Project="Repo.Project" Repo="Repo" Perms="perms" />
}

@code {
    private ProjectPermissions perms = ProjectPermissions.None;

    protected override async Task OnParametersSetAsync()
    {
        if (!await LoadRepoAsync()) return;
        perms = await Access.GetPermissionsAsync(Repo!.ProjectId);
    }
}
