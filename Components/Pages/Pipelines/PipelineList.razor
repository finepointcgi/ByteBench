@page "/p/{Key}/repos/{Slug}/pipelines"
@inherits RepoPageBase
@inject PipelineService Pipelines
@inject ProjectAccess Access
@inject LiveEvents Live
@implements IDisposable

<PageTitle>Pipelines · @Repo?.Name</PageTitle>

@if (NotFound)
{
    <ProjectNotFound Message="This repository does not exist." />
}
else if (Repo != null)
{
    <RepoHeader Repo="Repo" Active="pipelines" />

    <div class="repo-toolbar">
        @if (!Pipelines.Enabled)
        {
            <span class="muted small">CI pipelines are turned off on this server.</span>
        }
        else if (perms.Can(Permission.PushCode) && branches.Count > 0)
        {
            <MudSelect T="string" @bind-Value="runBranch" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" OuterClass="gb-ref-select gb-mono-input run-branch"
                       aria-label="Branch to run">
                @foreach (var b in branches) { <MudSelectItem T="string" Value="@b"><span class="mono">@b</span></MudSelectItem> }
                @foreach (var t in tags) { <MudSelectItem T="string" Value="@(CiRef.ForTag(t))"><span class="mono">tag @t</span></MudSelectItem> }
            </MudSelect>
            <MudTextField T="string" @bind-Value="runVariables" Variant="Variant.Outlined" Margin="Margin.Dense" Lines="1" MaxLines="6" Sizing="InputSizing.Auto"
                          Placeholder="Variables: NAME=value, one per line (optional)" aria-label="Variables for this run" Class="gb-mono-input run-variables" />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.PlayArrow" Disabled="@busy" OnClick="Run">Run pipeline</MudButton>
        }
        @if (perms.Can(Permission.ManageRepositories))
        {
            <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Outlined.Schedule" Href="@PipelineUrls.Schedules(Repo)">Schedules</MudButton>
        }
        <span class="toolbar-note muted small">Pipelines run <span class="mono">@CiFile.FileName</span> from the repository root.</span>
    </div>
    @if (Error != null) { <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3">@Error</MudAlert> }

    <div class="gb-rows ci-list">
        @if (list == null || list.Items.Count == 0)
        {
            <div class="empty">
                No pipelines yet. Add a <span class="mono">@CiFile.FileName</span> file to the repository root and push to run one.
            </div>
        }
        else
        {
            @foreach (var p in list.Items)
            {
                <div class="gb-row gb-row-hover ci-row" @key="p.Id">
                    <div class="ci-col-status"><PipelineStatusIcon Status="p.Status" ShowLabel="true" Href="@PipelineUrls.Detail(Repo, p.Id)" /></div>
                    <div class="gb-row-main">
                        <div class="gb-row-title">
                            <a href="@PipelineUrls.Detail(Repo, p.Id)">#@p.Id</a>
                            <span class="ci-msg">@(p.CommitMessage ?? "")</span>
                        </div>
                        <div class="gb-row-meta">
                            <a class="branch-pill" href="@RepoUrls.Source(Repo, CiRef.Browsable(p.Ref))">@(CiRef.IsTag(p.Ref) ? "tag " : "")@CiRef.Display(p.Ref)</a>
                            <a class="sha-pill" href="@RepoUrls.Commit(Repo, p.CommitSha)">@p.CommitSha[..7]</a>
                            · @PipelineFormat.Trigger(p)@if (p.TriggeredBy != null) {<span> by <b>@p.TriggeredBy.DisplayName</b></span>}
                            @if (p.Error != null) { <span class="ci-row-error"> · @Shorten(p.Error)</span> }
                        </div>
                    </div>
                    <div class="ci-col-time muted small">
                        @if (p.StartedAt != null) { <div title="Duration" class="ci-duration"><MudIcon Icon="@Icons.Material.Outlined.Timer" Style="font-size: 14px" /> @PipelineFormat.Duration(p.StartedAt, p.FinishedAt)</div> }
                        <div title="@p.CreatedAt.ToLocalTime().ToString("g")">@Display.Ago(p.CreatedAt)</div>
                    </div>
                </div>
            }
        }
    </div>
    @if (list != null && list.Pages > 1)
    {
        <div class="gb-pager">
            @if (list.Page > 1)
            {
                <MudButton Href="@PageUrl(list.Page - 1)" Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.ChevronLeft">Newer</MudButton>
            }
            <span class="muted small">Page @list.Page of @list.Pages</span>
            @if (list.Page < list.Pages)
            {
                <MudButton Href="@PageUrl(list.Page + 1)" Variant="Variant.Outlined" Size="Size.Small" EndIcon="@Icons.Material.Filled.ChevronRight">Older</MudButton>
            }
        </div>
    }
}

@code {
    [SupplyParameterFromQuery(Name = "page")] public int? PageNumber { get; set; }

    private PipelinePage? list;
    private ProjectPermissions perms = ProjectPermissions.None;
    private List<string> branches = [];
    private string? runBranch;
    private string? runVariables;
    private List<string> tags = [];
    private bool busy;
    private IDisposable? sub;
    private int reloadPending;

    protected override async Task OnParametersSetAsync()
    {
        if (!await LoadRepoAsync()) return;
        perms = await Access.GetPermissionsAsync(Repo!.ProjectId);
        branches = (await Git(path => GitOps.ListBranches(path, Repo!.DefaultBranch))).Select(b => b.Name).ToList();
        tags = (await Git(path => GitOps.ListTagDetails(path))).Select(t => t.Name).Take(50).ToList();
        if (runBranch == null || !(branches.Contains(runBranch) || CiRef.IsTag(runBranch) && tags.Contains(CiRef.TagName(runBranch))))
            runBranch = branches.Contains(Repo.DefaultBranch) ? Repo.DefaultBranch : branches.FirstOrDefault();
        await LoadAsync();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender) sub = Live.Subscribe<PipelineChanged>(OnPipelineChanged);
    }

    private async Task OnPipelineChanged(PipelineChanged e)
    {
        if (Repo == null || e.RepositoryId != Repo.Id) return;
        // Logs flush every second while jobs run; coalesce bursts of events into one reload.
        if (Interlocked.Exchange(ref reloadPending, 1) == 1) return;
        await Task.Delay(500);
        Interlocked.Exchange(ref reloadPending, 0);
        await InvokeAsync(async () => { await LoadAsync(); StateHasChanged(); });
    }

    private async Task LoadAsync() => list = await Pipelines.ListAsync(Repo!, PageNumber ?? 1);

    private async Task Run()
    {
        if (runBranch == null) return;
        Error = null;
        busy = true;
        try
        {
            var vars = ParseVariables(runVariables);
            var id = CiRef.IsTag(runBranch) ? await Pipelines.RunTagAsync(Repo!, CiRef.TagName(runBranch), vars) : await Pipelines.RunAsync(Repo!, runBranch, vars);
            Nav.NavigateTo(PipelineUrls.Detail(Repo!, id));
        }
        catch (InvalidOperationException ex) { Error = ex.Message; }
        finally { busy = false; }
    }

    /// <summary>"NAME=value" lines; blank lines and lines starting with # are ignored. The service validates the names and values.</summary>
    private static Dictionary<string, string>? ParseVariables(string? text)
    {
        if (string.IsNullOrWhiteSpace(text)) return null;
        var result = new Dictionary<string, string>(StringComparer.Ordinal);
        foreach (var raw in text.Split('\n'))
        {
            var line = raw.Trim('\r', ' ', '\t');
            if (line.Length == 0 || line.StartsWith('#')) continue;
            var eq = line.IndexOf('=');
            if (eq <= 0) throw new InvalidOperationException($"'{line}' isn't NAME=value.");
            result[line[..eq].Trim()] = line[(eq + 1)..];
        }
        return result;
    }

    private string PageUrl(int n) => PipelineUrls.List(Repo!) + (n > 1 ? $"?page={n}" : "");

    private static string Shorten(string s) => s.Length > 120 ? s[..119] + "…" : s;

    public void Dispose() => sub?.Dispose();
}
