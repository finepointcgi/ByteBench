@page "/p/{Key}/repos/{Slug}/pipelines/schedules"
@inherits RepoPageBase
@inject PipelineScheduleService Schedules
@inject PipelineService Pipelines
@inject ProjectAccess Access
@inject IDialogService Dialogs
@inject ISnackbar Snackbar

<PageTitle>Pipeline schedules · @Repo?.Name</PageTitle>

@if (NotFound)
{
    <ProjectNotFound Message="This repository does not exist." />
}
else if (Repo != null && !perms.Can(Permission.ManageRepositories))
{
    <RepoHeader Repo="Repo" Active="pipelines" />
    <Forbidden Message="Only Maintainers and Owners can manage pipeline schedules." BackHref="@PipelineUrls.List(Repo)" />
}
else if (Repo != null)
{
    <RepoHeader Repo="Repo" Active="pipelines" />

    <div class="mb-3">
        <MudText Typo="Typo.h6" HtmlTag="h2" Class="d-flex align-center gap-2 mb-1"><MudIcon Icon="@Icons.Material.Outlined.Schedule" /> Pipeline schedules</MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary">
            Run a branch's pipeline on a cron schedule (5 fields, in UTC: minute hour day-of-month month day-of-week, e.g.
            <span class="mono">0 3 * * 1-5</span> or <span class="mono">@@daily</span>). Pipelines run as the schedule's owner, the last person who saved it,
            with <span class="mono">CI_PIPELINE_SOURCE=schedule</span> and the variables below (not secret: use
            <a href="@(RepoUrls.Base(Repo) + "/settings/ci-variables")">CI variables</a> for secrets).
            @if (!Pipelines.Enabled) { <b> CI pipelines are turned off on this server.</b> }
        </MudText>
    </div>

    <MudPaper Outlined="true" Class="pa-4 mb-4">
        <MudText Typo="Typo.subtitle1" HtmlTag="h3" Class="gb-bold mb-3">@(editingId == null ? "New schedule" : "Edit schedule")</MudText>
        @if (Error != null) { <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3">@Error</MudAlert> }
        <MudGrid Spacing="3">
            <MudItem xs="12" md="5">
                <MudTextField T="string" Label="Description" @bind-Value="description" Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="200" Placeholder="Nightly build" />
            </MudItem>
            <MudItem xs="12" md="3">
                <MudTextField T="string" Label="Cron (UTC)" @bind-Value="cron" Variant="Variant.Outlined" Margin="Margin.Dense" Class="gb-mono-input"
                              Immediate="true" HelperText="@CronHelp" Error="@(cronError != null)" />
            </MudItem>
            <MudItem xs="12" md="4">
                <MudSelect T="string" Label="Branch" @bind-Value="branch" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" OuterClass="gb-ref-select gb-mono-input">
                    @foreach (var b in branches) { <MudSelectItem T="string" Value="@b"><span class="mono">@b</span></MudSelectItem> }
                </MudSelect>
            </MudItem>
            <MudItem xs="12">
                <MudText Typo="Typo.body2" Class="gb-bold mb-1">Variables</MudText>
                @for (var i = 0; i < vars.Count; i++)
                {
                    var row = vars[i];
                    <div class="d-flex gap-2 align-center mb-2">
                        <MudTextField T="string" @bind-Value="row.Name" Placeholder="NAME" Variant="Variant.Outlined" Margin="Margin.Dense" Class="gb-mono-input" aria-label="Variable name" />
                        <MudTextField T="string" @bind-Value="row.Value" Placeholder="value" Variant="Variant.Outlined" Margin="Margin.Dense" Class="gb-mono-input" aria-label="Variable value" />
                        <MudIconButton Icon="@Icons.Material.Outlined.Close" Size="Size.Small" aria-label="Remove variable" OnClick="() => vars.Remove(row)" />
                    </div>
                }
                <MudButton Size="Size.Small" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Add" OnClick="() => vars.Add(new VarRow())">Add variable</MudButton>
            </MudItem>
            <MudItem xs="12">
                <MudCheckBox T="bool" @bind-Value="active" Color="Color.Primary" Dense="true">Active</MudCheckBox>
            </MudItem>
        </MudGrid>
        <div class="d-flex gap-2 mt-3">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" Disabled="busy" OnClick="Save">@(editingId == null ? "Create schedule" : "Save schedule")</MudButton>
            @if (editingId != null) { <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="Reset">Cancel</MudButton> }
        </div>
    </MudPaper>

    <div class="gb-rows">
        @if (list.Count == 0) { <div class="empty">No schedules yet.</div> }
        @foreach (var s in list)
        {
            <div class="gb-row" @key="s.Id">
                <MudIcon Icon="@Icons.Material.Outlined.Schedule" Size="Size.Small" Class="@(s.Active ? "" : "mud-text-secondary")" />
                <div class="gb-row-main gb-min0">
                    <div class="gb-row-title">
                        @s.Description
                        @if (!s.Active) { <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Class="ma-0 ml-2">Inactive</MudChip> }
                    </div>
                    <div class="gb-row-meta">
                        <span class="mono">@s.Cron</span> · <a class="branch-pill" href="@RepoUrls.Source(Repo, s.Branch)">@s.Branch</a>
                        · owner @(s.Owner?.DisplayName ?? "none")
                        @if (s.NextRunAt is { } next) { <span> · next @next.ToLocalTime().ToString("g")</span> }
                        @if (s.LastRunAt is { } last) { <span> · last @Display.Ago(last)</span> }
                        @if (s.LastPipelineId is { } lp) { <span> (<a href="@PipelineUrls.Detail(Repo, lp)">#@lp</a>)</span> }
                        @{ var names = CiJobExtras.ParseVariables(s.VariablesJson).Keys.ToList(); }
                        @if (names.Count > 0) { <span> · variables <span class="mono">@string.Join(", ", names)</span></span> }
                    </div>
                    @if (s.LastError != null) { <div class="small mud-error-text">@s.LastError</div> }
                </div>
                <div class="gb-row-right d-flex gap-1">
                    @if (Pipelines.Enabled)
                    {
                        <MudTooltip Text="Run now (as you)">
                            <MudIconButton Icon="@Icons.Material.Filled.PlayArrow" Size="Size.Small" Color="Color.Primary" Disabled="busy" aria-label="@($"Run {s.Description} now")" OnClick="() => RunNow(s)" />
                        </MudTooltip>
                    }
                    <MudTooltip Text="Edit (you become the owner)">
                        <MudIconButton Icon="@Icons.Material.Outlined.Edit" Size="Size.Small" aria-label="@($"Edit {s.Description}")" OnClick="() => Edit(s)" />
                    </MudTooltip>
                    <MudTooltip Text="Delete">
                        <MudIconButton Icon="@Icons.Material.Outlined.Delete" Size="Size.Small" Color="Color.Error" aria-label="@($"Delete {s.Description}")" OnClick="() => Delete(s)" />
                    </MudTooltip>
                </div>
            </div>
        }
    </div>
}

@code {
    private sealed class VarRow { public string? Name { get; set; } public string? Value { get; set; } }

    private ProjectPermissions perms = ProjectPermissions.None;
    private List<PipelineSchedule> list = [];
    private List<string> branches = [];
    private int? editingId;
    private string? description, cron = "0 3 * * *", branch;
    private List<VarRow> vars = [];
    private bool active = true, busy;
    private string? cronError;

    private string CronHelp
    {
        get
        {
            var c = CiCron.TryParse(cron, out cronError);
            return c?.Next(DateTime.UtcNow) is { } n ? $"Next: {n:yyyy-MM-dd HH:mm} UTC" : cronError ?? "";
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!await LoadRepoAsync()) return;
        perms = await Access.GetPermissionsAsync(Repo!.ProjectId);
        if (!perms.Can(Permission.ManageRepositories)) return;
        branches = (await Git(path => GitOps.ListBranches(path, Repo!.DefaultBranch))).Select(b => b.Name).ToList();
        branch ??= branches.Contains(Repo.DefaultBranch) ? Repo.DefaultBranch : branches.FirstOrDefault();
        await LoadAsync();
    }

    private async Task LoadAsync() => list = await Schedules.ListAsync(Repo!);

    private void Edit(PipelineSchedule s)
    {
        editingId = s.Id;
        description = s.Description;
        cron = s.Cron;
        branch = s.Branch;
        active = s.Active;
        vars = CiJobExtras.ParseVariables(s.VariablesJson).Select(kv => new VarRow { Name = kv.Key, Value = kv.Value }).ToList();
        Error = null;
    }

    private void Reset()
    {
        editingId = null;
        description = null;
        cron = "0 3 * * *";
        branch = branches.Contains(Repo!.DefaultBranch) ? Repo.DefaultBranch : branches.FirstOrDefault();
        active = true;
        vars = [];
        Error = null;
    }

    private async Task Save()
    {
        Error = null;
        busy = true;
        try
        {
            var dict = new Dictionary<string, string>();
            foreach (var v in vars.Where(v => !string.IsNullOrWhiteSpace(v.Name) || !string.IsNullOrEmpty(v.Value)))
            {
                var name = (v.Name ?? "").Trim();
                if (!dict.TryAdd(name, v.Value ?? "")) throw new InvalidOperationException($"Variable '{name}' appears twice.");
            }
            var saved = await Schedules.SaveAsync(Repo!, editingId, description ?? "", cron ?? "", branch ?? "", dict, active);
            Snackbar.Add(editingId == null ? $"Created the schedule '{saved.Description}'." : $"Saved the schedule '{saved.Description}'.", Severity.Success);
            Reset();
            await LoadAsync();
        }
        catch (InvalidOperationException ex) { Error = ex.Message; }
        finally { busy = false; }
    }

    private async Task Delete(PipelineSchedule s)
    {
        if (!await Dialogs.ConfirmAsync("Delete schedule", $"Delete the schedule '{s.Description}'? Its pipelines are kept.")) return;
        try
        {
            await Schedules.DeleteAsync(Repo!, s.Id);
            if (editingId == s.Id) Reset();
            Snackbar.Add($"Deleted the schedule '{s.Description}'.", Severity.Success);
            await LoadAsync();
        }
        catch (InvalidOperationException ex) { Error = ex.Message; }
    }

    private async Task RunNow(PipelineSchedule s)
    {
        Error = null;
        busy = true;
        try
        {
            var id = await Schedules.RunNowAsync(Repo!, s.Id);
            Nav.NavigateTo(PipelineUrls.Detail(Repo!, id));
        }
        catch (InvalidOperationException ex) { Error = ex.Message; }
        finally { busy = false; }
    }
}
