@page "/admin/audit"
@inject CurrentUser Me

<PageTitle>Audit log · ByteBench</PageTitle>

@if (Me.User?.IsAdmin != true)
{
    <Forbidden Message="Only site administrators can view the audit log." />
}
else
{
    <div class="page-header">
        <div>
            <MudText Typo="Typo.h5" HtmlTag="h1">Audit log</MudText>
            <MudText Class="mud-text-secondary" Typo="Typo.body2">Sign-ins, access tokens, membership, settings, repositories, branch protection, webhooks and workflows across ByteBench.</MudText>
        </div>
    </div>
    <AuditViewer />
}

@code {
    protected override Task OnInitializedAsync() => Me.EnsureLoadedAsync();
}
