@page "/admin/users"
@inject CurrentUser Me
@inject AdminUserService Admin
@inject IDialogService Dialogs
@inject ISnackbar Snackbar

<PageTitle>Users · ByteBench</PageTitle>

@if (Me.User?.IsAdmin != true)
{
    <Forbidden Message="Only site administrators can manage users." />
}
else
{
    <div class="user-admin">
    <div class="page-header">
        <div>
            <MudText Typo="Typo.h5" HtmlTag="h1">Users</MudText>
            <MudText Class="mud-text-secondary" Typo="Typo.body2">Every account on this ByteBench server. Actions are recorded in the <MudLink Href="/admin/audit" Typo="Typo.body2">audit log</MudLink> as <code>admin.user_*</code>.</MudText>
        </div>
        <div>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" OnClick="NewUser">Create user</MudButton>
        </div>
    </div>

    <RegistrationPanel />

    <form class="ua-filters" @onsubmit="Search" @onsubmit:preventDefault>
        <MudTextField T="string" @bind-Value="search" Placeholder="Search username, name or email" Variant="Variant.Outlined" Margin="Margin.Dense"
                      Immediate="true" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Class="ua-search" aria-label="Search users" />
        <div class="ua-filter-buttons">
            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small">Search</MudButton>
            @if (!string.IsNullOrEmpty(applied))
            {
                <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="Clear">Clear</MudButton>
            }
        </div>
    </form>

    @if (error != null) { <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3">@error</MudAlert> }

    @if (result != null)
    {
        <MudText Typo="Typo.caption" HtmlTag="div" Class="mud-text-secondary mb-2">
            @if (result.Total == 0) { <span>No users match.</span> }
            else { <span>Showing @(Skip + 1)–@(Skip + result.Users.Count) of @result.Total users.</span> }
        </MudText>
        @if (result.Users.Count > 0)
        {
            var now = DateTimeOffset.UtcNow;
            <MudPaper Outlined="true" Class="ua-table-wrap">
                <MudSimpleTable Dense="true" Hover="true" Elevation="0" Class="ua-table">
                    <thead>
                        <tr><th>User</th><th>Email</th><th>Role</th><th>Status</th><th>2FA</th><th>Last sign-in</th><th class="ua-right">Projects</th><th class="ua-right">Actions</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var u in result.Users)
                        {
                            <tr @key="u.Id">
                                <td>
                                    <div class="ua-user">
                                        <MudAvatar Style="@($"background:{u.Color};color:{Display.TextOn(u.Color)};width:28px;height:28px;font-size:11px;font-weight:600;flex-shrink:0")">@Initials(u.DisplayName)</MudAvatar>
                                        <div>
                                            <div class="ua-nowrap">@u.DisplayName @if (u.Id == Me.User.Id) { <span class="ua-muted ua-small ml-1">(you)</span> }</div>
                                            <div class="ua-muted ua-small mono">@@@u.UserName</div>
                                        </div>
                                    </div>
                                </td>
                                <td class="ua-small">@u.Email</td>
                                <td>
                                    @if (u.IsBot) { <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Class="ma-0">Bot</MudChip> }
                                    else if (u.IsAdmin) { <MudChip T="string" Size="Size.Small" Color="Color.Primary" Class="ma-0">Admin</MudChip> }
                                    else { <span class="ua-muted ua-small">User</span> }
                                </td>
                                <td class="ua-small">
                                    @if (u.IsDeactivated)
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Error" Class="ma-0" title="@($"Deactivated {u.DeactivatedAt!.Value:yyyy-MM-dd}")">Deactivated</MudChip>
                                    }
                                    else if (u.IsLockedOut(now))
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Warning" Class="ma-0" title="@LockText(u)">Locked</MudChip>
                                        <div class="ua-muted ua-small">@LockText(u)</div>
                                    }
                                    else { <span class="ua-muted">Active</span> }
                                    @if (!u.EmailConfirmed)
                                    {
                                        <div><MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Class="ma-0" title="The email address was never confirmed">Email unconfirmed</MudChip></div>
                                    }
                                    @if (u.MustChangePassword)
                                    {
                                        <div class="ua-muted ua-small">Must change password</div>
                                    }
                                </td>
                                <td class="ua-small">@(u.TwoFactorEnabled ? "On" : "Off")</td>
                                <td class="ua-small ua-nowrap" title="@(u.LastSignIn?.ToString("yyyy-MM-dd HH:mm") + " UTC")">@(u.LastSignIn is { } ls ? Display.Ago(ls) : "Never")</td>
                                <td class="ua-right">@u.ProjectCount</td>
                                <td class="ua-right">
                                    @if (!u.IsBot)
                                    {
                                        <div class="ua-actions">
                                            @if (u.IsAdmin)
                                            {
                                                <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="() => Ask(u, ActionKind.RevokeAdmin)">Revoke admin</MudButton>
                                            }
                                            else
                                            {
                                                <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="() => Ask(u, ActionKind.GrantAdmin)">Make admin</MudButton>
                                            }
                                            @if (u.IsLockedOut(now) || u.IsDeactivated)
                                            {
                                                <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="() => Ask(u, ActionKind.Unlock)">@(u.IsDeactivated ? "Reactivate" : "Unlock")</MudButton>
                                            }
                                            else if (u.Id != Me.User.Id)
                                            {
                                                <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="() => Ask(u, ActionKind.Lock)">Lock</MudButton>
                                            }
                                            <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="() => Ask(u, ActionKind.SignOut)">Sign out</MudButton>
                                            @if (u.HasPassword)
                                            {
                                                <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="() => Ask(u, ActionKind.SendReset)">Send password reset email</MudButton>
                                                @if (u.Id != Me.User.Id)
                                                {
                                                    <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="() => Ask(u, ActionKind.TempPassword)">Set temporary password</MudButton>
                                                }
                                            }
                                            @if (!u.EmailConfirmed)
                                            {
                                                <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="() => Ask(u, ActionKind.ConfirmEmail)">Mark email confirmed</MudButton>
                                            }
                                            @if (u.TwoFactorEnabled)
                                            {
                                                <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="() => Ask(u, ActionKind.ResetTwoFactor)">Reset 2FA</MudButton>
                                            }
                                            @if (!u.IsDeactivated && u.Id != Me.User.Id)
                                            {
                                                <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Error" OnClick="() => Ask(u, ActionKind.Deactivate)">Deactivate</MudButton>
                                            }
                                        </div>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            </MudPaper>
            <div class="ua-pager">
                <MudPagination Count="PageCount" Selected="pageNumber" SelectedChanged="Go" Size="Size.Small" Variant="Variant.Outlined"
                               ShowFirstButton="true" ShowLastButton="true" MiddleCount="3" BoundaryCount="1" />
                <MudText Class="mud-text-secondary" Typo="Typo.caption">Page @pageNumber of @PageCount</MudText>
            </div>
        }
    }
    </div>
}

@code {
    private const int PageSize = 25;
    private AdminUserPage? result;
    private string? search, applied, error;
    private int pageNumber = 1;
    private int lockHours = 24;

    private int Skip => (pageNumber - 1) * PageSize;
    private int PageCount => Math.Max(1, ((result?.Total ?? 0) + PageSize - 1) / PageSize);

    private enum ActionKind { GrantAdmin, RevokeAdmin, Lock, Unlock, SignOut, ResetTwoFactor, Deactivate, SendReset, TempPassword, ConfirmEmail }

    private sealed record Pending(AdminUserRow User, ActionKind Kind, string Title, string Body, string ConfirmLabel, bool Danger);

    protected override async Task OnInitializedAsync()
    {
        await Me.EnsureLoadedAsync();
        if (Me.User?.IsAdmin == true) await Load();
    }

    private async Task Load()
    {
        try { result = await Admin.SearchAsync(applied, pageNumber, PageSize); }
        catch (ForbiddenException ex) { error = ex.Message; }
    }

    private async Task Search() { applied = search?.Trim(); pageNumber = 1; await Load(); }
    private async Task Clear() { search = applied = null; pageNumber = 1; await Load(); }
    private async Task Go(int page) { pageNumber = Math.Max(1, page); await Load(); }

    private async Task Ask(AdminUserRow u, ActionKind kind)
    {
        error = null;
        var who = $"{u.DisplayName} (@{u.UserName})";
        Pending p = kind switch
        {
            ActionKind.GrantAdmin => new(u, kind, "Make site admin?", $"{who} will have Owner rights in every project, including private ones, and can manage users.", "Make admin", false),
            ActionKind.RevokeAdmin => new(u, kind, "Revoke site admin?", $"{who} will keep only their own project memberships." + (u.Id == Me.User!.Id ? " You will lose access to this page." : ""), "Revoke admin", true),
            ActionKind.Lock => new(u, kind, "Lock account?", $"{who} will be signed out and can't sign in, use git or the API until the lock ends or an admin unlocks the account.", "Lock account", true),
            ActionKind.Unlock => new(u, kind, u.IsDeactivated ? "Reactivate account?" : "Unlock account?", $"{who} will be able to sign in again." + (u.IsDeactivated ? " Their revoked access tokens stay revoked." : ""), u.IsDeactivated ? "Reactivate" : "Unlock", false),
            ActionKind.SignOut => new(u, kind, "Sign out everywhere?", $"Every browser session of {who} ends within a minute. Personal access tokens keep working.", "Sign out", false),
            ActionKind.ResetTwoFactor => new(u, kind, "Reset two-factor sign-in?", $"Two-factor sign-in is turned off for {who}, and their authenticator key and recovery codes stop working. They can set it up again from their profile.", "Reset 2FA", true),
            ActionKind.SendReset => new(u, kind, "Send password reset email?", $"{who} gets an email at {u.Email} with a single-use link to choose a new password. Nothing changes until they use it.", "Send email", false),
            ActionKind.TempPassword => new(u, kind, "Set a temporary password?", $"{who}'s current password stops working, every session ends, and a generated password is shown once. They must choose their own at the next sign-in.", "Set temporary password", true),
            ActionKind.ConfirmEmail => new(u, kind, "Mark email as confirmed?", $"{who}'s address {u.Email} is treated as confirmed without them opening a link. Only do this if you know it is theirs.", "Mark confirmed", false),
            _ => new(u, kind, "Deactivate account?", $"{who} is locked indefinitely, signed out everywhere, and every personal access token they own is revoked. An admin can reactivate the account later, but the tokens stay revoked.", "Deactivate", true),
        };

        var dialog = await Dialogs.ShowAsync<UserActionDialog>(p.Title, new DialogParameters<UserActionDialog>
        {
            { d => d.Title, p.Title },
            { d => d.Body, p.Body },
            { d => d.ConfirmLabel, p.ConfirmLabel },
            { d => d.Danger, p.Danger },
            { d => d.AskLockDuration, kind == ActionKind.Lock },
            { d => d.LockHours, lockHours },
        }, new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true, CloseOnEscapeKey = true });
        var answer = await dialog.Result;
        if (answer is not { Canceled: false, Data: int hours }) return;
        if (kind == ActionKind.Lock) lockHours = hours;
        await Confirm(p);
    }

    private async Task Confirm(Pending p)
    {
        error = null;
        string? message = null;
        var who = "@" + p.User.UserName;
        try
        {
            switch (p.Kind)
            {
                case ActionKind.GrantAdmin: await Admin.SetAdminAsync(p.User.Id, true); message = $"{who} is now a site admin."; break;
                case ActionKind.RevokeAdmin: await Admin.SetAdminAsync(p.User.Id, false); message = $"{who} is no longer a site admin."; break;
                case ActionKind.Lock:
                    await Admin.LockAsync(p.User.Id, lockHours > 0 ? DateTimeOffset.UtcNow.AddHours(lockHours) : null);
                    message = $"{who} is locked{(lockHours > 0 ? "" : " until unlocked")}."; break;
                case ActionKind.Unlock: await Admin.UnlockAsync(p.User.Id); message = $"{who} can sign in again."; break;
                case ActionKind.SignOut: await Admin.ForceSignOutAsync(p.User.Id); message = $"{who} will be signed out of every browser session."; break;
                case ActionKind.ResetTwoFactor: await Admin.ResetTwoFactorAsync(p.User.Id); message = $"Two-factor sign-in was reset for {who}."; break;
                case ActionKind.SendReset: await Admin.SendPasswordResetAsync(p.User.Id); message = $"A password reset email is on its way to {who}."; break;
                case ActionKind.TempPassword:
                    var temp = await Admin.SetTemporaryPasswordAsync(p.User.Id);
                    await ShowPasswordAsync("Temporary password", temp, $"Give this to {who} over a secure channel. It is shown only once and can't be recovered.");
                    message = $"A temporary password was set for {who}."; break;
                case ActionKind.ConfirmEmail: await Admin.MarkEmailConfirmedAsync(p.User.Id); message = $"{who}'s email address is marked as confirmed."; break;
                case ActionKind.Deactivate: await Admin.DeactivateAsync(p.User.Id); message = $"{who} was deactivated and their access tokens revoked."; break;
            }
        }
        catch (InvalidOperationException ex) { error = ex.Message; } // ForbiddenException included
        if (message != null && error == null) Snackbar.Add(message, Severity.Success);
        if (p.Kind == ActionKind.RevokeAdmin && p.User.Id == Me.User!.Id && error == null)
        {
            result = null; // no longer allowed to see the list
            Me.User.IsAdmin = false;
            return;
        }
        await Load();
    }

    private async Task NewUser()
    {
        error = null;
        var dialog = await Dialogs.ShowAsync<NewUserDialog>("Create user", new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true });
        var answer = await dialog.Result;
        if (answer is { Canceled: false, Data: ByteBench.Services.TemporaryPassword temp })
        {
            await ShowPasswordAsync("User created", temp, "Give these credentials to the new user over a secure channel. The password is shown only once; they must change it at first sign-in.");
            await Load();
        }
    }

    private async Task ShowPasswordAsync(string title, ByteBench.Services.TemporaryPassword temp, string note)
    {
        var dialog = await Dialogs.ShowAsync<TemporaryPasswordDialog>(title, new DialogParameters<TemporaryPasswordDialog>
        {
            { d => d.UserName, temp.UserName }, { d => d.Password, temp.Password }, { d => d.Note, note },
        }, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true });
        await dialog.Result;
    }

    private static string LockText(AdminUserRow u) =>
        u.LockoutEnd is { } end && end.Year >= 9999 ? "until unlocked" : $"until {u.LockoutEnd!.Value.UtcDateTime:yyyy-MM-dd HH:mm} UTC";

    private static string Initials(string name) =>
        string.Concat(name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => char.ToUpperInvariant(p[0])));
}
