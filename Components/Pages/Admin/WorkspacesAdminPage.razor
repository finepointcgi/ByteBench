@page "/admin/workspaces"
@using ByteBench.Services.Workspaces
@using Microsoft.Extensions.Options
@implements IDisposable
@inject CurrentUser Me
@inject WorkspaceService Workspaces
@inject WorkspaceEditorService EditorAccess
@inject WorkspaceImage Image
@inject WorkspaceRuntime Runtime
@inject IWorkspaceBackend Backend
@inject WorkspaceUrls Urls
@inject IOptionsMonitor<WorkspaceOptions> Options
@inject Microsoft.Extensions.Configuration.IConfiguration Config
@inject ISnackbar Snackbar
@inject IDialogService Dialogs

<PageTitle>Workspaces · ByteBench</PageTitle>

@if (Me.User?.IsAdmin != true)
{
    <Forbidden Message="Only site administrators can manage workspaces." />
}
else
{
    var o = Options.CurrentValue;
    <div class="page-header mb-4">
        <MudText Typo="Typo.h5" HtmlTag="h1">Workspaces</MudText>
        <MudText Class="mud-text-secondary" Typo="Typo.body2">Per-user Docker development environments (VS Code in the browser). Limits and the image are set in <code>Workspaces:*</code> and need a restart.</MudText>
    </div>

    <MudPaper Outlined="true" Class="pa-5 mb-4" Style="max-width: 820px">
        <MudText Typo="Typo.subtitle1" HtmlTag="h2" Class="mb-2">Health</MudText>
        <MudSimpleTable Dense="true" Elevation="0" data-testid="ws-health">
            <tbody>
                <tr><td>Docker reachable</td><td data-testid="ws-health-docker">@(docker == null ? "Checking…" : docker == true ? "Yes" : "No: install Docker and make it reachable for ByteBench (docker CLI on the PATH, and the daemon socket or DOCKER_HOST)")</td></tr>
                <tr><td>Workspace image</td><td data-testid="ws-health-image"><span class="mono">@Image.Image</span>: @ImageText()</td></tr>
                <tr><td>Reaper</td><td data-testid="ws-health-reaper">@(Runtime.ReaperLastRun is { } r ? $"running, last pass {r.ToLocalTime():T}" : "not started yet")</td></tr>
                <tr><td>Instances</td><td data-testid="ws-health-instances">@InstancesText()</td></tr>
                <tr><td>Origins</td><td>@OriginText()</td></tr>
                <tr><td>Limits</td><td>@o.MaxPerUser per user, @o.MaxTotal in total · @o.Memory memory, @o.Cpus CPUs, @o.PidsLimit processes, @(o.DiskLimit ?? "no") disk · idle @o.IdleTimeoutMinutes min, lifetime @o.MaxLifetimeHours h · network: @o.EgressMode</td></tr>
            </tbody>
        </MudSimpleTable>
        @if (Image.LogTail.Count > 0 && Image.State is WorkspaceImageState.Building or WorkspaceImageState.Failed)
        {
            <pre class="mono mt-2" style="max-height:200px;overflow:auto;font-size:12px">@string.Join("\n", Image.LogTail)</pre>
        }
        <div class="mt-2">
            <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="Recheck" Disabled="@(Image.State == WorkspaceImageState.Building)">Check again / build image</MudButton>
        </div>
    </MudPaper>

    <MudPaper Outlined="true" Class="pa-5 mb-4" Style="max-width: 820px">
        <MudSwitch T="bool" Value="enabled" ValueChanged="SetEnabled" Color="Color.Primary" Label="Workspaces are on" data-testid="ws-switch" />
        <MudText Typo="Typo.body2" Class="mud-text-secondary">On by default once Docker is reachable; each project can also switch them off. Turning this off stops new workspaces; running ones keep going until you stop them.</MudText>
        <MudSwitch T="bool" Value="aiEnabled" ValueChanged="SetAi" Color="Color.Primary" Label="AI assistant in workspaces" data-testid="ws-ai-switch" />
        <MudText Typo="Typo.body2" Class="mud-text-secondary">Needs the Anthropic API (see AI). Per-user rate limit: @o.Ai.RequestsPerMinute requests per minute.</MudText>
        <MudSwitch T="bool" Value="editorEnabled" ValueChanged="SetEditor" Color="Color.Primary" Label="Local editors (VS Code Remote-SSH, JetBrains Gateway)" data-testid="ws-editor-switch" />
        <MudText Typo="Typo.body2" Class="mud-text-secondary">Off by default. When on, an owner can start an SSH server inside their own running workspace (key login only, loopback only) and reach it through a WebSocket tunnel on ByteBench's own address with a personal access token. No port is opened on the server. Only the owner can use it.</MudText>
    </MudPaper>

    <div class="d-flex align-center mb-2">
        <MudText Typo="Typo.subtitle1" HtmlTag="h2">Workspaces</MudText>
        <span class="flex-grow-1"></span>
        <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error" OnClick="StopAll" Disabled="@(items?.Any(w => w.Workspace.IsLive) != true)">Stop all</MudButton>
    </div>
    @if (items == null) { <MudProgressCircular Indeterminate="true" Size="Size.Small" /> }
    else if (items.Count == 0) { <div class="empty">No workspaces yet.</div> }
    else
    {
        <MudSimpleTable Dense="true" Hover="true" Outlined="true" data-testid="ws-admin-table">
            <thead><tr><th>Owner</th><th>Repository</th><th>Ref</th><th>State</th><th>Started</th><th>Last activity</th><th></th></tr></thead>
            <tbody>
            @foreach (var w in items)
            {
                <tr>
                    <td>@w.OwnerName</td><td>@w.RepositoryPath</td><td class="mono">@w.Workspace.Ref</td>
                    <td>@w.Workspace.State@(w.Workspace.StopReason != null ? " (" + w.Workspace.StopReason + ")" : "")@(w.Workspace.Error != null ? ": " + w.Workspace.Error : "")</td>
                    <td>@w.Workspace.CreatedAt.ToLocalTime().ToString("g")</td>
                    <td>@w.Workspace.LastActivityAt.ToLocalTime().ToString("g")</td>
                    <td>@if (w.Workspace.IsLive) { <MudButton Size="Size.Small" Color="Color.Error" Variant="Variant.Outlined" OnClick="() => Stop(w)">Stop</MudButton> }</td>
                </tr>
            }
            </tbody>
        </MudSimpleTable>
    }
}

@code {
    private bool? docker;
    private bool enabled, aiEnabled, editorEnabled;
    private List<WorkspaceInfo>? items;
    private PeriodicTimer? timer;

    private string ImageText() => Image.State switch
    {
        WorkspaceImageState.Ready => "present",
        WorkspaceImageState.Building => "building (first use; " + Image.Summary + ")",
        WorkspaceImageState.Failed => "build failed: " + Image.Error,
        WorkspaceImageState.NoDocker => "unknown (no Docker)",
        _ => "not checked yet",
    };

    // Running workspaces, IDE tickets (60 s, single use) and IDE sessions live in this process's memory, not the database.
    private string InstancesText() => Config.GetValue("Deployment:Instances", 1) > 1
        ? $"Warning: Deployment:Instances is {Config.GetValue("Deployment:Instances", 1)}. Workspace tickets, sessions and running environments are held in memory, so a ticket redeemed on another instance fails. Run one instance."
        : "One instance only: IDE tickets, sessions and running environments are kept in memory (a restart drops them, and the reaper removes the containers).";

    private string OriginText() => Urls.Mode switch
    {
        WorkspaceOriginMode.Subdomain => $"Separate origins under *.{Urls.BaseDomain}",
        WorkspaceOriginMode.SharedPath => "Shared origin (Workspaces:AllowSharedOrigin): the IDE runs on ByteBench's own origin. Set Workspaces:BaseDomain for isolation.",
        _ => "Not configured: set Workspaces:BaseDomain (a wildcard domain pointing at ByteBench) before workspaces can be opened.",
    };

    protected override async Task OnInitializedAsync()
    {
        await Me.EnsureLoadedAsync();
        if (Me.User?.IsAdmin != true) return;
        await Load();
        _ = Image.EnsureAsync();
        timer = new PeriodicTimer(TimeSpan.FromSeconds(3));
        _ = LoopAsync();
    }

    private async Task Load()
    {
        docker = await Backend.IsAvailableAsync();
        enabled = await Workspaces.IsEnabledAsync();
        aiEnabled = await Workspaces.IsAiEnabledSiteAsync();
        editorEnabled = await EditorAccess.IsEnabledAsync();
        items = await Workspaces.ListAllAsync(Me.Id);
    }

    private async Task LoopAsync()
    {
        try
        {
            while (await timer!.WaitForNextTickAsync()) { await Load(); await InvokeAsync(StateHasChanged); }
        }
        catch (ObjectDisposedException) { }
    }

    private async Task Recheck() { await Image.EnsureAsync(); await Load(); }

    private async Task SetEnabled(bool on) { await Workspaces.SetEnabledAsync(on, Me.Id); enabled = on; Snackbar.Add(on ? "Workspaces are on." : "Workspaces are off.", Severity.Success); }
    private async Task SetAi(bool on) { await Workspaces.SetAiEnabledSiteAsync(on, Me.Id); aiEnabled = on; Snackbar.Add(on ? "The workspace assistant is on." : "The workspace assistant is off.", Severity.Success); }

    private async Task SetEditor(bool on) { await EditorAccess.SetEnabledAsync(on, Me.Id); editorEnabled = on; Snackbar.Add(on ? "Local editors can connect to workspaces." : "Local editor connections are off.", Severity.Success); }

    private async Task Stop(WorkspaceInfo w)
    {
        await Workspaces.AdminStopAsync(w.Workspace.PublicId, Me.Id);
        Snackbar.Add("Workspace stopped.", Severity.Success);
        await Load();
    }

    private async Task StopAll()
    {
        if (await Dialogs.ShowMessageBoxAsync("Stop all workspaces?", "Every running workspace and its files are deleted.", yesText: "Stop all", cancelText: "Cancel") != true) return;
        await Workspaces.AdminStopAllAsync(Me.Id);
        await Load();
    }

    public void Dispose() => timer?.Dispose();
}
