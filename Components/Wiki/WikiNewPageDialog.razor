@* Asks for a new page's name (folders with /). Returns DialogResult.Ok(normalized page path). *@
@using ByteBench.Services.Wiki

<MudDialog>
    <DialogContent>
        <MudTextField T="string" @bind-Value="name" Immediate="true" Variant="Variant.Outlined" Margin="Margin.Dense" AutoFocus="true"
                      Label="Page name" Placeholder="Getting started" autocomplete="off" OnKeyDown="KeyDown"
                      Error="@(name is { Length: > 0 } && Normalized == null)" ErrorText="Use letters, digits, spaces, - _ . ( ) and / for folders."
                      HelperText="@(Normalized is { } n ? $"Saved as {n}.md" : "Use / for folders, e.g. guides/Setup")" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => MudDialog.Cancel()">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(Normalized == null)" OnClick="Create">Create page</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    /// <summary>The folder of the page the user was on; the name is created there unless it starts with /.</summary>
    [Parameter] public string Folder { get; set; } = "";

    private string? name;

    private string? Normalized => string.IsNullOrWhiteSpace(name) ? null
        : WikiPaths.Normalize(name.TrimStart().StartsWith('/') || Folder.Length == 0 ? name : Folder + "/" + name);

    private void Create()
    {
        if (Normalized is { } n) MudDialog.Close(DialogResult.Ok(n));
    }

    private void KeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") Create();
    }
}
