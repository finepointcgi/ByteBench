@using GitBench.Services.ChatIntegrations
@* Group settings: Slack / Teams integrations that every project in the group (and its subgroups) inherits. Owners only. *@

<div class="group-integrations">
    <MudText Typo="Typo.h6" HtmlTag="h2">Slack &amp; Microsoft Teams</MudText>
    <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3" Style="max-width: 760px;">
        Announce the events of <b>every project in @Group.Name</b> and its subgroups in one channel. Projects can opt out on their own
        integrations page. Messages use the same queue, retries and delivery log as project integrations; webhook URLs and tokens
        are stored encrypted and never shown again.
    </MudText>
    @if (!Perms.Can(GroupPermission.ManageGroupSettings))
    {
        <Forbidden Message="Only Owners can manage this group's chat integrations." BackHref="@($"/g/{Group.FullPath}")" />
    }
    else
    {
        <ChatIntegrationsManager Scope="@ChatScope.Group(Group.Id)" />
    }
</div>

@code {
    [Parameter, EditorRequired] public Group Group { get; set; } = null!;
    [Parameter] public GroupPermissions Perms { get; set; } = GroupPermissions.None;
}
