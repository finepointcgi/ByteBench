@using ByteBench.Services.Query

@* Pick the columns, then download /…/export.csv with the list's current query (basic filters or gql=). *@
<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6" Class="d-flex align-center gap-2"><MudIcon Icon="@Icons.Material.Outlined.FileDownload" /> Export CSV</MudText>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mud-text-secondary mb-2">
            Exports every issue that matches the current @(IsGql ? "query" : "filters") (up to @IssueCsvExporter.MaxRows.ToString("N0")), as UTF-8 CSV.
        </MudText>
        <div class="csv-cols">
            @foreach (var c in IssueCsvExporter.Columns)
            {
                <MudCheckBox T="bool" Value="@picked.Contains(c.Id)" ValueChanged="on => Toggle(c.Id, on)" Label="@c.Header" Dense="true" Size="Size.Small" />
            }
        </div>
        <div class="d-flex gap-2 mt-1">
            <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="All">All</MudButton>
            <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="Defaults">Defaults</MudButton>
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => MudDialog.Cancel()">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="@Href" Disabled="@(picked.Count == 0)" StartIcon="@Icons.Material.Filled.Download"
                   download="issues.csv" OnClick="Downloaded">Download</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    /// <summary>The export URL without a query, e.g. /p/WEB/issues/export.csv.</summary>
    [Parameter, EditorRequired] public string Path { get; set; } = "";
    /// <summary>The list's query string (without '?').</summary>
    [Parameter] public string Query { get; set; } = "";

    private readonly HashSet<string> picked = [.. IssueCsvExporter.DefaultColumns];

    private bool IsGql => Query.StartsWith("gql=") || Query.Contains("&gql=");

    private string Href
    {
        get
        {
            var cols = string.Join(",", IssueCsvExporter.Columns.Where(c => picked.Contains(c.Id)).Select(c => c.Id));
            return Path + "?" + (Query.Length > 0 ? Query + "&" : "") + "columns=" + Uri.EscapeDataString(cols);
        }
    }

    private void Toggle(string id, bool on)
    {
        if (on) picked.Add(id); else picked.Remove(id);
    }

    private void All() => picked.UnionWith(IssueCsvExporter.Columns.Select(c => c.Id));

    private void Defaults()
    {
        picked.Clear();
        picked.UnionWith(IssueCsvExporter.DefaultColumns);
    }

    private async Task Downloaded()
    {
        await Task.Delay(300); // let the browser start the download before the dialog (and its link) goes away
        MudDialog.Close();
    }
}
