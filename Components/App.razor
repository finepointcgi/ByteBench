<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["_content/MudBlazor/MudBlazor.min.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["css/code-tools.css"]" />
    <link rel="stylesheet" href="@Assets["css/notifications-email.css"]" />
    <link rel="stylesheet" href="@Assets["GitBench.styles.css"]" />
    <ImportMap nonce="@GitBench.Services.Hosting.ProductionSetup.CspNonce(HttpContext)" />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet @rendermode="PageRenderMode" />
</head>

<body>
    <Routes @rendermode="PageRenderMode" />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="@Assets["_content/MudBlazor/MudBlazor.min.js"]"></script>
    <script src="@Assets["js/theme.js"]"></script>
    <script src="@Assets["lib/highlightjs/highlight.min.js"]"></script>
    <script src="@Assets["lib/highlightjs/languages/dockerfile.min.js"]"></script>
    <script src="@Assets["lib/highlightjs/languages/powershell.min.js"]"></script>
    <script src="@Assets["lib/highlightjs/languages/fsharp.min.js"]"></script>
    <script src="@Assets["js/code-tools.js"]"></script>
    <script src="@Assets["js/attachments.js"]"></script>
</body>

</html>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    // Account pages carry [ExcludeFromInteractiveRouting] and run as static SSR,
    // because SignInManager has to write cookies on a real HTTP response.
    private IComponentRenderMode? PageRenderMode =>
        HttpContext.AcceptsInteractiveRouting() ? InteractiveServer : null;
}
