@* Branch/tag picker. Arbitrary SHAs being viewed are shown as an extra option. *@
<MudSelect T="string" Value="@Value" ValueChanged="Changed" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true"
           AdornmentIcon="@Icons.Material.Filled.ArrowDropDown" ToStringFunc="Display" OuterClass="gb-ref-select"
           aria-label="Switch branch or tag" title="Switch branch or tag" AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft">
    @if (!string.IsNullOrEmpty(Value) && !Branches.Any(b => b.Name == Value) && !Tags.Contains(Value))
    {
        <MudSelectItem T="string" Value="@Value">
            <span class="ref-option"><MudIcon Icon="@Icons.Material.Outlined.Commit" Size="Size.Small" /> <span class="mono">@Short(Value)</span> <span class="muted">(commit)</span></span>
        </MudSelectItem>
    }
    @foreach (var b in Branches)
    {
        <MudSelectItem T="string" Value="@b.Name">
            <span class="ref-option"><MudIcon Icon="@Icons.Material.Outlined.AccountTree" Size="Size.Small" /> <span class="mono">@b.Name</span>@if (b.IsDefault) {<span class="muted"> (default)</span>}</span>
        </MudSelectItem>
    }
    @if (Tags.Count > 0)
    {
        @foreach (var t in Tags)
        {
            <MudSelectItem T="string" Value="@t">
                <span class="ref-option"><MudIcon Icon="@Icons.Material.Outlined.LocalOffer" Size="Size.Small" /> <span class="mono">@t</span></span>
            </MudSelectItem>
        }
    }
</MudSelect>

@code {
    [Parameter] public IReadOnlyList<BranchInfo> Branches { get; set; } = [];
    [Parameter] public IReadOnlyList<string> Tags { get; set; } = [];
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string> ValueChanged { get; set; }

    private Task Changed(string? v) => ValueChanged.InvokeAsync(v ?? "");

    private static string Short(string v) => v.Length == 40 ? v[..7] : v;

    private string Display(string? v) => v == null ? "" : Tags.Contains(v) ? $"Tag: {v}" : Branches.Any(b => b.Name == v) ? v : $"{Short(v)} (commit)";
}
