@* Left-hand navigation for /p/{KEY}/repos/{slug}/settings/... pages. Add one link per settings page. *@
<nav aria-label="Repository settings">
    <MudPaper Outlined="true" Class="py-1">
        <MudList T="string" Dense="true">
            <MudListItem T="string" Href="@CodeUrls.Settings(Repo)" Icon="@Icons.Material.Outlined.Tune"
                         Class="@ItemClass("general")" aria-current="@(Active == "general" ? "page" : null)">General</MudListItem>
            <MudListItem T="string" Href="@RepoUrls.BranchProtection(Repo)" Icon="@Icons.Material.Outlined.Lock"
                         Class="@ItemClass("branches")" aria-current="@(Active == "branches" ? "page" : null)">Branch protection</MudListItem>
            <MudListItem T="string" Href="@PrUrls.MergeSettings(Repo)" Icon="@Icons.Material.Outlined.MergeType"
                         Class="@ItemClass("merge")" aria-current="@(Active == "merge" ? "page" : null)">Pull requests</MudListItem>
            <MudListItem T="string" Href="@(RepoUrls.Base(Repo) + "/settings/ci-variables")" Icon="@Icons.Material.Outlined.Key"
                         Class="@ItemClass("ci-variables")" aria-current="@(Active == "ci-variables" ? "page" : null)">CI variables</MudListItem>
            <MudListItem T="string" Href="@RepoUrls.DeployKeys(Repo)" Icon="@Icons.Material.Outlined.VpnKey"
                         Class="@ItemClass("deploy-keys")" aria-current="@(Active == "deploy-keys" ? "page" : null)">Deploy keys</MudListItem>
            <MudListItem T="string" Href="@(RepoUrls.Base(Repo) + "/settings/tags")" Icon="@Icons.Material.Outlined.Sell"
                         Class="@ItemClass("tags")" aria-current="@(Active == "tags" ? "page" : null)">Protected tags</MudListItem>
            <MudListItem T="string" Href="@GitBench.Services.Security.SecurityUrls.Settings(Repo)" Icon="@Icons.Material.Outlined.Shield"
                         Class="@ItemClass("security")" aria-current="@(Active == "security" ? "page" : null)">Security</MudListItem>
            <MudListItem T="string" Href="@(RepoUrls.Base(Repo) + "/settings/mirroring")" Icon="@Icons.Material.Outlined.Sync"
                         Class="@ItemClass("mirroring")" aria-current="@(Active == "mirroring" ? "page" : null)">Mirroring</MudListItem>
        </MudList>
    </MudPaper>
</nav>

@code {
    [Parameter, EditorRequired] public Repository Repo { get; set; } = null!;
    /// <summary>The current settings page, "general", "branches", "merge", "ci-variables", "deploy-keys", "tags", "security" or "mirroring".</summary>
    [Parameter] public string Active { get; set; } = "general";

    private string ItemClass(string page) => Active == page ? "settings-nav-item settings-nav-active" : "settings-nav-item";
}
