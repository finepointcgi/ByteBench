@* Unified diff: per-file collapsible sections with old/new line numbers and optional inline comments. *@
@inject CurrentUser Me

@if (Files.Count == 0)
{
    <div class="empty">@EmptyText</div>
}
else
{
    <div class="diff-summary">
        <span>Showing <b>@Files.Count</b> changed file@(Files.Count == 1 ? "" : "s") with
            <span class="diff-add-count">@Files.Sum(f => f.Additions) addition@(Files.Sum(f => f.Additions) == 1 ? "" : "s")</span> and
            <span class="diff-del-count">@Files.Sum(f => f.Deletions) deletion@(Files.Sum(f => f.Deletions) == 1 ? "" : "s")</span></span>
        <span class="diff-summary-actions">
            <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Filled.UnfoldMore" OnClick="() => collapsed.Clear()">Expand all</MudButton>
            <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Filled.UnfoldLess" OnClick="CollapseAll">Collapse all</MudButton>
        </span>
    </div>

    @foreach (var f in Files)
    {
        var isCollapsed = collapsed.Contains(f.Path);
        var fileComments = Comments?.Where(c => c.FilePath == f.Path).ToList() ?? [];
        <div class="diff-file" @key="f.Path">
            <div class="diff-file-head" @onclick="() => Toggle(f.Path)" role="button" aria-expanded="@(!isCollapsed)">
                <MudIcon Icon="@(isCollapsed ? Icons.Material.Filled.ChevronRight : Icons.Material.Filled.ExpandMore)" Size="Size.Small" Class="diff-chevron" />
                <span class="diff-status diff-status-@f.Status.Replace(' ', '-')">@f.Status</span>
                <span class="mono diff-path">@f.DisplayPath</span>
                @if (fileComments.Count > 0)
                {
                    <span class="diff-comment-count" title="Inline comments"><MudIcon Icon="@Icons.Material.Outlined.ChatBubbleOutline" Size="Size.Small" /> @fileComments.Count</span>
                }
                <span class="diff-stat">
                    <span class="diff-add-count">+@f.Additions</span>
                    <span class="diff-del-count">−@f.Deletions</span>
                    <DiffBar Additions="f.Additions" Deletions="f.Deletions" />
                </span>
                @if (Repo != null && ViewRef != null && f.Status != "deleted")
                {
                    <span @onclick:stopPropagation="true">
                        <MudButton Href="@RepoUrls.Source(Repo, ViewRef, f.Path)" Variant="Variant.Outlined" Size="Size.Small" Class="diff-view-file">View file</MudButton>
                    </span>
                }
            </div>
            @if (!isCollapsed)
            {
                @if (f.IsBinary)
                {
                    <div class="diff-note">Binary file not shown.</div>
                }
                else if (f.TooLarge)
                {
                    <div class="diff-note">This diff is too large to display.</div>
                }
                else if (f.Hunks.Count == 0)
                {
                    <div class="diff-note">No content changes@(f.OldPath != null ? " (file renamed)" : "").</div>
                }
                else
                {
                    <table class="diff-table" data-hl-diff data-hl-lang="@HighlightLanguage(f)">
                        @foreach (var h in f.Hunks)
                        {
                            <tr class="diff-hunk"><td class="ln"></td><td class="ln"></td><td class="code mono">@h.Header</td></tr>
                            @foreach (var line in h.Lines)
                            {
                                var lineComments = fileComments.Where(c => Matches(c, line)).ToList();
                                var composingHere = composing is { } cp && cp.Path == f.Path && cp.Old == line.OldLine && cp.New == line.NewLine;
                                <tr class="diff-line diff-@line.Kind.ToString().ToLowerInvariant()">
                                    <td class="ln">@line.OldLine</td>
                                    <td class="ln">@line.NewLine</td>
                                    <td class="code mono">
                                        @if (CanComment)
                                        {
                                            <button type="button" class="diff-comment-btn" title="Comment on this line" aria-label="Comment on this line" @onclick="() => StartComment(f.Path, line)">+</button>
                                        }
                                        <span class="diff-sign">@(line.Kind switch { DiffLineKind.Added => "+", DiffLineKind.Deleted => "-", _ => " " })</span>@CodeLanguages.Line(line.Text)
                                    </td>
                                </tr>
                                @if (lineComments.Count > 0 || composingHere)
                                {
                                    <tr class="diff-thread-row">
                                        <td colspan="3">
                                            <div class="diff-thread">
                                                @foreach (var c in lineComments)
                                                {
                                                    <div class="inline-comment" @key="c.Id">
                                                        <div class="inline-comment-head">
                                                            <Avatar User="c.Author" Size="20" /> <b>@c.Author.DisplayName</b> <AiBadge User="c.Author" />
                                                            <span class="muted small">@Display.Ago(c.CreatedAt)@(c.EditedAt != null ? " · edited" : "")</span>
                                                        </div>
                                                        <div class="markdown">@Display.Markdown(c.Body)</div>
                                                    </div>
                                                }
                                                @if (composingHere)
                                                {
                                                    <div class="inline-compose">
                                                        <MarkdownEditor @bind-Value="draft" Rows="3" Placeholder="Leave an inline comment…" ProjectId="Repo?.ProjectId" />
                                                        <div class="mt-2 d-flex gap-2">
                                                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" Disabled="@(string.IsNullOrWhiteSpace(draft) || saving)" OnClick="Submit">Comment</MudButton>
                                                            <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="() => composing = null">Cancel</MudButton>
                                                        </div>
                                                    </div>
                                                }
                                                else if (CanComment)
                                                {
                                                    <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Reply" OnClick="() => StartComment(f.Path, line)">Reply…</MudButton>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        }
                    </table>
                }
            }
        </div>
    }
}

@code {
    public record InlineCommentRequest(string Path, int? Line, int? OldLine, string Body);

    [Parameter, EditorRequired] public IReadOnlyList<FileDiff> Files { get; set; } = [];
    /// <summary>Existing inline comments (only those with a FilePath are shown).</summary>
    [Parameter] public IReadOnlyList<PullRequestComment>? Comments { get; set; }
    [Parameter] public bool CanComment { get; set; }
    [Parameter] public EventCallback<InlineCommentRequest> OnComment { get; set; }
    /// <summary>With both set, each file header links to the file at this ref.</summary>
    [Parameter] public Repository? Repo { get; set; }
    [Parameter] public string? ViewRef { get; set; }
    [Parameter] public string EmptyText { get; set; } = "No changes.";

    private readonly HashSet<string> collapsed = [];
    private (string Path, int? Old, int? New)? composing;
    private string? draft;
    private bool saving;
    private IReadOnlyList<FileDiff>? seenFiles;

    protected override void OnParametersSet()
    {
        if (ReferenceEquals(seenFiles, Files)) return;
        seenFiles = Files;
        // Start big files collapsed so large diffs stay responsive.
        collapsed.Clear();
        foreach (var f in Files.Where(f => f.Hunks.Sum(h => h.Lines.Count) > 800)) collapsed.Add(f.Path);
    }

    /// <summary>The highlight.js language for a file's diff, or null when unknown or over the size limit.</summary>
    private static string? HighlightLanguage(FileDiff f) =>
        f.Hunks.Sum(h => h.Lines.Sum(l => (long)l.Text.Length + 1)) > CodeLanguages.MaxHighlightBytes ? null : CodeLanguages.ForPath(f.Path);

    private static bool Matches(PullRequestComment c, DiffLine line) =>
        c.Line is { } n ? line.Kind != DiffLineKind.Deleted && line.NewLine == n
                        : line.Kind == DiffLineKind.Deleted && line.OldLine == c.OldLine;

    private void Toggle(string path)
    {
        if (!collapsed.Remove(path)) collapsed.Add(path);
    }

    private void CollapseAll()
    {
        foreach (var f in Files) collapsed.Add(f.Path);
    }

    private void StartComment(string path, DiffLine line)
    {
        composing = (path, line.OldLine, line.NewLine);
        draft = null;
    }

    private async Task Submit()
    {
        if (composing is not { } cp || string.IsNullOrWhiteSpace(draft)) return;
        saving = true;
        try
        {
            // Comments on deleted lines anchor to the old line number; everything else to the new one.
            var line = cp.New;
            var old = cp.New == null ? cp.Old : null;
            await OnComment.InvokeAsync(new InlineCommentRequest(cp.Path, line, old, draft.Trim()));
            composing = null;
            draft = null;
        }
        finally { saving = false; }
    }
}
