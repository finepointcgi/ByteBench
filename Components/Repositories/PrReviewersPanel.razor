@* PR sidebar: assigned reviewers (and anyone else who reviewed) with pending / approved / changes requested. *@
@inject ReviewerService Reviewers
@inject CurrentUser Me

@if (entries.Count == 0 && !editing)
{
    <MudText Class="mud-text-secondary" Typo="Typo.caption" HtmlTag="div">No reviewers yet.</MudText>
}
@foreach (var e in entries)
{
    <div class="reviewer" @key="e.User.Id">
        <span class="reviewer-name"><Avatar User="e.User" Size="22" ShowName /> <AiBadge User="e.User" /></span>
        @switch (e.Status)
        {
            case ReviewerStatus.Approved:
                <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Text" Icon="@Icons.Material.Filled.Check" Class="review-chip">Approved</MudChip>
                break;
            case ReviewerStatus.ChangesRequested:
                <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Text" Icon="@Icons.Material.Outlined.Edit" Class="review-chip">Changes requested</MudChip>
                break;
            default:
                <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Text" Icon="@Icons.Material.Outlined.Schedule" Class="review-chip"
                         title="@(e.Stale ? "Approved an older version; new commits were pushed since" : "Review requested")">
                    @(e.Stale ? "Re-review needed" : "Pending")
                </MudChip>
                break;
        }
    </div>
}
@if (CanEdit && Pr.State == PullRequestState.Open)
{
    @if (editing)
    {
        <div class="reviewer-picker mt-2">
            @if (candidates.Count == 0) { <MudText Class="mud-text-secondary" Typo="Typo.caption" HtmlTag="div">No other project members can review.</MudText> }
            @foreach (var u in candidates)
            {
                <MudCheckBox T="bool" @key="u.Id" Value="@selected.Contains(u.Id)" ValueChanged="v => Toggle(u.Id, v)" Size="Size.Small" Dense="true" Color="Color.Primary">
                    <span class="small">@u.DisplayName <span class="muted">@@@u.UserName</span></span>
                </MudCheckBox>
            }
            @if (error != null) { <MudText Typo="Typo.caption" Color="Color.Error" HtmlTag="div">@error</MudText> }
            <div class="d-flex gap-2 mt-1">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" Disabled="@busy" OnClick="Save">Save</MudButton>
                <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="() => editing = false">Cancel</MudButton>
            </div>
        </div>
    }
    else
    {
        <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Outlined.PersonAdd" OnClick="StartEdit" Class="mt-1 px-1">Edit reviewers</MudButton>
    }
}

@code {
    [Parameter, EditorRequired] public PullRequest Pr { get; set; } = null!;
    [Parameter] public string? HeadSha { get; set; }
    [Parameter] public bool CanEdit { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }

    private List<ReviewerEntry> entries = [];
    private List<User> candidates = [];
    private HashSet<int> selected = [];
    private bool editing, busy;
    private string? error;
    private PullRequest? loadedFor;

    protected override async Task OnParametersSetAsync()
    {
        if (ReferenceEquals(loadedFor, Pr)) return; // the page replaces Pr on every reload
        loadedFor = Pr;
        entries = await Reviewers.EntriesAsync(Pr, HeadSha);
    }

    private async Task StartEdit()
    {
        error = null;
        candidates = (await Reviewers.CandidatesAsync(Pr.Repository.ProjectId)).Where(u => u.Id != Pr.AuthorId).ToList();
        selected = entries.Where(e => e.Assigned).Select(e => e.User.Id).ToHashSet();
        editing = true;
    }

    private void Toggle(int id, bool on)
    {
        if (on) selected.Add(id); else selected.Remove(id);
    }

    private async Task Save()
    {
        busy = true;
        error = null;
        try
        {
            await Reviewers.SetAsync(Pr.Id, Me.Id, selected);
            editing = false;
            entries = await Reviewers.EntriesAsync(Pr, HeadSha);
            await OnChanged.InvokeAsync();
        }
        catch (InvalidOperationException ex) { error = ex.Message; }
        finally { busy = false; }
    }
}
