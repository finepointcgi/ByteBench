@inject NavigationManager Nav
@inject IJSRuntime JS
@inject ISnackbar Snackbar

@* focusin bubbles from the input, so the whole URL is selected when the field is focused. *@
<div class="clone-box" onfocusin="if (event.target.select) event.target.select()">
    <MudTextField T="string" Value="@Url" ReadOnly="true" Label="Clone" Variant="Variant.Outlined" Margin="Margin.Dense"
                  Adornment="Adornment.End" AdornmentIcon="@(copied ? Icons.Material.Filled.Check : Icons.Material.Outlined.ContentCopy)"
                  OnAdornmentClick="Copy" AdornmentAriaLabel="Copy clone URL" Class="clone-input gb-mono-input" />
</div>

@code {
    [Parameter, EditorRequired] public Repository Repo { get; set; } = null!;

    private bool copied;
    private string Url => RepoUrls.CloneUrl(Nav.BaseUri, Repo);

    private async Task Copy()
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", Url);
            copied = true;
            Snackbar.Add("Clone URL copied", Severity.Normal);
        }
        catch (JSException) { /* clipboard unavailable (e.g. insecure context); the field is still selectable */ }
    }
}
