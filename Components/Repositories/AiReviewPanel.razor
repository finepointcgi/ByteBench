@* Sidebar block on the PR page: AI review status plus "Review with AI" (Developers+). Live-updates. *@
@using ByteBench.Services.Ai
@implements IDisposable
@inject AiReviewService Reviews
@inject AiReviewSettingsService AiSettings
@inject AiReviewQueue Queue
@inject ProjectAccess Access
@inject CurrentUser Me

<div class="gb-side-field ai-review-panel">
    <span class="gb-section-label">AI review</span>
    @if (!settings.Enabled)
    {
        <MudText Class="mud-text-secondary" Typo="Typo.caption" HtmlTag="div">
            AI review is off for this repository.
            @if (canManage) { <a href="@PrUrls.AiReviewSettings(PullRequest.Repository)">Turn it on in settings.</a> }
        </MudText>
    }
    else if (availability is { Available: false })
    {
        <MudText Class="mud-text-secondary" Typo="Typo.caption" HtmlTag="div">@availability.Reason</MudText>
    }
    else
    {
        <MudAlert Severity="@StatusSeverity" Dense="true" Variant="Variant.Outlined" Icon="@StatusIcon" Class="ai-review-status">
            AI review: @StatusText
        </MudAlert>
        @if (latest?.Status == AiReviewStatus.Completed && latest.Error != null)
        {
            <MudText Typo="Typo.caption" HtmlTag="div" Class="mud-text-secondary mt-1">@latest.Error</MudText>
        }
        @if (blockers > 0)
        {
            <MudText Typo="Typo.caption" HtmlTag="div" Class="mt-1 ai-review-blockers">
                @blockers unresolved blocking finding@(blockers == 1 ? "" : "s")@(settings.BlockOnUnresolvedFindings ? " (blocks merging)" : "")
            </MudText>
        }
        @if (notice != null)
        {
            <MudText Typo="Typo.caption" HtmlTag="div" Class="mud-text-secondary mt-1 ai-review-notice">@notice</MudText>
        }
        @if (PullRequest.State == PullRequestState.Open && canReview)
        {
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" FullWidth="true" Class="mt-2 ai-review-button"
                       StartIcon="@Icons.Material.Outlined.AutoAwesome" Disabled="@(Busy || requesting)" OnClick="Request">Review with AI</MudButton>
        }
    }
</div>

@code {
    [Parameter, EditorRequired] public PullRequest PullRequest { get; set; } = null!;
    /// <summary>Invoked when a review finishes, so the page can reload comments and reviews.</summary>
    [Parameter] public EventCallback OnReviewFinished { get; set; }

    private AiReview? latest;
    private RepositoryAiReviewSettings settings = new();
    private AiReviewAvailability? availability;
    private bool requesting, canReview, canManage;
    private int blockers;
    private string? notice;
    private int? loadedFor;

    private bool Busy => latest?.Status is AiReviewStatus.Queued or AiReviewStatus.Running;

    private Severity StatusSeverity => latest?.Status switch
    {
        AiReviewStatus.Failed => Severity.Error,
        AiReviewStatus.Completed => Severity.Success,
        _ => Severity.Normal,
    };

    private string StatusIcon => latest?.Status switch
    {
        AiReviewStatus.Failed => Icons.Material.Outlined.ErrorOutline,
        AiReviewStatus.Completed => Icons.Material.Outlined.CheckCircle,
        AiReviewStatus.Queued or AiReviewStatus.Running => Icons.Material.Outlined.HourglassEmpty,
        _ => Icons.Material.Outlined.AutoAwesome,
    };

    private string StatusText => latest?.Status switch
    {
        _ when !Busy && Queue.IsWaiting(PullRequest.Id) => "new commits pushed, reviewing shortly…",
        null => "not run yet.",
        AiReviewStatus.Queued => "queued…",
        AiReviewStatus.Running => "running…",
        AiReviewStatus.Completed => $"done, {Plural(latest.FindingsCount, "finding")}" +
                                    (latest.UnplacedCount > 0 ? $" ({latest.InlineCount} inline)" : "") +
                                    $" on {Short(latest.HeadSha)} · {Display.Ago(latest.CompletedAt ?? latest.CreatedAt)}",
        AiReviewStatus.Failed => $"failed ({latest.Error ?? "unknown error"})",
        AiReviewStatus.Skipped => $"skipped ({latest.Error})",
        _ => "",
    };

    private static string Plural(int n, string word) => $"{n} {word}{(n == 1 ? "" : "s")}";
    private static string Short(string sha) => sha.Length > 7 ? sha[..7] : sha;

    protected override void OnInitialized() => Queue.Changed += OnChanged;

    protected override async Task OnParametersSetAsync()
    {
        if (loadedFor == PullRequest.Id) return;
        loadedFor = PullRequest.Id;
        var projectId = PullRequest.Repository.ProjectId;
        settings = await AiSettings.GetAsync(PullRequest.RepositoryId);
        canReview = await Access.CanAsync(projectId, Permission.ReviewPullRequest);
        canManage = await Access.CanAsync(projectId, Permission.ManageRepositories);
        if (settings.Enabled) availability = await AiSettings.GetAvailabilityAsync();
        await Refresh();
    }

    private async Task Refresh()
    {
        latest = await Reviews.GetLatestAsync(PullRequest.Id);
        blockers = settings.Enabled ? await Reviews.CountBlockersAsync(PullRequest.Id) : 0;
    }

    private void OnChanged(int prId)
    {
        if (prId != PullRequest.Id) return;
        _ = InvokeAsync(async () =>
        {
            var wasBusy = Busy;
            await Refresh();
            if (wasBusy && !Busy) await OnReviewFinished.InvokeAsync();
            StateHasChanged();
        });
    }

    private async Task Request()
    {
        requesting = true;
        notice = null;
        try
        {
            var intake = await Reviews.RequestManualAsync(PullRequest.Id, Me.Id);
            if (!intake.Queued) notice = intake.Reason;
            await Refresh();
        }
        catch (InvalidOperationException ex) { notice = ex.Message; }
        finally { requesting = false; }
    }

    public void Dispose() => Queue.Changed -= OnChanged;
}
