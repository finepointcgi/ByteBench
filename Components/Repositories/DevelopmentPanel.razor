@* Jira-style "Development" sidebar block for an issue: branches, pull requests and commits mentioning its key, and the environments they are deployed to. *@
@inject RepositoryService Repos

<div class="dev-panel">
    <div class="dev-label">Development</div>
    @if (info == null)
    {
        <MudText Class="mud-text-secondary" Typo="Typo.caption">Loading…</MudText>
    }
    else if (info.IsEmpty)
    {
        <MudText Class="mud-text-secondary" Typo="Typo.caption" HtmlTag="div">
            No branches, commits or pull requests yet. Include <code>@Issue.Key</code> in a branch name or commit message to link it.
        </MudText>
    }
    else
    {
        @if (info.PullRequests.Count > 0)
        {
            <div class="dev-group">
                <div class="dev-heading"><MudIcon Icon="@Icons.Material.Outlined.MergeType" Size="Size.Small" /> @info.PullRequests.Count pull request@(info.PullRequests.Count == 1 ? "" : "s")</div>
                @foreach (var pr in info.PullRequests)
                {
                    <a class="dev-item" href="@RepoUrls.PullRequest(pr)" title="@pr.Title">
                        <PrStateBadge State="pr.State" Draft="pr.IsDraft" Compact="true" />
                        <span class="dev-text">@pr.Repository.Slug#@pr.Number @pr.Title</span>
                    </a>
                }
            </div>
        }
        @if (info.Branches.Count > 0)
        {
            <div class="dev-group">
                <div class="dev-heading"><MudIcon Icon="@Icons.Material.Outlined.AccountTree" Size="Size.Small" /> @info.Branches.Count branch@(info.Branches.Count == 1 ? "" : "es")</div>
                @foreach (var b in info.Branches)
                {
                    <a class="dev-item mono" href="@RepoUrls.Source(b.Repo, b.Branch.Name)" title="@b.Repo.Slug: @b.Branch.Name">
                        <span class="dev-text">@b.Branch.Name</span>
                    </a>
                }
            </div>
        }
        @if (info.Commits.Count > 0)
        {
            <div class="dev-group">
                <div class="dev-heading"><MudIcon Icon="@Icons.Material.Outlined.Commit" Size="Size.Small" /> @info.Commits.Count recent commit@(info.Commits.Count == 1 ? "" : "s")</div>
                @foreach (var c in info.Commits)
                {
                    <a class="dev-item" href="@RepoUrls.Commit(c.Repo, c.Commit.Sha)" title="@c.Commit.Message">
                        <span class="sha-pill">@c.Commit.ShortSha</span>
                        <span class="dev-text">@c.Commit.MessageShort</span>
                    </a>
                }
            </div>
        }
        <div class="dev-group">
            <div class="dev-heading"><MudIcon Icon="@Icons.Material.Outlined.Cloud" Size="Size.Small" /> Deployments</div>
            <ByteBench.Components.Pipelines.DeployedToPanel Issue="Issue" ShowRepo="true" ShowEmpty="true" EmptyText="Not deployed to any environment yet." />
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public Issue Issue { get; set; } = null!;

    private DevelopmentInfo? info;
    private int loadedFor = -1;

    protected override async Task OnParametersSetAsync()
    {
        if (loadedFor == Issue.Id) return;
        loadedFor = Issue.Id;
        info = null;
        info = await Repos.GetDevelopmentAsync(Issue.ProjectId, Issue.Project.Key, Issue.Number);
    }
}
