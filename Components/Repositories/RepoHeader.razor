@* Breadcrumb, title and tab strip shared by every page of a repository. *@
@inject ProjectAccess Access
@inject NavigationManager Nav
@inject GitBench.Services.Forks.ForkService Forks
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject CurrentUser Me
@inject GitBench.Services.Pages.PagesService Pages
<div class="repo-crumbs"><MudBreadcrumbs Items="Crumbs" Class="px-0 pt-0 pb-2" /></div>
<div class="repo-header">
    <div class="repo-title">
        <span class="repo-icon"><MudIcon Icon="@Icons.Material.Outlined.Inventory2" /></span>
        <div class="gb-min0">
            <div class="d-flex align-center flex-wrap gap-2">
                <MudText Typo="Typo.h5" HtmlTag="h1" Class="repo-name">@Repo.Name</MudText>
                @if (Repo.IsArchived)
                {
                    <MudTooltip Text="Read-only: pushes and new pull requests are disabled">
                        <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined" Icon="@Icons.Material.Outlined.Archive" Class="ma-0">Archived</MudChip>
                    </MudTooltip>
                }
            </div>
            @if (!string.IsNullOrWhiteSpace(Repo.Description))
            {
                <MudText Class="mud-text-secondary" Typo="Typo.body2">@Repo.Description</MudText>
            }
            @if (forkInfo.Parent is { } parent)
            {
                <MudText Class="mud-text-secondary repo-forked-from" Typo="Typo.body2">
                    <MudIcon Icon="@Icons.Material.Outlined.CallSplit" Size="Size.Small" />
                    Forked from <a href="@RepoUrls.Base(parent)">@parent.Project.Key/@parent.Slug</a>
                </MudText>
            }
            else if (forkInfo.ParentHidden)
            {
                <MudText Class="mud-text-secondary" Typo="Typo.body2">Forked from a repository you can't see</MudText>
            }
        </div>
    </div>
    <div class="repo-header-actions">
        <form role="search" @onsubmit="Search" class="repo-search-form">
            <MudTextField T="string" @bind-Value="query" Immediate="true" Placeholder="Search code…" Variant="Variant.Outlined" Margin="Margin.Dense"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" InputType="InputType.Search"
                          aria-label="Search this repository" Class="repo-search-box" />
        </form>
        @if (forkInfo.Parent != null && canPush)
        {
            <MudTooltip Text="@($"Fast-forward {Repo.DefaultBranch} to the upstream's {forkInfo.Parent.DefaultBranch}")">
                <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Outlined.Sync" Disabled="@syncing" OnClick="Sync">Sync fork</MudButton>
            </MudTooltip>
        }
        @if (forkInfo.Parent != null && canCreatePr)
        {
            <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Outlined.MergeType"
                       Href="@GitBench.Services.Forks.ForkUrls.NewPullRequest(Repo)">PR to upstream</MudButton>
        }
        @if (siteUrl != null)
        {
            <MudTooltip Text="Open the published site (Pages)">
                <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Outlined.Language" Href="@siteUrl" Target="_blank" rel="noopener">Site</MudButton>
            </MudTooltip>
        }
        <MudButtonGroup Variant="Variant.Outlined" Size="Size.Small">
            <MudButton StartIcon="@Icons.Material.Outlined.CallSplit" OnClick="Fork">Fork</MudButton>
            <MudButton Href="@GitBench.Services.Forks.ForkUrls.List(Repo)" title="Forks of this repository" aria-label="@($"{forkInfo.ForkCount} forks")">@forkInfo.ForkCount</MudButton>
        </MudButtonGroup>
        @ChildContent
    </div>
</div>
@if (Repo.IsArchived)
{
    <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3">
        This repository was archived@(Repo.ArchivedAt is { } at ? $" on {at.ToLocalTime():MMM d, yyyy}" : ""). It is read-only: pushes, new branches and pull requests are disabled.
    </MudAlert>
}
<nav class="gb-tabs" aria-label="Repository">
    <TabLink Active="@(Active == "source")" Href="@RepoUrls.Source(Repo, Ref)" Icon="@Icons.Material.Outlined.Code">Source</TabLink>
    <TabLink Active="@(Active == "commits")" Href="@RepoUrls.Commits(Repo, Ref)" Icon="@Icons.Material.Outlined.Commit">Commits</TabLink>
    <TabLink Active="@(Active == "branches")" Href="@RepoUrls.Branches(Repo)" Icon="@Icons.Material.Outlined.AccountTree">Branches</TabLink>
    <TabLink Active="@(Active == "tags")" Href="@GitBench.Services.Releases.ReleaseUrls.Tags(Repo)" Icon="@Icons.Material.Outlined.LocalOffer">Tags</TabLink>
    <TabLink Active="@(Active == "releases")" Href="@GitBench.Services.Releases.ReleaseUrls.List(Repo)" Icon="@Icons.Material.Outlined.NewReleases">Releases</TabLink>
    <TabLink Active="@(Active == "prs")" Href="@RepoUrls.RepoPullRequests(Repo)" Icon="@Icons.Material.Outlined.MergeType">Pull requests</TabLink>
    <TabLink Active="@(Active == "pipelines")" Href="@PipelineUrls.List(Repo)" Icon="@Icons.Material.Outlined.PlayCircleOutline">Pipelines</TabLink>
    <TabLink Active="@(Active == "environments")" Href="@PipelineUrls.Environments(Repo)" Icon="@Icons.Material.Outlined.Cloud">Environments</TabLink>
    <TabLink Active="@(Active == "security")" Href="@GitBench.Services.Security.SecurityUrls.Repo(Repo)" Icon="@Icons.Material.Outlined.Shield">Security</TabLink>
    <TabLink Active="@(Active == "search")" Href="@CodeUrls.Search(Repo, null, Ref)" Icon="@Icons.Material.Outlined.Search">Search</TabLink>
    @if (canManage)
    {
        <TabLink Active="@(Active == "settings")" Href="@CodeUrls.Settings(Repo)" Icon="@Icons.Material.Outlined.Settings">Settings</TabLink>
    }
</nav>

@code {
    [Parameter, EditorRequired] public Repository Repo { get; set; } = null!;
    /// <summary>One of: source, commits, branches, tags, releases, prs, pipelines, environments, security, search, settings.</summary>
    [Parameter] public string Active { get; set; } = "source";
    /// <summary>The ref being viewed, carried across the Source/Commits/Search tabs.</summary>
    [Parameter] public string? Ref { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private bool canManage, canPush, canCreatePr, syncing;
    private int? permsFor;
    private GitBench.Services.Forks.ForkInfo forkInfo = new(null, false, 0);
    private string? query;
    private string? siteUrl;

    private List<BreadcrumbItem> Crumbs =>
    [
        new(Repo.Project.Name, $"/p/{Repo.Project.Key}/issues"),
        new("Repositories", RepoUrls.List(Repo.Project.Key)),
        new(Repo.Name, null, disabled: true),
    ];

    protected override async Task OnParametersSetAsync()
    {
        if (permsFor == Repo.ProjectId) return;
        permsFor = Repo.ProjectId;
        canManage = await Access.CanAsync(Repo.ProjectId, Permission.ManageRepositories);
        canPush = await Access.CanAsync(Repo.ProjectId, Permission.PushCode);
        canCreatePr = await Access.CanAsync(Repo.ProjectId, Permission.CreatePullRequest);
        forkInfo = await Forks.GetInfoAsync(Repo);
        siteUrl = await Pages.LiveUrlAsync(Repo);
    }

    private async Task Fork()
    {
        var dialog = await Dialogs.ShowAsync<ForkDialog>("Fork", new DialogParameters<ForkDialog> { { x => x.Upstream, Repo } },
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true });
        if (await dialog.Result is { Canceled: false, Data: Repository fork })
        {
            Snackbar.Add($"Forked into {fork.Project.Key}/{fork.Slug}.", Severity.Success);
            Nav.NavigateTo(RepoUrls.Base(fork));
        }
    }

    private async Task Sync()
    {
        syncing = true;
        try
        {
            await Me.EnsureLoadedAsync();
            var r = await Forks.SyncAsync(Repo, Me.Id);
            var b = Repo.DefaultBranch;
            var (text, severity) = r.State switch
            {
                ForkSyncState.FastForwarded => ($"Synced: {b} fast-forwarded by {r.Behind} commit{(r.Behind == 1 ? "" : "s")}.", Severity.Success),
                ForkSyncState.UpToDate => ($"{b} is already up to date with the upstream.", Severity.Info),
                ForkSyncState.Ahead => ($"{b} is {r.Ahead} commit{(r.Ahead == 1 ? "" : "s")} ahead of the upstream, with nothing new to bring in.", Severity.Info),
                ForkSyncState.Diverged => ($"{b} has diverged from the upstream ({r.Ahead} ahead, {r.Behind} behind), so it wasn't changed. Merge or rebase locally: the upstream's branches are in refs/upstream/*.", Severity.Warning),
                _ => ("The upstream has no matching default branch.", Severity.Warning),
            };
            Snackbar.Add(text, severity);
            if (r.State == ForkSyncState.FastForwarded) Nav.Refresh(forceReload: true);
        }
        catch (InvalidOperationException ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { syncing = false; }
    }

    private void Search()
    {
        if (string.IsNullOrWhiteSpace(query)) return;
        Nav.NavigateTo(CodeUrls.Search(Repo, query.Trim(), Ref));
    }
}
