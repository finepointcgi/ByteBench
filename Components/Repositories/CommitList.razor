@* Commits grouped by day, newest first. *@
@inject PipelineService Pipelines
@if (Commits.Count == 0)
{
    <div class="empty">@EmptyText</div>
}
else
{
    @foreach (var day in Commits.GroupBy(c => c.When.ToLocalTime().Date))
    {
        <div class="commit-day">Commits on @day.Key.ToString("MMM d, yyyy")</div>
        <div class="gb-rows commit-list">
            @foreach (var c in day)
            {
                <div class="gb-row gb-row-hover commit-row" @key="c.Sha">
                    <GitAvatar Name="@c.AuthorName" Email="@c.AuthorEmail" Users="Users" Size="28" />
                    <div class="gb-row-main">
                        <a class="commit-msg" href="@RepoUrls.Commit(Repo, c.Sha)">@c.MessageShort</a>
                        <IssueKeyLinks ProjectKey="@Repo.Project.Key" Text="@c.Message" />
                        <div class="gb-row-meta">
                            <b>@c.AuthorName</b> committed @Display.Ago(c.When.UtcDateTime)
                            @if (c.ParentShas.Count > 1) { <span class="merge-tag">merge</span> }
                        </div>
                    </div>
                    <div class="commit-actions">
                        @if (pipelines.GetValueOrDefault(c.Sha) is { } ci)
                        {
                            <PipelineStatusIcon Status="ci.Status" Href="@PipelineUrls.Detail(Repo, ci.Id)" Title="@($"Pipeline #{ci.Id}")" />
                        }
                        <a class="sha-pill" href="@RepoUrls.Commit(Repo, c.Sha)" title="@c.Sha">@c.ShortSha</a>
                        <MudIconButton Href="@RepoUrls.Source(Repo, c.Sha)" Icon="@Icons.Material.Filled.Code" Size="Size.Small" Variant="Variant.Outlined"
                                       title="Browse the repository at this commit" aria-label="Browse the repository at this commit" />
                    </div>
                </div>
            }
        </div>
    }
}

@code {
    [Parameter, EditorRequired] public IReadOnlyList<CommitInfo> Commits { get; set; } = [];
    [Parameter, EditorRequired] public Repository Repo { get; set; } = null!;
    [Parameter] public IReadOnlyDictionary<string, User>? Users { get; set; }
    [Parameter] public string EmptyText { get; set; } = "No commits.";

    private Dictionary<string, PipelineBadgeInfo> pipelines = [];

    protected override async Task OnParametersSetAsync() =>
        pipelines = await Pipelines.LatestForCommitsAsync(Repo, Commits.Select(c => c.Sha));
}
