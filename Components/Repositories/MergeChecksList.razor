@* The merge box's list of checks: branch protection (approvals, change requests) plus every IMergeCheck. *@
@if (Gate != null && (Gate.Checks.Count > 0 || Gate.Protection.IsProtected))
{
    <div class="merge-checks">
        @if (Gate.Protection.IsProtected)
        {
            <div class="mc-protected" title="Branch protection rules matching @Target">
                <MudIcon Icon="@Icons.Material.Outlined.Lock" Size="Size.Small" />
                <span><span class="mono">@Target</span> is protected (@Gate.Protection.Describe)</span>
            </div>
        }
        @foreach (var c in Gate.Checks)
        {
            <div class="mc-row">
                <MudIcon Icon="@Icon(c.State)" Color="@IconColor(c.State)" Size="Size.Small" Class="mc-icon" title="@c.State.ToString()" />
                <div class="mc-text">
                    @if (c.Url != null) { <a href="@c.Url"><b>@c.Name</b></a> } else { <b>@c.Name</b> }
                    @if (c.Detail != null) { <span class="muted"> · @c.Detail</span> }
                </div>
            </div>
        }
        @if (Gate.Blocked)
        {
            <MudAlert Severity="@(Gate.CanBypass ? Severity.Warning : Severity.Error)" Dense="true" Square="true" Class="mc-blocked">
                @if (Gate.CanBypass)
                {
                    <span>Blocked: @string.Join("; ", Gate.Blockers). As an admin you can bypass the rule and merge anyway.</span>
                }
                else
                {
                    <span>Merging is blocked: @string.Join("; ", Gate.Blockers).</span>
                }
            </MudAlert>
        }
    </div>
}

@code {
    [Parameter] public MergeGateResult? Gate { get; set; }
    [Parameter] public string Target { get; set; } = "";

    private static string Icon(MergeCheckState s) => s switch
    {
        MergeCheckState.Passed => Icons.Material.Filled.CheckCircle,
        MergeCheckState.Failed => Icons.Material.Filled.Cancel,
        MergeCheckState.Pending => Icons.Material.Filled.Schedule,
        _ => Icons.Material.Filled.RemoveCircleOutline,
    };

    private static Color IconColor(MergeCheckState s) => s switch
    {
        MergeCheckState.Passed => Color.Success,
        MergeCheckState.Failed => Color.Error,
        MergeCheckState.Pending => Color.Warning,
        _ => Color.Default,
    };
}
