@* One square per day for the last 52 weeks (columns are weeks starting Monday, rows are Monday to Sunday), as SVG. The shade is the
   number of commits that day relative to the busiest day. Days are UTC. *@
@using ByteBench.Services.Insights
<figure class="ihm-figure">
    <svg class="ihm-svg" viewBox="0 0 @(Columns * Step) @(7 * Step)" role="img"
         aria-label="@($"Commits per day for the last 52 weeks: {Days.Sum(d => d.Commits):N0} commits on {Days.Count(d => d.Commits > 0):N0} days, busiest day {Max:N0}")">
        @for (var i = 0; i < Days.Count; i++)
        {
            var d = Days[i];
            <rect class="ihm-cell ihm-l@(Level(d.Commits))" x="@((i / 7) * Step)" y="@((i % 7) * Step)" width="@(Step - 2)" height="@(Step - 2)" rx="2">
                <title>@d.Date: @d.Commits commit@(d.Commits == 1 ? "" : "s")</title>
            </rect>
        }
    </svg>
    <figcaption class="ihm-caption">
        <span>@(Days.FirstOrDefault()?.Date)</span>
        <span>less <span class="ihm-key ihm-l0" aria-hidden="true"></span><span class="ihm-key ihm-l1" aria-hidden="true"></span><span class="ihm-key ihm-l2" aria-hidden="true"></span><span class="ihm-key ihm-l3" aria-hidden="true"></span><span class="ihm-key ihm-l4" aria-hidden="true"></span> more</span>
        <span>@(Days.LastOrDefault()?.Date)</span>
    </figcaption>
</figure>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<DayCommits> Days { get; set; } = [];
    private const int Step = 12;
    private int Columns => (Days.Count + 6) / 7;
    private int Max => Days.Count == 0 ? 0 : Days.Max(d => d.Commits);
    private int Level(int commits) => commits <= 0 || Max == 0 ? 0 : Math.Clamp((int)Math.Ceiling(4.0 * commits / Max), 1, 4);
}
