@* Backlog/sprint header: total time logged on the section's issues (hidden when nothing is logged). *@
@inject TimeTrackingService Time

@if (spent > 0)
{
    <span class="tsp" title="Time logged on these issues">⏱ @Duration.Format(spent, hoursPerDay)</span>
}

@code {
    [Parameter, EditorRequired] public IReadOnlyCollection<Issue> Issues { get; set; } = null!;

    private int spent, hoursPerDay = Duration.DefaultHoursPerDay;
    private string? loadedFor;

    protected override async Task OnParametersSetAsync()
    {
        var key = string.Join(",", Issues.Select(i => i.Id));
        if (key == loadedFor) return;
        loadedFor = key;
        if (Issues.Count == 0) { spent = 0; return; }
        hoursPerDay = await Time.GetHoursPerDayAsync(Issues.First().ProjectId);
        spent = (await Time.GetSpentAsync(Issues.Select(i => i.Id).ToList())).Values.Sum();
    }
}
