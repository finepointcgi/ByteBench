@* One week of work logs as a grid: a row per issue (or per user), a column per day, totals on the right and bottom. *@
<div class="wg-scroll">
    <table class="wg">
        <thead>
            <tr>
                <th class="wg-first">@RowTitle</th>
                @for (var d = 0; d < 7; d++)
                {
                    var day = WeekStart.AddDays(d);
                    <th class="@(day == DateTime.Today ? "today" : "")">@day.ToString("ddd")<br /><span class="wg-date">@day.ToString("MMM d")</span></th>
                }
                <th>Total</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in Entries.GroupBy(RowKey).OrderBy(g => g.Key))
            {
                var first = row.First();
                <tr @key="row.Key">
                    <td class="wg-first">
                        @if (ByUser) { @first.UserName }
                        else { <a href="/p/@first.ProjectKey/issues/@first.IssueKey.Split('-').Last()" class="mono">@first.IssueKey</a> <span class="wg-title" title="@first.IssueTitle">@first.IssueTitle</span> }
                    </td>
                    @for (var d = 0; d < 7; d++)
                    {
                        var day = WeekStart.AddDays(d);
                        var cell = row.Where(e => e.Date.Date == day).ToList();
                        <td title="@string.Join("\n", cell.Select(c => $"{(ByUser ? c.IssueKey : c.UserName)}: {Duration.Format(c.Minutes, HoursPerDay)} {c.Comment}"))">
                            @(cell.Count == 0 ? "" : Duration.Hours(cell.Sum(c => c.Minutes)))
                        </td>
                    }
                    <td class="wg-total">@Duration.Hours(row.Sum(e => e.Minutes))</td>
                </tr>
            }
            @if (Entries.Count == 0)
            {
                <tr><td colspan="9" class="mud-text-secondary wg-empty">No work logged this week.</td></tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <td class="wg-first">Total (hours)</td>
                @for (var d = 0; d < 7; d++)
                {
                    var day = WeekStart.AddDays(d);
                    var sum = Entries.Where(e => e.Date.Date == day).Sum(e => e.Minutes);
                    <td>@(sum == 0 ? "" : Duration.Hours(sum))</td>
                }
                <td class="wg-total">@Duration.Hours(Entries.Sum(e => e.Minutes))</td>
            </tr>
        </tfoot>
    </table>
</div>

@code {
    [Parameter, EditorRequired] public List<TimesheetEntry> Entries { get; set; } = [];
    [Parameter, EditorRequired] public DateTime WeekStart { get; set; }
    /// <summary>Rows are users (project report) instead of issues (my timesheet).</summary>
    [Parameter] public bool ByUser { get; set; }
    [Parameter] public int HoursPerDay { get; set; } = Duration.DefaultHoursPerDay;

    private string RowTitle => ByUser ? "Person" : "Issue";
    private string RowKey(TimesheetEntry e) => ByUser ? e.UserName : e.IssueKey;
}
