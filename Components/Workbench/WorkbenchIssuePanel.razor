@* Issue sidebar: "Log time in Workbench" with the issue's charge code (its override, else the project's WBS code). Shown only
   when Workbench:BaseUrl is set and there's a code; otherwise nothing, or a hint for Maintainers. Editors can override
   the code for this issue. *@
@using ByteBench.Services.Workbench
@inject WorkbenchService Workbench
@inject WorkbenchDirectory Directory

@if (Workbench.IsConfigured)
{
    var link = Workbench.LinkFor(Issue, Project);
    <div class="wb-panel" aria-label="Workbench">
        <MudText Typo="Typo.caption" Class="mud-text-secondary wb-label">Time &amp; cost</MudText>
        @if (link != null)
        {
            <MudButton Href="@link.TimesheetUrl" Target="_blank" Rel="noopener noreferrer" Variant="Variant.Outlined" Color="Color.Primary"
                       Size="Size.Small" FullWidth="true" StartIcon="@Icons.Material.Outlined.Schedule" EndIcon="@Icons.Material.Outlined.OpenInNew"
                       data-testid="workbench-log-time">Log time in Workbench</MudButton>
            <div class="wb-code mud-text-secondary">
                Charge to <code data-testid="workbench-wbs">@link.Wbs</code>
                @if (link.ProjectCode != null) { <span> · project <code>@link.ProjectCode</code></span> }
                @if (link.IsIssueOverride) { <span> (this issue)</span> }
            </div>
        }
        else if (Perms.Role >= ProjectRole.Maintainer)
        {
            <MudText Typo="Typo.caption" HtmlTag="div" Class="mud-text-secondary" data-testid="workbench-hint">
                Time is logged in Workbench. <a href="/p/@Project.Key/settings#workbench">Set a Workbench charge code</a> to show a "Log time in Workbench" button here.
            </MudText>
        }
        @if (Workbench.IsConnected && link != null)
        {
            <WorkbenchTaskSummary ProjectId="Project.Id" Wbs="@link.Wbs" @key="link.Wbs" />
        }
        @if (Perms.Can(Permission.EditIssues))
        {
            @if (editing)
            {
                <div class="wb-edit">
                    @if (wbsList.Count > 0)
                    {
                        <MudAutocomplete T="string" @bind-Value="draft" SearchFunc="SearchWbs" Label="Charge code for this issue" Variant="Variant.Outlined" Margin="Margin.Dense"
                                         CoerceValue="true" CoerceText="false" Clearable="true" MaxItems="40" ResetValueOnEmptyText="true" HelperText="Empty uses the project's code."
                                         Error="@(error != null)" ErrorText="@error" data-testid="wb-issue-wbs-picker" />
                    }
                    else
                    {
                        <MudTextField T="string" @bind-Value="draft" Label="Charge code for this issue" Placeholder="@(Project.WorkbenchWbs ?? "e.g. 1.2.3")"
                                      MaxLength="WorkbenchService.MaxCodeLength" Immediate="true" Variant="Variant.Outlined" Margin="Margin.Dense"
                                      HelperText="Empty uses the project's code." Error="@(error != null)" ErrorText="@error" />
                    }
                    <div class="d-flex gap-1">
                        <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" OnClick="Save">Save</MudButton>
                        <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="() => editing = false">Cancel</MudButton>
                    </div>
                </div>
            }
            else
            {
                <MudButton Variant="Variant.Text" Size="Size.Small" Class="wb-link-btn" OnClick="StartEdit">
                    @(Issue.WorkbenchWbs == null ? "Use a different charge code" : "Change charge code")
                </MudButton>
            }
        }
    </div>
}

@code {
    [Parameter, EditorRequired] public Issue Issue { get; set; } = null!;
    [Parameter, EditorRequired] public Project Project { get; set; } = null!;
    [Parameter, EditorRequired] public ProjectPermissions Perms { get; set; } = ProjectPermissions.None;

    private bool editing;
    private string? draft, error;

    private IReadOnlyList<WbWbs> wbsList = [];

    private async Task StartEdit()
    {
        (draft, error, editing) = (Issue.WorkbenchWbs, null, true);
        wbsList = [];
        if (Workbench.IsConnected && Project.WorkbenchProjectCode is { } code)
        {
            var p = await Directory.FindProjectAsync(code);
            if (p.Ok && (await Directory.ListWbsAsync(p.Value!.Id)) is { Ok: true } l) wbsList = l.Value!;
        }
    }

    private Task<IEnumerable<string>> SearchWbs(string? text, CancellationToken ct) =>
        Task.FromResult(WorkbenchDirectory.SearchWbs(wbsList, text).Select(w => w.Code));

    private async Task Save()
    {
        error = null;
        try
        {
            await Workbench.SetIssueWbsAsync(Issue.Id, draft);
            Issue.WorkbenchWbs = string.IsNullOrWhiteSpace(draft) ? null : draft.Trim();
            editing = false;
        }
        catch (InvalidOperationException ex) { error = ex.Message; }
    }
}
