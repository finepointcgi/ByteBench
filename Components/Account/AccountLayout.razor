@inherits LayoutComponentBase

@* Account pages are static SSR: the theme provider only emits the (light) palette CSS variables. *@
<MudThemeProvider Theme="GitBenchTheme.Theme" />

<div class="auth-shell">
    <a class="auth-brand" href="/">
        <span class="auth-brand-mark">◆</span> GitBench
    </a>
    <MudPaper Elevation="8" Class="auth-card">
        @Body
    </MudPaper>
</div>
