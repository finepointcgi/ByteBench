@inherits LayoutComponentBase

@* Account pages are static SSR: the theme provider only emits the palette CSS variables, light or dark per the theme cookies. *@
<MudThemeProvider Theme="ByteBenchTheme.Theme" IsDarkMode="ThemePreference.IsDark(Http)" />

<div class="auth-shell">
    <a class="auth-brand" href="/">
        <span class="auth-brand-mark">◆</span> ByteBench
    </a>
    <MudPaper Elevation="8" Class="auth-card">
        @Body
    </MudPaper>
</div>

@code {
    [CascadingParameter] private HttpContext? Http { get; set; }
}
