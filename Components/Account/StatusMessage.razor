@if (Errors is { Count: > 0 })
{
    <MudAlert Severity="Severity.Error" Dense="true" Class="auth-alert" role="alert">
        @if (Errors.Count == 1)
        {
            @Errors[0]
        }
        else
        {
            <ul class="status-list">
                @foreach (var e in Errors)
                {
                    <li>@e</li>
                }
            </ul>
        }
    </MudAlert>
}
else if (!string.IsNullOrEmpty(Success))
{
    <MudAlert Severity="Severity.Success" Dense="true" Class="auth-alert" role="status">@Success</MudAlert>
}

@code {
    [Parameter] public string? Success { get; set; }
    [Parameter] public IReadOnlyList<string>? Errors { get; set; }
}
