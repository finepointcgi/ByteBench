@page "/account/change-password"
@attribute [Authorize]
@attribute [ExcludeFromInteractiveRouting]
@layout AccountLayout
@inject SignInManager<User> SignIn
@inject UserManager<User> Users
@inject NavigationManager Nav
@inject ByteBench.Services.Audit.AuditLog Audit

<PageTitle>Choose a new password · ByteBench</PageTitle>

<MudText Typo="Typo.h5" HtmlTag="h1" Class="auth-title">Choose a new password</MudText>
<MudText Typo="Typo.body2" Class="mud-text-secondary auth-sub">A site admin gave your account a temporary password. Choose your own to continue.</MudText>

<StatusMessage Errors="errors" />
<EditForm Model="Input" FormName="change-password" OnValidSubmit="Submit" method="post">
    <DataAnnotationsValidator />
    <div class="gb-field">
        <label class="gb-field-label" for="cp-current">Temporary password</label>
        <InputText id="cp-current" type="password" class="gb-input" @bind-Value="Input!.CurrentPassword" autocomplete="current-password" autofocus />
        <ValidationMessage For="() => Input!.CurrentPassword" />
    </div>
    <div class="gb-field">
        <label class="gb-field-label" for="cp-new">New password</label>
        <InputText id="cp-new" type="password" class="gb-input" @bind-Value="Input!.NewPassword" autocomplete="new-password" />
        <div class="gb-help">At least 8 characters, with upper- and lowercase letters and a digit.</div>
        <ValidationMessage For="() => Input!.NewPassword" />
    </div>
    <div class="gb-field">
        <label class="gb-field-label" for="cp-confirm">Confirm new password</label>
        <InputText id="cp-confirm" type="password" class="gb-input" @bind-Value="Input!.ConfirmPassword" autocomplete="new-password" />
        <ValidationMessage For="() => Input!.ConfirmPassword" />
    </div>
    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" DropShadow="false">Change password</MudButton>
</EditForm>

<form method="post" action="/account/logout" class="mt-3">
    <AntiforgeryToken />
    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Text" Size="Size.Small" FullWidth="true">Sign out instead</MudButton>
</form>

@code {
    private readonly List<string> errors = [];

    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private InputModel? Input { get; set; }

    private User? user;

    protected override async Task OnInitializedAsync()
    {
        Input ??= new();
        user = await Users.GetUserAsync(HttpContext.User);
        if (user is null) { Nav.NavigateTo("account/login", forceLoad: true); return; }
        if (!user.MustChangePassword && HttpMethods.IsGet(HttpContext.Request.Method)) Nav.NavigateTo("account/profile", forceLoad: true);
    }

    private async Task Submit()
    {
        if (user is null) return;
        var result = await Users.ChangePasswordAsync(user, Input!.CurrentPassword, Input.NewPassword);
        if (!result.Succeeded)
        {
            errors.AddRange(result.Errors.Select(e => e.Description));
            return;
        }
        user.MustChangePassword = false;
        await Users.UpdateAsync(user);
        await Audit.RecordAsync("user.password_changed", "user", user.Id, details: new { forced = true }, actorId: user.Id);
        await SignIn.RefreshSignInAsync(user); // new cookie without the "must change" claim
        Nav.NavigateTo("/", forceLoad: true);
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "Enter the temporary password."), DataType(DataType.Password)]
        public string CurrentPassword { get; set; } = "";

        [Required(ErrorMessage = "Enter a new password."), StringLength(100, MinimumLength = 8, ErrorMessage = "The new password must be at least 8 characters long.")]
        [DataType(DataType.Password)]
        public string NewPassword { get; set; } = "";

        [Required(ErrorMessage = "Confirm the new password.")]
        [DataType(DataType.Password)]
        [Compare(nameof(NewPassword), ErrorMessage = "The new passwords don't match.")]
        public string ConfirmPassword { get; set; } = "";
    }
}
