@page "/account/profile"
@attribute [Authorize]
@attribute [ExcludeFromInteractiveRouting]
@layout AccountLayout
@inject SignInManager<User> SignIn
@inject UserManager<User> Users
@inject NavigationManager Nav
@inject AccessTokenService Tokens
@inject GitBench.Services.Audit.AuditLog Audit

<PageTitle>Your profile · GitBench</PageTitle>

<div class="profile-page">
    <div class="profile-head">
        <a class="auth-back" href="/">← Back to GitBench</a>
        @if (user != null)
        {
            <div class="profile-id">
                <Avatar User="user" Size="48" />
                <div>
                    <h1 class="auth-title mb-0">@user.DisplayName</h1>
                    <div class="muted small">@@@user.UserName</div>
                </div>
            </div>
        }
    </div>

    <section class="profile-section">
        <h2 class="profile-section-title">Profile</h2>
        <StatusMessage Success="@profileSuccess" Errors="profileErrors" />

        <EditForm Model="ProfileInput" FormName="profile" OnValidSubmit="SaveProfile" method="post">
            <DataAnnotationsValidator />
            <div class="mb-3">
                <label class="form-label" for="pf-name">Display name</label>
                <InputText id="pf-name" class="form-control" @bind-Value="ProfileInput!.DisplayName" autocomplete="name" />
                <ValidationMessage For="() => ProfileInput!.DisplayName" class="text-danger small" />
            </div>
            <div class="mb-3">
                <label class="form-label" for="pf-email">Email</label>
                <InputText id="pf-email" type="email" class="form-control" @bind-Value="ProfileInput!.Email" autocomplete="email" />
                <ValidationMessage For="() => ProfileInput!.Email" class="text-danger small" />
            </div>
            <div class="mb-3">
                <span class="form-label d-block">Avatar color</span>
                <InputRadioGroup @bind-Value="ProfileInput!.Color" Name="color">
                    <div class="color-swatches">
                        @foreach (var c in AvatarPalette.Colors)
                        {
                            <label class="color-swatch" title="@c">
                                <InputRadio Value="c" />
                                <span style="background:@c"></span>
                            </label>
                        }
                    </div>
                </InputRadioGroup>
                <ValidationMessage For="() => ProfileInput!.Color" class="text-danger small" />
            </div>
            <button type="submit" class="btn btn-primary">Save profile</button>
        </EditForm>
    </section>

    <section class="profile-section">
        <h2 class="profile-section-title">Notifications</h2>
        <p class="mb-0">Choose what reaches you in the app and by email on the <a href="/account/notifications">notification preferences</a> page.</p>
    </section>

    <section class="profile-section">
        <h2 class="profile-section-title">Change password</h2>
        <StatusMessage Success="@passwordSuccess" Errors="passwordErrors" />

        <EditForm Model="PasswordInput" FormName="password" OnValidSubmit="ChangePassword" method="post">
            <DataAnnotationsValidator />
            <div class="mb-3">
                <label class="form-label" for="pw-current">Current password</label>
                <InputText id="pw-current" type="password" class="form-control" @bind-Value="PasswordInput!.CurrentPassword" autocomplete="current-password" />
                <ValidationMessage For="() => PasswordInput!.CurrentPassword" class="text-danger small" />
            </div>
            <div class="mb-3">
                <label class="form-label" for="pw-new">New password</label>
                <InputText id="pw-new" type="password" class="form-control" @bind-Value="PasswordInput!.NewPassword" autocomplete="new-password" />
                <ValidationMessage For="() => PasswordInput!.NewPassword" class="text-danger small" />
            </div>
            <div class="mb-3">
                <label class="form-label" for="pw-confirm">Confirm new password</label>
                <InputText id="pw-confirm" type="password" class="form-control" @bind-Value="PasswordInput!.ConfirmPassword" autocomplete="new-password" />
                <ValidationMessage For="() => PasswordInput!.ConfirmPassword" class="text-danger small" />
            </div>
            <button type="submit" class="btn btn-primary">Change password</button>
        </EditForm>
    </section>

    <section class="profile-section" id="tokens">
        <h2 class="profile-section-title">Access tokens</h2>
        <p class="muted small">
            Use a personal access token instead of your password for Git over HTTP: enter your username and paste the
            token when git asks for a password. Tokens with an API scope also work for the
            <a href="/developers/api">REST API</a> (<code>Authorization: Bearer gbp_…</code>). Tokens are shown once; GitBench stores only a hash.
        </p>
        <StatusMessage Success="@tokenSuccess" Errors="tokenErrors" />

        @if (newToken != null)
        {
            <div class="alert alert-success">
                <div class="mb-2"><b>Copy your new token now.</b> You won't be able to see it again.</div>
                <div class="input-group">
                    <input id="new-token" class="form-control mono" readonly value="@newToken" onfocus="this.select()" />
                    <button type="button" class="btn btn-outline-secondary"
                            onclick="navigator.clipboard.writeText(document.getElementById('new-token').value); this.textContent='Copied';">Copy</button>
                </div>
            </div>
        }

        <EditForm Model="TokenInput" FormName="create-token" OnValidSubmit="CreateToken" method="post">
            <DataAnnotationsValidator />
            <div class="mb-3">
                <label class="form-label" for="tk-name">Token name</label>
                <InputText id="tk-name" class="form-control" @bind-Value="TokenInput!.Name" placeholder="e.g. Laptop git" />
                <ValidationMessage For="() => TokenInput!.Name" class="text-danger small" />
            </div>
            <div class="mb-3">
                <span class="form-label d-block">Scopes</span>
                <label class="form-check">
                    <InputCheckbox class="form-check-input" @bind-Value="TokenInput!.ReadRepository" />
                    <span class="form-check-label"><code>read_repository</code>: clone and fetch</span>
                </label>
                <label class="form-check">
                    <InputCheckbox class="form-check-input" @bind-Value="TokenInput!.WriteRepository" />
                    <span class="form-check-label"><code>write_repository</code>: push (also allows clone and fetch)</span>
                </label>
                <label class="form-check">
                    <InputCheckbox class="form-check-input" @bind-Value="TokenInput!.ReadApi" />
                    <span class="form-check-label"><code>read_api</code>: read-only <a href="/developers/api">REST API</a> access (GET requests)</span>
                </label>
                <label class="form-check">
                    <InputCheckbox class="form-check-input" @bind-Value="TokenInput!.WriteApi" />
                    <span class="form-check-label"><code>write_api</code>: full REST API access (also allows reads)</span>
                </label>
            </div>
            <div class="mb-3">
                <label class="form-label" for="tk-exp">Expires</label>
                <InputSelect id="tk-exp" class="form-select" @bind-Value="TokenInput!.ExpiresInDays">
                    <option value="7">In 7 days</option>
                    <option value="30">In 30 days</option>
                    <option value="90">In 90 days</option>
                    <option value="365">In a year</option>
                    <option value="0">Never</option>
                </InputSelect>
            </div>
            <button type="submit" class="btn btn-primary">Create token</button>
        </EditForm>

        @if (tokens.Count > 0)
        {
            <form method="post" @formname="revoke-token" @onsubmit="RevokeToken" class="mt-4">
                <AntiforgeryToken />
                <table class="table table-sm small align-middle">
                    <thead><tr><th>Name</th><th>Token</th><th>Scopes</th><th>Created</th><th>Expires</th><th>Last used</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var t in tokens)
                        {
                            var now = DateTime.UtcNow;
                            <tr class="@(t.IsActive(now) ? "" : "text-muted")">
                                <td>@t.Name</td>
                                <td class="mono">@t.Prefix…</td>
                                <td>@ScopeText(t.Scopes)</td>
                                <td>@t.CreatedAt.ToLocalTime().ToString("d")</td>
                                <td>@(t.ExpiresAt?.ToLocalTime().ToString("d") ?? "Never")</td>
                                <td>@(t.LastUsedAt?.ToLocalTime().ToString("g") ?? "Never")</td>
                                <td class="text-end">
                                    @if (t.RevokedAt != null) { <span>Revoked</span> }
                                    else if (!t.IsActive(now)) { <span>Expired</span> }
                                    else { <button type="submit" name="RevokeTokenId" value="@t.Id" class="btn btn-sm btn-outline-danger">Revoke</button> }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </form>
        }
    </section>

    <form class="profile-signout" method="post" action="account/logout">
        <AntiforgeryToken />
        <button type="submit" class="btn btn-outline-secondary btn-sm">Sign out</button>
    </form>
</div>

@code {
    private User? user;
    private string? profileSuccess, passwordSuccess;
    private readonly List<string> profileErrors = [], passwordErrors = [];

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "profile")]
    private ProfileModel? ProfileInput { get; set; }

    [SupplyParameterFromForm(FormName = "password")]
    private PasswordModel? PasswordInput { get; set; }

    [SupplyParameterFromForm(FormName = "create-token")]
    private TokenModel? TokenInput { get; set; }

    [SupplyParameterFromForm(FormName = "revoke-token")]
    private int? RevokeTokenId { get; set; }

    private List<PersonalAccessToken> tokens = [];
    private string? newToken, tokenSuccess;
    private readonly List<string> tokenErrors = [];

    protected override async Task OnInitializedAsync()
    {
        user = await Users.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            // Cookie is valid but the account is gone: sign out and start over.
            await SignIn.SignOutAsync();
            Nav.NavigateTo("account/login", forceLoad: true);
            return;
        }

        ProfileInput ??= new() { DisplayName = user.DisplayName, Email = user.Email ?? "", Color = user.Color };
        PasswordInput ??= new();
        TokenInput ??= new() { ReadRepository = true };
        tokens = await Tokens.ListAsync(user.Id);
    }

    // ----- Personal access tokens -----

    private async Task CreateToken()
    {
        if (user is null || TokenInput is null) return;
        var scopes = (TokenInput.ReadRepository ? TokenScopes.ReadRepository : 0) | (TokenInput.WriteRepository ? TokenScopes.WriteRepository : 0)
                     | (TokenInput.ReadApi ? TokenScopes.ReadApi : 0) | (TokenInput.WriteApi ? TokenScopes.WriteApi : 0);
        DateTime? expires = TokenInput.ExpiresInDays > 0 ? DateTime.UtcNow.AddDays(TokenInput.ExpiresInDays) : null;
        try
        {
            (_, newToken) = await Tokens.CreateAsync(user.Id, TokenInput.Name, scopes, expires);
            tokenSuccess = $"Token '{TokenInput.Name.Trim()}' created.";
            TokenInput = new() { ReadRepository = true };
        }
        catch (InvalidOperationException ex) { tokenErrors.Add(ex.Message); }
        tokens = await Tokens.ListAsync(user.Id);
    }

    private async Task RevokeToken()
    {
        if (user is null || RevokeTokenId is not { } id) return;
        await Tokens.RevokeAsync(user.Id, id);
        tokenSuccess = "Token revoked. It can no longer be used.";
        tokens = await Tokens.ListAsync(user.Id);
    }

    private static string ScopeText(TokenScopes s) => string.Join(", ",
        new[] { (TokenScopes.ReadRepository, "read_repository"), (TokenScopes.WriteRepository, "write_repository"),
                (TokenScopes.ReadApi, "read_api"), (TokenScopes.WriteApi, "write_api") }
            .Where(x => s.HasFlag(x.Item1)).Select(x => x.Item2));

    private async Task SaveProfile()
    {
        if (user is null || ProfileInput is null) return;

        var newEmail = ProfileInput.Email.Trim();
        var emailChanged = newEmail != user.Email;
        if (emailChanged && await Users.FindByEmailAsync(newEmail) is { } other && other.Id != user.Id)
        {
            profileErrors.Add($"Email '{newEmail}' is already in use by another account.");
            return;
        }

        user.DisplayName = ProfileInput.DisplayName.Trim();
        if (AvatarPalette.Colors.Contains(ProfileInput.Color)) user.Color = ProfileInput.Color;

        // SetEmailAsync validates and persists the whole user, display name and color included.
        var result = emailChanged ? await Users.SetEmailAsync(user, newEmail) : await Users.UpdateAsync(user);
        if (!result.Succeeded)
        {
            profileErrors.AddRange(result.Errors.Select(e => e.Description));
            return;
        }

        await SignIn.RefreshSignInAsync(user);
        profileSuccess = "Your profile was saved.";
    }

    private async Task ChangePassword()
    {
        if (user is null || PasswordInput is null) return;

        var result = await Users.ChangePasswordAsync(user, PasswordInput.CurrentPassword, PasswordInput.NewPassword);
        PasswordInput = new(); // never echo passwords back
        if (!result.Succeeded)
        {
            passwordErrors.AddRange(result.Errors.Select(e => e.Description));
            return;
        }

        await Audit.RecordAsync("user.password_changed", "user", user.Id, actorId: user.Id);
        await SignIn.RefreshSignInAsync(user);
        passwordSuccess = "Your password was changed.";
    }

    private sealed class ProfileModel
    {
        [Required, StringLength(80, MinimumLength = 1)]
        [Display(Name = "Display name")]
        public string DisplayName { get; set; } = "";

        [Required, EmailAddress, StringLength(256)]
        public string Email { get; set; } = "";

        [Required, RegularExpression("^#[0-9a-fA-F]{6}$", ErrorMessage = "Pick a color.")]
        public string Color { get; set; } = "";
    }

    private sealed class TokenModel
    {
        [Required, StringLength(100, MinimumLength = 1)]
        [Display(Name = "Token name")]
        public string Name { get; set; } = "";
        // Defaults false: an unchecked box posts nothing, so a true default could never be cleared. The GET form pre-checks it.
        public bool ReadRepository { get; set; }
        public bool WriteRepository { get; set; }
        public bool ReadApi { get; set; }
        public bool WriteApi { get; set; }
        [Range(0, 365)] public int ExpiresInDays { get; set; } = 30;
    }

    private sealed class PasswordModel
    {
        [Required, DataType(DataType.Password)]
        [Display(Name = "Current password")]
        public string CurrentPassword { get; set; } = "";

        [Required, StringLength(100, MinimumLength = 8, ErrorMessage = "The new password must be at least 8 characters long.")]
        [DataType(DataType.Password)]
        [Display(Name = "New password")]
        public string NewPassword { get; set; } = "";

        [Required(ErrorMessage = "Confirm the new password.")]
        [DataType(DataType.Password)]
        [Compare(nameof(NewPassword), ErrorMessage = "The new passwords don't match.")]
        public string ConfirmPassword { get; set; } = "";
    }
}
