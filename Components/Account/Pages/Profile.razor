@page "/account/profile"
@attribute [Authorize]
@attribute [ExcludeFromInteractiveRouting]
@layout AccountLayout
@inject SignInManager<User> SignIn
@inject UserManager<User> Users
@inject NavigationManager Nav
@inject AccessTokenService Tokens
@inject ByteBench.Services.Audit.AuditLog Audit
@inject ByteBench.Services.Sso.SsoService Sso
@inject ByteBench.Services.Sso.Ldap.LdapAuthService Ldap
@inject ByteBench.Services.Accounts.EmailConfirmationService EmailConfirmation

<PageTitle>Your profile · ByteBench</PageTitle>

<div class="profile-page">
    <div class="profile-head">
        <a class="auth-back" href="/"><MudIcon Icon="@Icons.Material.Filled.ArrowBack" Size="Size.Small" /> Back to ByteBench</a>
        @if (user != null)
        {
            <div class="profile-id">
                <Avatar User="user" Size="48" />
                <div>
                    <MudText Typo="Typo.h5" HtmlTag="h1">@user.DisplayName</MudText>
                    <MudText Class="mud-text-secondary" Typo="Typo.body2">@@@user.UserName</MudText>
                </div>
            </div>
        }
    </div>

    <section class="profile-section">
        <MudText Typo="Typo.subtitle1" HtmlTag="h2" Class="profile-section-title">Profile</MudText>
        <StatusMessage Success="@profileSuccess" Errors="profileErrors" />

        @if (ProfileInput != null)
        {
        <EditForm Model="ProfileInput" FormName="profile" OnValidSubmit="SaveProfile" method="post">
            <DataAnnotationsValidator />
            <div class="gb-field">
                <label class="gb-field-label" for="pf-name">Display name</label>
                <InputText id="pf-name" class="gb-input" @bind-Value="ProfileInput!.DisplayName" autocomplete="name" />
                <ValidationMessage For="() => ProfileInput!.DisplayName" />
            </div>
            <div class="gb-field">
                <label class="gb-field-label" for="pf-email">Email</label>
                <InputText id="pf-email" type="email" class="gb-input" @bind-Value="ProfileInput!.Email" autocomplete="email" />
                <ValidationMessage For="() => ProfileInput!.Email" />
            </div>
            <div class="gb-field">
                <span class="gb-field-label">Avatar color</span>
                <InputRadioGroup @bind-Value="ProfileInput!.Color" Name="color">
                    <div class="color-swatches">
                        @foreach (var c in AvatarPalette.Colors)
                        {
                            <label class="color-swatch" title="@c">
                                <InputRadio Value="c" aria-label="@c" />
                                <span style="background:@c"></span>
                            </label>
                        }
                    </div>
                </InputRadioGroup>
                <ValidationMessage For="() => ProfileInput!.Color" />
            </div>
            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" DropShadow="false">Save profile</MudButton>
        </EditForm>
        }
    </section>

    <section class="profile-section">
        <MudText Typo="Typo.subtitle1" HtmlTag="h2" Class="profile-section-title">Notifications</MudText>
        <MudText Typo="Typo.body2">Choose what reaches you in the app and by email on the <MudLink Href="/account/notifications">notification preferences</MudLink> page.</MudText>
    </section>

    @if (Sso.Settings.Providers.Count > 0 || isDirectoryUser)
    {
        <section class="profile-section" id="connected-accounts">
            <MudText Typo="Typo.subtitle1" HtmlTag="h2" Class="profile-section-title">Connected accounts</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">Sign in to ByteBench with another account. Connecting one needs you to sign in with it once.</MudText>
            <StatusMessage Success="@ssoSuccess" Errors="ssoErrors" />
            @if (isDirectoryUser)
            {
                <div class="d-flex align-center gap-2 mb-2">
                    <MudIcon Icon="@Icons.Material.Outlined.AccountTree" Size="Size.Small" />
                    <MudText Typo="Typo.body2"><b>@Ldap.Options.DisplayName</b> (directory account)</MudText>
                    <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Text" Class="ma-0">Connected</MudChip>
                </div>
            }
            @if (connected.Count > 0)
            {
                <form method="post" @formname="unlink-sso" @onsubmit="Unlink">
                    <AntiforgeryToken />
                    @foreach (var c in connected)
                    {
                        <div class="d-flex align-center gap-2 mb-2 flex-wrap">
                            <MudIcon Icon="@SsoProviderButton.IconFor(c.Provider.Icon)" Size="Size.Small" />
                            <MudText Typo="Typo.body2" Class="flex-grow-1"><b>@c.Provider.Title</b></MudText>
                            @if (c.Linked)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Text" Class="ma-0">Connected</MudChip>
                                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small"
                                           name="UnlinkProvider" value="@c.Provider.Name">Disconnect</MudButton>
                            }
                            else
                            {
                                <MudButton Href="@($"account/sso/{c.Provider.Name}/link?t={Uri.EscapeDataString(linkToken!)}")" Variant="Variant.Outlined" Size="Size.Small" data-enhance-nav="false">Connect</MudButton>
                            }
                        </div>
                    }
                </form>
            }
        </section>
    }

    <section class="profile-section">
        <MudText Typo="Typo.subtitle1" HtmlTag="h2" Class="profile-section-title">@(hasPassword ? "Change password" : "Password")</MudText>
        @if (!hasPassword)
        {
            <MudText Typo="Typo.body2" Class="mud-text-secondary">
                @if (isDirectoryUser)
                {
                    <span>Your password is managed by <b>@Ldap.Options.DisplayName</b>; change it there.</span>
                }
                else
                {
                    <span>Your account has no ByteBench password: you sign in with a connected account.</span>
                }
                For git over HTTP, use a <a href="account/profile#tokens">personal access token</a> as the password@(isDirectoryUser && Ldap.Options.AllowGitPassword ? " (or your directory password, if two-factor sign-in is off)" : "").
            </MudText>
        }
        else
        {
        <StatusMessage Success="@passwordSuccess" Errors="passwordErrors" />

        @if (PasswordInput != null)
        {
        <EditForm Model="PasswordInput" FormName="password" OnValidSubmit="ChangePassword" method="post">
            <DataAnnotationsValidator />
            <div class="gb-field">
                <label class="gb-field-label" for="pw-current">Current password</label>
                <InputText id="pw-current" type="password" class="gb-input" @bind-Value="PasswordInput!.CurrentPassword" autocomplete="current-password" />
                <ValidationMessage For="() => PasswordInput!.CurrentPassword" />
            </div>
            <div class="gb-field">
                <label class="gb-field-label" for="pw-new">New password</label>
                <InputText id="pw-new" type="password" class="gb-input" @bind-Value="PasswordInput!.NewPassword" autocomplete="new-password" />
                <ValidationMessage For="() => PasswordInput!.NewPassword" />
            </div>
            <div class="gb-field">
                <label class="gb-field-label" for="pw-confirm">Confirm new password</label>
                <InputText id="pw-confirm" type="password" class="gb-input" @bind-Value="PasswordInput!.ConfirmPassword" autocomplete="new-password" />
                <ValidationMessage For="() => PasswordInput!.ConfirmPassword" />
            </div>
            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" DropShadow="false">Change password</MudButton>
        </EditForm>
        }
        }
    </section>

    <section class="profile-section" id="two-factor">
        <MudText Typo="Typo.subtitle1" HtmlTag="h2" Class="profile-section-title">Two-factor sign-in</MudText>
        <div class="d-flex align-center gap-2 mb-2">
            @if (user?.TwoFactorEnabled == true)
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Text" Class="ma-0">On</MudChip>
                <MudText Typo="Typo.body2">You sign in with a code from your authenticator app.</MudText>
            }
            else
            {
                <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Class="ma-0">Off</MudChip>
                <MudText Typo="Typo.body2">Add a code from an authenticator app to your sign-in.</MudText>
            }
        </div>
        <MudButton Href="account/two-factor" Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Outlined.Security">
            @(user?.TwoFactorEnabled == true ? "Manage two-factor sign-in" : "Set up two-factor sign-in")
        </MudButton>
    </section>

    <section class="profile-section" id="tokens">
        <MudText Typo="Typo.subtitle1" HtmlTag="h2" Class="profile-section-title">Access tokens</MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">
            Use a personal access token instead of your password for Git over HTTP: enter your username and paste the
            token when git asks for a password. Tokens with an API scope also work for the
            <a href="/developers/api">REST API</a> (<code>Authorization: Bearer gbp_…</code>). Tokens are shown once; ByteBench stores only a hash.
        </MudText>
        <StatusMessage Success="@tokenSuccess" Errors="tokenErrors" />

        @if (newToken != null)
        {
            <MudAlert Severity="Severity.Success" Class="auth-alert" NoIcon="true">
                <div class="mb-2"><b>Copy your new token now.</b> You won't be able to see it again.</div>
                <div class="token-copy">
                    <input id="new-token" class="gb-input mono" readonly value="@newToken" onfocus="this.select()" aria-label="New token" />
                    @* A plain button: MudButton's OnClick parameter would claim the inline JS onclick (static SSR has no events). *@
                    <button type="button" class="mud-button-root mud-button mud-button-outlined mud-button-outlined-default mud-button-outlined-size-medium"
                            onclick="navigator.clipboard.writeText(document.getElementById('new-token').value); this.textContent='Copied';">Copy</button>
                </div>
            </MudAlert>
        }

        @if (TokenInput != null)
        {
        <EditForm Model="TokenInput" FormName="create-token" OnValidSubmit="CreateToken" method="post">
            <DataAnnotationsValidator />
            <div class="gb-field">
                <label class="gb-field-label" for="tk-name">Token name</label>
                <InputText id="tk-name" class="gb-input" @bind-Value="TokenInput!.Name" placeholder="e.g. Laptop git" />
                <ValidationMessage For="() => TokenInput!.Name" />
            </div>
            <div class="gb-field">
                <span class="gb-field-label">Scopes</span>
                <label class="gb-check">
                    <InputCheckbox @bind-Value="TokenInput!.ReadRepository" />
                    <span><code>read_repository</code>: clone and fetch</span>
                </label>
                <label class="gb-check">
                    <InputCheckbox @bind-Value="TokenInput!.WriteRepository" />
                    <span><code>write_repository</code>: push (also allows clone and fetch)</span>
                </label>
                <label class="gb-check">
                    <InputCheckbox @bind-Value="TokenInput!.ReadApi" />
                    <span><code>read_api</code>: read-only <a href="/developers/api">REST API</a> access (GET requests)</span>
                </label>
                <label class="gb-check">
                    <InputCheckbox @bind-Value="TokenInput!.WriteApi" />
                    <span><code>write_api</code>: full REST API access (also allows reads)</span>
                </label>
            </div>
            <div class="gb-field">
                <label class="gb-field-label" for="tk-exp">Expires</label>
                <InputSelect id="tk-exp" class="gb-input" @bind-Value="TokenInput!.ExpiresInDays">
                    @* Static SSR: browsers ignore <select value>, so mark the chosen option itself (else the first, 7 days, wins). *@
                    @foreach (var (days, text) in ExpiryChoices)
                    {
                        <option value="@days" selected="@(TokenInput!.ExpiresInDays == days)">@text</option>
                    }
                </InputSelect>
            </div>
            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" DropShadow="false"
                       StartIcon="@Icons.Material.Filled.Key">Create token</MudButton>
        </EditForm>
        }

        @if (tokens.Count > 0)
        {
            <form method="post" @formname="revoke-token" @onsubmit="RevokeToken" class="mt-6">
                <AntiforgeryToken />
                <div class="token-table">
                    <MudSimpleTable Dense="true" Outlined="true" Elevation="0">
                        <thead><tr><th>Name</th><th>Token</th><th>Scopes</th><th>Created</th><th>Expires</th><th>Last used</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var t in tokens)
                            {
                                var now = DateTime.UtcNow;
                                <tr class="@(t.IsActive(now) ? "" : "token-inactive")">
                                    <td>@t.Name</td>
                                    <td class="mono">@t.Prefix…</td>
                                    <td>@ScopeText(t.Scopes)</td>
                                    <td>@t.CreatedAt.ToLocalTime().ToString("d")</td>
                                    <td>@(t.ExpiresAt?.ToLocalTime().ToString("d") ?? "Never")</td>
                                    <td>@(t.LastUsedAt?.ToLocalTime().ToString("g") ?? "Never")</td>
                                    <td class="token-action">
                                        @if (t.RevokedAt != null) { <span>Revoked</span> }
                                        else if (!t.IsActive(now)) { <span>Expired</span> }
                                        else
                                        {
                                            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small"
                                                       name="RevokeTokenId" value="@t.Id">Revoke</MudButton>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                </div>
            </form>
        }
    </section>

    <section class="profile-section" id="ssh-keys">
        <MudText Typo="Typo.subtitle1" HtmlTag="h2" Class="profile-section-title">SSH keys</MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">
            Use git over SSH with a key instead of a password or token. Add the public key of each computer you push from.
        </MudText>
        <MudButton Href="account/ssh-keys" Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Outlined.VpnKey">Manage SSH keys</MudButton>
    </section>

    <form class="profile-signout" method="post" action="account/logout">
        <AntiforgeryToken />
        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Outlined.Logout">Sign out</MudButton>
    </form>
</div>

@code {
    private User? user;
    private string? profileSuccess, passwordSuccess;
    private readonly List<string> profileErrors = [], passwordErrors = [];

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "profile")]
    private ProfileModel? ProfileInput { get; set; }

    [SupplyParameterFromForm(FormName = "password")]
    private PasswordModel? PasswordInput { get; set; }

    [SupplyParameterFromForm(FormName = "create-token")]
    private TokenModel? TokenInput { get; set; }

    [SupplyParameterFromForm(FormName = "revoke-token")]
    private int? RevokeTokenId { get; set; }

    private List<PersonalAccessToken> tokens = [];

    // ----- Connected accounts (SSO) -----
    private bool hasPassword = true, isDirectoryUser;
    private List<ByteBench.Services.Sso.ConnectedAccount> connected = [];
    private string? linkToken, ssoSuccess;
    private readonly List<string> ssoErrors = [];

    [SupplyParameterFromForm(FormName = "unlink-sso")]
    private string? UnlinkProvider { get; set; }

    [SupplyParameterFromQuery(Name = "sso")] private string? SsoResult { get; set; }
    [SupplyParameterFromQuery(Name = "sso_error")] private string? SsoError { get; set; }
    [SupplyParameterFromQuery(Name = "provider")] private string? SsoProvider { get; set; }
    private string? newToken, tokenSuccess;
    private readonly List<string> tokenErrors = [];

    protected override async Task OnInitializedAsync()
    {
        user = await Users.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            // Cookie is valid but the account is gone: sign out and start over.
            await SignIn.SignOutAsync();
            Nav.NavigateTo("account/login", forceLoad: true);
            return;
        }

        ProfileInput ??= new() { DisplayName = user.DisplayName, Email = user.Email ?? "", Color = user.Color };
        PasswordInput ??= new();
        TokenInput ??= new() { ReadRepository = true };
        tokens = await Tokens.ListAsync(user.Id);
        await LoadConnectedAsync();
        if (HttpMethods.IsGet(HttpContext.Request.Method))
        {
            var title = Sso.Settings.Find(SsoProvider)?.Title ?? "the provider";
            if (SsoResult == "linked") ssoSuccess = $"{title} is now connected. You can sign in with it.";
            if (SsoError != null) ssoErrors.Add(ByteBench.Services.Sso.SsoErrors.Message(SsoError, title));
        }
    }

    private async Task LoadConnectedAsync()
    {
        hasPassword = await Users.HasPasswordAsync(user!);
        isDirectoryUser = await Ldap.IsDirectoryUserAsync(user!);
        connected = await Sso.ConnectedAsync(user!);
        linkToken = Sso.CreateLinkToken(user!.Id);
    }

    private async Task Unlink()
    {
        if (user is null || UnlinkProvider is not { } provider) return;
        var error = await Sso.UnlinkAsync(user.Id, provider);
        var title = Sso.Settings.Find(provider)?.Title ?? provider;
        if (error != null) ssoErrors.Add(ByteBench.Services.Sso.SsoErrors.Message(error, title));
        else ssoSuccess = $"{title} was disconnected.";
        await LoadConnectedAsync();
    }

    // ----- Personal access tokens -----

    private async Task CreateToken()
    {
        if (user is null || TokenInput is null) return;
        var scopes = (TokenInput.ReadRepository ? TokenScopes.ReadRepository : 0) | (TokenInput.WriteRepository ? TokenScopes.WriteRepository : 0)
                     | (TokenInput.ReadApi ? TokenScopes.ReadApi : 0) | (TokenInput.WriteApi ? TokenScopes.WriteApi : 0);
        DateTime? expires = TokenInput.ExpiresInDays > 0 ? DateTime.UtcNow.AddDays(TokenInput.ExpiresInDays) : null;
        try
        {
            (_, newToken) = await Tokens.CreateAsync(user.Id, TokenInput.Name, scopes, expires);
            tokenSuccess = $"Token '{TokenInput.Name.Trim()}' created.";
            TokenInput = new() { ReadRepository = true };
        }
        catch (InvalidOperationException ex) { tokenErrors.Add(ex.Message); }
        tokens = await Tokens.ListAsync(user.Id);
    }

    private async Task RevokeToken()
    {
        if (user is null || RevokeTokenId is not { } id) return;
        await Tokens.RevokeAsync(user.Id, id);
        tokenSuccess = "Token revoked. It can no longer be used.";
        tokens = await Tokens.ListAsync(user.Id);
    }

    private static readonly (int Days, string Text)[] ExpiryChoices =
        [(7, "In 7 days"), (30, "In 30 days"), (90, "In 90 days"), (365, "In a year"), (0, "Never")];

    private static string ScopeText(TokenScopes s) => string.Join(", ",
        new[] { (TokenScopes.ReadRepository, "read_repository"), (TokenScopes.WriteRepository, "write_repository"),
                (TokenScopes.ReadApi, "read_api"), (TokenScopes.WriteApi, "write_api") }
            .Where(x => s.HasFlag(x.Item1)).Select(x => x.Item2));

    private async Task SaveProfile()
    {
        if (user is null || ProfileInput is null) return;

        var newEmail = ProfileInput.Email.Trim();
        var emailChanged = newEmail != user.Email;
        if (emailChanged && await Users.FindByEmailAsync(newEmail) is { } other && other.Id != user.Id)
        {
            profileErrors.Add($"Email '{newEmail}' is already in use by another account.");
            return;
        }

        user.DisplayName = ProfileInput.DisplayName.Trim();
        if (AvatarPalette.Colors.Contains(ProfileInput.Color)) user.Color = ProfileInput.Color;

        // With Account:RequireEmailConfirmation a new address only takes effect once its owner opens the emailed link.
        var confirmChange = emailChanged && EmailConfirmation.Required;
        // SetEmailAsync validates and persists the whole user, display name and color included.
        var result = emailChanged && !confirmChange ? await Users.SetEmailAsync(user, newEmail) : await Users.UpdateAsync(user);
        if (!result.Succeeded)
        {
            profileErrors.AddRange(result.Errors.Select(e => e.Description));
            return;
        }

        await SignIn.RefreshSignInAsync(user);
        profileSuccess = "Your profile was saved.";
        if (confirmChange)
        {
            if (await EmailConfirmation.RequestChangeAsync(user, newEmail) is { } problem)
                profileErrors.Add(problem);
            else
                profileSuccess = $"Your profile was saved. We sent a confirmation link to {newEmail}; your email stays {user.Email} until you open it.";
            ProfileInput!.Email = user.Email ?? "";
        }
    }

    private async Task ChangePassword()
    {
        if (user is null || PasswordInput is null) return;

        var result = await Users.ChangePasswordAsync(user, PasswordInput.CurrentPassword, PasswordInput.NewPassword);
        PasswordInput = new(); // never echo passwords back
        if (!result.Succeeded)
        {
            passwordErrors.AddRange(result.Errors.Select(e => e.Description));
            return;
        }

        await Audit.RecordAsync("user.password_changed", "user", user.Id, actorId: user.Id);
        await SignIn.RefreshSignInAsync(user);
        passwordSuccess = "Your password was changed.";
    }

    private sealed class ProfileModel
    {
        [Required, StringLength(80, MinimumLength = 1)]
        [Display(Name = "Display name")]
        public string DisplayName { get; set; } = "";

        [Required, EmailAddress, StringLength(256)]
        public string Email { get; set; } = "";

        [Required, RegularExpression("^#[0-9a-fA-F]{6}$", ErrorMessage = "Pick a color.")]
        public string Color { get; set; } = "";
    }

    private sealed class TokenModel
    {
        [Required, StringLength(100, MinimumLength = 1)]
        [Display(Name = "Token name")]
        public string Name { get; set; } = "";
        // Defaults false: an unchecked box posts nothing, so a true default could never be cleared. The GET form pre-checks it.
        public bool ReadRepository { get; set; }
        public bool WriteRepository { get; set; }
        public bool ReadApi { get; set; }
        public bool WriteApi { get; set; }
        [Range(0, 365)] public int ExpiresInDays { get; set; } = 30;
    }

    private sealed class PasswordModel
    {
        [Required, DataType(DataType.Password)]
        [Display(Name = "Current password")]
        public string CurrentPassword { get; set; } = "";

        [Required, StringLength(100, MinimumLength = 8, ErrorMessage = "The new password must be at least 8 characters long.")]
        [DataType(DataType.Password)]
        [Display(Name = "New password")]
        public string NewPassword { get; set; } = "";

        [Required(ErrorMessage = "Confirm the new password.")]
        [DataType(DataType.Password)]
        [Compare(nameof(NewPassword), ErrorMessage = "The new passwords don't match.")]
        public string ConfirmPassword { get; set; } = "";
    }
}
