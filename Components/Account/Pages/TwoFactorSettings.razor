@page "/account/two-factor"
@attribute [Authorize]
@attribute [ExcludeFromInteractiveRouting]
@layout AccountLayout
@using QRCoder
@inject SignInManager<User> SignIn
@inject UserManager<User> Users
@inject NavigationManager Nav
@inject ByteBench.Services.Audit.AuditLog Audit

<PageTitle>Two-factor sign-in · ByteBench</PageTitle>

<div class="profile-page">
    <div class="profile-head">
        <a class="auth-back" href="account/profile"><MudIcon Icon="@Icons.Material.Filled.ArrowBack" Size="Size.Small" /> Back to your profile</a>
        <MudText Typo="Typo.h5" HtmlTag="h1" Class="auth-title">Two-factor sign-in</MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary">
            Protect your account with a 6-digit code from an authenticator app (Google Authenticator, Microsoft Authenticator,
            1Password, Authy, …) in addition to your password.
        </MudText>
    </div>

    <div class="mt-4">
        <StatusMessage Success="@success" Errors="errors" />
    </div>

    @if (recoveryCodes != null)
    {
        <section class="profile-section">
            <MudText Typo="Typo.subtitle1" HtmlTag="h2" Class="profile-section-title">Your recovery codes</MudText>
            <MudAlert Severity="Severity.Warning" Dense="true" Class="auth-alert">
                <b>Save these codes now.</b> They are shown only once. If you lose your device, each code signs you in once instead of an authenticator code.
            </MudAlert>
            <pre id="recovery-codes" class="mono recovery-codes">@string.Join("\n", recoveryCodes)</pre>
            @* A plain button: MudButton's OnClick parameter would claim the inline JS onclick (static SSR has no events).
               The handler string is allowed by hash in ProductionSetup.InlineHandlers; keep the two in sync. *@
            <button type="button" class="mud-button-root mud-button mud-button-outlined mud-button-outlined-default mud-button-outlined-size-small"
                    onclick="navigator.clipboard.writeText(document.getElementById('recovery-codes').textContent); this.textContent='Copied';">Copy codes</button>
        </section>
    }

    @if (user != null && !enabled)
    {
        <section class="profile-section">
            <MudText Typo="Typo.subtitle1" HtmlTag="h2" Class="profile-section-title">Set up your authenticator app</MudText>
            <ol class="tf-steps">
                <li>Scan this QR code with your authenticator app, or enter the key manually.</li>
                <li>Enter the 6-digit code the app shows to finish.</li>
            </ol>
            <div class="tf-setup">
                @if (qrSvg != null)
                {
                    <div class="totp-qr" role="img" aria-label="QR code for your authenticator app">@((MarkupString)qrSvg)</div>
                }
                <div class="tf-key">
                    <div class="gb-field-label">Manual entry key</div>
                    <code class="mono totp-key">@FormatKey(sharedKey)</code>
                    <MudText Typo="Typo.caption" HtmlTag="div" Class="mud-text-secondary">Account: @user.UserName · Type: time-based · 6 digits</MudText>
                </div>
            </div>

            <EditForm Model="EnableInput" FormName="enable-2fa" OnValidSubmit="Enable" method="post">
                <DataAnnotationsValidator />
                <div class="gb-field tf-code-field">
                    <label class="gb-field-label" for="tf-verify">Verification code</label>
                    <InputText id="tf-verify" class="gb-input mono" @bind-Value="EnableInput!.Code" autocomplete="one-time-code" inputmode="numeric" placeholder="123456" />
                    <ValidationMessage For="() => EnableInput!.Code" />
                </div>
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" DropShadow="false"
                           StartIcon="@Icons.Material.Outlined.Security">Turn on two-factor sign-in</MudButton>
            </EditForm>
        </section>
    }
    else if (user != null)
    {
        <section class="profile-section">
            <MudText Typo="Typo.subtitle1" HtmlTag="h2" Class="profile-section-title">Status</MudText>
            <div class="d-flex align-center gap-2 mb-2">
                <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Text" Class="ma-0">On</MudChip>
                <MudText Typo="Typo.body2">You sign in with your password and a code from your authenticator app.</MudText>
            </div>
            <MudText Typo="Typo.body2" Class="mud-text-secondary">
                Git over HTTP and the REST API need a <a href="account/profile#tokens">personal access token</a>; your password alone is refused for git.
            </MudText>
        </section>

        <section class="profile-section">
            <MudText Typo="Typo.subtitle1" HtmlTag="h2" Class="profile-section-title">Recovery codes</MudText>
            <MudText Typo="Typo.body2" Class="mb-3">You have <b>@codesLeft</b> unused recovery code@(codesLeft == 1 ? "" : "s"). Generating new codes makes the old ones stop working.</MudText>
            <form method="post" @formname="regenerate-codes" @onsubmit="Regenerate">
                <AntiforgeryToken />
                @* Plain button for the inline confirm(); its string is allowed by hash in ProductionSetup.InlineHandlers. *@
                <button type="submit" class="mud-button-root mud-button mud-button-outlined mud-button-outlined-default mud-button-outlined-size-medium"
                        onclick="return confirm('Generate new recovery codes? Your current codes will stop working.');">Generate new recovery codes</button>
            </form>
        </section>

        <section class="profile-section">
            <MudText Typo="Typo.subtitle1" HtmlTag="h2" Class="profile-section-title">Turn off two-factor sign-in</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">Your account will be protected by your password only. Your authenticator key and recovery codes will stop working.</MudText>
            <EditForm Model="DisableInput" FormName="disable-2fa" OnValidSubmit="Disable" method="post">
                <DataAnnotationsValidator />
                <div class="gb-field tf-password-field">
                    <label class="gb-field-label" for="tf-password">Confirm with your password</label>
                    <InputText id="tf-password" type="password" class="gb-input" @bind-Value="DisableInput!.Password" autocomplete="current-password" />
                    <ValidationMessage For="() => DisableInput!.Password" />
                </div>
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Outlined" Color="Color.Error">Turn off</MudButton>
            </EditForm>
        </section>
    }
</div>

@code {
    private const int RecoveryCodeCount = 10;

    private User? user;
    private bool enabled;
    private int codesLeft;
    private string sharedKey = "";
    private string? qrSvg, success;
    private string[]? recoveryCodes;
    private readonly List<string> errors = [];

    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "enable-2fa")] private EnableModel? EnableInput { get; set; }
    [SupplyParameterFromForm(FormName = "disable-2fa")] private DisableModel? DisableInput { get; set; }

    protected override async Task OnInitializedAsync()
    {
        EnableInput ??= new();
        DisableInput ??= new();
        user = await Users.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            await SignIn.SignOutAsync();
            Nav.NavigateTo("account/login", forceLoad: true);
            return;
        }
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        enabled = await Users.GetTwoFactorEnabledAsync(user!);
        if (enabled)
        {
            codesLeft = await Users.CountRecoveryCodesAsync(user!);
            return;
        }
        var key = await Users.GetAuthenticatorKeyAsync(user!);
        if (string.IsNullOrEmpty(key))
        {
            // First visit: create a key. That rotates the security stamp, so re-issue our own cookie to stay signed in.
            await Users.ResetAuthenticatorKeyAsync(user!);
            await SignIn.RefreshSignInAsync(user!);
            key = await Users.GetAuthenticatorKeyAsync(user!);
        }
        sharedKey = key ?? "";
        var label = Uri.EscapeDataString("ByteBench:" + (user!.UserName ?? ""));
        var uri = $"otpauth://totp/{label}?secret={sharedKey}&issuer=ByteBench&digits=6";
        using var generator = new QRCodeGenerator();
        using var data = generator.CreateQrCode(uri, QRCodeGenerator.ECCLevel.M);
        qrSvg = new SvgQRCode(data).GetGraphic(5);
    }

    private async Task Enable()
    {
        if (user is null) return;
        var code = EnableInput!.Code.Replace(" ", "").Replace("-", "");
        EnableInput = new();
        if (!await Users.VerifyTwoFactorTokenAsync(user, Users.Options.Tokens.AuthenticatorTokenProvider, code))
        {
            errors.Add("That code is invalid. Check that your device's clock is correct and enter the current code.");
            return;
        }
        await Users.SetTwoFactorEnabledAsync(user, true);
        recoveryCodes = (await Users.GenerateNewTwoFactorRecoveryCodesAsync(user, RecoveryCodeCount))?.ToArray();
        await SignIn.RefreshSignInAsync(user);
        await Audit.RecordAsync("user.2fa_enabled", "user", user.Id, actorId: user.Id);
        success = "Two-factor sign-in is on.";
        await LoadAsync();
    }

    private async Task Regenerate()
    {
        if (user is null || !await Users.GetTwoFactorEnabledAsync(user)) return;
        recoveryCodes = (await Users.GenerateNewTwoFactorRecoveryCodesAsync(user, RecoveryCodeCount))?.ToArray();
        await Audit.RecordAsync("user.2fa_recovery_codes_regenerated", "user", user.Id, actorId: user.Id);
        success = "New recovery codes were generated. The old ones no longer work.";
        await LoadAsync();
    }

    private async Task Disable()
    {
        if (user is null) return;
        var ok = await Users.CheckPasswordAsync(user, DisableInput!.Password);
        DisableInput = new(); // never echo passwords back
        if (!ok)
        {
            errors.Add("Incorrect password.");
            return;
        }
        await TwoFactor.ResetAsync(Users, user);
        await SignIn.RefreshSignInAsync(user);
        await SignIn.ForgetTwoFactorClientAsync();
        await Audit.RecordAsync("user.2fa_disabled", "user", user.Id, actorId: user.Id);
        success = "Two-factor sign-in is off.";
        await LoadAsync();
    }

    private static string FormatKey(string key) =>
        string.Join(" ", Enumerable.Range(0, (key.Length + 3) / 4).Select(i => key.Substring(i * 4, Math.Min(4, key.Length - i * 4)))).ToLowerInvariant();

    private sealed class EnableModel
    {
        [Required(ErrorMessage = "Enter the code from your authenticator app.")]
        [StringLength(7, MinimumLength = 6, ErrorMessage = "The code has 6 digits.")]
        public string Code { get; set; } = "";
    }

    private sealed class DisableModel
    {
        [Required(ErrorMessage = "Enter your password.")]
        [DataType(DataType.Password)]
        public string Password { get; set; } = "";
    }
}
