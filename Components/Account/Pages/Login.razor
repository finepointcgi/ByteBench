@page "/account/login"
@attribute [ExcludeFromInteractiveRouting]
@layout AccountLayout
@inject SignInManager<User> SignIn
@inject UserManager<User> Users
@inject NavigationManager Nav
@inject ILogger<Login> Log
@inject GitBench.Services.Audit.AuditLog Audit

<PageTitle>Sign in · GitBench</PageTitle>

<MudText Typo="Typo.h5" HtmlTag="h1" Class="auth-title">Sign in</MudText>
<MudText Typo="Typo.body2" Class="mud-text-secondary auth-sub">Welcome back. Sign in to continue to GitBench.</MudText>

@if (error != null)
{
    <MudAlert Severity="Severity.Error" Dense="true" Class="auth-alert" role="alert">@error</MudAlert>
}

<EditForm Model="Input" FormName="login" OnValidSubmit="LoginUser" method="post">
    <DataAnnotationsValidator />
    @* The form posts back to the current URL, so ?returnUrl= survives the post. *@

    <div class="gb-field">
        <label class="gb-field-label" for="login-user">Username or email</label>
        <InputText id="login-user" class="gb-input" @bind-Value="Input!.UserNameOrEmail"
                   autocomplete="username" autofocus />
        <ValidationMessage For="() => Input!.UserNameOrEmail" />
    </div>
    <div class="gb-field">
        <label class="gb-field-label" for="login-password">Password</label>
        <InputText id="login-password" type="password" class="gb-input" @bind-Value="Input!.Password"
                   autocomplete="current-password" />
        <ValidationMessage For="() => Input!.Password" />
    </div>
    <label class="gb-check gb-field" for="login-remember">
        <InputCheckbox id="login-remember" @bind-Value="Input!.RememberMe" />
        <span>Remember me</span>
    </label>
    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" DropShadow="false">Sign in</MudButton>
</EditForm>

<MudText Typo="Typo.body2" Class="mud-text-secondary auth-footer">
    New to GitBench? <a href="@RegisterHref">Create an account</a>
</MudText>

@code {
    private string? error;

    [SupplyParameterFromForm]
    private InputModel? Input { get; set; }

    protected override void OnInitialized() => Input ??= new();

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    private string RegisterHref => AccountUrls.IsLocal(ReturnUrl)
        ? $"account/register?returnUrl={Uri.EscapeDataString(ReturnUrl!)}"
        : "account/register";

    private async Task LoginUser()
    {
        var login = Input!.UserNameOrEmail.Trim();
        var userName = login;
        if (login.Contains('@'))
        {
            var byEmail = await Users.FindByEmailAsync(login);
            if (byEmail?.UserName != null) userName = byEmail.UserName;
        }

        var result = await SignIn.PasswordSignInAsync(userName, Input!.Password, Input!.RememberMe, lockoutOnFailure: true);
        await Audit.SignInAttemptAsync(userName, result);
        if (result.Succeeded)
        {
            Log.LogInformation("User {User} signed in.", userName);
            Nav.NavigateTo(AccountUrls.SafeReturnUrl(ReturnUrl), forceLoad: true);
        }
        else if (result.IsLockedOut)
        {
            Log.LogWarning("User {User} is locked out.", userName);
            error = "This account is locked after too many failed sign-in attempts. Try again in a few minutes.";
        }
        else if (result.IsNotAllowed)
        {
            error = "This account is not allowed to sign in.";
        }
        else
        {
            error = "Invalid username/email or password.";
        }
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "Enter your username or email.")]
        public string UserNameOrEmail { get; set; } = "";

        [Required(ErrorMessage = "Enter your password.")]
        [DataType(DataType.Password)]
        public string Password { get; set; } = "";

        public bool RememberMe { get; set; }
    }
}
