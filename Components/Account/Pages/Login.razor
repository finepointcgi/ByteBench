@page "/account/login"
@attribute [ExcludeFromInteractiveRouting]
@layout AccountLayout
@inject SignInManager<User> SignIn
@inject UserManager<User> Users
@inject NavigationManager Nav
@inject ILogger<Login> Log
@inject ByteBench.Services.Audit.AuditLog Audit
@inject ByteBench.Services.Sso.SsoSettings Sso
@inject ByteBench.Services.Sso.Ldap.LdapAuthService Ldap
@inject Microsoft.Extensions.Options.IOptionsMonitor<ByteBench.Services.Accounts.AccountOptions> AccountConfig
@inject ByteBench.Services.Accounts.RegistrationPolicy Registration

<PageTitle>Sign in · ByteBench</PageTitle>

<MudText Typo="Typo.h5" HtmlTag="h1" Class="auth-title">Sign in</MudText>
<MudText Typo="Typo.body2" Class="mud-text-secondary auth-sub">Welcome back. Sign in to continue to ByteBench.</MudText>

@if (!string.IsNullOrEmpty(Notice) && HttpMethods.IsGet(HttpContext.Request.Method))
{
    <MudAlert Severity="Severity.Success" Dense="true" Class="auth-alert" role="status">@NoticeText</MudAlert>
}
@if (unconfirmed)
{
    <MudAlert Severity="Severity.Warning" Dense="true" Class="auth-alert" role="alert">
        Confirm your email address before signing in. We sent a link when you registered. <a href="account/resend-confirmation">Send it again</a>.
    </MudAlert>
}
else if (error != null)
{
    <MudAlert Severity="Severity.Error" Dense="true" Class="auth-alert" role="alert">@error</MudAlert>
}

<EditForm Model="Input" FormName="login" OnValidSubmit="LoginUser" method="post">
    <DataAnnotationsValidator />
    @* The form posts back to the current URL, so ?returnUrl= survives the post. *@

    <div class="gb-field">
        <label class="gb-field-label" for="login-user">Username or email</label>
        <InputText id="login-user" class="gb-input" @bind-Value="Input!.UserNameOrEmail"
                   autocomplete="username" autofocus />
        @if (Ldap.Enabled)
        {
            <div class="gb-help">@Ldap.Options.DisplayName accounts: your directory username (or <code>ldap:</code><i>username</i>).</div>
        }
        <ValidationMessage For="() => Input!.UserNameOrEmail" />
    </div>
    <div class="gb-field">
        <label class="gb-field-label" for="login-password">Password</label>
        <InputText id="login-password" type="password" class="gb-input" @bind-Value="Input!.Password"
                   autocomplete="current-password" />
        <ValidationMessage For="() => Input!.Password" />
        <div class="gb-help"><a href="account/forgot-password">Forgot password?</a></div>
    </div>
    <label class="gb-check gb-field" for="login-remember">
        <InputCheckbox id="login-remember" @bind-Value="Input!.RememberMe" />
        <span>Remember me</span>
    </label>
    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" DropShadow="false">Sign in</MudButton>
</EditForm>

@if (Sso.Providers.Count > 0)
{
    @* Plain links (GET), not form posts: the redirect to the provider then doesn't depend on the CSP's form-action. *@
    <div class="sso-divider" role="separator"><span>or</span></div>
    <div class="sso-buttons">
        @foreach (var p in Sso.Providers)
        {
            <SsoProviderButton Provider="p" Href="@SsoHref(p)" Text="@($"Sign in with {p.Title}")" />
        }
    </div>
}

@if (registrationOpen)
{
    <MudText Typo="Typo.body2" Class="mud-text-secondary auth-footer">
        New to ByteBench? <a href="@RegisterHref">Create an account</a>
    </MudText>
}

@code {
    private string? error;
    private bool unconfirmed, registrationOpen = true;

    /// <summary>Set by the reset and confirmation pages: <c>reset</c>, <c>confirmed</c>, <c>changed</c>.</summary>
    [SupplyParameterFromQuery(Name = "notice")]
    private string? Notice { get; set; }

    private string NoticeText => Notice switch
    {
        "reset" => "Your password was changed. Sign in with the new one.",
        "confirmed" => "Your email address is confirmed. You can sign in now.",
        _ => "",
    };

    [SupplyParameterFromForm]
    private InputModel? Input { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Input ??= new();
        registrationOpen = (await Registration.GetStateAsync()).IsOpen;
        if (SsoError != null && HttpMethods.IsGet(HttpContext.Request.Method))
            error = ByteBench.Services.Sso.SsoErrors.Message(SsoError, Sso.Find(SsoProvider)?.Title ?? "the identity provider");
    }

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    /// <summary>Set by /account/sso/* when a single sign-on was refused (see SsoErrors).</summary>
    [SupplyParameterFromQuery(Name = "sso_error")]
    private string? SsoError { get; set; }

    [SupplyParameterFromQuery(Name = "provider")]
    private string? SsoProvider { get; set; }

    private string SsoHref(ByteBench.Services.Sso.SsoProviderOptions p) =>
        $"account/sso/{p.Name}" + (AccountUrls.IsLocal(ReturnUrl) ? $"?returnUrl={Uri.EscapeDataString(ReturnUrl!)}" : "");

    private string RegisterHref => AccountUrls.IsLocal(ReturnUrl)
        ? $"account/register?returnUrl={Uri.EscapeDataString(ReturnUrl!)}"
        : "account/register";

    private async Task LoginUser()
    {
        var login = Input!.UserNameOrEmail.Trim();
        // LDAP for directory accounts, logins no local account has, and "ldap:" logins (Authentication:Ldap).
        var (useLdap, ldapLogin) = await Ldap.ShouldTryAsync(login);
        if (useLdap)
        {
            await LdapLogin(ldapLogin);
            return;
        }
        var userName = login;
        if (login.Contains('@'))
        {
            var byEmail = await Users.FindByEmailAsync(login);
            if (byEmail?.UserName != null) userName = byEmail.UserName;
        }

        var result = await SignIn.PasswordSignInAsync(userName, Input!.Password, Input!.RememberMe, lockoutOnFailure: true);
        await Audit.SignInAttemptAsync(userName, result);
        await Finish(userName, result);
    }

    private async Task LdapLogin(string login)
    {
        var r = await Ldap.AuthenticateAsync(login, Input!.Password);
        switch (r.Status)
        {
            case ByteBench.Services.Sso.Ldap.LdapLoginStatus.Success:
                // Through Identity's external-login sign-in, so lockout and ByteBench two-factor sign-in apply as usual.
                var result = await SignIn.ExternalLoginSignInAsync(ByteBench.Services.Sso.Ldap.LdapAuthService.LoginProvider, r.Key!, Input!.RememberMe, bypassTwoFactor: false);
                if (result.Succeeded) await Audit.RecordAsync("auth.sign_in", "user", r.User!.Id, details: new { method = "ldap" }, actorId: r.User.Id);
                else if (!result.RequiresTwoFactor) await Audit.SignInAttemptAsync(r.User!.UserName!, result);
                await Finish(r.User!.UserName!, result);
                break;
            case ByteBench.Services.Sso.Ldap.LdapLoginStatus.Locked:
                error = "This account is locked or deactivated.";
                break;
            case ByteBench.Services.Sso.Ldap.LdapLoginStatus.Conflict:
                error = "A ByteBench account with this username or email already exists, so the directory account can't sign in to it. Ask a site admin.";
                break;
            case ByteBench.Services.Sso.Ldap.LdapLoginStatus.RegistrationClosed:
                error = "New accounts can't be created on this server right now: registration is closed, or limited to certain email domains. Ask a site admin.";
                break;
            case ByteBench.Services.Sso.Ldap.LdapLoginStatus.NoAccount:
                error = "Your directory account doesn't have a ByteBench account. Ask a site admin.";
                break;
            case ByteBench.Services.Sso.Ldap.LdapLoginStatus.Unavailable:
                error = "The directory server can't be reached right now. Try again later.";
                break;
            default:
                error = "Invalid username/email or password.";
                break;
        }
    }

    private async Task Finish(string userName, SignInResult result)
    {
        if (result.Succeeded)
        {
            Log.LogInformation("User {User} signed in.", userName);
            Nav.NavigateTo(AccountUrls.SafeReturnUrl(ReturnUrl), forceLoad: true);
        }
        else if (result.RequiresTwoFactor)
        {
            // Password OK; Identity set the two-factor cookie. Ask for the authenticator (or recovery) code next.
            Nav.NavigateTo($"account/login-2fa?rememberMe={Input!.RememberMe}&returnUrl={Uri.EscapeDataString(AccountUrls.SafeReturnUrl(ReturnUrl))}", forceLoad: true);
        }
        else if (result.IsLockedOut)
        {
            Log.LogWarning("User {User} is locked out.", userName);
            error = "This account is locked after too many failed sign-in attempts. Try again in a few minutes.";
        }
        else if (result.IsNotAllowed)
        {
            // Only reached after the password was right (ByteBenchSignInManager), so this doesn't reveal accounts to strangers.
            var u = AccountConfig.CurrentValue.RequireEmailConfirmation ? await Users.FindByNameAsync(userName) : null;
            if (u is { EmailConfirmed: false }) unconfirmed = true;
            else error = "This account is not allowed to sign in.";
        }
        else
        {
            error = "Invalid username/email or password.";
        }
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "Enter your username or email.")]
        public string UserNameOrEmail { get; set; } = "";

        [Required(ErrorMessage = "Enter your password.")]
        [DataType(DataType.Password)]
        public string Password { get; set; } = "";

        public bool RememberMe { get; set; }
    }
}
