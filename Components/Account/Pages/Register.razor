@page "/account/register"
@attribute [ExcludeFromInteractiveRouting]
@layout AccountLayout
@inject SignInManager<User> SignIn
@inject UserManager<User> Users
@inject NavigationManager Nav
@inject ILogger<Register> Log
@inject GitBench.Services.Audit.AuditLog Audit

<PageTitle>Create account · GitBench</PageTitle>

<h1 class="auth-title">Create your account</h1>
<p class="muted auth-sub">Track issues, plan sprints and ship with your team.</p>

@if (errors.Count > 0)
{
    <div class="alert alert-danger auth-alert" role="alert">
        <ul class="mb-0 ps-3">
            @foreach (var e in errors)
            {
                <li>@e</li>
            }
        </ul>
    </div>
}

<EditForm Model="Input" FormName="register" OnValidSubmit="RegisterUser" method="post">
    <DataAnnotationsValidator />

    <div class="mb-3">
        <label class="form-label" for="reg-user">Username</label>
        <InputText id="reg-user" class="form-control" @bind-Value="Input!.UserName" autocomplete="username" autofocus />
        <ValidationMessage For="() => Input!.UserName" class="text-danger small" />
    </div>
    <div class="mb-3">
        <label class="form-label" for="reg-name">Display name</label>
        <InputText id="reg-name" class="form-control" @bind-Value="Input!.DisplayName" autocomplete="name" placeholder="Jane Doe" />
        <ValidationMessage For="() => Input!.DisplayName" class="text-danger small" />
    </div>
    <div class="mb-3">
        <label class="form-label" for="reg-email">Email</label>
        <InputText id="reg-email" type="email" class="form-control" @bind-Value="Input!.Email" autocomplete="email" />
        <ValidationMessage For="() => Input!.Email" class="text-danger small" />
    </div>
    <div class="mb-3">
        <label class="form-label" for="reg-password">Password</label>
        <InputText id="reg-password" type="password" class="form-control" @bind-Value="Input!.Password" autocomplete="new-password" />
        <div class="form-text">At least 8 characters, with upper- and lowercase letters and a digit.</div>
        <ValidationMessage For="() => Input!.Password" class="text-danger small" />
    </div>
    <div class="mb-3">
        <label class="form-label" for="reg-confirm">Confirm password</label>
        <InputText id="reg-confirm" type="password" class="form-control" @bind-Value="Input!.ConfirmPassword" autocomplete="new-password" />
        <ValidationMessage For="() => Input!.ConfirmPassword" class="text-danger small" />
    </div>
    <button type="submit" class="btn btn-primary w-100">Create account</button>
</EditForm>

<p class="auth-footer muted">
    Already have an account? <a href="@LoginHref">Sign in</a>
</p>

@code {
    private readonly List<string> errors = [];

    [SupplyParameterFromForm]
    private InputModel? Input { get; set; }

    protected override void OnInitialized() => Input ??= new();

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    private string LoginHref => AccountUrls.IsLocal(ReturnUrl)
        ? $"account/login?returnUrl={Uri.EscapeDataString(ReturnUrl!)}"
        : "account/login";

    private async Task RegisterUser()
    {
        var user = new User
        {
            UserName = Input!.UserName.Trim(),
            Email = Input!.Email.Trim(),
            DisplayName = Input!.DisplayName.Trim(),
            Color = AvatarPalette.Random(),
        };

        var result = await Users.CreateAsync(user, Input!.Password);
        if (!result.Succeeded)
        {
            errors.AddRange(result.Errors.Select(e => e.Description));
            return;
        }

        Log.LogInformation("Created account {User}.", user.UserName);
        await Audit.RecordAsync("auth.registered", "user", user.Id, details: new { user.UserName }, actorId: user.Id);
        await SignIn.SignInAsync(user, isPersistent: false);
        Nav.NavigateTo(AccountUrls.SafeReturnUrl(ReturnUrl), forceLoad: true);
    }

    private sealed class InputModel
    {
        [Required, StringLength(40, MinimumLength = 2)]
        [RegularExpression(@"^[A-Za-z0-9._-]+$", ErrorMessage = "Use letters, digits, '.', '_' or '-' only.")]
        [Display(Name = "Username")]
        public string UserName { get; set; } = "";

        [Required, StringLength(80, MinimumLength = 1)]
        [Display(Name = "Display name")]
        public string DisplayName { get; set; } = "";

        [Required, EmailAddress, StringLength(256)]
        public string Email { get; set; } = "";

        [Required, StringLength(100, MinimumLength = 8, ErrorMessage = "The password must be at least 8 characters long.")]
        [DataType(DataType.Password)]
        public string Password { get; set; } = "";

        [Required(ErrorMessage = "Confirm your password.")]
        [DataType(DataType.Password)]
        [Compare(nameof(Password), ErrorMessage = "The passwords don't match.")]
        [Display(Name = "Confirm password")]
        public string ConfirmPassword { get; set; } = "";
    }
}
