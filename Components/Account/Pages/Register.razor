@page "/account/register"
@attribute [ExcludeFromInteractiveRouting]
@layout AccountLayout
@inject SignInManager<User> SignIn
@inject UserManager<User> Users
@inject NavigationManager Nav
@inject ILogger<Register> Log
@inject ByteBench.Services.Audit.AuditLog Audit
@inject ByteBench.Services.Accounts.RegistrationPolicy Registration
@inject ByteBench.Services.Accounts.EmailConfirmationService Confirmation
@inject ByteBench.Services.Accounts.AccountEmails AccountMail

<PageTitle>Create account · ByteBench</PageTitle>

<MudText Typo="Typo.h5" HtmlTag="h1" Class="auth-title">Create your account</MudText>

@if (checkEmail)
{
    <MudAlert Severity="Severity.Success" Dense="true" Class="auth-alert mt-3" role="status">
        Almost there. We sent a confirmation link to the address you entered. Open it, then sign in.
        @if (!AccountMail.IsEnabled)
        {
            <span> Email delivery is switched off on this server, so ask a site admin to confirm your address.</span>
        }
    </MudAlert>
}
else if (closedMessage != null)
{
    <MudAlert Severity="Severity.Info" Dense="true" Class="auth-alert mt-3" role="status">@closedMessage</MudAlert>
}
else
{
<MudText Typo="Typo.body2" Class="mud-text-secondary auth-sub">Track issues, plan sprints and ship with your team.</MudText>

<StatusMessage Errors="errors" />

<EditForm Model="Input" FormName="register" OnValidSubmit="RegisterUser" method="post">
    <DataAnnotationsValidator />

    <div class="gb-field">
        <label class="gb-field-label" for="reg-user">Username</label>
        <InputText id="reg-user" class="gb-input" @bind-Value="Input!.UserName" autocomplete="username" autofocus />
        <ValidationMessage For="() => Input!.UserName" />
    </div>
    <div class="gb-field">
        <label class="gb-field-label" for="reg-name">Display name</label>
        <InputText id="reg-name" class="gb-input" @bind-Value="Input!.DisplayName" autocomplete="name" placeholder="Jane Doe" />
        <ValidationMessage For="() => Input!.DisplayName" />
    </div>
    <div class="gb-field">
        <label class="gb-field-label" for="reg-email">Email</label>
        <InputText id="reg-email" type="email" class="gb-input" @bind-Value="Input!.Email" autocomplete="email" />
        <ValidationMessage For="() => Input!.Email" />
    </div>
    <div class="gb-field">
        <label class="gb-field-label" for="reg-password">Password</label>
        <InputText id="reg-password" type="password" class="gb-input" @bind-Value="Input!.Password" autocomplete="new-password" />
        <div class="gb-help">At least 8 characters, with upper- and lowercase letters and a digit.</div>
        <ValidationMessage For="() => Input!.Password" />
    </div>
    <div class="gb-field">
        <label class="gb-field-label" for="reg-confirm">Confirm password</label>
        <InputText id="reg-confirm" type="password" class="gb-input" @bind-Value="Input!.ConfirmPassword" autocomplete="new-password" />
        <ValidationMessage For="() => Input!.ConfirmPassword" />
    </div>
    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" DropShadow="false">Create account</MudButton>
</EditForm>
}

<MudText Typo="Typo.body2" Class="mud-text-secondary auth-footer">
    Already have an account? <a href="@LoginHref">Sign in</a>
</MudText>

@code {
    private readonly List<string> errors = [];

    [SupplyParameterFromForm]
    private InputModel? Input { get; set; }

    private string? closedMessage;
    private bool checkEmail;

    [SupplyParameterFromQuery]
    private string? Invite { get; set; }

    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        Input ??= new();
        if (HttpMethods.IsGet(HttpContext.Request.Method)) closedMessage = await Registration.CheckPageAsync(Invite);
    }

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    private string LoginHref => AccountUrls.IsLocal(ReturnUrl)
        ? $"account/login?returnUrl={Uri.EscapeDataString(ReturnUrl!)}"
        : "account/login";

    private async Task RegisterUser()
    {
        var email = Input!.Email.Trim();
        // The rules are checked again on the POST: the page may be stale, and an invitation can be tied to one address.
        if (await Registration.CheckRegistrationAsync(email, Invite) is { } refused)
        {
            errors.Add(refused);
            return;
        }
        var invite = string.IsNullOrEmpty(Invite) ? null : await Registration.FindActiveInviteAsync(Invite, email);
        // An invitation is single-use: claim it before creating the account, give it back if that fails.
        if (invite != null && !await Registration.TryConsumeInviteAsync(invite.Id))
        {
            errors.Add("This invitation was just used. Ask a site admin for a new one.");
            return;
        }
        var consumed = invite != null;
        var needsConfirmation = Confirmation.Required;

        var user = new User
        {
            UserName = Input!.UserName.Trim(),
            Email = email,
            DisplayName = Input!.DisplayName.Trim(),
            Color = AvatarPalette.Random(),
            // An invitation was sent to this address by an admin, but that doesn't prove the mailbox: confirm when required.
        };

        var result = await Users.CreateAsync(user, Input!.Password);
        if (!result.Succeeded)
        {
            if (consumed) await Registration.FinishInviteAsync(invite!.Id, null);
            errors.AddRange(result.Errors.Select(e => e.Description));
            return;
        }
        if (consumed) await Registration.FinishInviteAsync(invite!.Id, user.Id);

        Log.LogInformation("Created account {User}.", user.UserName);
        await Audit.RecordAsync("auth.registered", "user", user.Id, details: new { user.UserName, invited = consumed }, actorId: user.Id);
        if (needsConfirmation)
        {
            await Confirmation.SendAsync(user);
            checkEmail = true;
            return;
        }
        await SignIn.SignInAsync(user, isPersistent: false);
        Nav.NavigateTo(AccountUrls.SafeReturnUrl(ReturnUrl), forceLoad: true);
    }

    private sealed class InputModel
    {
        [Required, StringLength(40, MinimumLength = 2)]
        [RegularExpression(@"^[A-Za-z0-9._-]+$", ErrorMessage = "Use letters, digits, '.', '_' or '-' only.")]
        [Display(Name = "Username")]
        public string UserName { get; set; } = "";

        [Required, StringLength(80, MinimumLength = 1)]
        [Display(Name = "Display name")]
        public string DisplayName { get; set; } = "";

        [Required, EmailAddress, StringLength(256)]
        public string Email { get; set; } = "";

        [Required, StringLength(100, MinimumLength = 8, ErrorMessage = "The password must be at least 8 characters long.")]
        [DataType(DataType.Password)]
        public string Password { get; set; } = "";

        [Required(ErrorMessage = "Confirm your password.")]
        [DataType(DataType.Password)]
        [Compare(nameof(Password), ErrorMessage = "The passwords don't match.")]
        [Display(Name = "Confirm password")]
        public string ConfirmPassword { get; set; } = "";
    }
}
