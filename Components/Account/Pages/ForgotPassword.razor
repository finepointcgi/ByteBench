@page "/account/forgot-password"
@attribute [ExcludeFromInteractiveRouting]
@layout AccountLayout
@inject ByteBench.Services.Accounts.PasswordResetService Reset
@inject Microsoft.Extensions.Options.IOptionsMonitor<ByteBench.Services.Accounts.AccountOptions> AccountConfig

<PageTitle>Forgot password · ByteBench</PageTitle>

<MudText Typo="Typo.h5" HtmlTag="h1" Class="auth-title">Forgot your password?</MudText>
<MudText Typo="Typo.body2" Class="mud-text-secondary auth-sub">Enter the email address of your account and we'll send you a link to choose a new password.</MudText>

@if (done)
{
    @* The same answer whether or not the address belongs to an account. *@
    <MudAlert Severity="Severity.Success" Dense="true" Class="auth-alert" role="status">
        If that email address belongs to an account, a reset link is on its way. It works once and expires in @Describe(AccountConfig.CurrentValue.PasswordResetMinutes).
        Check your spam folder if it doesn't arrive.
    </MudAlert>
}
else
{
    @if (throttled)
    {
        <MudAlert Severity="Severity.Warning" Dense="true" Class="auth-alert" role="alert">Too many requests from your network. Try again in a few minutes.</MudAlert>
    }
    <EditForm Model="Input" FormName="forgot-password" OnValidSubmit="Submit" method="post">
        <DataAnnotationsValidator />
        <div class="gb-field">
            <label class="gb-field-label" for="fp-email">Email</label>
            <InputText id="fp-email" type="email" class="gb-input" @bind-Value="Input!.Email" autocomplete="email" autofocus />
            <ValidationMessage For="() => Input!.Email" />
        </div>
        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" DropShadow="false">Send reset link</MudButton>
    </EditForm>
}

<MudText Typo="Typo.body2" Class="mud-text-secondary auth-footer"><a href="account/login">Back to sign in</a></MudText>

@code {
    private bool done, throttled;

    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private InputModel? Input { get; set; }

    protected override void OnInitialized() => Input ??= new();

    private async Task Submit()
    {
        var ok = await Reset.RequestAsync(Input!.Email, HttpContext.Connection.RemoteIpAddress?.ToString());
        done = ok;
        throttled = !ok;
    }

    private static string Describe(int minutes) => minutes == 60 ? "1 hour" : minutes > 60 && minutes % 60 == 0 ? $"{minutes / 60} hours" : $"{minutes} minutes";

    private sealed class InputModel
    {
        [Required(ErrorMessage = "Enter your email address."), EmailAddress(ErrorMessage = "Enter a valid email address."), StringLength(256)]
        public string Email { get; set; } = "";
    }
}
