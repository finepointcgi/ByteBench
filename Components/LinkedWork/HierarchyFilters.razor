@* Issue list filters: issues under an epic, and hide sub-tasks. Edits the page's IssueFilter, then calls OnChanged. *@
@inject LinkedWorkService LinkedWork

<MudSelect T="int?" Value="Filter.EpicId" ValueChanged="SetEpic" Label="Epic" Clearable="true" Dense="true"
           Variant="Variant.Outlined" Margin="Margin.Dense" ToStringFunc="EpicName" aria-label="Epic" Class="lw-filter-epic">
    @foreach (var e in epics) { <MudSelectItem T="int?" Value="e.Epic.Id">⚡ @e.Epic.Key @Trim(e.Epic.Title)</MudSelectItem> }
</MudSelect>
<MudCheckBox T="bool" Value="Filter.HideSubtasks" ValueChanged="SetHide" Dense="true" Size="Size.Small" Label="Hide sub-tasks" Class="lw-filter-hide" />

@code {
    [Parameter, EditorRequired] public Project Project { get; set; } = null!;
    [Parameter, EditorRequired] public IssueFilter Filter { get; set; } = null!;
    [Parameter] public EventCallback OnChanged { get; set; }

    private List<EpicSummary> epics = [];
    private int loadedFor;

    protected override async Task OnParametersSetAsync()
    {
        if (loadedFor == Project.Id) return;
        loadedFor = Project.Id;
        epics = await LinkedWork.GetEpicsAsync(Project.Id);
    }

    private static string Trim(string s) => s.Length > 40 ? s[..39] + "…" : s;

    private string EpicName(int? id) => id is { } v && epics.FirstOrDefault(e => e.Epic.Id == v) is { } e ? $"⚡ {e.Epic.Key} {Trim(e.Epic.Title)}" : "";

    private async Task SetEpic(int? id)
    {
        Filter.EpicId = id;
        await OnChanged.InvokeAsync();
    }

    private async Task SetHide(bool hide)
    {
        Filter.HideSubtasks = hide;
        await OnChanged.InvokeAsync();
    }
}
