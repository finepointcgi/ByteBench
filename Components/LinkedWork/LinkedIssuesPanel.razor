@* Issue detail: links to other issues (any project the user can view), grouped by relationship, with add and remove. *@
@inject LinkedWorkService LinkedWork
@inject IssueService Issues
@inject ProjectAccess Access
@inject CurrentUser Me
@inject LiveEvents Live
@implements IDisposable

@if (canEdit || links.Count > 0)
{
    <MudPaper Outlined="true" Class="px-4 py-3 mb-3">
        <div class="lw-panel">
            <div class="lw-panel-head">
                <MudText Typo="Typo.subtitle1" Class="lw-panel-title">Linked issues</MudText>
                @if (OpenBlockers.Any())
                {
                    <span class="lw-blocked" title="Blocked by @string.Join(", ", OpenBlockers.Select(b => b.Other.Key))">
                        <MudIcon Icon="@Icons.Material.Filled.Block" Class="lw-blocked-icon" /> Blocked
                    </span>
                }
            </div>
            @foreach (var group in links.GroupBy(l => l.Relation))
            {
                <div class="lw-group">@LinkedWorkService.Phrase(group.Key)</div>
                <ul class="lw-list">
                    @foreach (var l in group)
                    {
                        <li @key="l.LinkId" class="@(l.Other.Status == IssueStatus.Done ? "lw-done-row" : "")">
                            <span title="@l.Other.Type">@l.Other.Type.Icon()</span>
                            <a class="mono lw-key" href="@l.Other.Url">@l.Other.Key</a>
                            <a class="lw-item-title" href="@l.Other.Url">@l.Other.Title</a>
                            <Avatar User="l.Other.Assignee" Size="20" />
                            <StatusBadge Status="l.Other.Status" />
                            @if (canEdit)
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" Color="Color.Error" title="Remove link"
                                               aria-label="@($"Remove link to {l.Other.Key}")" Class="lw-remove" OnClick="() => Remove(l)" />
                            }
                        </li>
                    }
                </ul>
            }
            @if (links.Count == 0)
            {
                <div class="lw-muted mt-1 mb-2">No linked issues.</div>
            }
            @if (offerClose != null)
            {
                <MudAlert Severity="Severity.Success" Dense="true" Class="mb-2" ContentAlignment="HorizontalAlignment.Left">
                    <div class="lw-offer">
                        <span>@Issue.Key duplicates <b>@offerClose</b>. Close it?</span>
                        <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Success" OnClick="CloseAsDuplicate">Close as duplicate</MudButton>
                        <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="() => offerClose = null">Not now</MudButton>
                    </div>
                </MudAlert>
            }
            @if (canEdit)
            {
                <div class="lw-add">
                    <MudSelect T="IssueLinkRelation" @bind-Value="relation" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Class="lw-type"
                               ToStringFunc="@(r => LinkedWorkService.Phrase(r))" aria-label="Link type">
                        @foreach (var r in Enum.GetValues<IssueLinkRelation>()) { <MudSelectItem Value="r">@LinkedWorkService.Phrase(r)</MudSelectItem> }
                    </MudSelect>
                    <IssuePicker ExcludeIds="exclude" Placeholder="Link an issue: key or title, any project…" OnSelected="Add" />
                </div>
            }
            @if (error != null) { <MudAlert Severity="Severity.Error" Dense="true" Class="mt-2">@error</MudAlert> }
        </div>
    </MudPaper>
}

@code {
    [Parameter, EditorRequired] public Issue Issue { get; set; } = null!;

    private List<IssueLinkView> links = [];
    private int[] exclude = [];
    private bool canEdit;
    private string? error, offerClose;
    private IssueLinkRelation relation = IssueLinkRelation.RelatesTo;
    private (int, DateTime) loadedFor;
    private IDisposable? liveSubscription;

    private IEnumerable<IssueLinkView> OpenBlockers => links.Where(l => l.Relation == IssueLinkRelation.IsBlockedBy && l.Other.Status != IssueStatus.Done);

    protected override async Task OnParametersSetAsync()
    {
        var key = (Issue.Id, Issue.UpdatedAt);
        if (key == loadedFor) return;
        if (key.Item1 != loadedFor.Item1) offerClose = null;
        loadedFor = key;
        canEdit = (await Access.GetPermissionsAsync(Issue.ProjectId)).Can(Permission.EditIssues);
        await Load();
        if (Issue.Status == IssueStatus.Done) offerClose = null;
    }

    private async Task Load()
    {
        links = await LinkedWork.GetLinksAsync(Issue.Id);
        exclude = [Issue.Id];
    }

    // A linked issue changed (e.g. its status): refresh.
    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender) liveSubscription = Live.Subscribe<IssueChanged>(e => links.Any(l => l.Other.Id == e.IssueId)
            ? InvokeAsync(async () => { await Load(); StateHasChanged(); })
            : Task.CompletedTask);
    }

    public void Dispose() => liveSubscription?.Dispose();

    private async Task Add(IssueRef other)
    {
        error = null;
        try
        {
            await LinkedWork.AddLinkAsync(Issue.Id, other.Id, relation, Me.Id);
            if (relation == IssueLinkRelation.Duplicates && Issue.Status != IssueStatus.Done) offerClose = other.Key;
            await Load();
        }
        catch (InvalidOperationException ex) { error = ex.Message; }
    }

    private async Task Remove(IssueLinkView l)
    {
        error = null;
        try
        {
            await LinkedWork.RemoveLinkAsync(l.LinkId, Issue.Id, Me.Id);
            await Load();
        }
        catch (InvalidOperationException ex) { error = ex.Message; }
    }

    private async Task CloseAsDuplicate()
    {
        error = null;
        offerClose = null;
        try { await Issues.SetStatusAsync(Issue.Id, IssueStatus.Done, Me.Id); }
        catch (InvalidOperationException ex) { error = ex.Message; }
    }
}
