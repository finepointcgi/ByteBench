@* Search-as-you-type issue picker: type a key (WEB-12), a number or title words, then pick with the mouse or ↑ ↓ Enter. *@
@inject LinkedWorkService LinkedWork

<div class="lw-picker">
    <MudAutocomplete @ref="autocomplete" T="IssueRef" Value="selected" ValueChanged="Pick" SearchFunc="Search" ToStringFunc="@(r => r == null ? null : $"{r.Key} {r.Title}")"
                     Placeholder="@Placeholder" Disabled="Disabled" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true"
                     DebounceInterval="150" MaxItems="null" Strict="false" CoerceText="false" SelectValueOnTab="false"
                     AdornmentIcon="@Icons.Material.Filled.Search" Adornment="Adornment.Start" IconSize="Size.Small"
                     RelativeWidth="DropdownWidth.Adaptive" autocomplete="off">
        <ItemTemplate Context="r">
            <div class="lw-picker-item">
                <span title="@r.Type">@r.Type.Icon()</span>
                <span class="mono lw-picker-key">@r.Key</span>
                <span class="lw-picker-title @(r.Status == IssueStatus.Done ? "lw-done" : "")">@r.Title</span>
                <StatusBadge Status="r.Status" />
            </div>
        </ItemTemplate>
        <NoItemsTemplate>
            <div class="lw-picker-empty">No matching issues</div>
        </NoItemsTemplate>
    </MudAutocomplete>
</div>

@code {
    /// <summary>Only issues of this project (null: every project the user can view).</summary>
    [Parameter] public int? ProjectId { get; set; }
    [Parameter] public IReadOnlyCollection<int> ExcludeIds { get; set; } = [];
    [Parameter] public IReadOnlyCollection<IssueType>? Types { get; set; }
    [Parameter] public string Placeholder { get; set; } = "Search by key or title…";
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback<IssueRef> OnSelected { get; set; }

    private MudAutocomplete<IssueRef>? autocomplete;
    private IssueRef? selected;

    private async Task<IEnumerable<IssueRef>> Search(string? term, CancellationToken ct) =>
        await LinkedWork.SearchAsync(term, ProjectId, ExcludeIds, Types);

    private async Task Pick(IssueRef? r)
    {
        if (r == null) return;
        // Clear the box for the next pick; the choice is handed to the parent.
        selected = null;
        if (autocomplete != null) await autocomplete.ClearAsync();
        await OnSelected.InvokeAsync(r);
    }
}
