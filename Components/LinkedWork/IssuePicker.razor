@* Search-as-you-type issue picker: type a key (WEB-12), a number or title words, then pick with the mouse or ↑ ↓ Enter. *@
@inject LinkedWorkService LinkedWork

<div class="lw-picker">
    <input class="form-control form-control-sm" placeholder="@Placeholder" autocomplete="off" disabled="@Disabled"
           @bind="term" @bind:event="oninput" @bind:after="Search"
           @onkeydown="Key" @onfocus="Focus" @onblur="Blur" />
    @if (open && (results.Count > 0 || !string.IsNullOrWhiteSpace(term)))
    {
        <div class="lw-picker-menu">
            @if (results.Count == 0)
            {
                <div class="lw-picker-empty">No matching issues</div>
            }
            @for (var n = 0; n < results.Count; n++)
            {
                var r = results[n];
                var idx = n;
                <button type="button" class="lw-picker-item @(idx == active ? "active" : "")" @onmousedown="() => Pick(r)" @onmousedown:preventDefault>
                    <span title="@r.Type">@r.Type.Icon()</span>
                    <span class="mono small">@r.Key</span>
                    <span class="lw-picker-title @(r.Status == IssueStatus.Done ? "lw-done" : "")">@r.Title</span>
                    <StatusBadge Status="r.Status" />
                </button>
            }
        </div>
    }
</div>

@code {
    /// <summary>Only issues of this project (null: every project the user can view).</summary>
    [Parameter] public int? ProjectId { get; set; }
    [Parameter] public IReadOnlyCollection<int> ExcludeIds { get; set; } = [];
    [Parameter] public IReadOnlyCollection<IssueType>? Types { get; set; }
    [Parameter] public string Placeholder { get; set; } = "Search by key or title…";
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback<IssueRef> OnSelected { get; set; }

    private string? term;
    private List<IssueRef> results = [];
    private bool open;
    private int active;
    private int searchVersion;

    private async Task Search()
    {
        var version = ++searchVersion;
        var found = await LinkedWork.SearchAsync(term, ProjectId, ExcludeIds, Types);
        if (version != searchVersion) return; // a newer keystroke already searched
        results = found;
        active = 0;
        open = true;
    }

    private async Task Focus()
    {
        open = true;
        if (results.Count == 0) await Search();
    }

    private void Blur() => open = false;

    private async Task Key(KeyboardEventArgs e)
    {
        switch (e.Key)
        {
            case "ArrowDown": active = Math.Min(active + 1, results.Count - 1); open = true; break;
            case "ArrowUp": active = Math.Max(active - 1, 0); break;
            case "Escape": open = false; break;
            case "Enter" when open && active >= 0 && active < results.Count: await Pick(results[active]); break;
        }
    }

    private async Task Pick(IssueRef r)
    {
        open = false;
        term = null;
        results = [];
        await OnSelected.InvokeAsync(r);
    }
}
