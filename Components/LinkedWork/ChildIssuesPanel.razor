@* Issue detail: an epic's child issues or a story/task's sub-tasks, with progress, inline create, add existing and remove. *@
@inject LinkedWorkService LinkedWork
@inject ProjectAccess Access
@inject CurrentUser Me
@inject LiveEvents Live
@inject IDialogService Dialogs
@implements IDisposable

@if (Issue.Type != IssueType.Subtask && (canEdit || children.Count > 0))
{
    <MudPaper Outlined="true" Class="px-4 py-3 mb-3">
        <div class="lw-panel">
            <div class="lw-panel-head">
                <MudText Typo="Typo.subtitle1" Class="lw-panel-title">@(IsEpic ? "Child issues" : "Sub-tasks")</MudText>
                @if (hierarchy.Total > 0)
                {
                    <span class="lw-muted">@hierarchy.Done/@hierarchy.Total done@(hierarchy.Points > 0 ? $" · {hierarchy.DonePoints}/{hierarchy.Points} pts" : "")</span>
                    <span class="lw-percent">@hierarchy.Percent%</span>
                }
            </div>
            @if (hierarchy.Total > 0)
            {
                <MudProgressLinear Value="hierarchy.Percent" Color="Color.Success" Rounded="true" Size="Size.Small" Class="my-2"
                                   title="@($"{hierarchy.Done} of {hierarchy.Total} done")" />
            }
            <ul class="lw-list">
                @foreach (var c in children)
                {
                    <li @key="c.Id" class="@(c.Status == IssueStatus.Done ? "lw-done-row" : "")">
                        <span title="@c.Type">@c.Type.Icon()</span>
                        <a class="mono lw-key" href="@c.Url">@c.Key</a>
                        <a class="lw-item-title" href="@c.Url">@c.Title</a>
                        @if (c.StoryPoints is { } sp) { <span class="lw-points" title="Story points">@sp</span> }
                        <Avatar User="c.Assignee" Size="20" />
                        <StatusBadge Status="c.Status" />
                        @if (canEdit)
                        {
                            var label = c.Type == IssueType.Subtask ? "Remove sub-task (it becomes a task)" : "Remove from epic";
                            <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" Color="Color.Error" title="@label" aria-label="@label"
                                           Class="lw-remove" OnClick="() => Remove(c)" />
                        }
                    </li>
                }
                @if (children.Count == 0)
                {
                    <li class="lw-muted">@(IsEpic ? "No child issues yet." : "No sub-tasks yet.")</li>
                }
            </ul>
            @if (canEdit)
            {
                <div class="lw-add">
                    @if (IsEpic)
                    {
                        <MudSelect T="IssueType" @bind-Value="newType" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Class="lw-type"
                                   ToStringFunc="@(t => $"{t.Icon()} {t}")" aria-label="Child issue type">
                            @foreach (var t in HierarchyRules.AllowedChildTypes(IssueType.Epic)) { <MudSelectItem Value="t">@t.Icon() @t</MudSelectItem> }
                        </MudSelect>
                    }
                    <MudTextField T="string" @bind-Value="newTitle" Immediate="true" Placeholder="@(IsEpic ? "New child issue title" : "New sub-task title")"
                                  MaxLength="200" Variant="Variant.Outlined" Margin="Margin.Dense" OnKeyDown="CreateKey" Class="lw-grow" />
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Disabled="@string.IsNullOrWhiteSpace(newTitle)" OnClick="Create"
                               StartIcon="@Icons.Material.Filled.Add" Class="lw-nowrap">
                        @(IsEpic ? "Create" : "Create sub-task")
                    </MudButton>
                </div>
                <div class="lw-add">
                    <IssuePicker ProjectId="Issue.ProjectId" Types="HierarchyRules.AllowedChildTypes(Issue.Type)" ExcludeIds="exclude"
                                 Placeholder="@(IsEpic ? "Add existing issue to epic…" : "Move an existing sub-task here…")" OnSelected="AddExisting" />
                </div>
            }
            @if (error != null) { <MudAlert Severity="Severity.Error" Dense="true" Class="mt-2">@error</MudAlert> }
        </div>
    </MudPaper>
}

@code {
    [Parameter, EditorRequired] public Issue Issue { get; set; } = null!;

    private IssueHierarchy hierarchy = new([], []);
    private IReadOnlyList<IssueRef> children = [];
    private int[] exclude = [];
    private bool canEdit;
    private string? newTitle, error;
    private IssueType newType = IssueType.Story;
    private (int, IssueType, DateTime) loadedFor;
    private IDisposable? liveSubscription;

    private bool IsEpic => Issue.Type == IssueType.Epic;

    protected override async Task OnParametersSetAsync()
    {
        var key = (Issue.Id, Issue.Type, Issue.UpdatedAt);
        if (key == loadedFor) return;
        loadedFor = key;
        canEdit = (await Access.GetPermissionsAsync(Issue.ProjectId)).Can(Permission.EditIssues);
        await Load();
    }

    private async Task Load()
    {
        hierarchy = await LinkedWork.GetHierarchyAsync(Issue.Id);
        children = hierarchy.Children;
        exclude = [Issue.Id, .. hierarchy.Ancestors.Select(a => a.Id), .. children.Select(c => c.Id)];
    }

    // A child's status or title changed elsewhere: refresh the list and progress.
    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender) liveSubscription = Live.Subscribe<IssueChanged>(e => children.Any(c => c.Id == e.IssueId)
            ? InvokeAsync(async () => { await Load(); StateHasChanged(); })
            : Task.CompletedTask);
    }

    public void Dispose() => liveSubscription?.Dispose();

    private async Task Run(Func<Task> action)
    {
        error = null;
        try { await action(); await Load(); }
        catch (InvalidOperationException ex) { error = ex.Message; }
    }

    private async Task CreateKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await Create();
    }

    private async Task Create()
    {
        if (string.IsNullOrWhiteSpace(newTitle)) return;
        var title = newTitle;
        await Run(async () =>
        {
            await LinkedWork.CreateChildAsync(Issue.Id, title, IsEpic ? newType : IssueType.Subtask, Me.Id);
            newTitle = null;
        });
    }

    private Task AddExisting(IssueRef r) => Run(() => LinkedWork.SetParentAsync(r.Id, Issue.Id, Me.Id));

    private async Task Remove(IssueRef c)
    {
        if (c.Type == IssueType.Subtask &&
            await Dialogs.ShowMessageBoxAsync("Remove sub-task", $"Remove {c.Key} from {Issue.Key}? A sub-task can't stand alone, so it will become a Task.",
                yesText: "Remove", cancelText: "Cancel") != true) return;
        await Run(() => LinkedWork.DetachChildAsync(c.Id, Me.Id));
    }
}
