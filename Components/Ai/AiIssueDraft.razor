@using GitBench.Services.Ai
@implements IDisposable
@inject IssueAiService Ai
@inject CurrentUser Me

@* "Draft with AI" box for the new-issue form. Fills the form; never creates anything. *@
@if (!Ai.IsConfigured)
{
    <div class="ai-hint">
        <MudIcon Icon="@Icons.Material.Outlined.AutoAwesome" Size="Size.Small" />
        <span>AI features need <code>ANTHROPIC_API_KEY</code> (or <code>Ai:ApiKey</code>) to be set.</span>
    </div>
}
else
{
    <div class="ai-draft">
        <button type="button" class="ai-draft-head" @onclick="() => open = !open" aria-expanded="@(open ? "true" : "false")">
            <MudIcon Icon="@Icons.Material.Outlined.AutoAwesome" Size="Size.Small" />
            <span class="ai-draft-title">Draft with AI</span>
            <span class="ai-draft-sub">Describe it in a sentence or paste an error log — Claude fills in the form for you to review.</span>
            <MudIcon Icon="@(open ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)" Class="ml-auto" />
        </button>
        @if (open)
        {
            <div class="ai-draft-body">
                <MudTextField T="string" @bind-Value="rough" Immediate="true" Lines="3" Sizing="InputSizing.Auto" MaxLength="12000" OnKeyDown="Key"
                              Placeholder="e.g. checkout button does nothing on Safari after applying a coupon" Disabled="busy"
                              Variant="Variant.Outlined" Margin="Margin.Dense" aria-label="Describe the issue" />
                <div class="ai-draft-actions">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" Disabled="@(busy || string.IsNullOrWhiteSpace(rough))" OnClick="Draft"
                               StartIcon="@(busy ? null : Icons.Material.Outlined.AutoAwesome)">
                        @if (busy) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" Style="width:14px;height:14px" /><span>Drafting…</span> }
                        else { <span>Draft issue</span> }
                    </MudButton>
                    <span class="ai-muted">Ctrl+Enter</span>
                    @if (error != null) { <MudText Typo="Typo.caption" Color="Color.Error">@error</MudText> }
                    @if (applied) { <MudText Typo="Typo.caption" Color="Color.Success">Form filled. Review and edit before creating.</MudText> }
                </div>
                @if (dropped.Count > 0)
                {
                    <div class="ai-muted mt-1">Ignored labels that don't exist in this project: @string.Join(", ", dropped)</div>
                }
            </div>
        }
    </div>
}

@code {
    [Parameter, EditorRequired] public Project Project { get; set; } = null!;
    /// <summary>The form's issue object; its fields are overwritten with the draft.</summary>
    [Parameter, EditorRequired] public Issue Issue { get; set; } = null!;
    /// <summary>The form's selected label ids; replaced with the draft's labels.</summary>
    [Parameter, EditorRequired] public HashSet<int> LabelIds { get; set; } = null!;
    /// <summary>Raised after the form fields were filled so the page re-renders.</summary>
    [Parameter] public EventCallback OnApplied { get; set; }

    private bool open = true, busy, applied;
    private string? rough, error;
    private List<string> dropped = [];
    private CancellationTokenSource? cts;

    private async Task Key(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && (e.CtrlKey || e.MetaKey) && !busy && !string.IsNullOrWhiteSpace(rough)) await Draft();
    }

    private async Task Draft()
    {
        busy = true; error = null; applied = false; dropped = [];
        cts?.Cancel();
        cts = new CancellationTokenSource();
        try
        {
            var result = await Ai.DraftIssueAsync(Project, rough!, Me.User?.Id, cts.Token);
            if (!result.Ok) { error = result.Error; return; }
            var d = result.Value!;
            Issue.Title = d.Title;
            Issue.Description = d.Description;
            Issue.Type = d.Type;
            Issue.Priority = d.Priority;
            if (d.StoryPoints != null) Issue.StoryPoints = d.StoryPoints;
            LabelIds.Clear();
            LabelIds.UnionWith(d.LabelIds);
            dropped = d.DroppedLabels;
            applied = true;
            await OnApplied.InvokeAsync();
        }
        catch (OperationCanceledException) { }
        finally { busy = false; }
    }

    public void Dispose() { cts?.Cancel(); cts?.Dispose(); }
}
