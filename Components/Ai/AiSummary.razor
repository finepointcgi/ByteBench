@using ByteBench.Services.Ai
@implements IDisposable
@inject IssueAiService Ai
@inject CurrentUser Me

@* "Catch me up": streams a short AI summary of the issue's description, comments and activity. *@
@if (Ai.IsConfigured)
{
    <div class="ai-summary">
        <div class="ai-summary-head">
            @if (streaming)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Primary" Style="width:16px;height:16px" /><b>Summarising…</b>
                <MudButton Variant="Variant.Text" Size="Size.Small" Class="ml-auto ai-text-btn" OnClick="Stop" StartIcon="@Icons.Material.Filled.Stop">Stop</MudButton>
            }
            else if (summary == null)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Outlined.AutoAwesome" OnClick="Generate">Catch me up</MudButton>
                <span class="ai-muted">AI summary of the description, comments and activity.</span>
            }
            else
            {
                <MudIcon Icon="@Icons.Material.Outlined.AutoAwesome" Size="Size.Small" />
                <b>Catch me up</b>
                <span class="ai-tag">AI-generated</span>
                <span class="ai-muted" title="@generatedAt?.ToLocalTime().ToString("F")">@(generatedAt is { } g ? Display.Ago(g) : "")</span>
                @if (stale) { <span class="ai-muted">· issue updated since</span> }
                <span class="ml-auto d-flex gap-1">
                    @if (stale || note != null) { <MudButton Variant="Variant.Text" Size="Size.Small" Class="ai-text-btn" OnClick="Generate">Refresh</MudButton> }
                    <MudButton Variant="Variant.Text" Size="Size.Small" Class="ai-text-btn" OnClick="Hide">Hide</MudButton>
                </span>
            }
        </div>
        @if (streaming)
        {
            @* Plain text while streaming (Blazor escapes it); Markdown is rendered once complete. *@
            <div class="ai-summary-body ai-stream">@text</div>
        }
        else if (summary != null)
        {
            <div class="ai-summary-body markdown">@Display.Markdown(summary)</div>
        }
        @if (note != null) { <div class="ai-summary-note">@note</div> }
    </div>
}

@code {
    [Parameter, EditorRequired] public Issue Issue { get; set; } = null!;

    private int issueId;
    private bool streaming, stale;
    private string text = "";
    private string? summary, note;
    private DateTime? generatedAt, summaryFor;
    private CancellationTokenSource? cts;

    protected override void OnParametersSet()
    {
        if (Issue.Id != issueId)
        {
            cts?.Cancel();
            issueId = Issue.Id;
            streaming = false; summary = null; note = null; text = "";
            if (Ai.IsConfigured && Ai.GetCachedSummary(Issue) is { } c) Show(c);
        }
        stale = summary != null && summaryFor != Issue.UpdatedAt;
    }

    private void Show(IssueAiService.CachedSummary c)
    {
        summary = c.Markdown; generatedAt = c.GeneratedAt; summaryFor = c.IssueUpdatedAt; stale = false;
    }

    private async Task Generate()
    {
        if (Ai.GetCachedSummary(Issue) is { } cached) { Show(cached); note = null; return; }

        cts?.Cancel();
        cts = new CancellationTokenSource();
        var ct = cts.Token;
        streaming = true; text = ""; note = null;
        var last = DateTime.UtcNow;
        try
        {
            await foreach (var ev in Ai.StreamSummaryAsync(Issue, Me.User?.Id, ct))
            {
                if (ev.Done) { note = ev.Text; break; }
                text += ev.Text;
                if ((DateTime.UtcNow - last).TotalMilliseconds > 50)
                {
                    last = DateTime.UtcNow;
                    StateHasChanged();
                    await Task.Yield();
                }
            }
            if (note == null && Ai.GetCachedSummary(Issue) is { } c) Show(c);
            else if (text.Length > 0) { summary = text; generatedAt = DateTime.UtcNow; summaryFor = Issue.UpdatedAt; }
        }
        catch (OperationCanceledException) { if (text.Length > 0) { summary = text; generatedAt = DateTime.UtcNow; summaryFor = null; note = "Stopped before it finished."; } }
        finally { streaming = false; }
    }

    private void Stop() => cts?.Cancel();

    private void Hide() { summary = null; note = null; }

    public void Dispose() { cts?.Cancel(); cts?.Dispose(); }
}
