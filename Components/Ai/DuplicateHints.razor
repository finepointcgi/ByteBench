@using ByteBench.Services.Ai
@implements IDisposable
@inject IssueAiService Ai
@inject CurrentUser Me

@* Checks for likely duplicates whenever Title changes (the title input commits on blur, or a draft fills it). *@
@if (Ai.IsConfigured && (checking || hints.Count > 0 || error != null))
{
    <div class="dup-panel">
        @if (checking)
        {
            <div class="dup-muted"><MudProgressCircular Size="Size.Small" Indeterminate="true" Style="width:14px;height:14px" Class="mr-2" />Checking for possible duplicates…</div>
        }
        else if (error != null)
        {
            <div class="dup-muted">Duplicate check unavailable: @error</div>
        }
        else
        {
            <div class="dup-head">
                <MudIcon Icon="@Icons.Material.Outlined.ContentCopy" Size="Size.Small" Color="Color.Warning" />
                <b>Possible duplicates</b>
                <span class="ai-tag">AI-generated</span>
                <MudButton Variant="Variant.Text" Size="Size.Small" Class="ml-auto dup-dismiss" OnClick="() => hints = []">Dismiss</MudButton>
            </div>
            <ul class="dup-list">
                @foreach (var h in hints)
                {
                    <li>
                        <a href="/p/@Project.Key/issues/@h.Number" target="_blank" rel="noopener">
                            <span class="mono">@h.Key</span> @h.Title
                        </a>
                        @if (h.Closed) { <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Text" Class="my-0 mr-0 ml-1" Style="height:20px">Closed</MudChip> }
                        <div class="dup-muted">@h.Reason</div>
                    </li>
                }
            </ul>
        }
    </div>
}

@code {
    [Parameter, EditorRequired] public Project Project { get; set; } = null!;
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Description { get; set; }

    private string? lastTitle;
    private bool checking;
    private string? error;
    private List<DuplicateHint> hints = [];
    private CancellationTokenSource? cts;

    protected override void OnParametersSet()
    {
        var title = Title?.Trim();
        if (title == lastTitle) return;
        lastTitle = title;
        cts?.Cancel();
        hints = []; error = null; checking = false;
        if (!Ai.IsConfigured || IssueAiLogic.WordCount(title) < 4) return;
        cts = new CancellationTokenSource();
        _ = CheckAsync(title!, Description, cts.Token);
    }

    private async Task CheckAsync(string title, string? description, CancellationToken ct)
    {
        checking = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            var result = await Ai.FindDuplicatesAsync(Project, title, description, Me.User?.Id, ct);
            if (ct.IsCancellationRequested) return;
            if (result.Ok) hints = result.Value!; else error = result.Error;
        }
        catch (OperationCanceledException) { return; }
        catch (Exception) { if (!ct.IsCancellationRequested) error = "the request failed."; }
        if (ct.IsCancellationRequested) return;
        checking = false;
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose() { cts?.Cancel(); cts?.Dispose(); }
}
