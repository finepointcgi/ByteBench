@using ByteBench.Services.Ai
@implements IDisposable
@inject IssueAiService Ai
@inject CurrentUser Me
@inject IJSRuntime JS
@inject ISnackbar Snackbar

@* "Generate release notes" for one milestone, shown in a dialog with a copyable Markdown box. *@
@if (Ai.IsConfigured)
{
    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Outlined.AutoAwesome" OnClick="Open"
               title="Generate release notes from this milestone's closed issues" Class="rn-btn">Release notes</MudButton>
    <MudDialog Visible="open" VisibleChanged="VisibleChanged" Options="dialogOptions" AriaLabel="@($"Release notes for {Milestone.Title}")">
        <TitleContent>
            <div class="rn-head">
                <MudIcon Icon="@Icons.Material.Outlined.AutoAwesome" Color="Color.Primary" />
                <MudText Typo="Typo.h6">Release notes · @Milestone.Title</MudText>
                @if (generatedAt is { } g) { <span class="rn-tag">AI-generated</span><span class="rn-muted">@g.ToLocalTime().ToString("g")</span> }
            </div>
        </TitleContent>
        <DialogContent>
            @if (busy)
            {
                <div class="rn-muted"><MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" Style="width:16px;height:16px" />Writing release notes from closed issues…</div>
            }
            else if (error != null)
            {
                <MudAlert Severity="Severity.Error" Dense="true">@error</MudAlert>
            }
            else if (notes != null)
            {
                <MudTabs Elevation="0" ActivePanelIndex="@(raw ? 1 : 0)" ActivePanelIndexChanged="i => raw = i == 1" MinimumTabWidth="90px"
                         TabPanelsClass="pt-3" Class="rn-tabs">
                    <MudTabPanel Text="Preview">
                        <div class="markdown rn-preview">@Display.Markdown(notes)</div>
                    </MudTabPanel>
                    <MudTabPanel Text="Markdown">
                        <textarea class="mono rn-raw" readonly rows="16" data-select-on-focus aria-label="Release notes Markdown">@notes</textarea>
                    </MudTabPanel>
                </MudTabs>
            }
        </DialogContent>
        <DialogActions>
            <MudButton Variant="Variant.Text" Disabled="busy" OnClick="Generate">Regenerate</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(busy || notes == null)" OnClick="Copy" StartIcon="@Icons.Material.Outlined.ContentCopy">Copy Markdown</MudButton>
            <MudButton Variant="Variant.Text" OnClick="Close">Close</MudButton>
        </DialogActions>
    </MudDialog>
}

@code {
    [Parameter, EditorRequired] public Project Project { get; set; } = null!;
    [Parameter, EditorRequired] public Milestone Milestone { get; set; } = null!;

    private static readonly DialogOptions dialogOptions = new() { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true, CloseOnEscapeKey = true };

    private bool open, busy, raw;
    private string? notes, error;
    private DateTime? generatedAt;
    private CancellationTokenSource? cts;

    private async Task Open()
    {
        open = true;
        if (notes == null && !busy) await Generate();
    }

    private void Close() { open = false; cts?.Cancel(); }

    private void VisibleChanged(bool visible)
    {
        if (!visible) Close();
    }

    private async Task Generate()
    {
        busy = true; error = null;
        cts?.Cancel();
        cts = new CancellationTokenSource();
        try
        {
            var result = await Ai.ReleaseNotesAsync(Project, Milestone, Me.User?.Id, cts.Token);
            if (result.Ok) { notes = result.Value; generatedAt = DateTime.UtcNow; }
            else error = result.Error;
        }
        catch (OperationCanceledException) { }
        finally { busy = false; }
    }

    private async Task Copy()
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", notes);
            Snackbar.Add("Copied to clipboard.", Severity.Success);
        }
        catch (JSException) { raw = true; error = null; } // clipboard blocked: show the raw box to copy by hand
    }

    public void Dispose() { cts?.Cancel(); cts?.Dispose(); }
}
