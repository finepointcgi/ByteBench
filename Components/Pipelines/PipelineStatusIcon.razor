@* Pipeline/job/step status: check passed, cross failed or error, clock queued, spinner running, block canceled, dash skipped, play manual. *@
@if (Href != null)
{
    <a class="ci-icon ci-@Css" href="@Href" title="@Tooltip" aria-label="@Tooltip">@Glyph@if (ShowLabel) {<span class="ci-label">@Label</span>}</a>
}
else
{
    <span class="ci-icon ci-@Css" title="@Tooltip">@Glyph@if (ShowLabel) {<span class="ci-label">@Label</span>}</span>
}

@code {
    [Parameter] public PipelineStatus Status { get; set; }
    [Parameter] public string? Href { get; set; }
    /// <summary>Prefix for the tooltip, e.g. "Pipeline #12".</summary>
    [Parameter] public string? Title { get; set; }
    [Parameter] public bool ShowLabel { get; set; }

    private string Css => Status.ToString().ToLowerInvariant();
    private string Label => Status.ToString();
    private string Tooltip => Title != null ? $"{Title}: {Label.ToLowerInvariant()}" : Label;

    private RenderFragment Glyph => Status switch
    {
        PipelineStatus.Running => @<span class="ci-glyph"><span class="ci-spinner"></span></span>,
        _ => @<span class="ci-glyph"><MudIcon Icon="@IconFor(Status)" Style="font-size: 16px" /></span>,
    };

    private static string IconFor(PipelineStatus s) => s switch
    {
        PipelineStatus.Passed => Icons.Material.Filled.CheckCircle,
        PipelineStatus.Failed or PipelineStatus.Error => Icons.Material.Filled.Cancel,
        PipelineStatus.Canceled => Icons.Material.Outlined.Block,
        PipelineStatus.Skipped => Icons.Material.Outlined.RemoveCircleOutline,
        PipelineStatus.Manual => Icons.Material.Outlined.PlayCircleOutline,
        _ => Icons.Material.Outlined.Schedule,
    };
}
