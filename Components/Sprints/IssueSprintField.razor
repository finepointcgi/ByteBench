@* Sprint picker for the issue detail sidebar. Changing it records a sprint activity; the page reloads via IssueChanged. *@
@implements IDisposable
@inject SprintService Sprints
@inject ProjectAccess Access
@inject LiveEvents Live

<div class="sprint-field">
    @* 0 stands for "Backlog (no sprint)". Keyed so a failed move shows the issue's real sprint again. *@
    <MudSelect T="int" @key="(Issue.SprintId, attempts)" Value="@(Issue.SprintId ?? 0)" ValueChanged="Change" Label="Sprint" Disabled="@(!canEdit)"
               Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" ToStringFunc="SprintName" InputId="@($"issue-sprint-{Issue.Id}")">
        <MudSelectItem Value="0">Backlog (no sprint)</MudSelectItem>
        @foreach (var s in sprints.Where(s => s.State != SprintState.Completed || s.Id == Issue.SprintId))
        {
            <MudSelectItem Value="s.Id">@SprintName(s.Id)</MudSelectItem>
        }
    </MudSelect>
    @if (Issue.SprintId != null)
    {
        <a class="sprint-link" href="/p/@Issue.Project?.Key/backlog#sprint-@Issue.SprintId">View in backlog</a>
    }
    @if (error != null) { <MudText Typo="Typo.caption" Color="Color.Error" Class="d-block mt-1">@error</MudText> }
</div>

@code {
    [Parameter, EditorRequired] public Issue Issue { get; set; } = null!;

    private List<Sprint> sprints = [];
    private bool canEdit;
    private int loadedFor, attempts;
    private string? error;
    private IDisposable? sub;

    private string SprintName(int id) => id == 0 ? "Backlog (no sprint)"
        : sprints.FirstOrDefault(s => s.Id == id) is { } s ? s.Name + (s.State == SprintState.Planned ? "" : $" ({s.State.ToString().ToLowerInvariant()})") : "";

    protected override async Task OnParametersSetAsync()
    {
        if (loadedFor == Issue.ProjectId) return;
        loadedFor = Issue.ProjectId;
        canEdit = (await Access.GetPermissionsAsync(Issue.ProjectId)).Can(Permission.EditIssues);
        sprints = await Sprints.GetSprintsAsync(Issue.ProjectId);
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender) sub = Live.Subscribe<SprintChanged>(e => e.ProjectId != Issue.ProjectId ? Task.CompletedTask : InvokeAsync(async () =>
        {
            sprints = await Sprints.GetSprintsAsync(Issue.ProjectId);
            StateHasChanged();
        }));
    }

    private async Task Change(int value)
    {
        error = null;
        int? id = value == 0 ? null : value;
        try { await Sprints.MoveIssueAsync(Issue.Id, id, null, reorder: false); }
        catch (InvalidOperationException ex) { error = ex.Message; attempts++; }
    }

    public void Dispose() => sub?.Dispose();
}
