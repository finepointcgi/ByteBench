@* Issue list filter by sprint (sets IssueFilter.SprintId: null = any, 0 = no sprint). *@
@inject SprintService Sprints

<MudSelect T="int?" Value="Filter.SprintId" ValueChanged="Change" Label="Sprint" Clearable="true" Dense="true"
           Variant="Variant.Outlined" Margin="Margin.Dense" ToStringFunc="SprintName" aria-label="Sprint">
    <MudSelectItem T="int?" Value="0">No sprint (backlog)</MudSelectItem>
    @foreach (var s in sprints)
    {
        <MudSelectItem T="int?" Value="s.Id">@SprintName(s.Id)</MudSelectItem>
    }
</MudSelect>

@code {
    [Parameter, EditorRequired] public int ProjectId { get; set; }
    [Parameter, EditorRequired] public IssueFilter Filter { get; set; } = null!;
    [Parameter] public EventCallback OnChanged { get; set; }

    private List<Sprint> sprints = [];
    private int loadedFor;

    private string SprintName(int? id) => id switch
    {
        null => "",
        0 => "No sprint (backlog)",
        _ => sprints.FirstOrDefault(s => s.Id == id) is { } s
            ? s.Name + (s.State == SprintState.Active ? " (active)" : s.State == SprintState.Completed ? " (completed)" : "") : $"#{id}",
    };

    protected override async Task OnParametersSetAsync()
    {
        if (loadedFor == ProjectId) return;
        loadedFor = ProjectId;
        sprints = await Sprints.GetSprintsAsync(ProjectId);
    }

    private async Task Change(int? id)
    {
        Filter.SprintId = id;
        await OnChanged.InvokeAsync();
    }
}
