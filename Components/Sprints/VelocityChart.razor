@* Velocity as inline SVG: committed vs completed per completed sprint, with the average completed as a dashed line. *@
@using static GitBench.Components.Sprints.ChartScale

<figure class="chart" aria-label="@($"Velocity: committed and completed {Unit} per sprint")">
    <div class="chart-legend" aria-hidden="true">
        <span><i class="sw sw-committed"></i>Committed</span>
        <span><i class="sw sw-completed"></i>Completed</span>
        <span><i class="sw sw-average"></i>Average completed (@F(avg))</span>
    </div>
    <svg viewBox="0 0 @W @H" class="chart-svg" role="img">
        <title>Velocity in @Unit over the last @Data.Count completed sprints</title>
        @for (var v = 0.0; v <= yMax + 0.001; v += yStep)
        {
            var y = Y(v);
            <g>
                <line x1="@L" x2="@(W - R)" y1="@F(y)" y2="@F(y)" class="chart-grid" />
                <text x="@(L - 8)" y="@F(y + 4)" text-anchor="end" class="chart-tick">@F(v)</text>
            </g>
        }
        <text x="12" y="@F(T + PlotH / 2)" class="chart-axis-label" text-anchor="middle" transform="rotate(-90 12 @F(T + PlotH / 2))">@(CountMode ? "Issues" : "Story points")</text>
        <line x1="@L" x2="@(W - R)" y1="@F(Y(0))" y2="@F(Y(0))" class="chart-axis" />
        @for (var k = 0; k < Data.Count; k++)
        {
            var e = Data[k];
            var cx = L + groupW * (k + 0.5);
            var (c, d) = Values(e);
            <g>
                <title>@($"{e.Sprint.Name}\nCommitted: {c} {Unit}\nCompleted: {d} {Unit} ({Pct(c, d)})")</title>
                <rect x="@F(cx - groupW / 2)" y="@T" width="@F(groupW)" height="@PlotH" class="chart-hit" />
                <path d="@Bar(cx - barW - 1, c)" class="chart-bar-committed" />
                <path d="@Bar(cx + 1, d)" class="chart-bar-completed" />
                <text x="@F(cx - barW / 2 - 1)" y="@F(Y(c) - 5)" text-anchor="middle" class="chart-value">@c</text>
                <text x="@F(cx + barW / 2 + 1)" y="@F(Y(d) - 5)" text-anchor="middle" class="chart-value">@d</text>
                <text x="@F(cx)" y="@(H - B + 18)" text-anchor="middle" class="chart-tick">@Short(e.Sprint.Name)</text>
            </g>
        }
        @if (Data.Count > 0)
        {
            <line x1="@L" x2="@(W - R)" y1="@F(Y(avg))" y2="@F(Y(avg))" class="chart-line-average" />
        }
    </svg>
</figure>

<details class="chart-table">
    <summary>Data table</summary>
    <table class="table table-sm">
        <thead><tr><th scope="col">Sprint</th><th scope="col">Completed on</th><th scope="col" class="text-end">Committed</th><th scope="col" class="text-end">Completed</th><th scope="col" class="text-end">Completed %</th></tr></thead>
        <tbody>
            @foreach (var e in Data)
            {
                var (c, d) = Values(e);
                <tr>
                    <td>@e.Sprint.Name</td>
                    <td>@e.Sprint.CompletedAt?.ToString("MMM d, yyyy")</td>
                    <td class="text-end">@c</td>
                    <td class="text-end">@d</td>
                    <td class="text-end">@Pct(c, d)</td>
                </tr>
            }
        </tbody>
    </table>
</details>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<VelocityEntry> Data { get; set; } = [];
    [Parameter] public bool CountMode { get; set; }

    private const int W = 760, H = 280, L = 48, R = 16, T = 18, B = 34;
    private const int PlotW = W - L - R, PlotH = H - T - B;

    private double yMax, yStep, groupW, barW, avg;
    private string Unit => CountMode ? "issues" : "points";

    private (int committed, int completed) Values(VelocityEntry e) =>
        CountMode ? (e.CommittedCount, e.CompletedCount) : (e.CommittedPoints, e.CompletedPoints);

    private double Y(double v) => T + PlotH - v / yMax * PlotH;

    protected override void OnParametersSet()
    {
        var max = Data.Select(e => Values(e)).Select(v => Math.Max(v.committed, v.completed)).DefaultIfEmpty(0).Max();
        (yMax, yStep) = Nice(max * 1.08); // headroom for value labels
        groupW = PlotW / (double)Math.Max(1, Data.Count);
        barW = Math.Min(36, groupW * 0.32);
        avg = Data.Count == 0 ? 0 : Math.Round(Data.Average(e => Values(e).completed), 1);
    }

    /// <summary>A bar with 3px rounded top corners, square at the baseline.</summary>
    private string Bar(double x, int v)
    {
        var y0 = Y(0);
        var h = y0 - Y(v);
        if (h <= 0) return $"M{F(x)},{F(y0)}h{F(barW)}";
        var r = Math.Min(3, Math.Min(h, barW / 2));
        return $"M{F(x)},{F(y0)}V{F(y0 - h + r)}Q{F(x)},{F(y0 - h)} {F(x + r)},{F(y0 - h)}H{F(x + barW - r)}Q{F(x + barW)},{F(y0 - h)} {F(x + barW)},{F(y0 - h + r)}V{F(y0)}Z";
    }

    private static string Pct(int committed, int completed) => committed == 0 ? "—" : $"{completed * 100 / committed}%";

    private static string Short(string name) => name.Length <= 14 ? name : name[..13] + "…";
}
