@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Nav
@inject IssueService Issues
@inject CurrentUser Me
@inject ProjectAccess Access

<div class="app">
    <header class="topbar">
        <a class="brand" href="/">
            <span class="brand-mark">◆</span> GitBench
        </a>

        <div class="topbar-search">
            <select class="form-select form-select-sm" value="@projectKey" @onchange="GoToProject">
                <option value="">Jump to project…</option>
                @foreach (var p in projects)
                {
                    <option value="@p.Key">@p.Key — @p.Name</option>
                }
            </select>
        </div>

        <div class="topbar-right">
            @if (projectKey != null && projectPerms.Can(Permission.EditIssues))
            {
                <a class="btn btn-primary btn-sm" href="/p/@projectKey/issues/new">+ New issue</a>
            }
            @if (Me.User != null)
            {
                <NotificationBell />
                <div class="user-menu">
                    @* Profile is static SSR ([ExcludeFromInteractiveRouting]); force a full load from interactive pages. *@
                    <a class="user-menu-profile" href="account/profile" title="Your profile"
                       @onclick="OpenProfile" @onclick:preventDefault>
                        <Avatar User="Me.User" Size="28" ShowName />
                    </a>
                    <a class="user-menu-profile small" href="/developers/api" title="REST API and webhooks">API</a>
                    <form class="user-menu-signout" method="post" action="account/logout">
                        <AntiforgeryToken />
                        <button type="submit" class="btn btn-sm btn-signout">Sign out</button>
                    </form>
                </div>
            }
        </div>
    </header>

    <div class="shell">
        <nav class="sidebar">
            <NavLink class="side-link" href="/" Match="NavLinkMatch.All">🏠 Dashboard</NavLink>
            <NavLink class="side-link" href="/projects/new">➕ New project</NavLink>

            @if (projectKey != null && CurrentProject is { } cp)
            {
                <div class="side-section">
                    <div class="side-project">
                        <span class="proj-avatar">@cp.Key[..1]</span>
                        <div>
                            <div class="side-project-name">@cp.Name</div>
                            <div class="muted small">@cp.Key</div>
                        </div>
                    </div>
                    <NavLink class="side-link" href="@($"/p/{cp.Key}/issues")" Match="NavLinkMatch.All">📋 Issues</NavLink>
                    <NavLink class="side-link" href="@($"/p/{cp.Key}/board")">🗂️ Board</NavLink>
                    <NavLink class="side-link" href="@($"/p/{cp.Key}/milestones")">🏁 Milestones</NavLink>
                    <NavLink class="side-link" href="@($"/p/{cp.Key}/repos")">📦 Repositories</NavLink>
                    <NavLink class="side-link" href="@($"/p/{cp.Key}/pull-requests")">🔀 Pull requests</NavLink>
                    <NavLink class="side-link" href="@($"/p/{cp.Key}/code-search")">🔍 Code search</NavLink>
                    <NavLink class="side-link" href="@($"/p/{cp.Key}/members")">👥 Members</NavLink>
                    @if (projectPerms.ProjectId == cp.Id && projectPerms.Can(Permission.ManageLabelsAndMilestones))
                    {
                        <NavLink class="side-link" href="@($"/p/{cp.Key}/settings")">⚙️ Settings</NavLink>
                    }
                </div>
            }

            <div class="side-section">
                <div class="side-heading">Projects</div>
                @foreach (var p in projects)
                {
                    <NavLink class="side-link" href="@($"/p/{p.Key}/issues")" Match="NavLinkMatch.Prefix">
                        <span class="proj-avatar sm">@p.Key[..1]</span> @p.Name
                    </NavLink>
                }
            </div>
        </nav>

        <main class="content">
            @* Render once the user is loaded, even when signed out, so RedirectToLogin can run. *@
            @if (userLoaded)
            {
                @Body
            }
        </main>
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private List<ProjectSummary> projects = [];
    private ProjectPermissions projectPerms = ProjectPermissions.None;
    private string? projectKey;
    private bool userLoaded;

    private ProjectSummary? CurrentProject => projects.FirstOrDefault(p => p.Key == projectKey);

    protected override async Task OnInitializedAsync()
    {
        await Me.EnsureLoadedAsync();
        userLoaded = true;
        await RefreshProjects();
        Nav.LocationChanged += OnLocationChanged;
        ParseProjectKey();
    }

    // Anonymous visitors (e.g. on the not-found page) don't get to see project names.
    // GetProjectsAsync only returns projects the user can view; projectPerms drives the project nav.
    private async Task RefreshProjects()
    {
        projects = Me.IsSignedIn ? await Issues.GetProjectsAsync() : [];
        var key = Nav.ToBaseRelativePath(Nav.Uri).Split('?')[0].Split('/') is [ "p", var k, .. ] ? k.ToUpperInvariant() : null;
        projectPerms = projects.FirstOrDefault(p => p.Key == key) is { } cur ? await Access.GetPermissionsAsync(cur.Id) : ProjectPermissions.None;
    }

    private async void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        ParseProjectKey();
        // Pick up newly created/deleted projects.
        await RefreshProjects();
        await InvokeAsync(StateHasChanged);
    }

    private void ParseProjectKey()
    {
        var path = Nav.ToBaseRelativePath(Nav.Uri).Split('?')[0].Split('/');
        projectKey = path.Length >= 2 && path[0] == "p" ? path[1].ToUpperInvariant() : null;
    }

    private void GoToProject(ChangeEventArgs e)
    {
        if (e.Value is string k && k.Length > 0) Nav.NavigateTo($"/p/{k}/issues");
    }

    private void OpenProfile() => Nav.NavigateTo("account/profile", forceLoad: true);

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}
