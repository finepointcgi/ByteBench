@implements IDisposable
@inject NotificationService Notifications
@inject LiveEvents Live
@inject CurrentUser Me
@inject NavigationManager Nav

<div class="gb-notif">
    <MudBadge Content="@(unread > 99 ? "99+" : unread.ToString())" Visible="@(unread > 0)" Color="Color.Error" Overlap="true" Bordered="true">
        <MudIconButton Icon="@(unread > 0 ? Icons.Material.Filled.Notifications : Icons.Material.Outlined.Notifications)" Color="Color.Inherit"
                       OnClick="Toggle" aria-label="@($"Notifications, {unread} unread")" aria-expanded="@(open ? "true" : "false")" />
    </MudBadge>
    <MudPopover Open="open" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" Class="gb-notif-popover" Paper="true" Elevation="8">
        <div class="d-flex align-center px-4 py-2">
            <MudText Typo="Typo.subtitle2">Notifications</MudText>
            <MudSpacer />
            <MudButton Variant="Variant.Text" Size="Size.Small" Disabled="@(unread == 0)" OnClick="MarkAllRead">Mark all read</MudButton>
        </div>
        <MudDivider />
        @if (latest.Count == 0)
        {
            <MudText Typo="Typo.body2" Class="pa-4 mud-text-secondary">You're all caught up.</MudText>
        }
        <MudList T="int" Dense="true" Class="py-0">
            @foreach (var n in latest)
            {
                <MudListItem T="int" @key="n.Id" OnClick="() => Open(n)" Class="@(n.IsRead ? "" : "gb-notif-unread")">
                    <div class="d-flex gap-3 align-start">
                        <Avatar User="n.Actor" Size="24" />
                        <div class="flex-grow-1">
                            <MudText Typo="Typo.body2"><b>@(n.Actor?.DisplayName ?? "GitBench")</b> @NotificationService.Verb(n.Kind) <span>@n.Title</span></MudText>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">@Display.Ago(n.CreatedAt)</MudText>
                        </div>
                        @if (!n.IsRead) { <span class="gb-notif-dot" title="Unread"></span> }
                    </div>
                </MudListItem>
            }
        </MudList>
        <MudDivider />
        <MudButton Href="/notifications" FullWidth="true" Variant="Variant.Text" OnClick="() => open = false">View all notifications</MudButton>
    </MudPopover>
    <MudOverlay Visible="open" OnClick="() => open = false" AutoClose="true" />
</div>

@code {
    private int unread;
    private bool open;
    private List<Notification> latest = [];
    private IDisposable? subscription;

    protected override async Task OnInitializedAsync()
    {
        if (Me.IsSignedIn) unread = await Notifications.GetUnreadCountAsync(Me.Id);
    }

    protected override void OnAfterRender(bool firstRender)
    {
        // Subscribe only once interactive (never during prerendering), so Dispose always pairs with it.
        if (firstRender && Me.IsSignedIn)
            subscription = Live.Subscribe<NotificationsChanged>(e => e.UserId == Me.Id ? InvokeAsync(RefreshAsync) : Task.CompletedTask);
    }

    private async Task RefreshAsync()
    {
        unread = await Notifications.GetUnreadCountAsync(Me.Id);
        if (open) latest = await Notifications.GetLatestAsync(Me.Id);
        StateHasChanged();
    }

    private async Task Toggle()
    {
        open = !open;
        if (open) latest = await Notifications.GetLatestAsync(Me.Id);
    }

    private async Task Open(Notification n)
    {
        open = false;
        if (!n.IsRead) await Notifications.MarkReadAsync(Me.Id, n.Id);
        Nav.NavigateTo(n.Url);
    }

    private async Task MarkAllRead()
    {
        await Notifications.MarkAllReadAsync(Me.Id);
        await RefreshAsync();
    }

    public void Dispose() => subscription?.Dispose();
}
