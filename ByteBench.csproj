<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <UserSecretsId>d0f93638-83e5-4e33-ac39-5868488acf6c</UserSecretsId>
    <!-- The test project lives under tests/: keep its sources, obj and bin out of the app's default globs. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);tests/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Anthropic" Version="13.10.0" />
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
    <PackageReference Include="LibGit2Sharp" Version="0.32.0" />
    <PackageReference Include="MailKit" Version="5.0.0" />
    <PackageReference Include="Markdig" Version="1.6.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.14" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.15" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.14" />
    <PackageReference Include="Microsoft.DevTunnels.Ssh" Version="3.12.42" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.15" />
    <PackageReference Include="MudBlazor" Version="9.14.0" />
    <PackageReference Include="Novell.Directory.Ldap.NETStandard" Version="4.0.0" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

  <!--
    One-time cleanup for a checkout that was built before the product was renamed from GitBench. The old bin/obj output makes the
    incremental build keep the previous component style ids, so every page loses its styling. The old project name leaves
    obj/GitBench.csproj.nuget.g.props; the target removes the compile output and those files, so it only ever runs once.
  -->
  <Target Name="CleanOutputFromBeforeTheRename" BeforeTargets="BeforeBuild;BeforeRebuild" Condition="Exists('$(MSBuildProjectDirectory)/obj/GitBench.csproj.nuget.g.props')">
    <Message Importance="high" Text="Removing build output from before the rename to ByteBench (one time)." />
    <ItemGroup>
      <_PreRenameFiles Include="$(MSBuildProjectDirectory)/obj/GitBench.*" />
    </ItemGroup>
    <RemoveDir Directories="$(MSBuildProjectDirectory)/obj/Debug;$(MSBuildProjectDirectory)/obj/Release;$(MSBuildProjectDirectory)/bin" />
    <Delete Files="@(_PreRenameFiles)" />
  </Target>

</Project>
