                "artifactLocation": {
                  "uri": "app/api.py"
                },
                "region": {
                  "startLine": 88
                }
              }
            }
          ]
        },
        {
          "ruleId": "duplication",
          "ruleIndex": 7,
          "level": "note",
          "message": {
            "text": "42 duplicated lines (app/api.py, app/views.py)"
          },
          "partialFingerprints": {
            "nightowl/v1": "1a5c99c04c4549a25dafd0e7d1c47ac8"
          },
          "properties": {
            "severity": "Low",
            "engines": [
