          },
          "properties": {
            "severity": "High",
            "engines": [
              "trivy-image"
            ]
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "Dockerfile"
                },
                "region": {
                  "startLine": 1
                }
              }
            }
          ]
        },
        {
          "ruleId": "complexity",
          "ruleIndex": 5,
          "level": "note",
          "message": {
            "text": "render() has cyclomatic complexity 23 (max 15)"
          },
          "partialFingerprints": {
            "nightowl/v1": "3716fd71a893335bfec443739c070f59"
          },
          "properties": {
            "severity": "Low",
            "engines": [
              "lizard"
            ]
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "app/views.py"
                },
                "region": {
                  "startLine": 10
                }
              }
            }
          ]
        },
        {
          "ruleId": "javascript.browser.security.eval-detected",
          "ruleIndex": 6,
          "level": "error",
          "message": {
            "text": "eval() with dynamic input"
          },
          "partialFingerprints": {
            "nightowl/v1": "74f83d20fa17990c6b5da0916324e011"
          },
          "properties": {
            "severity": "High",
            "engines": [
