{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Email": {
    "Enabled": false,
    "From": "GitBench <gitbench@localhost>",
    "DigestMinutes": 0,
    "PickupDirectory": "mail-drop",
    "Smtp": { "Port": 587, "UseStartTls": true }
  },
  "Ci": {
    "Enabled": true,
    "MaxConcurrentJobs": 2,
    "JobTimeoutMinutes": 20,
    "Network": "bridge",
    "Memory": "2g",
    "Cpus": "2"
  }
}
