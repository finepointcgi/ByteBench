{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Email": {
    "Enabled": false,
    "From": "GitBench <gitbench@localhost>",
    "DigestMinutes": 0,
    "PickupDirectory": "mail-drop",
    "Smtp": { "Port": 587, "UseStartTls": true }
  },
  "ServiceDesk": {
    "IncomingAddress": "desk@gitbench.localhost",
    "MaxAttachmentBytes": 10485760,
    "MaxAttachmentsPerMessage": 10,
    "MaxMessagesPerSenderPerHour": 20,
    "MaxFormSubmissionsPerHour": 10,
    "Imap": { "Enabled": false, "Port": 993, "UseSsl": true, "Folder": "INBOX", "PollSeconds": 60 }
  },
  "Ci": {
    "Enabled": true,
    "MaxConcurrentJobs": 2,
    "JobTimeoutMinutes": 20,
    "Network": "bridge",
    "Memory": "2g",
    "Cpus": "2"
  }
}
