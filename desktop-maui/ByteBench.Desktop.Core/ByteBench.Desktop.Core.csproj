<Project Sdk="Microsoft.NET.Sdk">

  <!-- Plain net10.0 library: no MAUI workload needed. Everything platform-neutral the desktop shell relies on. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ByteBench.Desktop.Core</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

</Project>
