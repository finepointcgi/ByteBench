<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ByteBench desktop client built on .NET MAUI: a thin shell around the server's own web UI.
    Mac Catalyst always; Windows only when building on Windows. No Android or iOS.
    Needs the MAUI workload for the platform:  dotnet workload install maui-maccatalyst   (Windows: maui-windows)
    This project is intentionally NOT part of ByteBench.sln so CI does not need the workload.
  -->
  <PropertyGroup>
    <TargetFrameworks>net10.0-maccatalyst</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <RootNamespace>ByteBench.Desktop</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <ApplicationTitle>ByteBench</ApplicationTitle>
    <ApplicationId>com.bytebench.desktop</ApplicationId>
    <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <SupportedOSPlatformVersion Condition="$(TargetFramework.Contains('-maccatalyst'))">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$(TargetFramework.Contains('-windows'))">10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$(TargetFramework.Contains('-windows'))">10.0.17763.0</TargetPlatformMinVersion>

    <!-- Unpackaged on Windows: runs from a folder, no MSIX needed. -->
    <WindowsPackageType Condition="$(TargetFramework.Contains('-windows'))">None</WindowsPackageType>
    <WindowsAppSDKSelfContained Condition="$(TargetFramework.Contains('-windows'))">true</WindowsAppSDKSelfContained>
    <SelfContained Condition="$(TargetFramework.Contains('-windows'))">true</SelfContained>

    <!-- Mac Catalyst: this app starts git and writes to a folder the user names, so it is not sandboxed. See README. -->
    <CodesignEntitlements Condition="$(TargetFramework.Contains('-maccatalyst'))">Platforms/MacCatalyst/Entitlements.plist</CodesignEntitlements>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ByteBench.Desktop.Core\ByteBench.Desktop.Core.csproj" />
  </ItemGroup>

</Project>
